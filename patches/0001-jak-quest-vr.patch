+void skin_trace(std::uint8_t* memory, std::uint32_t matrices, std::uint32_t bones, int count, std::uint32_t camera) {
+#if !defined(__ANDROID__)
+  constexpr std::ptrdiff_t kBoneSize = 96;    // Jak 1's bone: its transform, scale and cache
+  constexpr std::ptrdiff_t kSkinSize = 128;   // a skinning matrix (pris-mtx): its transform, normals and scale
+  if (!memory || !s_trace_bone || !s_trace_trans) {
+    return;
+  }
+  const std::ptrdiff_t off = s_trace_bone - (memory + bones);
+  if (off < 0 || off % kBoneSize != 0 || off / kBoneSize >= count) {
+    return;
+  }
+  const auto* t = reinterpret_cast<const float*>(memory + matrices + (off / kBoneSize) * kSkinSize);
+  const float* at = s_game_tag.hidden[0].at;
+  float p[3];
+  for (int i = 0; i < 3; ++i) {
+    p[i] = at[0] * t[i] + at[1] * t[4 + i] + at[2] * t[8 + i] + t[12 + i];
+  }
+  // the camera's place from its matrix (a point times it is that point in the camera): minus its last row turned back
+  const auto* c = reinterpret_cast<const float*>(memory + camera);
+  float place[3];
+  for (int k = 0; k < 3; ++k) {
+    place[k] = -(c[12] * c[4 * k] + c[13] * c[4 * k + 1] + c[14] * c[4 * k + 2]);
+  }
+  const auto* bone = reinterpret_cast<const float*>(s_trace_bone);
+  const float m = 1.0f / 4096.0f;
+  // the skinned point back in the world, and how far from the bone's own place, in the bone's axes (each axis's length
+  // is its scale)
+  float world[3], d[3], along[3], scale[3];
+  for (int k = 0; k < 3; ++k) {
+    world[k] = place[k];
+    for (int i = 0; i < 3; ++i) {
+      world[k] += p[i] * c[4 * k + i];
+    }
+    d[k] = world[k] - bone[12 + k];
+  }
+  for (int j = 0; j < 3; ++j) {
+    const float* row = bone + 4 * j;
+    scale[j] = std::sqrt(row[0] * row[0] + row[1] * row[1] + row[2] * row[2]);
+    along[j] = scale[j] > 1e-6f ? (d[0] * row[0] + d[1] * row[1] + d[2] * row[2]) / (scale[j] * scale[j]) : 0.0f;
+  }
+  log_line(0, fmt::format("[vr-body] skinned frame {}: head point in the camera ({:.2f} {:.2f} {:.2f}); the camera "
+                          "({:.3f} {:.3f} {:.3f}) m from where placed, the neck base ({:.3f} {:.3f} {:.3f}) m from posed; "
+                          "the point ({:.3f} {:.3f} {:.3f}) m from the bone's place, ({:.3f} {:.3f} {:.3f}) in its "
+                          "axes, their scale ({:.3f} {:.3f} {:.3f}), w ({:.3f} {:.3f} {:.3f} {:.3f}); at ({:.3f} {:.3f} "
+                          "{:.3f}) m",
+                          s_game_tag.number, p[0] * m, p[1] * m, p[2] * m, (place[0] - s_trace_trans_was[0]) * m,
+                          (place[1] - s_trace_trans_was[1]) * m, (place[2] - s_trace_trans_was[2]) * m,
+                          (bone[12] - s_trace_bone_was[12]) * m, (bone[13] - s_trace_bone_was[13]) * m,
+                          (bone[14] - s_trace_bone_was[14]) * m, d[0] * m, d[1] * m, d[2] * m, along[0] * m,
+                          along[1] * m, along[2] * m, scale[0], scale[1], scale[2], bone[3], bone[7], bone[11], bone[15],
+                          at[0] * m, at[1] * m, at[2] * m)
+                  .c_str());
+#else
+  (void)memory;
+  (void)matrices;
+  (void)bones;
+  (void)count;
+  (void)camera;
+#endif
+}
+
+float glow_near_fade(float depth, float z_offset, float flare, float flare_max) {
+  const auto& d = s_display;
+  if (d.pass.kind != PassKind::kEye || !d.drawing || !d.drawing->first_person) {
+    return 1.0f;
+  }
+  // The flare is drawn z_offset nearer the eye than the light; its size on screen is its size over that depth. Gone
+  // where that depth is half a metre or less (at none or less the game's sums turn it inside out, filling the view),
+  // all of it from 2 m.
+  const float flare_depth = depth - z_offset;
+  const float fade = std::clamp((flare_depth - 0.5f * 4096.0f) / (1.5f * 4096.0f), 0.0f, 1.0f);
+#if !defined(__ANDROID__)
+  static const bool trace = std::getenv("JAKVR_GLOW_TRACE") != nullptr;
+  if (trace && d.pass.eye == 0 && (fade < 1.0f || flare_depth < 4.0f * 4096.0f)) {
+    log_line(0, fmt::format("[vr-glow] frame {}: a glow {:.2f} m ahead of the eye, its flare {:.2f} m nearer, {:.0f} "
+                            "wide on screen (most {:.0f}), at {:.2f} of its light",
+                            d.drawing->number, depth / 4096.0f, z_offset / 4096.0f, flare, flare_max, fade)
+                    .c_str());
+  }
+#endif
+  return fade;
+}
