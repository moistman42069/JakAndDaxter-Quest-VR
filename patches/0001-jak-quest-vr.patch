+(defun vr-state-trace ()
+  "PC test aid (JAKVR_STATE_TRACE=1, pc-vr-test-flags bit 2): Jak's state in the log as it changes."
+  (when (and *target* (logtest? (pc-vr-test-flags) 2))
+    (let ((name (-> *target* next-state name)))
+      (when (!= name *vr-state-was*)
+        (set! *vr-state-was* name)
+        (format 0 "[vr] state ~A~%" name))))
+  ;; PC test aid (JAKVR_TEST_HUD=1, pc-vr-test-flags bit 32): the HUD kept on screen in play, for the HUD tests
+  (when (and *target* (logtest? (pc-vr-test-flags) 32))
+    (show-hud #f))
+  0)
+
+(defun vr-camera-update ()
+  (when (not (pc-vr-on?))
+    (set! *vr-head-hidden* #f)
+    (set! *vr-stereo* #f))
+  (when (pc-vr-on?)
+    (let ((info *vr-camera-info*))
+      (set! (-> info mode)
+            (cond
+              ((paused?) 2)
+              ;; a blackout (a load, a scene starting): the game's own camera, so what waits on it starts
+              ((< (-> *display* base-clock frame-counter) (-> *game-info* blackout-time)) 4)
+              ((movie?) 1)
+              (else 0)))
+      (set! (-> info flags) 0)
+      (when *target*
+        (logior! (-> info flags) 1)
+        (if (not (logtest? (-> *target* draw status) (draw-control-status no-draw)))
+            (logior! (-> info flags) 64))
+        (if (vr-title?)
+            (set! (-> info mode) 3))
+        (if (vr-first-person-ok?)
+            (logior! (-> info flags) 2))
+        (if (vr-vehicle-first-person-ok?)
+            (logior! (-> info flags) 256))
+        ;; he has a gun and may draw it here: the holsters count (kFlagGun; before it a grip at the hip is a fist)
+        (if (and (logtest? (-> *target* game features) (game-feature gun))
+                 (logtest? (-> *setting-control* user-current features) (game-feature gun)))
+            (logior! (-> info flags) 512))
+        (if (focus-test? *target* grabbed)
+            (logior! (-> info flags) 8))
+        (if (logtest? (-> *target* control status) (collide-status on-surface))
+            (logior! (-> info flags) 16))
+        (if (case (-> *target* next-state name) (('target-duck-stance 'target-duck-walk) #t) (else #f))
+            (logior! (-> info flags) 32))
+        ;; 0.1.1: in his roll (kFlagRolling): the view goes down with him as in a crouch, so his arms still reach the
+        ;; player's hands (jak_vr.cpp first_person_anchor; Vixel: "rolling feels off")
+        (if (= (-> *target* next-state name) 'target-roll)
+            (logior! (-> info flags) 1024))
+        ;; 0.1.1: on the JET-Board (kFlagBoard): the right stick's click is the game's R2 there too, so the click that
+        ;; put him on it takes him off (sim b36 buttons3: there the click was R3, the game's look around, unused in VR)
+        (if (focus-test? *target* board)
+            (logior! (-> info flags) 2048))
+        (set! (-> info target-trans quad) (-> *target* control trans quad))
+        (if (and (nonzero? (-> *target* neck)) (-> *target* neck joint))
+            (vr-eyes<-neck! (-> info head) (-> *target* neck joint)
+                            (vector-z-quaternion! (new-stack-vector0) (-> *target* control quat)))
+            (begin
+              (set! (-> info head quad) (-> *target* control trans quad))
+              (+! (-> info head y) (meters 1.5))))
+        (let ((fwd (vector-z-quaternion! (new-stack-vector0) (-> *target* control quat))))
+          ;; atan gives GOAL rotation units (65536 per turn); the runtime wants radians
+          (set! (-> info target-yaw) (* 0.00009587380 (atan (-> fwd x) (-> fwd z))))))
+      ;; a scene acting with its own Jak: the eyes in his head
+      (set! *vr-scene-jak* (the-as process-drawable #f))
+      (if (= (-> info mode) 1)
+          (vr-scene-jak-head! info))
+      (set! (-> info camera-trans quad) (-> *math-camera* trans quad))
+      ;; back: 1 when the view is in Jak's head this frame, 2 when the eyes see the game in stereo
+      (let ((r (pc-vr-camera! (-> *math-camera* inv-camera-rot) (-> *math-camera* trans) info)))
+        (set! *vr-head-hidden* (logtest? r 1))
+        (set! *vr-stereo* (logtest? r 2)))
+      (vr-graphics!)
+      (vr-body-update! (-> info mode))
+      (vr-menu-draw)))
+  (vr-test-continue!)
+  (vr-state-trace)
+  0)
