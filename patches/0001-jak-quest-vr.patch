+constexpr float kShoulderLift = 0.35f;   // the shoulder's rise with the hand high (about 20 degrees at most)
+constexpr float kShoulderReach = 0.25f;  // and its swing toward a hand reaching far (about 14 degrees)
+
+// A controller in the world as the camera placed the head this frame: its place, along the fingers of an open hand
+// (-z), out of the palm (+x for the left hand, -x for the right: OpenXR's grip), the top of the fist (+y, the thumb's
+// side); and the palm's middle, on the controller's handle, which sits 3 cm off the palm.
+struct GripWorld {
+  Vec3 at, along, palm, thumb, palm_middle;
+};
+GripWorld grip_world(int side, const Pose& grip) {
+  GripWorld g;
+  g.at = s_rig.map_head_world + scaled(to_world_dir(grip.position - s_rig.map_head_tracking, s_rig.map_yaw), s_rig.map_units);
+  g.along = unit(to_world_dir(rot(grip.orientation, {0, 0, -1}), s_rig.map_yaw), {0, 0, 1});
+  g.palm = to_world_dir(rot(grip.orientation, {side == quest::kLeft ? 1.0f : -1.0f, 0, 0}), s_rig.map_yaw);
+  g.palm = unit(g.palm - scaled(g.along, dot3(g.palm, g.along)), {1, 0, 0});
+  g.thumb = unit(to_world_dir(rot(grip.orientation, {0, 1, 0}), s_rig.map_yaw), {0, 1, 0});
+  g.palm_middle = g.at - scaled(g.palm, 0.03f * s_rig.map_units);
+  return g;
+}
+
+// How far (radians) a hand must pitch about its palm to keep its wrist `clear` of the eyes: the palm at `to_palm` from
+// them, the fingers along `along`, the wrist `reach` behind the palm; pitching by p turns `along` toward `up_n` (unit,
+// square to it), so a positive pitch drops the wrist. 0 when the wrist is clear already. The wrist is behind the palm at
+// to_palm - reach * along', clear while to_palm . along' <= c below; along' = along cos p + up_n sin p makes that
+// A cos p + B sin p = rho cos(p - psi), so the wrist is in the eyes for p within psi +- alpha, and the least pitch out is
+// psi + alpha (up) or psi - alpha (down).
+float wrist_pitch(Vec3 to_palm, Vec3 along, Vec3 up_n, float reach, float clear) {
+  const float c = (dot3(to_palm, to_palm) + reach * reach - clear * clear) / (2.0f * reach);
+  const float A = dot3(to_palm, along), B = dot3(to_palm, up_n);
+  if (A <= c) {
+    return 0.0f;
+  }
+  const float rho = std::sqrt(A * A + B * B);
+  const float psi = std::atan2(B, A), alpha = std::acos(std::clamp(c / rho, -1.0f, 1.0f));
+  const float up = psi + alpha, down = psi - alpha;  // A > c puts p = 0 inside: up > 0 > down
+  return -down + kWristPreferUp < up ? down : up;
+}
+
+// One arm to the controller `grip` (tracking), and its hand and fingers. `facing`: where his chest faces, flat;
+// `shift`: the hand moved off the controller by the world (hands on the world); `curl_fixed`: 0 or more, its four
+// fingers closed at least that far whatever is there (on the gun); less, each finger tried against `planes` (what the
+// hand is at); `seconds`: the frame's time.
+void pose_arm(Mat* w, const VrBodyInfo& info, int side, const Pose& grip, Vec3 facing, Vec3 shift, float curl_fixed,
+              const HandPlane* planes, int plane_count, float seconds) {
+  const auto& s = s_shape;
+  const int base = kJointSide + 16 * side;
+  const auto node = [&](int j) {
+    const int n = info.named[base + j];
+    return n >= 0 && n < s.count && info.bone[n] != 0 ? n : -1;
+  };
