   # Replace @@ with ${}, even if that may not be read by CMake scripts.
   string(REGEX REPLACE "@([a-zA-Z_][a-zA-Z0-9_]*)@" "\${\\1}" _makefile_inc_text ${_makefile_inc_text})
 
