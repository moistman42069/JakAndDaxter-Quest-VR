diff --git a/game/vr/crash_dump_win.cpp b/game/vr/crash_dump_win.cpp
new file mode 100644
index 000000000..95a94bd30
--- /dev/null
+++ b/game/vr/crash_dump_win.cpp
@@ -0,0 +1,82 @@
+// Jak and Daxter Quest VR: a PC test aid. With JAKVR_CRASH_DUMP=<folder>, the first access violation writes the
+// registers and the stack's first words (crash.txt, laid out as lldb's "register read" and "x/64xg $rsp", which the
+// tools in C:\JakQuest\sim read) and the game's memory above its protected first 512 KB (ee.bin) to that folder, so a
+// crash in the game's own code can be named at full speed (under lldb the games run several times slower). Nothing
+// is done without the variable.
+#if defined(_WIN32)
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <Windows.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "common/goal_constants.h"
+
+#include "game/runtime.h"
+#include "game/vr/jak_vr.h"
+
+namespace jakvr {
+namespace {
+
+std::string s_dump_folder;
+std::atomic<bool> s_dumped{false};
+
+LONG CALLBACK on_exception(EXCEPTION_POINTERS* info) {
+  if (info->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || s_dumped.exchange(true)) {
+    return EXCEPTION_CONTINUE_SEARCH;
+  }
+  const CONTEXT& c = *info->ContextRecord;
+  const std::string text_path = s_dump_folder + "\\crash.txt";
+  if (FILE* f = std::fopen(text_path.c_str(), "w")) {
+    const auto* rec = info->ExceptionRecord;
+    std::fprintf(f, "stop reason = Exception 0x%08lx encountered at address 0x%llx: access %llu at 0x%llx\n",
+                 rec->ExceptionCode, (unsigned long long)rec->ExceptionAddress,
+                 (unsigned long long)rec->ExceptionInformation[0], (unsigned long long)rec->ExceptionInformation[1]);
+    std::fprintf(f, "ee base 0x%llx\n", (unsigned long long)g_ee_main_mem);
+    std::fprintf(f, "General Purpose Registers:\n");
+    const struct {
+      const char* name;
+      DWORD64 value;
+    } regs[] = {{"rax", c.Rax}, {"rbx", c.Rbx}, {"rcx", c.Rcx}, {"rdx", c.Rdx}, {"rdi", c.Rdi}, {"rsi", c.Rsi},
+                {"rbp", c.Rbp}, {"rsp", c.Rsp}, {"r8", c.R8},   {"r9", c.R9},   {"r10", c.R10}, {"r11", c.R11},
+                {"r12", c.R12}, {"r13", c.R13}, {"r14", c.R14}, {"r15", c.R15}, {"rip", c.Rip}};
+    for (const auto& r : regs) {
+      std::fprintf(f, "     %s = 0x%016llx\n", r.name, (unsigned long long)r.value);
+    }
+    std::fprintf(f, "(lldb) x/64xg $rsp\n");
+    unsigned long long words[128] = {};
+    SIZE_T got = 0;
+    ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(c.Rsp), words, sizeof words, &got);
+    for (SIZE_T i = 0; i + 1 < got / 8; i += 2) {
+      std::fprintf(f, "0x%llx: 0x%016llx 0x%016llx\n", (unsigned long long)(c.Rsp + i * 8), words[i], words[i + 1]);
+    }
+    std::fclose(f);
+  }
+  if (g_ee_main_mem) {
+    const std::string mem_path = s_dump_folder + "\\ee.bin";
+    if (FILE* f = std::fopen(mem_path.c_str(), "wb")) {
+      std::fwrite(g_ee_main_mem + EE_MAIN_MEM_LOW_PROTECT, 1, EE_MAIN_MEM_SIZE - EE_MAIN_MEM_LOW_PROTECT, f);
+      std::fclose(f);
+    }
+  }
+  return EXCEPTION_CONTINUE_SEARCH;
+}
+
+}  // namespace
+
+void install_crash_dump() {
+  const char* folder = std::getenv("JAKVR_CRASH_DUMP");
+  if (!folder || !*folder || !s_dump_folder.empty()) {
+    return;
+  }
+  s_dump_folder = folder;
+  AddVectoredExceptionHandler(1, on_exception);
+}
+
+}  // namespace jakvr
+
+#endif
diff --git a/game/vr/glyphs.h b/game/vr/glyphs.h
new file mode 100644
index 000000000..73accb778
--- /dev/null
+++ b/game/vr/glyphs.h
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// The headset's controls in place of the PS2 pad icons in the game's texts (Rerac-vr's
+// pad_glyphs.rs, npiriou, ISC): the icons (text bytes 0x10..0x19) of the three fonts, each a 24 x 16
+// cell of the font's texture, are painted again as the control that sends that button here (pad.h:
+// A Cross, the trigger Circle, the right stick's click Triangle, the right grip Square, the left
+// grip L1, the left trigger R1, X L2, B R2, and the two sticks). The game keeps its font textures
+// as 8-bit indices into 256 colours, so each texel painted takes the nearest colour the texture
+// has. Plain math (tests/rig_pad_test.cpp).
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace quest::glyphs {
+
+inline constexpr int kCellW = 24;
+inline constexpr int kCellH = 16;
+inline constexpr float kOpaque = 128.0f;  // the GS's alpha of an opaque texel
+
+enum class Shape { Button, Key, Stick, StickClick };
+
+struct Glyph {
+    std::uint8_t code;
+    Shape shape;
+    const char* label;
+};
+
+// The pad icon codes, with the control that sends each (Rerac-vr's table; pad.h's mapping is the same).
+inline constexpr std::array<Glyph, 10> kGlyphs = {{
+    {0x10, Shape::Button, "A"},       // Cross: jump, confirm
+    {0x11, Shape::Key, "RT"},         // Circle: weapons and gadgets
+    {0x12, Shape::StickClick, "R"},   // Triangle: talk, the quick select, back
+    {0x13, Shape::Key, "RG"},         // Square: the wrench
+    {0x14, Shape::Key, "LG"},         // L1: the previous page in menus
+    {0x15, Shape::Key, "LT"},         // R1: crouch, the packs; the next page in menus
+    {0x16, Shape::Button, "X"},       // L2
+    {0x17, Shape::Button, "B"},       // R2: hover, strafe, the Hydro-Pack's boost
+    {0x18, Shape::Stick, "R"},        // the right stick
+    {0x19, Shape::Stick, "L"},        // the left stick
+}};
+
+// A cell being painted: straight colour and the GS's alpha (0..128), all clear to start.
+struct Cell {
+    float rgba[kCellH][kCellW][4] = {};
+
+    // Source over, in straight colour.
+    void blend(int x, int y, const float rgb[3], float cover) {
+        if (x < 0 || y < 0 || x >= kCellW || y >= kCellH || cover <= 0.0f) {
+            return;
+        }
+        float* px = rgba[y][x];
+        const float sa = std::min(cover, 1.0f), da = px[3] / kOpaque;
+        const float a = sa + da * (1.0f - sa);
+        for (int c = 0; c < 3; ++c) {
+            px[c] = std::clamp(std::round((rgb[c] * sa + px[c] * da * (1.0f - sa)) / a), 0.0f, 255.0f);
+        }
+        px[3] = std::round(a * kOpaque);
+    }
+
+    // Fills what `inside` covers (4 x 4 samples a texel) with `shade(x, y)`.
+    template <class Inside, class Shade>
+    void fill(Inside inside, Shade shade) {
+        for (int y = 0; y < kCellH; ++y) {
+            for (int x = 0; x < kCellW; ++x) {
+                int n = 0;
+                for (int sy = 0; sy < 4; ++sy) {
+                    for (int sx = 0; sx < 4; ++sx) {
+                        n += inside(x + (sx + 0.5f) / 4.0f, y + (sy + 0.5f) / 4.0f) ? 1 : 0;
+                    }
+                }
+                float rgb[3];
+                shade(x + 0.5f, y + 0.5f, rgb);
+                blend(x, y, rgb, n / 16.0f);
+            }
+        }
+    }
+};
+
+inline void grey(float v, float out[3]) {
+    out[0] = v;
+    out[1] = v;
+    out[2] = v * 1.06f;
+}
+
+// A face button: a dark rim, a body lit from above.
+inline void disc(Cell& cell, float cx, float cy, float r) {
+    const auto d = [=](float x, float y) { return std::sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)); };
+    cell.fill([=](float x, float y) { return d(x, y) <= r; }, [](float, float, float out[3]) { grey(30.0f, out); });
+    cell.fill([=](float x, float y) { return d(x, y) <= r - 1.2f; },
+              [=](float, float y, float out[3]) { grey(86.0f - (y - cy + r) / (2.0f * r) * 40.0f, out); });
+}
+
+// A trigger or grip: a bevelled key, its top and left edges lit.
+inline void key(Cell& cell, float x0, float y0, float w, float h) {
+    const auto rounded = [=](float x, float y, float inset) {
+        const float l = x0 + inset, t = y0 + inset, r = x0 + w - inset, b = y0 + h - inset;
+        const float k = 1.5f;
+        const float dx = std::max(std::max(l + k - x, x - (r - k)), 0.0f);
+        const float dy = std::max(std::max(t + k - y, y - (b - k)), 0.0f);
+        return x >= l && x <= r && y >= t && y <= b && dx * dx + dy * dy <= k * k;
+    };
+    cell.fill([=](float x, float y) { return rounded(x, y, 0.0f); },
+              [=](float x, float y, float out[3]) { grey(x - x0 < 1.0f || y - y0 < 1.0f ? 150.0f : 28.0f, out); });
+    cell.fill([=](float x, float y) { return rounded(x, y, 1.0f); },
+              [=](float, float y, float out[3]) { grey(66.0f - (y - y0) / h * 30.0f, out); });
+}
+
+// A thumbstick: the dark base and the cap's lighter rim.
+inline void stick(Cell& cell, float cx, float cy, float r) {
+    const auto d = [=](float x, float y) { return std::sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy)); };
+    cell.fill([=](float x, float y) { return d(x, y) <= r; }, [](float, float, float out[3]) { grey(24.0f, out); });
+    cell.fill([=](float x, float y) { return d(x, y) <= r - 1.0f; },
+              [](float, float, float out[3]) { grey(118.0f, out); });
+    cell.fill([=](float x, float y) { return d(x, y) <= r - 2.2f; },
+              [=](float, float y, float out[3]) { grey(70.0f - (y - cy + r) / (2.0f * r) * 34.0f, out); });
+}
+
+// A downward arrow over the stick, centred on column `cx`.
+inline void press_arrow(Cell& cell, int cx) {
+    float light[3];
+    grey(235.0f, light);
+    const int rows[3][2] = {{0, 2}, {1, 1}, {2, 0}};
+    for (const auto& row : rows) {
+        for (int x = cx - row[1]; x <= cx + row[1]; ++x) {
+            cell.blend(x, row[0], light, 1.0f);
+        }
+    }
+}
+
+struct Letter {
+    char c;
+    int width;
+    const char* rows[9];
+};
+
+// Bold letters, two-texel stems.
+inline constexpr Letter kLetters[] = {
+    {'A', 7, {"..###..", ".##.##.", "##...##", "##...##", "##...##", "#######", "##...##", "##...##", "##...##"}},
+    {'X', 7, {"##...##", "##...##", ".##.##.", "..###..", "..###..", "..###..", ".##.##.", "##...##", "##...##"}},
+    {'B', 7, {"######.", "##...##", "##...##", "##...##", "######.", "##...##", "##...##", "##...##", "######."}},
+    {'R', 6, {"#####.", "##..##", "##..##", "##..##", "#####.", "##.##.", "##..##", "##..##", "##..##"}},
+    {'T', 6, {"######", "######", "..##..", "..##..", "..##..", "..##..", "..##..", "..##..", "..##.."}},
+    {'G', 6, {".####.", "##..##", "##....", "##....", "##.###", "##..##", "##..##", "##..##", ".####."}},
+    {'L', 6, {"##....", "##....", "##....", "##....", "##....", "##....", "##....", "######", "######"}},
+};
+
+// The stick caps' smaller letters (seven rows).
+inline constexpr Letter kSmallLetters[] = {
+    {'R', 5, {"####.", "##.##", "##.##", "####.", "##.#.", "##.##", "##.##"}},
+    {'L', 5, {"##...", "##...", "##...", "##...", "##...", "#####", "#####"}},
+};
+
+inline void ink(Cell& cell, const Letter& letter, int rows, int x0, int y0) {
+    const float white[3] = {238.0f, 238.0f, 244.0f};
+    for (int y = 0; y < rows; ++y) {
+        for (int x = 0; letter.rows[y][x] != '\0'; ++x) {
+            if (letter.rows[y][x] == '#') {
+                cell.blend(x0 + x, y0 + y, white, 1.0f);
+            }
+        }
+    }
+}
+
+// The label's bold letters, one texel apart, centred on column `cx` from row `y0`.
+inline void letters(Cell& cell, const char* label, int cx, int y0) {
+    const Letter* found[4] = {};
+    int count = 0, width = 0;
+    for (const char* c = label; *c != '\0' && count < 4; ++c) {
+        for (const Letter& l : kLetters) {
+            if (l.c == *c) {
+                found[count++] = &l;
+                width += l.width;
+            }
+        }
+    }
+    width += std::max(count - 1, 0);
+    int x = cx + 1 - (width + 1) / 2;
+    for (int i = 0; i < count; ++i) {
+        ink(cell, *found[i], 9, x, y0);
+        x += found[i]->width + 1;
+    }
+}
+
+inline void small_letter(Cell& cell, const char* label, int cx, int y0) {
+    for (const char* c = label; *c != '\0'; ++c) {
+        for (const Letter& l : kSmallLetters) {
+            if (l.c == *c) {
+                ink(cell, l, 7, cx + 1 - (l.width + 1) / 2, y0);
+            }
+        }
+    }
+}
+
+// Paints `glyph` in a clear cell; returns its advance (the pen's step past it).
+inline int paint(Cell& cell, const Glyph& glyph) {
+    switch (glyph.shape) {
+    case Shape::Button:
+        disc(cell, 9.5f, 8.0f, 7.9f);
+        letters(cell, glyph.label, 9, 3);
+        return 18;
+    case Shape::Key:
+        key(cell, 1.0f, 2.0f, 19.0f, 13.0f);
+        letters(cell, glyph.label, 10, 4);
+        return 21;
+    case Shape::Stick:
+        stick(cell, 8.5f, 8.5f, 7.4f);
+        small_letter(cell, glyph.label, 8, 5);
+        return 17;
+    case Shape::StickClick:
+        stick(cell, 9.5f, 9.5f, 6.4f);
+        small_letter(cell, glyph.label, 9, 6);
+        press_arrow(cell, 9);
+        return 17;
+    }
+    return 0;
+}
+
+// The GS's CSM1 order: an 8-bit index's colour is at the palette entry with bits 3 and 4 swapped.
+inline int csm1(int index) { return (index & 0xE7) | ((index & 0x08) << 1) | ((index & 0x10) >> 1); }
+
+// The texture's index nearest a texel's colour, `palette` its 256 colours as they lie in memory
+// (r, g, b, a bytes; CSM1 order), compared premultiplied so a clear texel takes a clear colour.
+inline std::uint8_t nearest(const std::uint8_t* palette, const float rgba[4]) {
+    const float a = rgba[3] / kOpaque;
+    int best = 0;
+    float best_d = 1e30f;
+    for (int i = 0; i < 256; ++i) {
+        const std::uint8_t* p = palette + 4 * csm1(i);
+        const float pa = std::min(p[3] / kOpaque, 1.0f);
+        float d = 0;
+        for (int c = 0; c < 3; ++c) {
+            const float e = rgba[c] * a - p[c] * pa;
+            d += e * e;
+        }
+        const float ea = (a - pa) * 255.0f;
+        d += 2.0f * ea * ea;
+        if (d < best_d) {
+            best_d = d;
+            best = i;
+        }
+    }
+    return static_cast<std::uint8_t>(best);
+}
+
+}  // namespace quest::glyphs
diff --git a/game/vr/hand.h b/game/vr/hand.h
new file mode 100644
index 000000000..7b52dabf6
--- /dev/null
+++ b/game/vr/hand.h
@@ -0,0 +1,257 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// What is held in the hand, put where the hand is: Rerac-vr's mounts (npiriou, ISC; embodied.rs
+// place, blaster.rs place and grip, bomb_glove.rs mount), the same game models on another engine.
+// Plain math, apart from the game and OpenXR (tests/rig_pad_test.cpp).
+//
+// A hand is OpenXR's grip pose: `forward` along the fist, `up` out of the thumb; or, for what points
+// (held_pointing), its aim pose turned by the player's Gun angle, at the grip's place: on the Quest's
+// controllers the grip's forward runs up the handle, well above where the controller points. An
+// item's moby has a matrix whose rows are where its model's X, Y and Z point, and a position:
+//
+// - guns and gadgets: their model has X out of the top, -Y out of the barrel, and is put with the
+//   point Rerac-vr measured on each model's handle (kGrips) in the palm;
+// - gloves: their first joint list ends at the palm, which is put in the hand;
+// - the wrench: that joint's frame has the shaft along its Z, so the frame is turned a quarter
+//   about the hand's side to lay the shaft along the fist, and it is 20% bigger, as on PC;
+// - anything else: its first joint list ends at the muzzle, put ahead of the hand.
+
+#pragma once
+
+#include "rig.h"
+
+namespace quest {
+
+// Three columns.
+struct Mat3 {
+    Vec3 x, y, z;
+};
+
+inline Vec3 operator*(const Mat3& m, Vec3 v) { return m.x * v.x + m.y * v.y + m.z * v.z; }
+inline Mat3 operator*(const Mat3& a, const Mat3& b) { return {a * b.x, a * b.y, a * b.z}; }
+inline float dot(Vec3 a, Vec3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+inline Mat3 transpose(const Mat3& m) {
+    return {{m.x.x, m.y.x, m.z.x}, {m.x.y, m.y.y, m.z.y}, {m.x.z, m.y.z, m.z.z}};
+}
+
+// A hand in the game's world.
+struct HandFrame {
+    Vec3 at, forward, left, up;
+};
+
+// The hand `pose` (OpenXR's grip, in the frame of rig.h) in the world.
+inline HandFrame hand_in_world(const Pose& pose) {
+    return {frame_to_world(pose.position), frame_to_world(rotate(pose.orientation, {0, 0, -1})),
+            frame_to_world(rotate(pose.orientation, {-1, 0, 0})),
+            frame_to_world(rotate(pose.orientation, {0, 1, 0}))};
+}
+
+// The first joint list's last joint in its model, from the class's inverse bind matrix `s`: its
+// columns are the joint's rows, and its last row the place, in the joint's axes and negated.
+struct JointFrame {
+    bool valid = false;
+    Mat3 basis;   // columns: the joint's X, Y and Z in the model
+    Vec3 anchor;  // the joint in the model, in the model's own units
+};
+
+inline JointFrame joint_frame(const float s[16]) {
+    JointFrame out;
+    out.valid = true;
+    out.basis = {{s[0], s[4], s[8]}, {s[1], s[5], s[9]}, {s[2], s[6], s[10]}};
+    out.anchor = (out.basis * Vec3{s[12], s[13], s[14]}) * -1.0f;
+    return out;
+}
+
+// Rerac-vr's blaster.rs grip: the handle's place on each model, in game units.
+struct GunGrip {
+    int oclass;
+    Vec3 grip;
+};
+
+inline constexpr GunGrip kGrips[] = {
+    {157, {0.0f, -0.04f, 0.0f}},       // Devastator
+    {163, {0.0f, -0.18f, 0.0f}},       // Visibomb
+    {168, {-0.065f, -0.13f, 0.0f}},    // Blaster
+    {175, {-0.035f, -0.22f, 0.0f}},    // Taunter
+    {176, {-0.045f, -0.14f, 0.0f}},    // Pyrocitor
+    {177, {-0.115f, -0.17f, 0.0f}},    // Tesla Claw
+    {180, {0.0f, -0.16f, 0.0f}},       // Walloper
+    {185, {-0.07f, -0.22f, -0.04f}},   // Morph-o-Ray
+    {188, {-0.015f, -0.145f, 0.0f}},   // Trespasser
+    {208, {0.0f, -0.075f, 0.0f}},      // Swingshot
+    {454, {-0.08f, -0.15f, 0.0f}},     // RYNO
+    {483, {-0.06f, -0.22f, -0.05f}},   // Hologuise, Drone Device remote
+    {585, {0.0f, -0.14f, -0.03f}},     // Metal Detector
+    {619, {0.02f, -0.17f, -0.045f}},   // PDA
+    {849, {0.0f, -0.14f, 0.0f}},       // Suck Cannon
+    {1251, {0.0f, -0.15f, 0.0f}},      // Hydrodisplacer
+};
+
+inline constexpr int kWrenchClass = 71;
+inline constexpr int kSwingshotClass = 208;
+inline constexpr int kPyrocitorClass = 176;
+inline constexpr int kWalloperClass = 180;
+inline constexpr float kWrenchScale = 1.2f;
+
+inline const GunGrip* gun_grip(int oclass) {
+    for (const GunGrip& g : kGrips) {
+        if (g.oclass == oclass) {
+            return &g;
+        }
+    }
+    return nullptr;
+}
+
+// The items a throwing glove holds (the hero's items 10, 17, 20 and 25).
+inline bool glove_item(int item) { return item == 10 || item == 17 || item == 20 || item == 25; }
+
+// What is held as a gun, its barrel where the controller points, and drawn at the Gun size: not the
+// wrench (swung as the fist holds it), the gloves (on the palm, at the Hand size), the Swingshot's
+// housing on the wrist, or the upright remotes.
+inline bool held_pointing(int oclass, int item) {
+    return oclass != kWrenchClass && oclass != kSwingshotClass && oclass != 483 && oclass != 619 && !glove_item(item);
+}
+
+// Where a moby goes.
+struct Mount {
+    Mat3 axes;       // columns: the rows of its matrix
+    Vec3 position;
+    float scale = 1; // times its class's scale
+    float size = 1;  // the Gun or Hand size: drawn so (put_mount), its place and muzzle already sized
+    Vec3 muzzle;     // where it fires from, Rerac-vr's blaster.rs place: where the hand aims from
+};
+
+// Rerac-vr's own muzzles where the first joint list is not one: the Visibomb's ends on its sight,
+// the Trespasser has none (its prong tip).
+inline bool fixed_muzzle(int oclass, Vec3& out) {
+    if (oclass == 163) {
+        out = {0.04f, -0.82f, 0.0f};
+        return true;
+    }
+    if (oclass == 188) {
+        out = {0.04f, -1.0f, -0.025f};
+        return true;
+    }
+    return false;
+}
+
+// The models made for the right hand (Rerac-vr's akimbo.rs right_handed): the gloves, the Walloper's
+// fist and the Swingshot's wrist housing. In the left hand they are mirrored, not held by a mirrored grip.
+inline bool right_handed(int oclass, int item) {
+    return glove_item(item) || oclass == kWalloperClass || oclass == kSwingshotClass;
+}
+
+inline Vec3 reflect(Vec3 v, Vec3 normal) { return v - normal * (2.0f * dot(v, normal)); }
+
+// `m`, placed for the right hand at `hand`, turned into its mirror image across the hand's side plane
+// (Rerac-vr's akimbo.rs mirror): the place and every axis reflected about the hand.
+inline Mount mirrored(const Mount& m, const HandFrame& hand) {
+    const float size = std::sqrt(dot(hand.left, hand.left));
+    if (size < 1e-6f) {
+        return m;
+    }
+    const Vec3 normal = hand.left * (1.0f / size);
+    Mount out = m;
+    out.axes = {reflect(m.axes.x, normal), reflect(m.axes.y, normal), reflect(m.axes.z, normal)};
+    out.position = hand.at + reflect(m.position - hand.at, normal);
+    out.muzzle = hand.at + reflect(m.muzzle - hand.at, normal);
+    return out;
+}
+
+inline Mount mount_right(const HandFrame& hand, int oclass, int item, float scale, const JointFrame& joint, bool left,
+                         float size);
+
+// A moby of `oclass` holding hand item `item`, in `hand`. `scale`: the moby's own; `joint`: its
+// first joint list's end. `left`: in the left hand, a model made for the right hand placed as the
+// right's and then mirrored, and so a gun with `mirror_guns` (its handle, a side grip or a tank on the
+// other side then, as a left-handed gun has them; else only its grip is mirrored, as Rerac-vr holds
+// it). What points (held_pointing) is drawn `gun_size` of the game's size and a glove, which is the
+// hand, `hand_size`, each shrunk about the hand. With `follow_hands` (Items match hand size) what
+// points is drawn at both sizes and the rest, the wrench among it, at the Hand size; without it the
+// rest keeps the game's.
+inline Mount mount_item(const HandFrame& hand, int oclass, int item, float scale, const JointFrame& joint, bool left = false,
+                        float gun_size = 1.0f, float hand_size = 1.0f, bool mirror_guns = false, bool follow_hands = false) {
+    const float size = glove_item(item)               ? hand_size
+                       : held_pointing(oclass, item) ? gun_size * (follow_hands ? hand_size : 1.0f)
+                       : follow_hands                ? hand_size
+                                                     : 1.0f;
+    if (left && (right_handed(oclass, item) || (mirror_guns && held_pointing(oclass, item)))) {
+        return mirrored(mount_right(hand, oclass, item, scale, joint, false, size), hand);
+    }
+    return mount_right(hand, oclass, item, scale, joint, left, size);
+}
+
+inline Mount mount_right(const HandFrame& hand, int oclass, int item, float scale, const JointFrame& joint, bool left,
+                         float size) {
+    Mount out;
+    out.size = size;
+    HandFrame h = hand;
+
+    // The Swingshot's housing goes on the back of the wrist: a quarter about the fist, from his right side up (Rerac-vr's
+    // blaster.rs, the hand turned +90 degrees about its Z). This was a quarter the other way until 0.1.12, which put the
+    // housing under the fist and the whole thing upside down (a tester's "facing the wrong way").
+    if (oclass == kSwingshotClass) {
+        h.up = hand.left;
+        h.left = hand.up * -1.0f;
+    }
+    const Vec3 right = h.left * -1.0f;
+    const Mat3 gun{h.up, h.forward * -1.0f, right};
+
+    if (oclass == kWrenchClass) {
+        // The joint's Z is the shaft: Rerac-vr's desired axes are the hand turned a quarter about
+        // its side (its "forward" the hand's down, its "up" the hand's forward).
+        const Mat3 desired{h.up * -1.0f, h.left, h.forward};
+        out.scale = kWrenchScale;
+        out.axes = joint.valid ? desired * transpose(joint.basis) : desired;
+        out.position = h.at;
+        if (joint.valid) {
+            out.position = h.at - out.axes * (joint.anchor * (scale * kWrenchScale * size / 1024.0f));
+        }
+        out.muzzle = h.at;
+        return out;
+    }
+
+    if (const GunGrip* grip = gun_grip(oclass)) {
+        // The upright remotes are wide along Y, their -Z face looking back at the holder.
+        out.axes = (oclass == 483 || oclass == 619) ? Mat3{h.up, h.left * -1.0f, h.forward} : gun;
+        // In the left hand the grip is mirrored across the gun's side.
+        const Vec3 held = left ? Vec3{grip->grip.x, grip->grip.y, -grip->grip.z} : grip->grip;
+        out.position = h.at - out.axes * (held * size);
+        // The muzzle: the first joint list's end on the model (its bind pose here, where Rerac-vr
+        // poses it), or Rerac-vr's own point; the remotes fire nothing and keep their grip.
+        Vec3 point = grip->grip;
+        if (!fixed_muzzle(oclass, point) && oclass != 483 && oclass != 619 && joint.valid) {
+            point = joint.anchor * (scale / 1024.0f);
+        }
+        out.muzzle = out.position + out.axes * (point * size);
+        return out;
+    }
+
+    out.axes = joint.valid ? gun * transpose(joint.basis) : gun;
+    const Vec3 anchor = joint.valid ? joint.anchor * (scale * size / 1024.0f) : Vec3{};
+    if (glove_item(item)) {
+        out.position = h.at - out.axes * anchor;
+        out.muzzle = h.at;
+        return out;
+    }
+
+    // Unmeasured guns: the muzzle ahead of the hand, as far as Rerac-vr reaches for each.
+    const float reach = oclass == kPyrocitorClass                                     ? 0.65f
+                        : (oclass == 157 || oclass == 163 || oclass == 454 || oclass == 849) ? 0.70f
+                                                                                          : 0.40f;
+    out.muzzle = h.at + (h.forward * reach + h.up * 0.03f) * size;
+    out.position = out.muzzle - out.axes * anchor;
+    return out;
+}
+
+// Giant Clank's punch does its real damage with a sweep of the ground ahead (Rerac-vr's giant.rs sweep_toward:
+// the walk's own spheres, 1.8 out and 1.4 up, an eighth of a turn apart), turned to the strike's flat `way`.
+constexpr int kGiantSweepPoints = 3;
+inline Vec3 giant_sweep_point(Vec3 hero, Vec3 way, int index) {
+    constexpr float kOut = 1.8f, kUp = 1.4f, kApart = 0.7853982f;
+    const float yaw = std::atan2(way.y, way.x) + static_cast<float>(index - 1) * kApart;
+    return hero + Vec3{std::cos(yaw) * kOut, std::sin(yaw) * kOut, kUp};
+}
+
+}  // namespace quest
diff --git a/game/vr/heading.h b/game/vr/heading.h
new file mode 100644
index 000000000..748d9119f
--- /dev/null
+++ b/game/vr/heading.h
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// Where the player's body faces, from the head and both controllers (Rerac-vr's vr/orientation.rs,
+// npiriou, ISC): a weighted mean of the head's heading, the shoulder line, the hands' midpoint ahead of
+// the neck and where the controllers point. It follows past 15 degrees and settles within 2, so a glance
+// does not swing it, and the head never looks more than 90 degrees from it. Plain math, in OpenXR's
+// tracking space (tests/rig_pad_test.cpp). A heading is as tracking_yaw's.
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include "rig.h"
+
+namespace quest {
+
+inline constexpr float kBodyHeadWeight = 0.75f;
+inline constexpr float kBodyShoulderWeight = 2.0f;
+inline constexpr float kBodyReachWeight = 1.5f;
+inline constexpr float kBodyPointWeight = 0.5f;
+inline constexpr float kBodyStart = 0.26f;    // radians off before it follows
+inline constexpr float kBodySettle = 0.035f;  // and where it stops
+inline constexpr float kBodyFollowSeconds = 0.15f;
+inline constexpr float kBodyNeckBack = 0.10f;
+
+inline float smooth_step(float a, float b, float x) {
+    const float t = std::clamp((x - a) / (b - a), 0.0f, 1.0f);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+inline float heading_of(Vec3 v) { return std::atan2(-v.x, -v.z); }
+
+inline Vec3 flat_unit(Vec3 v) {
+    v.y = 0;
+    const float size = length(v);
+    return size > 0.0f ? v * (1.0f / size) : Vec3{};
+}
+
+// The head's heading, proof against its pitch: square to its right axis.
+inline Vec3 head_forward(const Pose& head) {
+    const Vec3 right = rotate(head.orientation, {1, 0, 0});
+    Vec3 h{right.z, 0, -right.x};
+    if (h.x * h.x + h.z * h.z < 0.04f) {
+        h = rotate(head.orientation, {0, 0, -1});
+        h.y = 0;
+    }
+    const Vec3 unit = flat_unit(h);
+    return length(unit) > 0.0f ? unit : Vec3{0, 0, -1};
+}
+
+// The body's heading this instant; `left` and `right` null when a controller is lost: then the head's.
+inline float body_target(const Pose& head, const Pose* left, const Pose* right) {
+    const Vec3 h = head_forward(head);
+    if (left == nullptr || right == nullptr) {
+        return heading_of(h);
+    }
+    Vec3 sum = h * kBodyHeadWeight;
+    // The shoulder line: forward is square to left to right (not when the hands cross).
+    Vec3 across = right->position - left->position;
+    across.y = 0;
+    const Vec3 shoulder = flat_unit({-across.z, 0, across.x}) * 1.0f;
+    if (shoulder.x * h.x + shoulder.z * h.z > -0.3f) {
+        sum = sum + shoulder * (kBodyShoulderWeight * smooth_step(0.2f, 0.4f, length(across)));
+    }
+    // The hands' midpoint ahead of the neck (a head turning in place swings the headset about it).
+    const Vec3 neck = head.position - h * kBodyNeckBack;
+    Vec3 reach = (left->position + right->position) * 0.5f - neck;
+    reach.y = 0;
+    const Vec3 ahead = flat_unit(reach);
+    if (ahead.x * h.x + ahead.z * h.z > 0.0f) {
+        sum = sum + ahead * (kBodyReachWeight * smooth_step(0.08f, 0.25f, length(reach)));
+    }
+    for (const Pose* hand : {left, right}) {
+        Vec3 pointing = rotate(hand->orientation, {0, 0, -1});
+        pointing.y = 0;
+        sum = sum + pointing * kBodyPointWeight;
+    }
+    return sum.x * sum.x + sum.z * sum.z > 1e-6f ? heading_of(sum) : heading_of(h);
+}
+
+class BodyHeading {
+public:
+    float update(const Pose& head, const Pose* left, const Pose* right, float seconds) {
+        const float target = body_target(head, left, right);
+        const float head_yaw = heading_of(head_forward(head));
+        if (!m_known) {
+            m_yaw = target;
+            m_known = true;
+        }
+        const float gap = wrap_angle(target - m_yaw);
+        if (std::abs(gap) > kBodyStart) {
+            m_turning = true;
+        } else if (std::abs(gap) < kBodySettle) {
+            m_turning = false;
+        }
+        if (m_turning) {
+            m_yaw = wrap_angle(m_yaw + gap * (1.0f - std::exp(-seconds / kBodyFollowSeconds)));
+        }
+        const float neck = wrap_angle(head_yaw - m_yaw);
+        if (std::abs(neck) > kPi * 0.5f) {
+            m_yaw = wrap_angle(head_yaw - std::copysign(kPi * 0.5f, neck));
+        }
+        return m_yaw;
+    }
+
+    void reset() {
+        m_known = false;
+        m_turning = false;
+    }
+
+private:
+    bool m_known = false;
+    bool m_turning = false;
+    float m_yaw = 0;
+};
+
+}  // namespace quest
diff --git a/game/vr/jak_vr.cpp b/game/vr/jak_vr.cpp
new file mode 100644
index 000000000..92dee140d
