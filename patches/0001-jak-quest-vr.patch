 namespace decompiler {
+
+// Jak and Daxter Quest VR: every word of every object file the decompiler loads is one of these (Jak 3: 590 MB of game
+// data, 147 million words), and it was 16 bytes with a string of its own on the heap for each symbol word, so linking
+// took the Quest's installer from 0.8 to 3.5 GB and Android closed it (0.1.0, titan's Jak 3 log). Now 8 bytes: the data
+// and one more word holding the kind and either the label id or the symbol name's place in one table of names that
+// every word shares. (AI-assisted)
+namespace linked_word_names {
+struct Table {
+  std::shared_mutex mutex;
+  std::deque<std::string> names;                     // never moved once added: the index's keys view them
+  std::unordered_map<std::string_view, u32> index;
+};
+
+inline Table& table() {
+  static Table t;
+  return t;
+}
+
+inline u32 intern(const std::string& name) {
+  auto& t = table();
+  {
+    std::shared_lock<std::shared_mutex> lock(t.mutex);
+    auto it = t.index.find(name);
+    if (it != t.index.end()) {
+      return it->second;
+    }
+  }
+  std::unique_lock<std::shared_mutex> lock(t.mutex);
+  auto it = t.index.find(name);
+  if (it != t.index.end()) {
+    return it->second;
+  }
+  const u32 id = (u32)t.names.size();
+  t.names.push_back(name);
+  t.index.emplace(std::string_view(t.names.back()), id);
+  return id;
+}
+
+inline std::string name(u32 id) {
+  auto& t = table();
+  std::shared_lock<std::shared_mutex> lock(t.mutex);
+  return t.names.at(id);
+}
