+  return bool_to_symbol(jakvr::menu::shown());
+}
+// (pc-vr-menu-box i out): box i into out (x y w h, the game's 2D screen); its kind (1 the menu, 2 the chosen
+// row), 0 past the last.
+u64 pc_vr_menu_box(u32 index, u32 out) {
+  int kind = 0;
+  float r[4];
+  if (!jakvr::menu::box(static_cast<int>(index), kind, r)) {
+    return 0;
+  }
+  auto* v = Ptr<float>(out).c();
+  for (int i = 0; i < 4; ++i) {
+    v[i] = r[i];
+  }
+  return static_cast<u64>(kind);
+}
+// (pc-vr-menu-text i str out): text i's words into str (in the game's font, at most 255 bytes) and its x y scale
+// width into out; back #x10000 + align * 256 + font-color, 0 past the last.
+u64 pc_vr_menu_text(u32 index, u32 str, u32 out) {
+  jakvr::menu::Text t;
+  if (!jakvr::menu::text(static_cast<int>(index), t)) {
+    return 0;
+  }
+  std::string words = t.words;
+  if (g_game_version == GameVersion::Jak1) {
+    words = str_util::to_upper(words);  // the Jak 1 font has only capitals
+  }
+  std::string encoded = get_font_bank_from_game_version(g_game_version)->convert_utf8_to_game(words);
+  if (encoded.size() > 255) {
+    encoded.resize(255);
+  }
+  std::strcpy(Ptr<String>(str).c()->data(), encoded.c_str());
+  auto* v = Ptr<float>(out).c();
+  v[0] = t.x;
+  v[1] = t.y;
+  v[2] = t.scale;
+  v[3] = t.width;
+  return 0x10000u + static_cast<u64>(t.align) * 256u + static_cast<u64>(t.color);
+}
+// (pc-vr-test-flags): PC test aids for the simulated headset's runs, from the environment; 0 on the Quest and in play.
+// Bit 1 (JAKVR_TEST_GUN=1): Jak II and 3 give Jak the gun at the start, for the gun tests (tests/jak2_gun.sim).
+// Bit 2 (JAKVR_STATE_TRACE=1): each game's pc-vr.gc logs Jak's state as it changes ("[vr] state ...").
+// Bit 4 (JAKVR_TEST_BOARD=1): Jak II and 3 give Jak the JET-Board, for the board and vehicle tests.
+// Bit 8 (JAKVR_BODY_TRACE): Jak 3's cloth.gc logs Jak's cloth and whether the eyes leave it out.
+// Bit 16 (JAKVR_CLOCK_TRACE=1): Jak II and 3's vr-graphics! logs the game's clocks every 60 game frames.
+// Bit 32 (JAKVR_TEST_HUD=1): each game's pc-vr.gc keeps the HUD on screen in play (show-hud), for the HUD tests.
+// Bit 64 (JAKVR_TEST_PILLS=1): Jak 3 makes dark eco pills near Jak that fade (gun-util.gc), for the arena's crash.
+// Bit 128 (JAKVR_POINTER_TRACE=1): Jak II and 3's vr-ptr-yes-no! log the dot against each two-way line as it moves.
+// Bit 256 (JAKVR_TEST_TURRETS=1): Jak II destroys the sewer's first gun turret once it is made (pc-vr.gc
+// vr-test-turret!), for the turret's crash (LIST-0.1.1 item 22).
+// Bit 512 (JAKVR_TEST_WARP_APPROACH=1): Jak 1's JAKVR_TEST_WARP goes to its offset first, then onto the actor once the
+// levels there have loaded (as a player walks up to it: the elevator down to the underwater city, LIST-0.1.1 item 43).
+// Bit 1024 (JAKVR_TEST_KILL_SCENE=1): Jak 1 kills a scene's camera (pov-camera) a second into its scene, as Vixel's
+// pipe game scene died (LIST-0.1.1 item 44), to see the scene camera's net let Jak go.
+u64 pc_vr_test_flags() {
+#if defined(__ANDROID__)
+  return 0;
+#else
+  static const u64 flags = (std::getenv("JAKVR_TEST_GUN") != nullptr ? 1 : 0) |
+                           (std::getenv("JAKVR_STATE_TRACE") != nullptr ? 2 : 0) |
+                           (std::getenv("JAKVR_TEST_BOARD") != nullptr ? 4 : 0) |
+                           (std::getenv("JAKVR_BODY_TRACE") != nullptr ? 8 : 0) |
+                           (std::getenv("JAKVR_CLOCK_TRACE") != nullptr ? 16 : 0) |
+                           (std::getenv("JAKVR_TEST_HUD") != nullptr ? 32 : 0) |
+                           (std::getenv("JAKVR_TEST_PILLS") != nullptr ? 64 : 0) |
+                           (std::getenv("JAKVR_POINTER_TRACE") != nullptr ? 128 : 0) |
+                           (std::getenv("JAKVR_TEST_TURRETS") != nullptr ? 256 : 0) |
+                           (std::getenv("JAKVR_TEST_WARP_APPROACH") != nullptr ? 512 : 0) |
+                           (std::getenv("JAKVR_TEST_KILL_SCENE") != nullptr ? 1024 : 0);
+  return flags;
+#endif
+}
+// (pc-vr-body-cut): what the VR menu's Body shown leaves out of the eyes in first person (vr_options.h BodyShown), as
+// bits: 1 his body, 2 his arms, 4 his legs. His merc model is cut in the renderer (jak_vr.cpp body()); Jak 3's cloth
+// cape and scarf, drawn apart from it, go with his body (cloth.gc).
+u64 pc_vr_body_cut() {
+  switch (jakvr::options().body_shown) {
+    case jakvr::BodyShown::kBodyArms:
+      return 4;
+    case jakvr::BodyShown::kBodyLegs:
+      return 2;
+    case jakvr::BodyShown::kArmsLegs:
+      return 1;
+    case jakvr::BodyShown::kArms:
+      return 1 | 4;
+    case jakvr::BodyShown::kLegs:
+      return 1 | 2;
+    case jakvr::BodyShown::kHands:
+      return 1 | 2 | 4;
+    default:
+      return 0;
+  }
+}
+// (pc-vr-test-continue! str): PC test aid, JAKVR_TEST_CONTINUE=<continue point> (each game's level-info continues, e.g.
+// Jak 1's "firecanyon-start"): its name into the GOAL string str and 1, so the game starts again there once Jak is in
+// play (each game's pc-vr.gc vr-test-continue!); 0 without it, and always on the Quest.
+u64 pc_vr_test_continue(u32 str_ptr) {
+#if !defined(__ANDROID__)
+  const char* name = std::getenv("JAKVR_TEST_CONTINUE");
+  if (name && *name && str_ptr) {
+    String* s = Ptr<String>(str_ptr).c();
+    const int room = static_cast<int>(s->len) - 1;
+    if (room > 0) {
+      std::strncpy(s->data(), name, static_cast<std::size_t>(room));
+      s->data()[room] = 0;
+      return 1;
+    }
+  }
+#endif
+  return 0;
+}
+// (pc-vr-test-warp! str): PC test aid, JAKVR_TEST_WARP=<actor> (an actor's entity name, or its type's name for the first
+// of that type; "list" logs them): into the GOAL string str and 1, so Jak 1's pc-vr.gc vr-test-warp! puts Jak a metre
+// over that actor once he is in play (after any test continue); 0 without it, and always on the Quest.
+u64 pc_vr_test_warp(u32 str_ptr) {
+#if !defined(__ANDROID__)
+  const char* name = std::getenv("JAKVR_TEST_WARP");
+  if (name && *name && str_ptr) {
+    String* s = Ptr<String>(str_ptr).c();
+    const int room = static_cast<int>(s->len) - 1;
+    if (room > 0) {
+      std::strncpy(s->data(), name, static_cast<std::size_t>(room));
+      s->data()[room] = 0;
+      return 1;
+    }
+  }
+#endif
+  return 0;
+}
+// (pc-vr-test-warp-offset! vec): PC test aid, JAKVR_TEST_WARP_OFFSET="dx,dy,dz" (metres) into vec in game units and 1,
+// so the warp puts Jak there from the actor instead of a metre over it (a thing an actor spawns itself, as the pipe
+// game's buttons); 0 without it, and always on the Quest.
+u64 pc_vr_test_warp_offset(u32 vec_ptr) {
+#if !defined(__ANDROID__)
+  const char* s = std::getenv("JAKVR_TEST_WARP_OFFSET");
+  float d[3] = {0.0f, 0.0f, 0.0f};
+  if (s && *s && vec_ptr && std::sscanf(s, "%f,%f,%f", &d[0], &d[1], &d[2]) == 3) {
+    float* v = Ptr<float>(vec_ptr).c();
+    for (int i = 0; i < 3; i++) {
+      v[i] = d[i] * 4096.0f;
+    }
+    return 1;
+  }
+#endif
+  return 0;
+}
