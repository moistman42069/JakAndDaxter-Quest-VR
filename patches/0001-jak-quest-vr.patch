+// Turns joint `n` (and all under it) to sit on its parent as it was made: the game's animation of it undone.
+void straighten(Mat* w, int n) {
+  const auto& s = s_shape;
+  const int p = n >= 0 ? s.parent[n] : -1;
+  if (p < 0 || !s.has_made[n] || !s.has_made[p]) {
+    return;
+  }
+  const Mat want = mat_mul(mat_mul(s.made[n], mat_inverse(s.made[p])), w[p]);
+  turn_under(w, n, mat_mul(mat_transpose3(mat_turn_of(w[n])), mat_turn_of(want)), mat_place(w[n]));
+}
