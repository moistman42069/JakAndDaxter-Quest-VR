+// The game's own stretch of a limb undone (0.1.1's refinement pass). Jak's attacks blow his limbs up, a cartoon's
+// smear, by scaling their joints: Jak 1's punch has both arms 1.9 times their size for 20 frames (sim b28 act1: the
+// wrist straps' tips 0.56 m from the wrist against 0.30, the wrist 16 cm further behind the palm). From outside it
+// reads as speed; from his own eyes it is an arm twice the size across the view. Every joint under `top` is given the
+// body's own scale `ref` (his hips'), and set on its parent as far out as it sat before the stretch. `was`: room for
+// the joints as they came (BodyWork: not the stack). True if anything was stretched.
+bool unstretch(Mat* w, Mat* was, const VrBodyInfo& info, int top, float ref) {
+  const auto& s = s_shape;
+  if (top < 0 || top >= s.count || !(ref > 1e-3f)) {
+    return false;
+  }
+  const auto& list = under(top);
+  const auto row_length = [&](int i, int r) { return quest::length(Vec3{w[i].m[r][0], w[i].m[r][1], w[i].m[r][2]}); };
+  bool any = false;
+  for (int i : list) {
+    for (int r = 0; r < 3 && !any && info.bone[i] != 0; ++r) {
+      any = std::fabs(row_length(i, r) - ref) > 0.03f * ref;
+    }
+  }
+  if (!any) {
+    return false;
+  }
+  for (int i : list) {
+    was[i] = w[i];
+  }
+  for (int i : list) {  // parents first
+    if (info.bone[i] == 0) {
+      continue;
+    }
+    for (int r = 0; r < 3; ++r) {
+      const float l = row_length(i, r);
+      if (l > 1e-6f) {
+        for (int c = 0; c < 3; ++c) {
+          w[i].m[r][c] *= ref / l;
+        }
+      }
+    }
+    const int p = s.parent[i];
+    if (i != top && p >= 0 && info.bone[p] != 0 && hangs_under(p, top)) {
+      const Vec3 at = mat_point(mat_point(mat_place(was[i]), mat_inverse(was[p])), w[p]);
+      if (std::isfinite(at.x) && std::isfinite(at.y) && std::isfinite(at.z)) {
+        w[i].m[3][0] = at.x;
+        w[i].m[3][1] = at.y;
+        w[i].m[3][2] = at.z;
+      }
+    }
+  }
+  return true;
+}
