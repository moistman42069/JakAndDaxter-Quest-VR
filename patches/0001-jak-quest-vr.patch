+// ---- Small math ----
+
+Vec3 rot(Quat q, Vec3 v) {
+  return quest::rotate(q, v);
+}
+
+float wrap(float a) {
+  return quest::wrap_angle(a);
+}
+
+Vec3 add(Vec3 a, Vec3 b) {
+  return {a.x + b.x, a.y + b.y, a.z + b.z};
+}
+
+Vec3 scaled(Vec3 a, float s) {
+  return {a.x * s, a.y * s, a.z * s};
+}
+
+// A tracking direction (Y up, -Z ahead, +X right) as the game's, turned by `yaw` about the world's Y (0: +Z ahead,
+// pi/2: +X). The game's world is right-handed as tracking is (Y up and +Z ahead puts +X on the LEFT: its camera's
+// first row is forward x down, the left), so the two differ by a half turn about Y, not a mirror. Mirrored (as this
+// was until 2026-11-12) the right controller showed on the left, turning the head left turned the view right (sim
+// j1_turn1), the eyes were swapped and his arms crossed in front of him.
+Vec3 to_world_dir(Vec3 t, float yaw) {
+  const Vec3 m{-t.x, t.y, -t.z};
+  const float c = std::cos(yaw), s = std::sin(yaw);
+  return {m.x * c + m.z * s, m.y, -m.x * s + m.z * c};
+}
+
+// The yaw of a tracking orientation's look in the game's frame with no turn (as to_world_dir measures it).
+float tracking_yaw_game(Quat q) {
+  const Vec3 ahead = rot(q, {0, 0, -1});
+  return std::atan2(-ahead.x, -ahead.z);
+}
