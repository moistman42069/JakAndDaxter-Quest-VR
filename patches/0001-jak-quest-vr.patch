+
+  template <typename Arg>
+  void operator()(Arg&& arg)
+  {
+    this->frame()->attach_thread(this);
+    this->frame()->return_value(std::forward<Arg>(arg));
+    this->frame()->clear_cancellation_slot();
+    this->frame()->pop_frame();
+    this->pump();
+  }
+};
