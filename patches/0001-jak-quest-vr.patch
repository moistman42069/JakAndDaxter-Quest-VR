 (defmethod stack-size-set! ((this thread) (size-bytes int))
   "Adjust the size of the stack that can be stored during a suspend. Must be called before any process allocations."
+  ;; Jak and Daxter Quest VR: never below 512 bytes, as Precursor does in Jak 1's kernel. This compiler's frames are
+  ;; bigger than the ones the game's 16 to 128 byte backup stacks were picked for (on x86 too: the eco-pill suspended
+  ;; with 144 of its 128 on a PC and the game went down, 2026-11-14), and a suspend past the backup stack overwrites the
+  ;; process.
+  (set! size-bytes (max size-bytes 512))
   (let ((a2-0 (-> this process)))
     (cond
       ((!= this (-> a2-0 main-thread))
@@ -2093,7 +2098,11 @@
     )
