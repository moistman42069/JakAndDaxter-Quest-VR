+;; Jak Quest VR: the menu pointer (pc/pc-vr.gc *vr-ptr*) on a row of the menu: moving onto a row chooses it, and a
+;; click on the chosen row is Cross on it.
+(defun vr-ptr-progress-row ((obj progress) (index int) (y0 float) (y1 float))
+  (when (and (= (-> obj menu-transition) 0.0)
+             (zero? (-> obj want-option-index))
+             (vr-ptr-over? 40.0 472.0 y0 y1))
+    (cond
+      ((-> obj selected-option)
+       (if (and (logtest? *vr-ptr-flags* 4) (= index (-> obj option-index)))
+           (pc-vr-pointer-hit!)))
+      (else
+        (when (and (logtest? *vr-ptr-flags* 6) (!= index (-> obj option-index)))
+          (set! (-> obj option-index) index)
+          (sound-play "roll-over"))
+        (if (logtest? *vr-ptr-flags* 4)
+            (pc-vr-pointer-hit!)))))
+  0)
+
+;; Jak Quest VR: the menu pointer on the main menu's ring: a click on the name in its middle is Cross on it; above or
+;; below the name turns the ring a step that way.
+(defun vr-ptr-progress-ring ((obj progress))
+  (when (and (= (-> obj menu-transition) 0.0)
+             (= (-> obj ring-angle) (-> obj ring-want-angle))
+             (zero? (-> obj want-option-index))
+             (not (-> obj selected-option))
+             (logtest? *vr-ptr-flags* 1))
+    (let* ((top (if (= (get-aspect-ratio) 'aspect4x3) 180.0 175.0))
+           (bottom (+ top 80.0)))
+      (cond
+        ((< (-> *vr-ptr* y) top)
+         (when *vr-ptr-click*
+           (set! (-> obj want-option-index) -1)
+           (sound-play "ring-select")))
+        ((>= (-> *vr-ptr* y) bottom)
+         (when *vr-ptr-click*
+           (set! (-> obj want-option-index) 1)
+           (sound-play "ring-select")))
+        (else
+          (if (logtest? *vr-ptr-flags* 4)
+              (pc-vr-pointer-hit!))))))
+  0)
