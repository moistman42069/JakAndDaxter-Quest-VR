+/// Awaitable object that returns the cancellation state of the current
+/// coroutine.
+/**
+ * @par Example
+ * @code asio::awaitable<void> my_coroutine()
+ * {
+ *   asio::cancellation_state cs
+ *     = co_await asio::this_coro::cancellation_state;
+ *
+ *   // ...
