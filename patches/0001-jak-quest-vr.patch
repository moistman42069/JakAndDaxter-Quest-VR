+  ;; PC test aid (JAKVR_TEST_BOARD=1): the JET-Board given, the same way, for the board tests (tests/jak2_board.sim)
+  (when (and *target* (not (logtest? (-> *game-info* features) (game-feature board))) (logtest? (pc-vr-test-flags) 4))
+    (logior! (-> *game-info* features) (game-feature board)))
