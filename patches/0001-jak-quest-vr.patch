+(defun target-in-level-sphere? ((level-name symbol))
+  (if (and (-> *level* level0) (= (-> *level* level0 name) level-name) (-> *level* level0 inside-sphere?))
+    (return #t)
+    )
+  (if (and (-> *level* level1) (= (-> *level* level1 name) level-name) (-> *level* level1 inside-sphere?))
+    (return #t)
+    )
