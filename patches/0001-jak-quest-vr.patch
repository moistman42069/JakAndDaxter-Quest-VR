+void pose_publish(const void* info_ptr, const float* trans, const float* quat, int posed, std::uint8_t* memory) {
+  std::string word;
+  if (posed && info_ptr && trans && quat && memory) {
+    VrBodyInfo& info = s_pose_info;
+    std::memcpy(&info, info_ptr, sizeof info);
+    info.count = std::clamp(info.count, 0, kBodyNodesMost);
+    const Mat inv_root = mat_inverse(pose_root(trans, quat));
+    std::vector<std::uint8_t> out = {'J', 'V', kPoseVersion, 0};
+    int n = 0;
+    for (int k = 0; k < kJointHideFirst; ++k) {
+      const int node = info.named[k];
+      if (k == kJointGun || node < 0 || node >= info.count || !bone_ok(info.bone[node])) {
+        continue;
+      }
+      Mat w;
+      std::memcpy(&w, memory + info.bone[node], sizeof w);
+      const Mat rel = mat_mul(w, inv_root);
+      float q[4];
+      pose_quat(mat_turn_of(rel), q);
+      out.push_back(static_cast<std::uint8_t>(k));
+      for (float c : q) {
+        put_i16(out, c * 32767.0f);
+      }
+      const Vec3 at = mat_place(rel);
+      put_i16(out, at.x * 0.5f);
+      put_i16(out, at.y * 0.5f);
+      put_i16(out, at.z * 0.5f);
+      ++n;
+    }
+    out[3] = static_cast<std::uint8_t>(n);
+    if (n > 0) {
+      word = base64_encode(out);
+    }
+  }
+  std::lock_guard<std::mutex> lock(s_pose_mutex);
+  s_pose_word = std::move(word);
+}
+
+std::string pose_word() {
+  std::lock_guard<std::mutex> lock(s_pose_mutex);
+  return s_pose_word;
+}
