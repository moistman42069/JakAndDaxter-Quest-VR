+  }
+  std::lock_guard<std::mutex> inner(g_session->mu);
+  if (!partying(g_session->mode)) {
+    return out;
+  }
+  out.push_back({g_session->my_index, g_session->config().name, true});
+  for (const auto& [index, name] : g_session->names) {
