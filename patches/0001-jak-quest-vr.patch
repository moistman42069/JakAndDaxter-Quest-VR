+void async_read_handler(const asio::error_code& e,
+    size_t bytes_transferred, size_t expected_bytes_transferred, bool* called)
+{
+  *called = true;
+  ASIO_CHECK(!e);
+  ASIO_CHECK(bytes_transferred == expected_bytes_transferred);
+}
