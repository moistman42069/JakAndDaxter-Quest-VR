+bool merc_near_fade(const char* name, float& gone, float& full) {
+  gone = 0.0f;
+  full = 0.0f;
+  const auto& d = s_display;
+  if (d.pass.kind != PassKind::kEye || !d.drawing || !d.drawing->first_person || !name) {
+    return false;
+  }
+  bool his = std::strncmp(name, "gun-", 4) == 0;
+  const char* own = d.drawing->hidden[0].name;
+  if (!his && own[0] != 0) {
+    const std::size_t n = std::strlen(own);
+    his = std::strncmp(name, own, n) == 0 && (name[n] == 0 || name[n] == '-');
+  }
+  if (!his) {
+    return false;
+  }
+  // From kNearFadeGone (just past the near plane, so no cut edge is ever seen) to all of it at kNearFadeFull, the
+  // player's metres.
+  gone = kNearFadeGone * d.drawing->units;
+  full = kNearFadeFull * d.drawing->units;
+  static std::vector<std::string> told;
+  if (told.size() < 16 && std::find(told.begin(), told.end(), name) == told.end()) {
+    told.emplace_back(name);
+    log_line(0, fmt::format("[vr-body] the eyes fade merc model {} nearer than {:.0f} cm (gone by {:.0f} cm)", name,
+                            kNearFadeFull * 100.0f, kNearFadeGone * 100.0f)
+                    .c_str());
+  }
+  return true;
+}
+
+// ==== Game thread: the pad ====
+
+namespace {
+
+// A stick as Jak's two bytes: 128 the middle, the game's dead zone 48 either side, full at 110 (analog-input's).
+// The stick is scaled as a whole, along the way it is pushed: the games take its direction from the two bytes as they
+// are (pad.gc: stick0-dir is atan of leftx - 128 over 127 - lefty), so 0.1.0's dead zone added to each axis by itself
+// made a thumb three degrees off straight read as twenty-five (x 0.05, y 1 gave 52 and 110 off the middle). A player,
+// 0.1.0: "I allways look like I am walking diagonal when I press forward ... In all 3 games". Straight along an axis
+// nothing changes. A round stick's corners reach as far as a pad's gate does (kStickGate: each axis 0.8 of full at
+// 45 degrees, for what reads one axis at a time), and a stick resting a hair off its middle is the middle.
+constexpr float kStickRest = 0.08f, kStickGate = 1.25f;
+void jak_stick(float x, float y, std::uint8_t& byte_x, std::uint8_t& byte_y) {
+  const float length = std::sqrt(x * x + y * y);
+  if (length < kStickRest) {
+    byte_x = byte_y = 128;
+    return;
+  }
+  const float gate = std::min(length / std::max(std::fabs(x), std::fabs(y)), kStickGate);
+  const float k = (49.0f + std::min(length, 1.0f) * 61.0f) * gate / length;
+  const auto byte = [](float off) {
+    return static_cast<std::uint8_t>(std::clamp(std::round(128.0f + std::clamp(off, -110.0f, 110.0f)), 0.0f, 255.0f));
+  };
+  byte_x = byte(x * k);
+  byte_y = byte(y * k);
+}
+
+enum Bit : std::uint16_t {
+  kSelect = 1 << 0,
+  kL3 = 1 << 1,
+  kR3 = 1 << 2,
+  kStart = 1 << 3,
+  kUp = 1 << 4,
+  kRight = 1 << 5,
+  kDown = 1 << 6,
+  kLeft = 1 << 7,
+  kL2 = 1 << 8,
+  kR2 = 1 << 9,
+  kL1 = 1 << 10,
+  kR1 = 1 << 11,
+  kTriangle = 1 << 12,
+  kCircle = 1 << 13,
+  kCross = 1 << 14,
+  kSquare = 1 << 15,
+};
+
+// abutton (pressure) order: right, left, up, down, triangle, circle, cross, square, L1, R1, L2, R2.
+constexpr std::uint16_t kPressure[12] = {kRight, kLeft, kUp, kDown, kTriangle, kCircle,
+                                         kCross, kSquare, kL1, kR1, kL2, kR2};
+
+// A hand's position in the head's frame (x right, y up, -z ahead), metres.
+Vec3 in_head(const FrameInfo& f, int hand) {
+  return rot(quest::conjugate(f.head.orientation), f.hand_grip[hand].position - f.head.position);
+}
+
+// A hand at the hip (low at the side) or over the shoulder (up behind the head): the holsters. Holster size (VR menu,
+// 100% the places of 0.1.0) moves every edge out by 15 cm for each 100% more, in by as much for less: 130% to start.
+bool at_holster(const FrameInfo& f, int hand, int size_percent) {
+  if (!f.hand_valid[hand]) {
+    return false;
+  }
+  const float m = 0.15f * static_cast<float>(size_percent - 100) / 100.0f;
+  const Vec3 h = in_head(f, hand);
+  const float side = hand == quest::kRight ? h.x : -h.x;
+  const bool hip = h.y < -0.45f + m && side > 0.08f - m * 0.5f && h.z > -0.25f - m;
+  const bool shoulder = h.y > -0.25f - m && h.z > 0.02f - m * 0.5f && std::abs(h.x) < 0.35f + m;
+  return hip || shoulder;
+}
+
+// ---- The menu pointer ----
+// Ratchet's (pointer_hands and menu_pointer in its quest_vr.cpp; the owner, 2026-11-13: "a similar menu pointer that
+// works for both controllers, like our openrac work does"): in the games' menus (pause, title, options) and the VR
+// menu, one hand's beam onto the panel the 2D is on, the HUD following the head or the flat screen standing in the
+// room. With "Either hand" (the VR menu's Menu pointer hand, to start) the right points until the left's trigger is
+// pulled with its ray on the menu, then the left until the right's is; that pull takes the pointer and is no click
+// until let go. The pointing hand's trigger is the click, not the game's R1 or L1; a trigger held as play comes back
+// is no R1 or L1 until let go.
+
+struct PointerNow {
+  bool active = false;    // in a menu: the beam shown, the pointing hand's trigger its click
+  int hand = quest::kRight;
+  bool on_panel = false;  // its ray meets the panel
+  float u = 0, v = 0;     // there: 0..1 from the left and from the top
+  bool pressed = false;   // its trigger held (not a pull that took the pointer)
+  bool press = false;     // pulled this tick
+  quest::PointerLayers layers;
+};
+
+// The pointer on the games' screen for their menus (menu_pointer_at), and when a game's menu last chose the row under
+// it (menu_pointer_hit).
+struct PointerScreen {
+  bool valid = false;
+  float x = 0, y = 0;
+  float read_x = -1000, read_y = -1000;  // where the dot last counted as moved (menu_pointer_at)
+};
+PointerScreen s_pointer_screen;
+// The dot counts as moved (the menu chooses the row under it) only past this many of the screen's 512 units across from
+// where it last did: about 2.6 cm on the menu 1.6 m ahead, a turn of the hand near 1 degree. To 0.1.1 any 1.5 units
+// (a fifth of a degree) did, which a hand held still on a headset passes all the time, so a dot left resting on a row
+// kept choosing it back from the stick: a player on Jak 1's title moved down to Load Game with the stick and A started
+// a new game, the dot still on New Game (a player's report, 2026-11-16; the owner: "clicking something else by
+// accident"). Ratchet's pointer takes the cursor only as the dot reaches another row; this is the same for all three
+// games' menus without each game's rows.
+constexpr float kPointerMoveUnits = 8.0f;
+// A stick (or the d-pad) moving through a menu takes over from the dot: the place it counts moves from is where the dot
+// is then, so only a real move of the hand after that chooses by pointing again (menu_pointer, menu_pointer_at).
+std::atomic<bool> s_pointer_stick_took{false};
+bool s_pointer_stick_was = false;
+double s_pointer_hit_at = -1;
+// How many times the game's menu has read a waiting click (menu_pointer_at, the game's own thread). A click waits until
+// the menu has had it in two of its frames, not a fixed time: Jak 3's title menu ran at 7 or 8 frames a second on the
+// simulated headset (its kernel 125 to 140 ms a frame), so a click given up after 0.25 s was gone before the menu's
+// next frame looked, and a quick tap on its Quit row did nothing (sim b33 ptr3). kPointerClickLongest: given up then
+// whatever the game's pace (a menu that went away under it).
+std::atomic<int> s_pointer_click_reads{0};
+constexpr double kPointerClickLongest = 1.5;
+std::atomic<int> s_pointer_side{0};  // menu_pointer_side: -1 left, 1 right, for fill_pad to press once
+bool s_pointer_in_menu_was = false;
+
+PointerNow menu_pointer(const FrameInfo& f, const Controls& c, const Options& o, bool in_menu) {
+  auto& p = s_pad;
+  PointerNow out;
+  out.active = in_menu;
+  bool panel_hud = true;
+  Pose panel_pose;
+  bool hud_stays = false;
+  Pose hud_pose;
+  float triggers[2] = {c.left_trigger, c.right_trigger};
+  {
+    std::lock_guard<std::mutex> lock(s_shared.mutex);
+    panel_hud = s_shared.panel_hud;
+    panel_pose = s_shared.flat_pose;
+    hud_stays = s_shared.hud_stays;
+    hud_pose = s_shared.hud_pose;
+    for (int side = 0; side < 2; ++side) {  // a pull since the last read counts (Shared::trigger_most)
+      triggers[side] = std::max(triggers[side], s_shared.trigger_most[side]);
+      s_shared.trigger_most[side] = 0;
+    }
+  }
+  float panel_width = kFlatWidth;
+  if (panel_hud) {
+    // as end_frame places the HUD
+    const float distance = static_cast<float>(o.hud_distance) / 100.0f;
+    panel_width = distance * 1.05f * static_cast<float>(o.hud_size) / 100.0f;
+    panel_pose = hud_stays ? hud_pose
+                           : Pose{f.head.position +
+                                      rot(f.head.orientation, {0, static_cast<float>(o.hud_height) / 100.0f, -distance}),
+                                  f.head.orientation};
+  }
+  const float panel_height = panel_width * 0.75f;
+  bool on_panel[2] = {false, false};
+  float hu[2] = {0, 0}, hv[2] = {0, 0};
+  for (int side = 0; side < 2; ++side) {
+    on_panel[side] = in_menu && f.hand_valid[side] &&
+                     quest::panel_point(panel_pose, panel_width, panel_height, f.hand_aim[side], hu[side], hv[side]);
+  }
+  if (o.menu_hand == MenuHand::kRight) {
+    p.point_hand = quest::kRight;
+  } else if (o.menu_hand == MenuHand::kLeft) {
+    p.point_hand = quest::kLeft;
+  }
+  for (int side = 0; side < 2; ++side) {
+    const bool was = p.pull[side];
+    p.pull[side] = triggers[side] > (was ? 0.4f : 0.6f);
+    if (!p.pull[side]) {
+      p.pull_spent[side] = false;
+    } else if (!was && in_menu && o.menu_hand == MenuHand::kBoth && side != p.point_hand && on_panel[side]) {
+      p.point_hand = side;
+      p.pull_spent[side] = true;
+      lg::info("[vr-pointer] the {} hand's trigger on the menu: the {} hand points", side == quest::kLeft ? "left" : "right",
+               side == quest::kLeft ? "left" : "right");
+    }
+    if (!in_menu && s_pointer_in_menu_was && p.pull[side]) {
+      p.pull_spent[side] = true;  // held as play comes back: no R1 or L1 until let go
+    }
+  }
+  s_pointer_in_menu_was = in_menu;
+  const int hand = p.point_hand;
+  out.hand = hand;
+  out.on_panel = on_panel[hand];
+  out.u = hu[hand];
+  out.v = hv[hand];
+  out.pressed = in_menu && p.pull[hand] && !p.pull_spent[hand];
+  out.press = out.pressed && !p.pressed_was;
+  p.pressed_was = out.pressed;
+  if (in_menu && f.hand_valid[hand]) {
+    // Ratchet's beam: from 2.5 cm off the hand to where it meets the panel (the dot 1 cm off it), else 2 m out
+    const Pose& aim = f.hand_aim[hand];
+    const Vec3 from = aim.position + rot(aim.orientation, {0, 0, -0.025f});
+    Vec3 to = aim.position + rot(aim.orientation, {0, 0, -2.0f});
+    if (out.on_panel) {
+      to = panel_pose.position +
+           rot(panel_pose.orientation, {(out.u - 0.5f) * panel_width, (0.5f - out.v) * panel_height, 0.01f});
+      out.layers.dot = true;
+      out.layers.dot_pose = {to, panel_pose.orientation};
+    }
+    out.layers.beam = quest::beam_pose(from, to, f.head.position, out.layers.beam_pose, out.layers.beam_length);
+  }
+  s_pointer_screen.valid = out.on_panel && !menu::shown();
+  s_pointer_screen.x = out.u * menu::kScreenWidth;
+  s_pointer_screen.y = out.v * menu::game_screen_height();
+  {
+    // Either stick pushed past half way in a menu (the left stick moves through it; the right one is the d-pad with
+    // the thumb on its rest): the stick takes over from the dot, once as it goes in.
+    const bool stick = in_menu && std::max(std::max(std::fabs(c.left_x), std::fabs(c.left_y)),
+                                           std::max(std::fabs(c.right_x), std::fabs(c.right_y))) > 0.5f;
+    if (stick && !s_pointer_stick_was) {
+      s_pointer_stick_took.store(true);
+    }
+    s_pointer_stick_was = stick;
+  }
+  return out;
+}
+
+}  // namespace
+
+int menu_pointer_at(float& x, float& y) {
+  auto& s = s_pointer_screen;
+  if (!s.valid) {
+    s.read_x = s.read_y = -1000;
+    return 0;
+  }
+  x = s.x;
+  y = s.y;
+  int flags = 1;
+  if (s_pointer_stick_took.exchange(false)) {
+    s.read_x = s.x;  // the stick took over: the dot counts again only once it has really moved from here
+    s.read_y = s.y;
+  } else if (std::hypot(s.x - s.read_x, s.y - s.read_y) > kPointerMoveUnits) {
+    flags |= 2;  // moved since it last counted: the game's menu chooses the row under it
+    s.read_x = s.x;
+    s.read_y = s.y;
+  }
+  if (s_pad.click_pending) {
+    flags |= 4;  // a click waits for the row under it
+    s_pointer_click_reads.fetch_add(1);
+  }
+  return flags;
+}
+
+void menu_pointer_hit() {
+  s_pointer_hit_at = now_seconds();
+}
+
+void menu_pointer_side(int dir) {
+  s_pointer_side.store(dir < 0 ? -1 : 1);
+}
+
+void fill_pad(int port, std::uint8_t* report) {
+  if (port != 0 || !s_vr_on.load()) {
+    return;
+  }
+  bool have = false;
+  const FrameInfo f = latest_frame(have);
+  if (!have || !f.focused) {
+    return;
+  }
+  auto* cpad = reinterpret_cast<CPadInfo*>(report);
+  const Options& o = options();
+  const Controls& c = f.controls;
+  auto& p = s_pad;
+  const double now = now_seconds();
+  const double dt = p.last > 0 ? std::clamp(now - p.last, 0.0, 0.1) : 1.0 / 60.0;
+  p.last = now;
+  const int mode = s_rig.last_mode;
+  const bool play = mode == kModePlay;
+  const bool menu = mode == kModeMenu || mode == kModeTitle;
+  const bool first_person = play && s_rig.last_first_person;
+  // The VR menu's Cutscenes changed: it decides the scenes' view again (over the menu button's switch). So it does
+  // once the scene the switch was made in is over (play again, or the title).
+  const int scene_option = static_cast<int>(o.cutscene_view);
+  if (scene_option != p.scene_option_was) {
+    if (p.scene_option_was >= 0) {
+      p.scene_view = -1;
+    }
+    p.scene_option_was = scene_option;
+  }
+  if (p.scene_view >= 0 && (mode == kModePlay || mode == kModeTitle)) {
+    p.scene_view = -1;
+  }
+
+  // The buttons as held, for what the VR menu keeps from the game as it closes.
+  std::uint16_t raw = 0;
+  if (c.a) raw |= kCross;
+  if (c.b) raw |= kCircle;
+  if (c.x) raw |= kSquare;
+  if (c.y) raw |= kTriangle;
+  // (with no left menu button bound, as on SteamVR with Touch, the left stick's click is the menu button: below; the
+  // VR menu's "Stick click as menu button", on to start. The Quest's own runtime binds the menu button: never there.)
+  const bool click_is_menu = !c.menu_sensed && o.stick_click_menu;
+  const bool menu_held = c.menu || (click_is_menu && c.left_click);
+  if (menu_held) raw |= kStart;
+  if (c.right_trigger > 0.3f) raw |= kR1;
+  if (c.left_trigger > 0.3f) raw |= kL1;
+  if (c.right_grip > 0.3f) raw |= kR2;
+  if (c.left_grip > 0.3f) raw |= kL2;
+
+  // The VR menu's View row: a change there switches play's view now.
+  if (o.first_person != p.option_first_person) {
+    p.option_first_person = o.first_person;
+    p.view_first_person = o.first_person;
+  }
+
+  // The menu pointer (menu_pointer): in the games' menus and the VR menu, shown on the headset each frame.
+  const PointerNow pointer = menu_pointer(f, c, o, menu);
+  {
+    std::lock_guard<std::mutex> lock(s_shared.mutex);
+    s_shared.pointer = pointer.active ? pointer.layers : quest::PointerLayers{};
+  }
+
+  // The VR menu (vr_menu.h): while it is open the controllers are its alone, and the game gets a pad at rest. The left
+  // menu button closes it; play coming back (the game's menu gone) closes it too.
+  if (menu::shown() && !menu) {
+    menu::close();
+  }
+  if (menu::shown()) {
+    menu::Input in;
+    const float left_far = std::max(std::fabs(c.left_x), std::fabs(c.left_y));
+    const float right_far = std::max(std::fabs(c.right_x), std::fabs(c.right_y));
+    in.stick_x = left_far >= right_far ? c.left_x : c.right_x;
+    in.stick_y = left_far >= right_far ? c.left_y : c.right_y;
+    in.confirm = c.a;
+    in.back = c.b || c.y;
+    in.point_valid = pointer.on_panel;
+    in.point_u = pointer.u;
+    in.point_v = pointer.v;
+    in.point_press = pointer.pressed;
+    menu::update(in, now);
+    if (menu_held && !p.menu_was) {
+      menu::close();
+    }
+    p.menu_was = menu_held;
+    p.menu_hold_done = true;  // its release is no Start
+    p.click_pending = false;
+    p.cross_frames = 0;  // the click that opened it (VR Options) is spent: none of it is the game's as it closes
+    if (!menu::shown()) {
+      p.swallow = raw;  // what closed it (B, the menu button) is not the game's
+    }
+    cpad->button0 = 0;
+    cpad->leftx = cpad->lefty = cpad->rightx = cpad->righty = 128;
+    for (auto& pressure : cpad->abutton) {
+      pressure = 0;
+    }
+    return;
+  }
+
+  // A game menu's row under the dot: the game's menu code chose it (pc-vr.gc, menu_pointer_hit) after the click, and
+  // the click is Cross on it.
+#if !defined(__ANDROID__)
+  // PC test aid (JAKVR_POINTER_TRACE=1): each pull of the trigger on the menu, and a click that found no row
+  static const bool trace_pointer = std::getenv("JAKVR_POINTER_TRACE") != nullptr;
+  if (trace_pointer && pointer.active && pointer.press) {
+    lg::info("[vr-pointer] the trigger pulled, the dot {} ({:.3f} {:.3f}), the screen's dot {}",
+             pointer.on_panel ? "on the panel" : "off it", pointer.u, pointer.v,
+             s_pointer_screen.valid ? "shown to the game" : "not shown to the game");
+  }
+#endif
+  if (pointer.active && pointer.press && pointer.on_panel) {
+    p.click_pending = true;
+    p.click_at = now;
+    s_pointer_click_reads.store(0);
+  }
+  if (p.click_pending && s_pointer_hit_at >= p.click_at) {
+    p.click_pending = false;
+    p.cross_frames = 2;
+    lg::info("[vr-pointer] a click on the game's menu: Cross");
+  } else if (p.click_pending && ((now - p.click_at > 0.25 && s_pointer_click_reads.load() >= 2) ||
+                                 now - p.click_at > kPointerClickLongest)) {
+    p.click_pending = false;  // nothing of the game's menu under it (it looked twice), or no menu looked
+#if !defined(__ANDROID__)
+    if (trace_pointer) {
+      lg::info("[vr-pointer] the click found no row of the game's menu ({} of its looks, {:.2f} s)",
+               s_pointer_click_reads.load(), now - p.click_at);
+    }
+#endif
+  }
+
+  std::uint16_t held = 0;
+  if (p.cross_frames > 0) {
+    held |= kCross;
+    --p.cross_frames;
+  }
+  // A game menu's two-way choice (On / Off, Yes / No) with the dot on one side (pc-vr-pointer-side!, Jak 3's menus,
+  // 0.1.1): that side of the d-pad for two frames, which the menu takes as it takes the d-pad.
+  if (const int side = s_pointer_side.exchange(0); side != 0 && pointer.active && p.side_frames == 0) {
+    p.side_frames = 2;
+    p.side_dir = side;
+  }
+  if (p.side_frames > 0) {
+    held |= p.side_dir < 0 ? kLeft : kRight;
+    --p.side_frames;
+  }
+  float lx = c.left_x, ly = c.left_y, rx = c.right_x, ry = c.right_y;
+  quest::shape_stick(lx, ly);
+  quest::shape_stick(rx, ry);
+
+  // Face buttons: A Cross, B Circle, X Square, Y Triangle.
+  if (c.a) held |= kCross;
+  if (c.b) held |= kCircle;
+  if (c.x) held |= kSquare;
+  if (c.y) held |= kTriangle;
+
+  // Triggers R1 and L1; grips R2 and L2, but not a grip at a holster (Jak II and 3's guns: drawn there).
+  // (in a menu, the pointing hand's trigger is the pointer's click, not the game's; a pull spent on the pointer, or
+  // held as play came back, is nothing until let go)
+  const bool trig_r = p.trigger[1].update(c.right_trigger) && !(pointer.active && pointer.hand == quest::kRight) &&
+                      !p.pull_spent[quest::kRight];
+  const bool trig_l = p.trigger[0].update(c.left_trigger) && !(pointer.active && pointer.hand == quest::kLeft) &&
+                      !p.pull_spent[quest::kLeft];
+  const bool grip_r = p.grip[1].update(c.right_grip);
+  const bool grip_l = p.grip[0].update(c.left_grip);
+  if (trig_r) held |= kR1;
+  if (trig_l) held |= kL1;
+  const bool guns = s_game != (int)GameVersion::Jak1;
+  // Jak on foot (the games' first person is allowed): not in a vehicle, on the board, a turret or a ride.
+  const bool on_foot = play && (s_rig.last_flags & kFlagFirstPersonOk) != 0;
+  // The holsters only on foot, where the gun can come out (Vixel, 0.1.1: Jak II's car "button that makes cars go up and
+  // down randomly doesn't work then randomly starts working again": sitting, his right hand rested at the hip, and its
+  // grip went to the holster, 53 times "did not draw the gun (state target-pilot-stance)", instead of the car's R2).
+  // "Holsters only on foot" off: in play anywhere, as 0.1.0.
+  const bool holster_here = o.holster_on_foot ? on_foot : play;
+  // ... and only while he has a gun he may draw (kFlagGun): before the first gun, and where the game allows none, a grip
+  // low at the side is a fist as anywhere (Vixel, 0.1.0, before his first gun: "physical punch in 2 and 3 is less
+  // responsive than in 1": his fists made at the hip went to holsters that had nothing in them).
+  const bool gun_here = guns && (s_rig.last_flags & kFlagGun) != 0;
+  const bool at_holster_r = holster_here && gun_here && o.holster_draw && at_holster(f, quest::kRight, o.holster_size);
+  const bool at_holster_l = holster_here && gun_here && o.holster_draw && at_holster(f, quest::kLeft, o.holster_size);
+  if (!holster_here) {
+    p.holster_grip_began_there[quest::kLeft] = p.holster_grip_began_there[quest::kRight] = false;
+  }
+  // The holsters (item 28, as Ratchet's): what each grip did there, for the game (holster(), gun-util.gc vr-holster!).
+  // A grip squeezed there draws the gun; one let go there puts it away (not the squeeze that just drew it).
+  {
+    const bool grips[2] = {grip_l, grip_r};
+    const bool there[2] = {at_holster_l, at_holster_r};
+    for (int side = 0; side < 2; ++side) {
+      if (grips[side] && !p.holster_grip_was[side]) {
+        p.holster_grip_began_there[side] = there[side];
+        if (there[side]) {
+          p.holster_news |= kHolsterGripped;
+          buzz(side, 0.35f, 0.04f);
+          lg::info("[vr-pad] holster: the {} grip squeezed at a holster", side == quest::kLeft ? "left" : "right");
+        }
+      } else if (!grips[side] && p.holster_grip_was[side] && there[side]) {
+        p.holster_news |= p.holster_grip_began_there[side] ? kHolsterLetGoThere : kHolsterBroughtBack;
+        lg::info("[vr-pad] holster: the {} grip let go at a holster", side == quest::kLeft ? "left" : "right");
+      }
+      p.holster_grip_was[side] = grips[side];
+    }
+  }
+  // A grip at a holster, or one squeezed there and still held (the hand bringing the gun out), is the gun's: never
+  // fists, R2 or L2. Fists there made the hand coming up from the hip a punch, which stopped the draw (sim j2_holster1).
+  const bool holster_r = grip_r && (at_holster_r || p.holster_grip_began_there[quest::kRight]);
+  const bool holster_l = grip_l && (at_holster_l || p.holster_grip_began_there[quest::kLeft]);
+  // The left grip on the drawn gun's front holds it (Two-hand grip), not L2; a squeeze begun elsewhere stays L2's.
+  const bool left_on_gun =
+      guns && (s_support.held ||
+               (s_gun_in_hand && o.two_hand_grip && o.hand_aim && !s_support.free && f.hand_valid[quest::kLeft] &&
+                f.hand_valid[quest::kRight] &&
+                support_reach(f.hand_grip[quest::kRight], f.hand_grip[quest::kLeft], one_hand_aim(f.hand_aim[quest::kRight])) >= 0.0f));
+  // Fists on the right grip (owner, 2026-11-13, as Ratchet's wrench on its right grip): with Physical melee and this
+  // on, on foot, the right grip held makes Jak's fists, and only fists punch and swing (a hand moved to aim, point or
+  // reach never throws a punch). Jak 1's left grip, which the game leaves unused, makes them too. Not while the gun is
+  // in the right hand (the grip holds it). The game's R2 that the right grip gave on foot (Jak II and 3: the JET-Board,
+  // and Light Jak's end in Jak 3) moves to the right stick's click; on the board, in a vehicle, in the Titan suit and
+  // the like the grip is R2 as before (the car's height in Jak II, the board's end). (on_foot: above, the holsters)
+  const bool melee_grip = o.hand_melee && o.melee_grip && on_foot;
+  const bool fist_r = melee_grip && grip_r && !holster_r && !s_gun_in_hand;
+  // 0.1.1 (Vixel: "physical punch in 2 and 3 is less responsive than in 1"): in Jak II and 3 the left grip makes the
+  // left fist as well, so that hand punches by its own grip as in Jak 1; it stays the game's L2 (Dark and Light Jak)
+  // as it was. Not at a holster or on the drawn gun's front, where the grip is the gun's.
+  const bool fist_l = melee_grip && grip_l && (!guns || (!holster_l && !left_on_gun));
+  if ((fist_r && !s_rig.fist[quest::kRight]) || (fist_l && !s_rig.fist[quest::kLeft])) {
+    const int side = fist_r && !s_rig.fist[quest::kRight] ? quest::kRight : quest::kLeft;
+    buzz(side, 0.25f, 0.03f);
+    lg::info("[vr-pad] fists up: the {} grip", side == quest::kLeft ? "left" : "right");
+  }
+  s_rig.fist[quest::kRight] = fist_r;
+  s_rig.fist[quest::kLeft] = fist_l;
+  if (grip_r && !holster_r && !melee_grip) held |= kR2;
+  if (grip_l && !holster_l && !left_on_gun && !(fist_l && !guns)) held |= kL2;
+  // (a grip at a holster is neither R2 nor L2: the game hears it through holster(), not as R1, which would fire)
+
+  // Both sticks clicked together: a recentre, neither click reaching the game. A lone click is held a few frames.
+  const bool clicks[2] = {c.left_click, c.right_click};
+  if (clicks[0] && clicks[1]) {
+    if (!p.click_pair) {
+      p.click_pair = true;
+      s_rig.recentre_wanted = true;
+      buzz(quest::kLeft, 0.4f, 0.05f);
+      buzz(quest::kRight, 0.4f, 0.05f);
+    }
+  } else if (!clicks[0] && !clicks[1]) {
+    p.click_pair = false;
+  }
+  for (int i = 0; i < 2; ++i) {
+    if (clicks[i] && !p.click_pair) {
+      ++p.click_wait[i];
+    } else if (!clicks[i]) {
+      p.click_wait[i] = 0;
+    }
+  }
+
+  // The left menu button: a press is Start; held a second switches first and third person in play.
+  // SteamVR keeps the left Touch controller's menu button for its dashboard (Vixel, 0.1.0: "vr itself cant start
+  // button"): when the runtime binds no left menu button, the left stick's lone click is the menu button, and no L3.
+  // Not with the left hand at the head, where that click is the d-pad's Select, and not once the right stick's click
+  // joins it for a recentre (then no Start either). (click_is_menu: above, with menu_held.)
+  if (click_is_menu && p.click_pair && p.menu_was) {
+    p.menu_hold_done = true;
+  }
+  const bool menu_button =
+      c.menu || (click_is_menu && clicks[0] && !p.click_pair && !(p.dpad_by_head && !menu && !p.menu_was));
+  if (menu_button && !p.menu_was) {
+    p.menu_down_at = now;
+    p.menu_hold_done = false;
+  }
+  if (menu_button && !p.menu_hold_done && now - p.menu_down_at >= 1.0) {
+    p.menu_hold_done = true;
+    if (play) {
+      p.view_first_person = !p.view_first_person;
+      buzz(quest::kLeft, 0.6f, 0.08f);
+      lg::info("[vr-pad] the view is {} now: the left menu button held", p.view_first_person ? "first person" : "third person");
+    } else if (mode == kModeMovie) {
+      // in a scene: through his eyes, or around you, from what is seen now (Adaptive cutscenes may have put the scene
+      // around you by itself); the choice holds for this scene, the VR menu's Cutscenes for the ones after
+      const bool eyes = s_rig.last_first_person;
+      p.scene_view = eyes ? 0 : 1;
+      buzz(quest::kLeft, 0.6f, 0.08f);
+      lg::info("[vr-pad] scenes are seen {} now: the left menu button held", eyes ? "around you" : "through his eyes");
+    } else if (menu) {
+      // in the pause menu or the title's: the VR menu (as its own row in the game's options menu does)
+      buzz(quest::kLeft, 0.4f, 0.06f);
+      menu::open("the left menu button held in a menu");
+    }
+  }
+  if (!menu_button && p.menu_was && !p.menu_hold_done) {
+    p.start_frames = 3;
+    lg::info("[vr-pad] Start: the left {} pressed (mode {})", click_is_menu ? "stick's click" : "menu button", mode);
+  }
+  p.menu_was = menu_button;
+  if (p.start_frames > 0) {
+    held |= kStart;
+    --p.start_frames;
+  }
+
+  // The d-pad, as Ratchet 0.1.19's (the same owner's ask there): with "Left hand at your head", the left controller
+  // held up by the side of the head, as a phone at the ear, turns the left stick into it and its click into Select
+  // (quest::hand_by_head's place, larger by the VR menu's reach past its 22 cm, and larger again once in so a hand at
+  // its edge does not come and go; a buzz as the hand gets there). With "Left thumb rest", the left thumb resting on its
+  // thumb rest (that sensor alone) turns the right stick into it and its click into Select. Not in the menus, whose
+  // sticks move through them already.
+  bool dpad_left = false, dpad_right = false;
+  if (!menu) {
+    // A controller with no left thumb rest (PC VR's Index, Vive wand, Windows Mixed Reality) has the head's d-pad.
+    if (o.dpad_place == DpadPlace::kHead || !c.left_rest_sensed) {
+      const float grow = static_cast<float>(o.dpad_reach - 22) / 100.0f;
+      const Vec3 h = rot(quest::conjugate(f.head.orientation), f.hand_grip[quest::kLeft].position - f.head.position);
+      const float g = grow + (p.dpad_by_head ? quest::kBySideLeave : 0.0f);
+      dpad_left = f.hand_valid[quest::kLeft] && -h.x > quest::kBySideNear - g && -h.x < quest::kBySideFar + g &&
+                  h.y > -(quest::kBySideDown + g) && h.y < quest::kBySideUp + g &&
+                  h.z > -(quest::kBySideFront + g) && h.z < quest::kBySideBack + g;
+      if (dpad_left && !p.dpad_by_head) {
+        buzz(quest::kLeft, 0.22f, 0.03f);
+      }
+      p.dpad_by_head = dpad_left;
+    } else {
+      dpad_right = c.left_rest_touch;
+      p.dpad_by_head = false;
+    }
+  }
+  // A direction is in past half way, and stays in until back under a third (no flicker at the edge, 0.1.1).
+  std::uint16_t dpad = 0;
+  const auto dpad_from = [&](float& x, float& y) {
+    const auto in = [&](float v, std::uint16_t bit) { return v > ((p.dpad_was & bit) ? 0.35f : 0.5f); };
+    if (in(y, kUp)) dpad |= kUp;
+    if (in(-y, kDown)) dpad |= kDown;
+    if (in(x, kRight)) dpad |= kRight;
+    if (in(-x, kLeft)) dpad |= kLeft;
+    x = 0;
+    y = 0;
+  };
+  // Jak 1's own menus read the d-pad alone (progress.gc and progress-pc.gc: `cpad-pressed? 0 down`; Jak II and 3's add
+  // l-analog-down, the stick), so there both sticks are its d-pad (0.1.1). To 0.1.1 the stick did nothing in them: a
+  // player pushed it down to Load Game on the title, the highlight stayed on New Game and A started a new game (a
+  // player's report, 2026-11-16: "load game is new game ... only jak 1 has this problem"; sim b42 stick1: the stick
+  // down twice, nothing moved). No buzz for these (they are the menu's, not a d-pad press asked for).
+  const bool menu_dpad = menu && s_game == (int)GameVersion::Jak1;
+  if (dpad_left || menu_dpad) {
+    dpad_from(lx, ly);
+    if (dpad_left && p.click_wait[0] > 3) held |= kSelect;
+  }
+  if (!dpad_left && p.click_wait[0] > 3 && !click_is_menu) {
+    held |= kL3;
+  }
+  if (menu_dpad && !dpad_right) {
+    dpad_from(rx, ry);
+  }
+  if (dpad_right) {
+    dpad_from(rx, ry);
+    if (p.click_wait[1] > 3) held |= kSelect;
+  } else if (p.click_wait[1] > 3) {
+    // With the fists on the right grip, on foot, the click is the grip's R2 (above); its R3, the games' own look
+    // around, is the player's head in VR. On the JET-Board too, with the same option (0.1.1, sim b36 buttons3: the
+    // click put Jak 3 on the board, and the same click again was R3 there, so it never took him off; the grip stays R2
+    // on it as well). With Fists on the right grip off the grip gets on and off, and the click is R3, as before.
+    const bool click_boards = play && guns && o.hand_melee && o.melee_grip && (s_rig.last_flags & kFlagBoard) != 0;
+    held |= (melee_grip || click_boards) ? kR2 : kR3;
+  }
+  held |= dpad;
+  // The owner (0.1.1): "i couldnt tell if dpad was activating ... the controller stick vibrates when moved in a
+  // direction". A quick pulse in that stick's hand as a direction goes in (the VR menu's "Buzz on d-pad presses"), and
+  // a lighter one as the left thumb's rest makes the right stick the d-pad.
+  if (const std::uint16_t fresh = dpad & ~p.dpad_was; fresh != 0) {
+    const char* name = (fresh & kUp) ? "up" : (fresh & kDown) ? "down" : (fresh & kLeft) ? "left" : "right";
+    if (menu_dpad) {
+      lg::info("[vr-pad] d-pad {} (a stick in Jak 1's menu)", name);
+    } else {
+      lg::info("[vr-pad] d-pad {} (the {} stick)", name, dpad_left ? "left" : "right");
+    }
+    if (o.dpad_buzz && !menu_dpad) {
+      buzz(dpad_left ? quest::kLeft : quest::kRight, 0.3f, 0.03f);
+    }
+  }
+  if (dpad_right && !p.dpad_rest_was && o.dpad_buzz) {
+    buzz(quest::kLeft, 0.12f, 0.02f);
+  }
+  p.dpad_rest_was = dpad_right;
+  p.dpad_was = dpad;
+
+  // Physical crouch (play, on the ground): the player's own neck gone down by the drop holds L1, the crouch in all
+  // three games (Jak 1 R1 too). Never in the air, where L1 is the dive. Jak walks crouched, so the stick does not let go.
+  {
+    const Vec3 neck = f.head.position + rot(f.head.orientation, {0, -kNeckDown, kNeckBack});
+    if (!p.stand_known || s_rig.recentre_wanted) {
+      p.stand_known = true;
+      p.stand_height = neck.y;
+      p.ducking = false;
+    }
+    p.stand_height = std::max(neck.y, p.stand_height - (p.ducking ? 0.0f : kStandSettle * static_cast<float>(dt)));
+    const float drop = p.stand_height - neck.y;
+    const float height = static_cast<float>(o.crouch_drop) / 100.0f;
+    p.ducking = o.physical_crouch && !o.seated &&
+                (drop >= height || (p.ducking && drop > std::max(height - kCrouchRise, 0.05f)));
+    const bool on_ground = (s_rig.last_flags & kFlagOnGround) != 0;
+    const bool already_ducked = (s_rig.last_flags & kFlagDucking) != 0;
+    const bool press = play && p.ducking && (on_ground || already_ducked);
+    if (press != s_rig.crouch_physical) {
+      lg::info("[vr-body] physical crouch {}: neck {:.2f} m below standing", press ? "on" : "off", drop);
+    }
+    s_rig.crouch_physical = press;
+    if (press) held |= kL1;
+  }
+
+  // The right stick: the game's camera in third person and the menus; a turn of the view in first person on foot (in a
+  // vehicle the view turns with it, and the stick stays the game's).
+  if (first_person && on_foot) {
+    quest::TurnSettings turn;
+    turn.smooth = o.turn == TurnKind::kSmooth;
+    turn.snap_angle = static_cast<float>(o.snap_degrees) * quest::kPi / 180.0f;
+    turn.smooth_rate = static_cast<float>(o.smooth_degrees) * quest::kPi / 180.0f;
+    // (radians left, and the rig's yaw grows to the left as the head's and the game's do: the stick pushed right turns
+    // the view right)
+    const float angle = p.turn.update(rx, static_cast<float>(dt), turn);
+    s_rig.yaw = wrap(s_rig.yaw + angle);
+    rx = 0;
+    ry = 0;
+  }
+
+  // Where the stick moves Jak (owner, 2026-11-12: where you look, by default). The games turn the stick by the math
+  // camera's rotation (read-pad, matrix-local->world in each game), which in VR is the head's in first and third person
+  // alike: so "Move where you look" needs nothing. "Move where your left hand points" turns it on by the angle from the
+  // head's look to the left controller's, both flat.
+  if (play && o.move_by == MoveBy::kLeftHand && f.hand_valid[quest::kLeft] && (lx != 0.0f || ly != 0.0f)) {
+    // (the game's yaw grows to the left: the head's less the hand's is how far right the hand points)
+    const float angle = tracking_yaw_game(f.head.orientation) - tracking_yaw_game(f.hand_aim[quest::kLeft].orientation);
+    const float c = std::cos(angle), s = std::sin(angle);
+    const float x = lx * c + ly * s, y = -lx * s + ly * c;  // a hand to the right: forward goes right
+    lx = x;
+    ly = y;
+  }
+  // The games turn the stick by the camera, then turn it with the shortest turn that takes the camera's up onto the
+  // ground's (read-pad and warp-vector-into-surface!, the same in all three), which a head tilted to one shoulder
+  // while looking down or up sends a little to one side: 12 degrees of tilt looking 40 degrees down is 4.4 degrees off
+  // (0.1.1, a player: "I allways look like I am walking diagonal when I press forward"). The stick is turned back by
+  // that, so ahead is where the head looks whatever its tilt; nothing looking near straight up or down, where the
+  // look has no direction along the ground. (Checked on the simulated headset: tests/jak1_walk_straight.sim's tilts.)
+  if (play && (lx != 0.0f || ly != 0.0f)) {
+    const Vec3 ahead = rot(f.head.orientation, {0, 0, -1});
+    const Vec3 up = rot(f.head.orientation, {0, 1, 0});
+    const float flat = std::sqrt(ahead.x * ahead.x + ahead.z * ahead.z);
+    const float share = std::clamp((0.95f - std::fabs(ahead.y)) / 0.15f, 0.0f, 1.0f);
+    if (flat > 1e-3f && up.y > -0.5f && share > 0.0f) {
+      // the games' ahead: the look turned by the shortest turn taking the head's up to straight up (two mirrors,
+      // across up + straight up then across the ground; the second leaves the flat part alone)
+      const float k = ahead.y / (1.0f + up.y);
+      const float game_x = ahead.x - k * up.x, game_z = ahead.z - k * up.z;
+      const float game_flat = std::sqrt(game_x * game_x + game_z * game_z);
+      if (game_flat > 1e-3f) {
+        // how far to the right of the look's own flat ahead the games' ahead points
+        const float gx = game_x / game_flat, gz = game_z / game_flat;
+        const float ax = ahead.x / flat, az = ahead.z / flat;
+        const float skew = std::atan2(gx * -az + gz * ax, gx * ax + gz * az) * share;
+        const float c = std::cos(skew), s = std::sin(skew);
+        const float x = lx * c - ly * s, y = lx * s + ly * c;  // the stick turned left by it
+        lx = x;
+        ly = y;
+      }
+    }
+  }
+
+  // Physical melee (play, Melee on): a hand thrown forward fast is a punch (Square); swept across fast, a spin kick
+  // (Circle). With Fists on the right grip (on foot), only while a fist is made: the right grip's fist arms both
+  // hands, and so does Jak 1's left; Jak II and 3's left grip (Dark Jak's button too) arms the left hand alone, since
+  // the right may be aiming the gun. On foot only: in a vehicle, on the board or a ride the hands moving pressed
+  // Square and Circle there (sim b3 in Jak 3's buggy).
+  if (on_foot && o.hand_melee) {
+    const float speed_needed = static_cast<float>(o.melee_speed) / 10.0f;
+    const auto armed = [&](int h) { return !melee_grip || fist_r || (fist_l && (!guns || h == quest::kLeft)); };
+    for (int h = 0; h < 2; ++h) {
+      if (!f.hand_valid[h]) {
+        continue;
+      }
+      if (p.hand_known && armed(h)) {
+        const float span = static_cast<float>(std::max(now - p.hand_at, 1e-3));
+        const Vec3 v = scaled(f.hand_grip[h].position - p.hand_was[h], 1.0f / span);
+        const Vec3 local = rot(quest::conjugate(f.head.orientation), v);
+        const float forward = -local.z;
+        const float across = std::abs(local.x);
+        const float upward = local.y;
+        // Crouched (the head, or the trigger's L1), a hand thrown up is the punch from the crouch: the game's
+        // uppercut (target-attack-uppercut in all three games).
+        const bool crouched = s_rig.crouch_physical || (held & kL1) || (s_rig.last_flags & kFlagDucking);
+        if (now - p.hit_at[h] > 0.4) {
+          if (crouched && upward > speed_needed && upward > across) {
+            p.square_frames = 4;
+            p.hit_at[h] = now;
+            s_rig.punch_hand = h;
+            s_rig.punch_at = now;
+            buzz(h, 0.8f, 0.07f);
+            lg::info("[vr-pad] uppercut: the {} hand up at {:.1f} m/s", h == quest::kLeft ? "left" : "right", upward);
+          } else if (forward > speed_needed && forward > across) {
+            p.square_frames = 4;
+            p.hit_at[h] = now;
+            s_rig.punch_hand = h;  // Jak 1's yellow eco leaves this hand (hand_shot)
+            s_rig.punch_at = now;
+            buzz(h, 0.7f, 0.06f);
+            lg::info("[vr-pad] punch: the {} hand ahead at {:.1f} m/s", h == quest::kLeft ? "left" : "right", forward);
+          } else if (across > speed_needed * 1.2f && across > forward) {
+            p.circle_frames = 4;
+            p.hit_at[h] = now;
+            buzz(h, 0.7f, 0.08f);
+            lg::info("[vr-pad] spin kick: the {} hand across at {:.1f} m/s", h == quest::kLeft ? "left" : "right", across);
+          }
+        }
+      }
+      p.hand_was[h] = f.hand_grip[h].position;
+    }
+    p.hand_at = now;
+    p.hand_known = true;
+  } else {
+    p.hand_known = false;
+  }
+  // Spin kick by spreading your arms (Vixel, 0.1.1: "T-pose to trigger spin move"; its own switch, on to start): on
+  // foot, both hands out wide at the sides (each over 50 cm out from the head, between 55 cm below the eyes and 15 cm
+  // above, not over 35 cm ahead or behind) for a fifth of a second is one spin kick (Circle); the arms come in before
+  // the next. Holding the gun ahead, resting at the sides or reaching forward is none of that.
+  bool spread = false;
+  if (on_foot && o.spread_spin_kick && f.hand_valid[quest::kLeft] && f.hand_valid[quest::kRight]) {
+    const auto wide = [](const Vec3& h, float out) {
+      return out > 0.5f && h.y > -0.55f && h.y < 0.15f && std::abs(h.z) < 0.35f;
+    };
+    const Vec3 l = in_head(f, quest::kLeft), r = in_head(f, quest::kRight);
+    spread = wide(l, -l.x) && wide(r, r.x);
+  }
+  if (!spread) {
+    p.spread_since = -1;
+    p.spread_kicked = false;
+  } else if (p.spread_since < 0) {
+    p.spread_since = now;
+  } else if (!p.spread_kicked && now - p.spread_since > 0.2) {
+    p.spread_kicked = true;
+    p.circle_frames = 4;
+    buzz(quest::kLeft, 0.7f, 0.08f);
+    buzz(quest::kRight, 0.7f, 0.08f);
+    lg::info("[vr-pad] spin kick: the arms spread");
+  }
+  if (p.square_frames > 0) {
+    held |= kSquare;
+    --p.square_frames;
+  }
+  if (p.circle_frames > 0) {
+    held |= kCircle;
+    --p.circle_frames;
+  }
+  (void)menu;
+
+  // What closed the VR menu stays the menu's until let go.
+  p.swallow &= raw;
+  held &= static_cast<std::uint16_t>(~p.swallow);
+
+  // Into the report: buttons as well as a real pad's; a stick of ours off its middle takes that stick's place.
+  cpad->button0 = static_cast<std::uint16_t>(cpad->button0 | held);
+  if (lx != 0.0f || ly != 0.0f) {
+    jak_stick(lx, -ly, cpad->leftx, cpad->lefty);
+  }
+  if (rx != 0.0f || ry != 0.0f) {
+    jak_stick(rx, -ry, cpad->rightx, cpad->righty);
+  }
+  for (int i = 0; i < 12; ++i) {
+    if (held & kPressure[i]) {
+      cpad->abutton[i] = 255;
+    }
+  }
+}
+
+void rumble(int port, int small_motor, int big_motor) {
+  if (port != 0 || !s_vr_on.load()) {
+    return;
+  }
+  // The game's two motors split to the hands: the big one (a hit, a landing, a quake) both; the small one (what he does
+  // himself) the hand that does it, the gun's while it is drawn, the hand that punched in the last second, else both.
+  const float big = static_cast<float>(big_motor) / 255.0f;
+  if (big > 0.0f) {
+    buzz(quest::kLeft, big, 0.1f);
+    buzz(quest::kRight, big, 0.1f);
+  }
+  if (small_motor > 0) {
+    const bool punched = now_seconds() - s_rig.punch_at < 1.0;
+    if (s_gun_in_hand) {
+      buzz(quest::kRight, 0.35f, 0.1f);
+    } else if (punched) {
+      buzz(s_rig.punch_hand, 0.35f, 0.1f);
+    } else {
+      buzz(quest::kLeft, 0.35f, 0.1f);
+      buzz(quest::kRight, 0.35f, 0.1f);
+    }
+  }
+}
+
+void gun_fired(int ammo) {
+  if (!s_vr_on.load()) {
+    return;
+  }
+  // A kick a round, by gun (Ratchet's: a round used, so a refused shot is none): the Blaster's (yellow) sharp, the
+  // Scatter Gun's (red) heavy, the Vulcan's (blue) light (it fires fast), the Peacemaker's (dark) the heaviest. The
+  // left hand has a share of it with both hands on the gun.
+  static constexpr float kStrength[4] = {0.55f, 0.95f, 0.30f, 1.0f};
+  static constexpr float kSeconds[4] = {0.05f, 0.09f, 0.03f, 0.16f};
+  const int k = std::clamp(ammo, 0, 3);
+#if !defined(__ANDROID__)
+  // PC test aid (JAKVR_BODY_TRACE=1): each round, so a test can tell a shot from none (the holsters draw without one)
+  static const bool trace = std::getenv("JAKVR_BODY_TRACE") != nullptr;
+  if (trace) {
+    lg::info("[vr-gun] a round fired (ammo {})", k);
+  }
+#endif
+  buzz(quest::kRight, kStrength[k], kSeconds[k]);
+  if (s_support.held) {
+    buzz(quest::kLeft, 0.6f * kStrength[k], kSeconds[k]);
+  }
+}
+
+void gun_switched(int gun) {
+  if (!s_vr_on.load()) {
+    return;
+  }
+  // The owner (0.1.1): "immersion for switching weapons". A short click in the gun's hand, lighter than a round.
+  lg::info("[vr-gun] the gun switched (the game's gun {})", gun);
+  if (options().gun_switch_buzz) {
+    buzz(quest::kRight, 0.4f, 0.04f);
+  }
+}
+
+int holster() {
+  // fill_pad and the game's ask are both on the game's thread
+  const int news = s_pad.holster_news;
+  s_pad.holster_news = 0;
+  return s_vr_on.load() ? news : 0;
+}
+
+int graphics() {
+  if (!s_vr_on.load()) {
+    return 0;
+  }
+  const Options& o = options();
+  return (o.max_draw_distance ? kGraphicsMaxDistance : 0) | (o.ps2_detail ? kGraphicsPs2Detail : 0) |
+         (s_game_fps.load() << 8);
+}
+
+// Textures are made from the start (before the headset's session), so these ask wanted(), not on().
+float anisotropy(float most) {
+  if (!wanted()) {
+    return most;
+  }
+  return std::max(1.0f, std::min(most, static_cast<float>(options().anisotropy)));
+}
+
+int msaa_samples(int game_samples) {
+  return wanted() ? std::max(1, options().msaa) : game_samples;
+}
+
+bool on() {
+  return s_vr_on.load();
+}
+
+bool exit_wanted() {
+  return s_exit_wanted.load();
+}
+
+}  // namespace jakvr
