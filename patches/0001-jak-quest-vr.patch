+namespace {
+
+// Jak and Daxter Quest VR: a display frame of the headset's. The game's chain, when it has sent one, drawn once for
+// each pass (the HUD's panel, then each eye) by jakvr::draw_passes; the headset paces this loop, and the game is let go
+// at 60 frames a second whatever its rate (jakvr::release_game).
+struct VrFrameContext {
+  RenderOptions base;
+};
+
+void draw_vr_pass(void* user) {
+  const auto& ctx = *static_cast<VrFrameContext*>(user);
+  const auto& pass = jakvr::pass();
+  RenderOptions options = ctx.base;
+  options.game_res_w = pass.render_width;
+  options.game_res_h = pass.render_height;
+  options.window_framebuffer_width = pass.width;
+  options.window_framebuffer_height = pass.height;
+  options.draw_region_width = pass.width;
+  options.draw_region_height = pass.height;
+  options.output_fbo = pass.target_fbo;
+  options.vr_pass = true;
+  // Jak II and 3 clear in BlitDisplays, drawn in the frame's first pass only, and the sky clears only where one is
+  // drawn: indoors (Jak II's fortress) an eye's pass kept the last pass's depth and drew nothing but its particles.
+  options.clear_render = pass.kind == jakvr::PassKind::kHud || pass.kind == jakvr::PassKind::kEye;
+  options.keep_alpha = pass.kind == jakvr::PassKind::kHud;
+  g_gfx_data->ogl_renderer.render(DmaFollower(g_gfx_data->dma_copier.get_last_input_data(),
+                                              g_gfx_data->dma_copier.get_last_input_offset()),
+                                  options);
+  if (pass.kind == jakvr::PassKind::kEye) {
+    // smoother frames: the eye's motion from its depth
+    jakvr::eye_drawn(g_gfx_data->ogl_renderer.last_render_fbo(), pass.render_width, pass.render_height);
+  }
+}
+
+void render_vr_frame(int msaa_samples, int brightness_contrast_color, int brightness_contrast_alpha) {
+  bool got_chain = false;
+  {
+    auto p = scoped_prof("vr-wait-for-dma");
+    std::unique_lock<std::mutex> lock(g_gfx_data->dma_mutex);
+    // A short wait: the headset's frame goes on with the last pictures if the game is not ready.
+    got_chain = g_gfx_data->dma_cv.wait_for(lock, std::chrono::milliseconds(2),
+                                            [=] { return g_gfx_data->has_data_to_render; });
+  }
+  VrFrameContext ctx;
+  if (got_chain) {
+#ifdef __ANDROID__
+    android_touch_controls::game_frame_rendered();
+#endif
+    g_gfx_data->frame_idx_of_input_data = g_gfx_data->frame_idx;
+    auto& o = ctx.base;
+    GLint msaa_max;
+    glGetIntegerv(GL_MAX_SAMPLES, &msaa_max);
+    // Jak and Daxter Quest VR: the launcher's Anti-aliasing (vr-options.txt msaa), not the game's own setting
+    o.msaa_samples = std::clamp(jakvr::msaa_samples(msaa_samples), 1, std::max(1, (int)msaa_max));
+    o.brightness_contrast_color = brightness_contrast_color;
+    o.brightness_contrast_alpha = brightness_contrast_alpha;
+    o.pmode_alp_register = g_gfx_data->pmode_alp;
+    o.gpu_sync = g_gfx_data->debug_gui.should_gl_finish();
+  }
+  {
+    auto p = scoped_prof("vr-render");
+    jakvr::draw_passes(got_chain, draw_vr_pass, &ctx);
+  }
+  if (got_chain) {
+    std::unique_lock<std::mutex> lock(g_gfx_data->dma_mutex);
+    g_gfx_data->engine_timer.start();
+    g_gfx_data->has_data_to_render = false;
+    g_gfx_data->sync_cv.notify_all();
+  }
+}
