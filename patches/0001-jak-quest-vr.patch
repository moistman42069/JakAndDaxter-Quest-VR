@@ -0,0 +1,6872 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+//
+// See jak_vr.h. The headset (xr.h: OpenXR on the Quest and a PC, the simulated one for tests), the rig that puts
+// the player in the game's world, the passes that draw the game's frame for the eyes and the panel, the pad.
+
+#include "jak_vr.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "common/goal_constants.h"
+#include "common/log/log.h"
+#include "common/versions/versions.h"
+
+#include "game/graphics/opengl_renderer/buckets.h"
+#include "game/graphics/pipelines/opengl.h"
+#include "game/kernel/common/kernel_types.h"
+#include "game/runtime.h"
+#include "game/vr/pad.h"
+#include "game/vr/hand.h"  // dot(), which pointer.h uses (as in Ratchet's)
+#include "game/vr/pointer.h"
+#include "game/vr/vr_menu.h"
+#include "game/vr/vr_options.h"
+#include "game/vr/xr.h"
+
+#if defined(_WIN32)
+#include "third-party/SDL/include/SDL3/SDL.h"
+#endif
+
+namespace quest {
+#if defined(_WIN32)
+extern void* (*sim_gl_proc)(const char*);
+#endif
+}  // namespace quest
+
+namespace jakvr {
+
+using quest::Controls;
+using quest::FrameInfo;
+using quest::Headset;
+using quest::Pose;
+using quest::Quat;
+using quest::Vec3;
+
+namespace {
+
+constexpr float kUnitsPerMetre = 4096.0f;
+// First person's World scale 100%: this many game metres to one of the player's (Jak's eye height over a person's).
+constexpr float kLifeSize = 1.45f;
+// The games' frames a second in VR (0.1.1, the VR menu's Game frame rate): 60 as they were made, whatever the
+// headset's rate (0.1.0's only way, and still the start); the headset's own rate, so each display has a new game
+// frame; or half of it, half the work, the headset turning each picture to the head between (the RDR1 Quest port's
+// "36 fps shown at 72 Hz"). Smoother frames makes it half: the headset paces the game so. Set by the display thread
+// (begin_frame), read by the game (graphics, pc-vr.gc vr-graphics!), which steps its clocks by it.
+std::atomic<int> s_game_fps{60};
+
+// A bone's (or bind pose's) game address the runtime may read or write its matrix at: in the game's memory past the
+// low protected part and 16-byte aligned, as every one is. A process slot gone (Daxter's link left to a dead one at a
+// new game's start, sim j2_glow1) can give anything else: that is left alone, not read or written through.
+bool bone_ok(std::uint32_t address) {
+  return address >= static_cast<std::uint32_t>(EE_MAIN_MEM_LOW_PROTECT) && (address & 15u) == 0 &&
+         address <= static_cast<std::uint32_t>(EE_MAIN_MEM_SIZE) - 64u;
+}
