+}
+
+void play_host_copy() {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (!g_session || hosting() || !in_party()) {
+    g_save_note = "Join a game first.";
+    return;
+  }
+  g_copy.clear();
+  g_copy_parts = g_copy_of = 0;
+  g_copy_asked = true;
+  g_save_note = "Asking the host for its progress...";
+  g_session->send_to(0, {{"save", "ask"}});
+}
