+void OpenGLRenderer::render_bucket(size_t bucket_id, DmaFollower& dma, ScopedProfilerNode& prof) {
+  auto* renderer = m_bucket_renderers[bucket_id].get();
+  const auto& pass = jakvr::pass();
+  bool draw = true;
+  if (pass.kind != jakvr::PassKind::kWindow) {
+    if (dynamic_cast<TextureUploadHandler*>(renderer)) {
+      draw = true;  // what later buckets draw with, in every pass
+    } else if (dynamic_cast<BlitDisplays*>(renderer)) {
+      // It keeps the picture before it for the game's screen effects and clears: once a frame, after an eye's pass.
+      draw = pass.first_of_frame;
+    } else {
+      draw = jakvr::bucket_drawn((int)bucket_id);
+    }
+  }
+  if (draw) {
+    renderer->render(dma, &m_render_state, prof);
+  } else {
+    while (dma.current_tag_offset() != m_render_state.next_bucket) {
+      dma.read_and_advance();
+    }
+  }
