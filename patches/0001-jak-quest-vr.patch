+void buzz(int hand, float strength, float seconds) {
+  if (!options().vibration) {
+    return;
+  }
+  strength = std::min(1.0f, strength * static_cast<float>(options().vibration_strength) / 100.0f);  // Vibration strength
+  std::lock_guard<std::mutex> lock(s_shared.mutex);
+  auto& b = s_shared.buzz[hand];
+  b.strength = std::max(b.wanted ? b.strength : 0.0f, strength);
+  b.seconds = std::max(b.wanted ? b.seconds : 0.0f, seconds);
+  b.wanted = true;
+}
