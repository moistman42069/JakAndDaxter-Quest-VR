+  bone_as_made(w, fore, hand);
+  const GripWorld g = grip_world(side, grip);
+  Vec3 along_w = g.along, palm_w = g.palm, thumb_w = g.thumb;
+  // The bones' scale (his model's size against the model as made), from the hand's x row.
+  const float size = quest::length(Vec3{w[hand].m[0][0], w[hand].m[0][1], w[hand].m[0][2]});
+  const float reach = s.palm_reach[side] * size;
+  const Vec3 palm_at = g.palm_middle + shift;
+  // The wrist out of the eyes (kWristClear): the hand pitched about its palm. Not the gun's hand (the gun goes where the
+  // controller points, held as the game holds it: a sight brought to the eye is the gun's).
+  {
+    const Vec3 up_n = unit(Vec3{0, 1, 0} - scaled(along_w, along_w.y) + scaled(thumb_w, 0.05f), thumb_w);
+    const bool gun_hand = side == quest::kRight && s_gun_in_hand;
+    const float want = gun_hand || reach < 1.0f
+                           ? 0.0f
+                           : wrist_pitch(palm_at - s_rig.map_head_world, along_w, up_n, reach,
+                                         kWristClear * s_rig.map_units);
+    float& pitch = s_body.wrist_pitch[side];
+    const float dt = body_ease_dt(s_body.wrist_pitch_at[side]);
+    if (dt < 0.0f || (want * pitch >= 0.0f && std::fabs(want) > std::fabs(pitch))) {
+      pitch = want;  // nearer: out of the eyes at once
+    } else {
+      pitch += (want - pitch) * (1.0f - std::exp(-kWristFollows * dt));
+    }
+    if (std::fabs(pitch) > 1e-4f) {
+      const Vec3 bent = unit(scaled(along_w, std::cos(pitch)) + scaled(up_n, std::sin(pitch)), along_w);
+      const Mat turn = turn_between(along_w, bent);
+      along_w = bent;
+      palm_w = unit(mat_dir(palm_w, turn), palm_w);
+      thumb_w = unit(mat_dir(thumb_w, turn), thumb_w);
+    }
+  }
+  // The palm's middle on the controller's handle, the wrist behind it.
+  const Vec3 target = palm_at - scaled(along_w, reach);
+
+  const float a = quest::length(mat_place(w[fore]) - mat_place(w[arm]));
+  const float b = quest::length(mat_place(w[hand]) - mat_place(w[fore]));
+  if (a < 1.0f || b < 1.0f) {
+    return;
+  }
+  // How near the eyes the hand is (0.1.1, the owner: "full body ik HAS to be made better", his video: the sleeve across
+  // the view with a hand up close): 1 within 15 cm of them, 0 past 40 cm (the player's metres).
+  const float near_head = std::clamp(
+      1.0f - (quest::length(target - s_rig.map_head_world) / s_rig.map_units - 0.15f) / 0.25f, 0.0f, 1.0f);
+  // His shoulder rises a little with a hand held high, and swings toward a hand reaching far, as a real one does
+  // (the arm alone reaching up looks pinned at the shoulder); not toward a hand brought to the face, where a real
+  // shoulder stays down (it lifted the upper arm into the view).
+  const int collar = node(kSideShoulder);
+  if (collar >= 0 && hangs_under(arm, collar)) {
+    const Vec3 C = mat_place(w[collar]), S0 = mat_place(w[arm]);
+    const Vec3 to = target - S0;
+    const float up_k = std::clamp((to.y / (a + b) - 0.15f) / 0.6f, 0.0f, 1.0f) * (1.0f - near_head);
+    const float far_k = std::clamp((quest::length(to) / (a + b) - 0.8f) / 0.25f, 0.0f, 1.0f);
+    if (up_k > 0.0f || far_k > 0.0f) {
+      const Vec3 d0 = unit(S0 - C, {1, 0, 0});
+      const Vec3 d1 = unit(d0 + Vec3{0, up_k * kShoulderLift, 0} + scaled(unit(to, d0), far_k * kShoulderReach), d0);
+      turn_under(w, collar, turn_between(d0, d1), C);
+    }
+  }
+  // The elbow: down, out to his side and a little back, as arms hang, and away from the thumb (a hand turned palm
+  // down puts its elbow out, palm up tucks it in), whichever way his chest faces (Ratchet's pole, with the hand's roll).
+  const Vec3 S = mat_place(w[arm]);
+  const int neck = info.named[kJointNeck];
+  Vec3 out = neck >= 0 && neck < s.count && info.bone[neck] != 0 ? S - mat_place(w[neck]) : Vec3{0, 0, 0};
+  out = out - scaled(facing, dot3(out, facing));
+  out.y = 0;
+  out = unit(out, {0, 0, 0});
+  // 0.1.1: the hand's roll moves the elbow less (the forearm's twist takes the rest), and less again with the hand high
+  // or at the face: a palm turned down there swung the elbow out to shoulder height, the forearm across the view. A hand
+  // at the face hangs its elbow down and a little forward, as a real one; held lower, down, out and back as before.
+  const float high = std::clamp(((target - S).y / (a + b) + 0.1f) / 0.6f, 0.0f, 1.0f);
+  const float thumb_k = 0.4f * (1.0f - 0.75f * std::max(near_head, high));
+  // A wrist over the eyes (a hand above the head, pitched down by kWristPreferUp) hangs its elbow out to the side
+  // instead, the forearm beside the head, not down across the face.
+  const float over =
+      near_head * std::clamp((target - s_rig.map_head_world).y / s_rig.map_units / 0.08f, 0.0f, 1.0f);
+  const float by_face = near_head - over;
+  const Vec3 want = Vec3{0, -(0.6f + 0.8f * by_face) + 0.2f * over, 0} +
+                    scaled(out, 0.6f * (1.0f - 0.5f * by_face) + 0.8f * over) - scaled(facing, 0.3f - 0.4f * by_face) -
+                    scaled(thumb_w, thumb_k);
+  // Eased in his chest's own axes (so it does not trail a turn of his body): a hint that jumps (a tracking glitch, a
+  // quick roll of the wrist) no longer flicks the elbow to the other side. Fast enough not to be seen following.
+  const Vec3 across = unit(cross3(Vec3{0, 1, 0}, facing), {1, 0, 0});
+  const Vec3 local{dot3(want, across), want.y, dot3(want, facing)};
+  Vec3& eased = s_body.elbow_hint[side];
+  const float dt = body_ease_dt(s_body.elbow_hint_at[side]);
+  if (!s_body.elbow_hint_ok[side] || dt < 0.0f) {
+    eased = local;
+  } else {
+    const float k = 1.0f - std::exp(-kElbowFollows * dt);
+    eased = eased + (local - eased) * k;
+  }
+  s_body.elbow_hint_ok[side] = true;
+  const Vec3 pole = scaled(across, eased.x) + Vec3{0, eased.y, 0} + scaled(facing, eased.z);
+  two_bone(w, arm, fore, hand, target, pole, 0.15f, std::clamp(static_cast<float>(options().arm_length) / 100.0f, 0.7f, 1.5f));
+
+  // The hand turned as the controller is. Its twist about the forearm shared half and half with the forearm (at most
+  // a third of a turn's worth there), so the wrist does not wring.
+  const Vec3 along_l = s.along[side], palm_l = s.palm[side];
+  Mat local_rows = mat_identity(), world_rows = mat_identity();
+  const Vec3 third_l = cross3(along_l, palm_l), third_w = cross3(along_w, palm_w);
+  const Vec3 lr[3] = {along_l, palm_l, third_l}, wr[3] = {along_w, palm_w, third_w};
+  for (int i = 0; i < 3; ++i) {
+    local_rows.m[i][0] = lr[i].x, local_rows.m[i][1] = lr[i].y, local_rows.m[i][2] = lr[i].z;
+    world_rows.m[i][0] = wr[i].x, world_rows.m[i][1] = wr[i].y, world_rows.m[i][2] = wr[i].z;
+  }
+  const Mat hand_turn = mat_mul(mat_transpose3(local_rows), world_rows);  // the hand's axes to the world, wanted
+  {
+    const Vec3 e = mat_place(w[fore]), wr2 = mat_place(w[hand]);
+    const Vec3 axis = unit(wr2 - e, {0, -1, 0});
+    const Mat delta = mat_mul(mat_transpose3(mat_turn_of(w[hand])), hand_turn);
+    // the twist: a line across the forearm, turned, flattened across it again
+    const Vec3 across = unit(cross3(axis, std::fabs(axis.y) < 0.9f ? Vec3{0, 1, 0} : Vec3{1, 0, 0}));
+    Vec3 turned = mat_dir(across, delta);
+    turned = turned - scaled(axis, dot3(turned, axis));
+    const float twist = std::atan2(dot3(cross3(across, turned), axis), dot3(across, turned));
+    turn_under(w, fore, turn_about(axis, std::clamp(0.5f * twist, -1.05f, 1.05f)), e);
+  }
+  {
+    const Mat delta = mat_mul(mat_transpose3(mat_turn_of(w[hand])), hand_turn);
+    turn_under(w, hand, delta, mat_place(w[hand]));
+  }
+
+  // The fingers: set as made, under the hand as it is now, then curled.
+  if (!options().fingers) {
+    return;
+  }
+  const Mat hand_axes = mat_turn_of(w[hand]);
+  const Fingers& feel = s_fingers[side];
+  // A surface the palm faces (the fingers lie on it, or curl on to it), with give: taken with the palm turned within
+  // 60 degrees of it, let go only past 70. Without the give a hand edge on in the ground, its palm near 60 degrees from
+  // it, went between the two about once a second and its little finger curled on to the ground and opened again with
+  // the hand held still (sim b24 fingers, 0.12 to 0.62 and back).
+  bool palm_side = false;
+  if (plane_count > 0 && planes) {
+    float most = 1.0f;
+    for (int q = 0; q < plane_count; ++q) {
+      most = std::min(most, dot3(planes[q].n, palm_w));
+    }
+    palm_side = most < (s_body.palm_faces[side] ? -0.34f : -0.5f);
+  }
+  s_body.palm_faces[side] = palm_side;
+  for (int f = 0; f < 5; ++f) {
+    const int fa = node(kSideThumbA + 2 * f), fb = node(kSideThumbA + 2 * f + 1);
+    if (fa < 0 || !s.has_made[fa]) {
+      continue;
+    }
+    for (int i : under(fa)) {
+      const int p = s.parent[i];
+      if (p >= 0 && s.has_made[i] && s.has_made[p]) {
+        // as made against its parent, under its parent as it is now
+        w[i] = mat_mul(mat_mul(s.made[i], mat_inverse(s.made[p])), w[p]);
+      }
+    }
+    const float want = f == 0 ? feel.thumb : (f == 1 ? feel.first : feel.rest);
+    const Vec3 k = unit(mat_dir(s.bend[side][f], hand_axes), {1, 0, 0});
+    const float bend_a = f == 0 ? kThumbBendA : kBendA, bend_b = f == 0 ? kThumbBendB : kBendB;
+    float& off = s_body.finger_off[side][f];
+    float curl = want;
+    if (curl_fixed >= 0.0f) {
+      off = 0.0f;
+      curl = f == 0 ? want : std::max(want, curl_fixed);
+    } else {
+      float wanted = 0.0f;     // off what the controller asks
+      bool in_it_now = false;  // as it was drawn it is in something: out of it fast
+      if (fb >= 0 && plane_count > 0 && planes) {
+        const Vec3 pa = mat_place(w[fa]), pb = mat_place(w[fb]);
+        const float l1 = quest::length(pb - pa), l2 = 0.9f * l1;  // the last bone has no joint at its end
+        const Vec3 d0 = unit(pb - pa, along_w);
+        const float thick = kFingerThick * 4096.0f * size;
+        // the finger at curl c: its middle joint and its tip against each surface its root is in front of
+        const auto meets = [&](float c) {
+          const Vec3 b = pa + scaled(mat_dir(d0, turn_about(k, c * bend_a)), l1);
+          const Vec3 t = b + scaled(mat_dir(d0, turn_about(k, c * (bend_a + bend_b))), l2);
+          for (int q = 0; q < plane_count; ++q) {
+            const HandPlane& pl = planes[q];
+            if (dot3(pl.n, pa - pl.at) < 0.0f) {
+              continue;
+            }
+            if (dot3(pl.n, b - pl.at) < thick || dot3(pl.n, t - pl.at) < thick) {
+              return true;
+            }
+          }
+          return false;
+        };
+        // 0.1.1 (the owner: "satisfying world collision with finger bending to the world"): the finger goes from the
+        // curl it is drawn at toward the one it is asked for and stops where the world is, as a real finger does;
+        // found in something (the hand moved), it takes the nearest way out from where it is. Before, every frame
+        // asked afresh for the free curl nearest the asked one, so a finger just touching flicked between two answers
+        // (open, and curled 0.4 on) as the hand breathed (sim b22 fingers: the little finger with the hand edge on,
+        // all four with the tips pressed down).
+        const float cur = std::clamp(want + off, kFingerBackMost, 1.0f);
+        // where it goes with nothing in the way: the asked curl, or on to a surface the palm faces until it rests
+        // there (a finger held out on purpose stays out)
+        float goal = want;
+        if (palm_side && (f >= 2 || (f == 0 && feel.thumb > 0.5f) || (f == 1 && feel.first > 0.1f))) {
+          const float top = std::min(want + kFingerWrapMost, 1.0f);
+          for (float c = want + kFingerFine; c <= top + 1e-3f; c += kFingerFine) {
+            if (meets(c)) {
+              goal = c - kFingerFine;
+              break;
+            }
+          }
+        }
+        float to = cur;
+        in_it_now = meets(cur);
+        if (in_it_now) {
+          // the nearest free curl either way, the goal's side first; none (a hand edge on in the ground): it stays
+          const float first = goal >= cur ? 1.0f : -1.0f;
+          bool found = false;
+          for (int step = 1; step <= 70 && !found; ++step) {
+            const float d = kFingerFine * static_cast<float>(step);
+            const float tries[2] = {cur + first * d, cur - first * d};
+            for (float c : tries) {
+              if (!found && c >= kFingerBackMost && c <= 1.0f && !meets(c)) {
+                to = c;
+                found = true;
+              }
+            }
+          }
+        } else {
+          // toward the goal, as far as the world lets it
+          const float way = goal >= cur ? 1.0f : -1.0f;
+          for (int step = 0; step < 70 && to != goal; ++step) {
+            const float next = std::fabs(goal - to) <= kFingerFine ? goal : to + way * kFingerFine;
+            if (meets(next)) {
+              break;
+            }
+            to = next;
+          }
+        }
+        wanted = to - want;
+      }
+      const float rate = (in_it_now ? kFingerStops : kFingerFollows) * seconds;
+      off += std::clamp(wanted - off, -rate, rate);
+      curl = std::clamp(want + off, kFingerBackMost, 1.0f);
+    }
+    s_body.finger_curl[side][f] = curl;
+    turn_under(w, fa, turn_about(k, curl * bend_a), mat_place(w[fa]));
+    if (fb >= 0) {
+      turn_under(w, fb, turn_about(k, curl * bend_b), mat_place(w[fb]));
+    }
+  }
+}
