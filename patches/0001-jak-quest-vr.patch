+(define-extern pc-vr-test-flags (function int)) ;; PC test aids from the environment (1: the gun given, JAKVR_TEST_GUN; 2: Jak's state logged, JAKVR_STATE_TRACE; 4: the JET-Board given, JAKVR_TEST_BOARD; 8: the body traced, JAKVR_BODY_TRACE)
+(define-extern pc-vr-body-cut (function int)) ;; what Body shown leaves out of the eyes in first person: 1 his body, 2 his arms, 4 his legs (cloth.gc: his cape with his body)
+(define-extern pc-vr-test-continue! (function string int)) ;; PC test aid: JAKVR_TEST_CONTINUE's continue point into the string, 1 when set
+(define-extern pc-vr-menu-open! (function none)) ;; the VR menu (game/vr/vr_menu.h): opened from the game's options menu
+(define-extern pc-vr-menu-shown? (function symbol)) ;; it is up: vr-menu-draw draws it
+(define-extern pc-vr-menu-box (function int structure int)) ;; box i into the vector (x y w h); its kind (1 menu, 2 chosen row), 0 none
+(define-extern pc-vr-menu-text (function int string structure int)) ;; text i into the string, x y scale width into the vector; #x10000 + align * 256 + font-color, 0 none
