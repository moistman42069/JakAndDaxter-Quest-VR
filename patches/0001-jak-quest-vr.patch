+          declval<initiate_async_write_some_at>(), token, offset, buffers)))
+  {
+    return async_initiate<WriteToken,
+      void (asio::error_code, std::size_t)>(
+        initiate_async_write_some_at(this), token, offset, buffers);
+  }
