+}
+
+void save_made(const std::uint8_t* data, int length) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (!g_session || g_copy_for.empty()) {
+    return;
+  }
+  if (!data || length <= 0 || static_cast<std::size_t>(length) > kSaveMost) {
+    for (int k : g_copy_for) {
+      g_session->send_to(k, {{"save", "none"}});
+    }
+    g_copy_for.clear();
+    return;
+  }
+  const std::size_t size = static_cast<std::size_t>(length);
+  const int of = static_cast<int>((size + kSaveChunk - 1) / kSaveChunk);
+  for (int k : g_copy_for) {
+    for (int n = 0; n < of; ++n) {
+      const std::size_t at = static_cast<std::size_t>(n) * kSaveChunk;
+      g_session->send_to(k, {{"save", "part"},
+                             {"n", n},
+                             {"of", of},
+                             {"data", base64_encode(data + at, std::min(kSaveChunk, size - at))}});
+    }
+    lg::info("party: this game's progress ({} bytes) sent to player {}", size, k);
+  }
+  g_copy_for.clear();
+}
+
+int save_copy_into(std::uint8_t* to, int most) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (!to || g_copy.empty() || static_cast<int>(g_copy.size()) > most) {
+    return 0;
+  }
+  std::memcpy(to, g_copy.data(), g_copy.size());
+  const int n = static_cast<int>(g_copy.size());
+  g_copy.clear();
+  return n;
+}
+
+void save_done(int kind, bool ok) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  switch (kind & 15) {
+    case kSaveLoadSlot:
+      g_save_note = ok ? "" : "That save could not be loaded.";
+      break;
+    case kSaveNewGame:
+      g_save_note = ok ? "A new game: save it from the pause menu to keep it." : "";
+      break;
+    case kSaveMakeCopy:
+      if (!ok) {
+        save_made(nullptr, 0);
+      }
+      break;
+    case kSaveLoadCopy:
+      g_save_note = ok ? "Playing the host's progress (your own saves are kept)."
+                       : "The host's progress could not be loaded.";
+      break;
+    default:
+      break;
+  }
+  lg::info("party: save {} {}", kind & 15, ok ? "done" : "failed");
+}
