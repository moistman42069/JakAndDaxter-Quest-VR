diff --git a/goal_src/jak3/pc/pc-vr.gc b/goal_src/jak3/pc/pc-vr.gc
new file mode 100644
index 000000000..5daef54f1
--- /dev/null
+++ b/goal_src/jak3/pc/pc-vr.gc
@@ -0,0 +1,581 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; Jak Quest VR (Jak 3): hands the game's camera to the VR runtime once per frame.
+;; Called from update-camera just before camera-rot is built from inv-camera-rot, so the
+;; runtime can replace the camera with the player's head (first person) or turn it with the
+;; head (third person). Does nothing when no headset is running. Same contract as
+;; goal_src/jak1/pc/pc-vr.gc; the C++ side is game/kernel/common/kmachine.cpp pc_vr_camera.
+
+(define-extern movie? (function symbol))
+(define-extern paused? (function symbol))
+(define-extern vector<-cspace! (function vector cspace vector))
+(define-extern cspace<-parented-transformq-joint! (function cspace transformq none))
+
+;; must match VrCameraInfo in game/vr/jak_vr.h (64 bytes)
+(deftype vr-camera-info (structure)
+  ((mode         int32)
+   (flags        int32)
+   (target-yaw   float)   ;; radians
+   (pad0         float)
+   (head         vector :inline)
+   (target-trans vector :inline)
+   (camera-trans vector :inline))
+  )
+
+(define *vr-camera-info* (new 'static 'vr-camera-info))
+
+(defun vr-title? ()
+  (= (-> *target* next-state name) 'target-title))
+
+(defun vr-first-person-ok? ()
+  "Can the camera sit in Jak's head right now? No in vehicles, on the JET-Board, in the Titan
+   suit, as Daxter alone, on rails, poles and turrets (and the turret flag), and in scripted states."
+  (not (or (focus-test? *target* pilot pilot-riding board mech indax rail halfpipe tube flut pole turret
+                        teleporting dead)
+           (case (-> *target* next-state name) (('target-title 'target-death 'target-clone-anim 'target-board-clone-anim 'target-pilot-clone-anim 'target-mech-clone-anim 'target-play-anim 'target-demo 'target-launch 'target-float 'target-warp-in 'target-warp-out 'target-turret-get-on 'target-turret-stance 'target-turret-stance-fire 'target-turret-get-off 'target-flut-clone-anim 'target-indax-hang) #t) (else #f)))))
+
+(defun vr-vehicle-first-person-ok? ()
+  "Jak and Daxter Quest VR 0.1.1, the VR menu's First person in vehicles (off to start): in a car or a desert vehicle,
+   on the JET-Board (its rails and half-pipes too), in the mech, on the flut, down a slide or at a gun turret, where the
+   view can sit in his head and turn with it (the owner: 'vehicles/everything ... the jetboard too of course'). Not
+   dead, warping or in a scripted move; not as Daxter alone or round a pole."
+  (and (or (focus-test? *target* pilot pilot-riding board mech flut tube turret)
+           (case (-> *target* next-state name) (('target-turret-stance 'target-turret-stance-fire) #t) (else #f)))
+       (not (focus-test? *target* dead teleporting))
+       (not (case (-> *target* next-state name) (('target-death 'target-clone-anim 'target-board-clone-anim 'target-pilot-clone-anim 'target-mech-clone-anim 'target-flut-clone-anim 'target-play-anim 'target-demo 'target-launch 'target-warp-in 'target-warp-out) #t) (else #f)))))
+
+;; ---- Jak's head, and Daxter on his shoulder, kept out of the first-person view ----
+;; The view sits in Jak's head, so his head (neckB and the hair, ears, eyes and mouth on it) is left out of the eyes,
+;; and Daxter likewise in play (on the shoulder, at the eyes) and in a scene while he is within a metre of them. Left
+;; out in the renderer only (jak_vr.cpp body and merc_hidden), not in his bones: his shadow keeps all of him, head and
+;; all (the owner's ask, 2026-11-12, as Ratchet's).
+
+(define *vr-head-hidden* #f)    ;; first person this frame
+(define *vr-stereo* #f)         ;; the eyes see the game in stereo this frame: no letterbox (main.gc)
+(defun vr-daxter ()
+  "Daxter: Jak's sidekick process (no game sets *sidekick*), #f without one."
+  (let ((p (if (and *target* (-> *target* sidekick)) (ppointer->process (-> *target* sidekick)) #f)))
+    ;; a sidekick still: the link can outlive him, its process slot dead or another's (sim j2_glow1, a new game)
+    (if (and p (type? p sidekick)) (the-as sidekick p) (the-as sidekick #f))))
+
+(defun vr-eyes<-neck! ((out vector) (csp cspace) (fwd vector))
+  "The eyes' place from Jak's neck joint: a little above it and ahead along his facing fwd (any length, flattened), so a
+   cutscene's eyes look out of his face, not from inside his neck. The world's up and his body's facing, not the neck's
+   own axes: a scene's high-res Jak turns his neck bone every way (sim, 2026-11-12)."
+  (vector<-cspace! out csp)
+  (when (!= (-> out w) 0.0)
+    (+! (-> out y) (meters 0.1))
+    (let ((len (sqrtf (+ (* (-> fwd x) (-> fwd x)) (* (-> fwd z) (-> fwd z))))))
+      (when (< 0.0 len)
+        (+! (-> out x) (* (-> fwd x) (/ (meters 0.08) len)))
+        (+! (-> out z) (* (-> fwd z) (/ (meters 0.08) len))))))
+  out)
+
+(defun vr-near-eyes? ((pd process-drawable))
+  "pd (where it is drawn: Daxter's root stays put, his joints hang off Jak's shoulder) within a metre of the view."
+  (if (and pd (nonzero? (-> pd draw))
+           (< (vector-vector-distance (-> pd draw origin) (-> *math-camera* trans)) (meters 1.0)))
+      #t
+      #f))
+
+(defun vr-before-joints ()
+  "Called just before the frame's joint math (main.gc). Nothing now: the body is posed after it (vr-body-update!)."
+  (none))
+
+;; ---- The cutscene's own Jak and Daxter (Jak II and 3) ----
+;; Their scenes act with high-res models (skel-jak-highres and the like), not Jak himself, who is hidden or elsewhere,
+;; so the cutscene eyes go in that model's head (its joint found by name), its head hidden as Jak's is in play, and the
+;; high-res Daxter likewise while he is within a metre of the eyes. Looked up each frame: the scene's actors change.
+
+(define *vr-scene-jak* (the-as process-drawable #f))  ;; this frame's
+(define *vr-scene-jak-head* -1)
+
+(defun vr-prefix? ((s string) (p string))
+  "Does s start with p? (no game has a runtime string-prefix test)"
+  (let ((n (length p)))
+    (if (< (length s) n)
+        (return #f))
+    (dotimes (i n)
+      (if (!= (-> s data i) (-> p data i))
+          (return #f))))
+  #t)
+
+(defun vr-jak-art? ((name string))
+  "A Jak model's art: skel-jak-highres, skel-jakc-highres, skel-jakc-feet (barefoot, Jak 3's palace), skel-darkjak-...,
+   and the like. Accessory models (a scarf) have no neck, which vr-scene-actor also asks for."
+  (if (or (vr-prefix? name "skel-jak") (vr-prefix? name "skel-darkjak") (vr-prefix? name "skel-lightjak"))
+      #t
+      #f))
+
+(defun vr-joint-named ((pd process-drawable) (name string))
+  "The index of pd's joint called name, -1 without one."
+  (let ((nl (-> pd node-list)))
+    (when (nonzero? nl)
+      (dotimes (i (-> nl length))
+        (let ((j (-> nl data i joint)))
+          (if (and j (string= (the-as string (-> j name)) name)) (return i))))))
+  -1)
+
+(defun vr-scene-actor ((jak? symbol))
+  "The playing scene's Jak (jak? #t: a Jak model with a neck) or Daxter (#f: skel-sidekick-...), a drawn one first;
+   #f without one."
+  (let ((sp (the-as scene-player (ppointer->process *scene-player*)))
+        (found (the-as process-drawable #f)))
+    (when (and sp (-> sp scene) (-> sp scene actor))
+      (let ((actors (-> sp scene actor)))
+        (dotimes (i (-> actors length))
+          (let ((art (-> actors i art-group))
+                ;; a scene actor not yet spawned has handle 0, not #f: handle->process would read address 0 (the Jak II
+                ;; opening crashed as the rift scene began, crash dump 2026-11-13)
+                (p (the-as process-drawable (let ((hnd (-> actors i process)))
+                                              (if (nonzero? hnd) (handle->process hnd))))))
+            (when (and art p
+                       (if jak?
+                           (and (vr-jak-art? art)
+                                (or (>= (vr-joint-named p "neckB") 0) (>= (vr-joint-named p "head") 0)))
+                           (vr-prefix? art "skel-sidekick")))
+              (if (not (logtest? (-> p draw status) (draw-control-status no-draw)))
+                  (return p))
+              (if (not found)
+                  (set! found p)))))))
+    found))
+
+(defun vr-scene-jak-head! ((info vr-camera-info))
+  "In a scene with its own Jak, the eyes' place from his head and his facing from his body (flag 128, and 64 while he
+   is drawn): the playable Jak's facing is not his (the view looked back over his shoulder, sim 2026-11-12)."
+  (set! *vr-scene-jak* (vr-scene-actor #t))
+  (set! *vr-scene-jak-head* -1)
+  (when *vr-scene-jak*
+    (let ((h (vr-joint-named *vr-scene-jak* "neckB"))
+          (body (vr-joint-named *vr-scene-jak* "main")))
+      (if (< h 0) (set! h (vr-joint-named *vr-scene-jak* "head")))
+      (if (< body 0) (set! body 3))
+      (when (>= h 0)
+        (set! *vr-scene-jak-head* h)
+        (logior! (-> info flags) 128) ;; the scene's own Jak: first person in every shot, however far the camera
+        ;; his body's ahead: the main joint's z row (its y row is up)
+        (let ((fwd (-> *vr-scene-jak* node-list data body bone transform vector 2)))
+          (vr-eyes<-neck! (-> info head) (-> *vr-scene-jak* node-list data h) fwd)
+          (if (or (!= (-> fwd x) 0.0) (!= (-> fwd z) 0.0))
+              (set! (-> info target-yaw) (* 0.00009587380 (atan (-> fwd x) (-> fwd z))))))
+        (set! (-> info target-trans quad) (-> *vr-scene-jak* root trans quad))
+        (if (logtest? (-> *vr-scene-jak* draw status) (draw-control-status no-draw))
+            (logclear! (-> info flags) 64)
+            (logior! (-> info flags) 64)))))
+  0)
+
+;; ---- Jak's body in first person (all three games alike) ----
+;; The runtime poses his bones once a frame after the joint math and the camera (pc-vr-body!, jak_vr.cpp body): his
+;; arms to the controllers, his fingers to the player's, the body under the head, his head turned as the player's (seen
+;; in the shadow). It also leaves his head, and Daxter at the eyes, out of the eyes. Here: what it needs to know of his
+;; skeleton, each frame.
+
+;; must match VrBodyInfo in game/vr/jak_vr.h
+(deftype vr-body-info (structure)
+  ((count    int32)
+   (flags    int32)       ;; 1 pose him, 2 his head out of the eyes, 4 Daxter out of the eyes
+   (key      uint32)      ;; the node list the named joints were found in
+   (pad      int32)
+   (named    int16 48)    ;; jak_vr.h BodyJoint: the named joints' nodes, -1 for none
+   (jak-name uint8 64)    ;; his merc model's name
+   (dax-name uint8 64)    ;; Daxter's
+   (parent   int8 128)    ;; each node's parent node
+   (bone     uint32 128)  ;; each node's bone
+   (bind     uint32 128)  ;; its joint's bind pose
+   ;; the hands against the world: lines the runtime asks about (pc-vr-hand-probes!), each a sphere moved from `from`
+   ;; to `to` (w its radius); `hit` xyz the normal of what it met, w how far along (0 to 1), -1 for nothing
+   (probe-count int32)
+   (probe-pad   int32 3)
+   (probe-from  vector 8 :inline)  ;; 8 (0.1.1): the palms, the fingers ahead, under the palms, the wrist straps
+   (probe-to    vector 8 :inline)
+   (probe-hit   vector 8 :inline)
+   ;; Jak II and 3's gun: its bones, carried with his hand (gun-util.gc vr-gun-fill!); flags 1 drawn, in hand
+   (gun-count   int32)
+   (gun-flags   int32)
+   (gun-barrel  int32)
+   (gun-pad     int32)     ;; the gun's own node count (the trace's, JAKVR_BODY_TRACE)
+   (gun-bone    uint32 64)  ;; 64: Jak 3's magazines are its joints 36 to 39 (0.1.1 item 10)
+   ;; the gun's root as its process placed it (its quat and trans), which the runtime carries the gun from
+   (gun-root    matrix :inline)
+   ;; Daxter on his shoulder in play: his bones, carried with Jak's posed chest (vr-dax-fill!)
+   (dax-count   int32)
+   (dax-pad     int32 3)
+   (dax-bone    uint32 64))
+  )
+
+(define *vr-body-info* (new 'static 'vr-body-info))
+
+(define-extern vr-gun-fill! (function vr-body-info int)) ;; gun-util.gc (after the gun's types)
+(define-extern vr-holster! (function int)) ;; gun-util.gc: the holsters draw and put away the gun
+
+;; the named joints in BodyJoint's order: neck, main, chest, gun, then a side each (16 apiece, the left first: shoulder
+;; to fingers, thigh and knee), the ankles, hips, upper_body
+(define *vr-body-names*
+  (new 'static 'boxed-array :type string
+       "neckB" "main" "chest" "gun"
+       "Lshould" "Larm" "Lforarm" "sk_lhand" "lthumA" "lthumB" "lindA" "lindB" "lmidA" "lmidB" "lringA" "lringB" "lpinkA" "lpinkB" "Lthigh" "Lknee"
+       "Rshould" "Rarm" "Rforarm" "sk_rhand" "rthumA" "rthumB" "rindA" "rindB" "rmidA" "rmidB" "rringA" "rringB" "rpinkA" "rpinkB" "Rthigh" "Rknee"
+       "Lankle" "Rankle" "hips" "upper_body"
+       ;; left out of the eyes, each on its own: the collar flaps by his jaw (Jak 1), Dark Jak's horns (Jak II and 3)
+       "collarL" "collarR" "horns" "" "" "" "" ""))
+
+(defun vr-body-fill! ((info vr-body-info) (pd process-drawable) (flags int))
+  "info from pd's skeleton: each node's bone, its joint's bind pose and parent; its named joints when it is new."
+  (let* ((nl (-> pd node-list))
+         (n (min 128 (-> nl length))))
+    (set! (-> info flags) flags)
+    (when (or (!= (-> info key) (the-as uint nl)) (!= (-> info count) n))
+      (set! (-> info key) (the-as uint nl))
+      (dotimes (k 48)
+        (set! (-> info named k) -1)
+        (when (< k (-> *vr-body-names* length))
+          (let ((name (-> *vr-body-names* k)))
+            (if (nonzero? (length name))
+                (set! (-> info named k) (vr-joint-named pd name))))))
+      (if (< (-> info named 0) 0)
+          (set! (-> info named 0) (vr-joint-named pd "head"))))
+    (set! (-> info count) n)
+    (dotimes (i n)
+      (let* ((csp (-> nl data i))
+             (j (-> csp joint)))
+        (set! (-> info bone i) (the-as uint (-> csp bone)))
+        (cond
+          (j
+           (set! (-> info bind i) (the-as uint (-> j bind-pose)))
+           (set! (-> info parent i) (if (-> j parent) (+ (-> j parent number) 1) -1)))
+          (else
+           (set! (-> info bind i) (the-as uint 0))
+           (set! (-> info parent i) -1))))))
+  (charp<-string (-> info jak-name) (-> pd draw mgeo name))
+  info)
+
+(defun vr-hand-probes! ((info vr-body-info))
+  "The lines the runtime asks about for the hands (pc-vr-hand-probes!), each probed as a sphere moved along it against
+   the level and solid objects: how far along it met something (0 to 1) and that thing's normal, -1 for nothing."
+  (let ((n (pc-vr-hand-probes! info))
+        (cq (new 'stack-no-clear 'collide-query)))
+    (dotimes (i n)
+      (let ((from (-> info probe-from i))
+            (hit (-> info probe-hit i))
+            (radius (-> info probe-to i w)))
+        (set! (-> hit w) -1.0)
+        (when (< 0.0 radius)
+          (set! (-> cq start-pos quad) (-> from quad))
+          (vector-! (-> cq move-dist) (-> info probe-to i) from)
+          (set! (-> cq radius) radius)
+          (set! (-> cq collide-with) (collide-spec backgnd obstacle))
+          (set! (-> cq ignore-process0) *target*)
+          (set! (-> cq ignore-process1) #f)
+          (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1))
+          (set! (-> cq action-mask) (collide-action solid))
+          (let ((u (fill-and-probe-using-line-sphere *collide-cache* cq)))
+            (when (>= u 0.0)
+              (set! (-> hit quad) (-> cq best-other-tri normal quad))
+              (set! (-> hit w) u)))))))
+  0)
+
+(defun vr-dax-fill! ((info vr-body-info))
+  "Daxter's bones on Jak's shoulder in play, which the runtime carries with Jak's posed chest (jak_vr.cpp body): his
+   animation sits him on the animated shoulder, which the pose moves under the head."
+  (let ((dax (the-as process-drawable (vr-daxter))))
+    (when (and dax (nonzero? (-> dax node-list)) (nonzero? (-> dax draw)))
+      (let ((n (min 64 (-> dax node-list length))))
+        (dotimes (i n)
+          (set! (-> info dax-bone i) (the-as uint (-> dax node-list data i bone))))
+        (set! (-> info dax-count) n))))
+  0)
+
+;; what vr-graphics! last set: 0 nothing, 1 Max draw distance, 2 PS2 detail
+(define *vr-graphics-set* 0)
+(define *vr-clock-trace-count* 0)
+
+(defun vr-graphics! ()
+  "While VR draws, the game's own graphics settings follow the VR menu's Max draw distance (on to start; the owner,
+   2026-11-13: no pop-in in any of the games, as Ratchet's): every actor born and drawn however far (the PC port's
+   actor culling off; Jak II and 3 also past each actor's own vis-dist, entity.gc), each model, the level and the sea at
+   their highest detail with no distance cut, every effect launched in full however far (as at the camera), shadows
+   and reflections at any distance. Off, the game's own settings as the player set them."
+  (let* ((g (pc-vr-graphics))
+         (fps (logand (ash g -8) 255))
+         (s *pc-settings*))
+    ;; 0.1.1: the game's frames a second follow the VR menu's Game frame rate (jak_vr.cpp s_game_fps: 60, the headset's
+    ;; rate or half of it; half with Smoother frames). The runtime lets the game go that often and the clocks step by
+    ;; it; the player's own choice is kept for the settings file (pckernel-common.gc *vr-user-fps*).
+    (when (and (> fps 0) (!= fps (-> s target-fps)))
+      (if (< *vr-user-fps* 0) (set! *vr-user-fps* (the-as int (-> s target-fps))))
+      (set-frame-rate! s fps #f))
+    ;; PC test aid (JAKVR_CLOCK_TRACE=1, pc-vr-test-flags bit 16): the game's clocks once every 60 of its frames
+    (when (logtest? (pc-vr-test-flags) 16)
+      (+! *vr-clock-trace-count* 1)
+      (when (= (mod *vr-clock-trace-count* 60) 0)
+        (format 0 "[vr] clock: game frames ~D, fps ~D, video ~A, time-factor ~f"
+                *vr-clock-trace-count* (the-as int (-> s target-fps)) (get-video-mode) (-> *display* time-factor))
+        (format 0 ", dog ~f, base ~D, real ~D~%"
+                (-> *display* dog-ratio) (-> *display* base-clock frame-counter) (-> *display* real-clock frame-counter))))
+    (cond
+      ((logtest? g 2)
+       ;; PS2 detail (0.1.1, off to start; over Max draw distance): far things, effects and shadows as the PS2 drew them
+       (set! (-> s ps2-actor-vis?) #t)
+   (set! (-> s use-vis?) #f) ;; the PS2's own 4:3 picture off (its fixed field would override the eyes' own)
+       (set! (-> s ps2-lod-dist?) #t)
+       (set! (-> s ps2-parts?) #t)
+       (set! (-> s ps2-shadow?) #t)
+       (set! (-> s force-envmap?) #f)
+       (set! *vr-graphics-set* 2))
+      ((logtest? g 1)
+       (set! (-> s ps2-actor-vis?) #f)
+   (set! (-> s use-vis?) #f) ;; the PS2's own 4:3 picture off (its fixed field would override the eyes' own)
+       (set! (-> s ps2-lod-dist?) #f)
+       (set! (-> s ps2-parts?) #f)
+       (set! (-> s ps2-shadow?) #f)
