+namespace {
+int pose_other_apply(int player, const void* info_ptr, const float* trans, const float* quat, std::uint8_t* memory) {
+  if (!info_ptr || !trans || !quat || !memory) {
+    return 0;
+  }
+  std::vector<std::uint8_t> word;
+  {
+    std::lock_guard<std::mutex> lock(s_pose_mutex);
+    const auto it = s_pose_heard.find(player);
+    if (it == s_pose_heard.end() || std::chrono::steady_clock::now() - it->second.when > kPoseFresh) {
+      return 0;
+    }
+    word = it->second.word;
+  }
+  if (word.size() < 4 || word[0] != 'J' || word[1] != 'V' || word[2] < 1 ||
+      word.size() < 4 + static_cast<std::size_t>(word[3]) * kPoseEntry) {
+    return 0;
+  }
+  VrBodyInfo& info = s_pose_info;
+  std::memcpy(&info, info_ptr, sizeof info);
+  info.count = std::clamp(info.count, 0, kBodyNodesMost);
+  if (info.count == 0) {
+    return 0;
+  }
+  // Each of his nodes the word places, and where (in his root's frame).
+  int joint_of[kBodyNodesMost];
+  Mat rel[kJointHideFirst];
+  std::fill(std::begin(joint_of), std::end(joint_of), -1);
+  for (int e = 0; e < word[3]; ++e) {
+    const std::uint8_t* p = word.data() + 4 + e * kPoseEntry;
+    const int k = p[0];
+    if (k >= kJointHideFirst) {
+      continue;
+    }
+    const int node = info.named[k];
+    if (node < 0 || node >= info.count) {
+      continue;
+    }
+    float q[4];
+    for (int c = 0; c < 4; ++c) {
+      q[c] = get_i16(p + 1 + 2 * c) / 32767.0f;
+    }
+    const float len = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+    if (len < 0.5f) {
+      continue;
+    }
+    for (float& c : q) {
+      c /= len;
+    }
+    const float place[3] = {get_i16(p + 9) * 2.0f, get_i16(p + 11) * 2.0f, get_i16(p + 13) * 2.0f};
+    rel[k] = pose_root(place, q);
+    joint_of[node] = k;
+  }
+  // Parents before children: his nodes by how many joints they hang under.
+  int depth[kBodyNodesMost];
+  int order[kBodyNodesMost];
+  for (int i = 0; i < info.count; ++i) {
+    int d = 0;
+    for (int a = info.parent[i]; a >= 0 && a < info.count && d < kBodyNodesMost; a = info.parent[a]) {
+      ++d;
+    }
+    depth[i] = d;
+    order[i] = i;
+  }
+  std::stable_sort(order, order + info.count, [&](int a, int b) { return depth[a] < depth[b]; });
+  const Mat root = pose_root(trans, quat);
+  bool have[kBodyNodesMost] = {};
+  bool moved[kBodyNodesMost] = {};
+  for (int i = 0; i < info.count; ++i) {
+    have[i] = bone_ok(info.bone[i]);
+    if (have[i]) {
+      std::memcpy(&s_pose_old[i], memory + info.bone[i], sizeof(Mat));
+      make_affine(s_pose_old[i]);  // as body() does (mat_corner_off)
+    }
+  }
+  for (int o = 0; o < info.count; ++o) {
+    const int i = order[o];
+    if (!have[i]) {
+      continue;
+    }
+    const int parent = info.parent[i];
+    if (joint_of[i] >= 0) {
+      Mat m = mat_mul(rel[joint_of[i]], root);
+      for (int r = 0; r < 3; ++r) {  // his skeleton's own scale on each axis
+        const float s = quest::length(Vec3{s_pose_old[i].m[r][0], s_pose_old[i].m[r][1], s_pose_old[i].m[r][2]});
+        for (int c = 0; c < 3; ++c) {
+          m.m[r][c] *= s;
+        }
+      }
+      s_pose_new[i] = m;
+      moved[i] = true;
+    } else if (parent >= 0 && parent < info.count && moved[parent]) {
+      s_pose_new[i] = mat_mul(mat_mul(s_pose_old[i], mat_inverse(s_pose_old[parent])), s_pose_new[parent]);
+      moved[i] = true;
+    }
+  }
+  for (int i = 0; i < info.count; ++i) {
+    if (moved[i]) {
+      make_affine(s_pose_new[i]);
+      std::memcpy(memory + info.bone[i], &s_pose_new[i], sizeof(Mat));
+    } else if (have[i]) {
+      std::memcpy(memory + info.bone[i], &s_pose_old[i], sizeof(Mat));  // made affine
+    }
+  }
+  return 1;
+}
