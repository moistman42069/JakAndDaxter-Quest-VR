+// 2 (2026-11-14): "to"/"from" between two players (a save sent), "remove" and "removed", "where" and "cells" in a
+// listing. Every game of a party is the same build anyway; the party server checks it.
+constexpr int kProto = 2;
+constexpr const char* kGameName = "jak1";
+constexpr std::size_t kSaveChunk = 36 * 1024;  // bytes of a save a line (base64 under kMaxLine)
+constexpr std::size_t kSaveMost = 512 * 1024;  // a save sent no bigger than this
+constexpr auto kTick = std::chrono::milliseconds(33);   // a player moving is sent about 30 times a second
+constexpr auto kHeartbeat = std::chrono::seconds(1);    // and standing still, once a second (and so newcomers see him)
+constexpr auto kBeaconEvery = std::chrono::seconds(1);
+constexpr auto kBeaconLasts = std::chrono::seconds(6);  // a game not heard of this long is gone from the list
+constexpr auto kListEvery = std::chrono::seconds(3);    // the server's list asked again (and the link kept alive)
+constexpr auto kRetryServer = std::chrono::seconds(5);
+constexpr auto kIdle = std::chrono::seconds(60);        // a member heard nothing from this long is dropped
+constexpr auto kLinger = std::chrono::seconds(3);
+constexpr std::size_t kMaxLine = 64 * 1024;
+constexpr std::size_t kMaxQueued = 1024;  // lines waiting to go out on one link; more and the link is too slow
+constexpr std::size_t kMaxHistory = 8000;
+const char* const kInterKeys[] = {"interType", "interAmount", "interStatus", "interName", "interParent", "interLevel"};
+
+// Teamruns' interaction-type values (mod-settings-h.gc) whose level things another's game took are taken again here
+// when this game loads that level: orbs, enemies, flies, crates, periscopes, snow bumpers, dark crystals.
+bool replayed(int type) {
+  return type == 5 || type == 7 || type == 8 || type == 9 || type == 11 || type == 12 || type == 13;
+}
+
+// Printable ASCII only (the Jak 1 font), at most this long.
+std::string clean(const std::string& text, std::size_t most = 24) {
+  std::string out;
+  for (char c : text) {
+    if (out.size() >= most) {
+      break;
+    }
+    out += (c >= 0x20 && c < 0x7f) ? c : '?';
+  }
+  return out;
+}
+
+// Jak 1's levels as the game names them: by their level-info index (a save's level-index, level-info.gc), and by
+// their own names (a Teamruns update's currentLevel).
+const char* const kLevelNames[][2] = {
+    {"training", "Geyser Rock"},           {"village1", "Sandover Village"},  {"beach", "Sentinel Beach"},
+    {"jungle", "Forbidden Jungle"},        {"jungleb", "Forbidden Jungle"},   {"misty", "Misty Island"},
+    {"firecanyon", "Fire Canyon"},         {"village2", "Rock Village"},      {"sunken", "Lost Precursor City"},
+    {"sunkenb", "Lost Precursor City"},    {"swamp", "Boggy Swamp"},          {"rolling", "Precursor Basin"},
+    {"ogre", "Mountain Pass"},             {"village3", "Volcanic Crater"},   {"snow", "Snowy Mountain"},
+    {"maincave", "Spider Cave"},           {"darkcave", "Spider Cave"},       {"robocave", "Spider Cave"},
+    {"lavatube", "Lava Tube"},             {"citadel", "Gol and Maia's Citadel"},
+    {"finalboss", "Gol and Maia's Citadel"}};
+
+std::string level_name(const std::string& level) {
+  for (const auto& l : kLevelNames) {
+    if (level == l[0]) {
+      return l[1];
+    }
+  }
+  return "";
+}
+
+std::string level_name(int index) {  // level-info's :index, 1 Geyser Rock
+  const int n = static_cast<int>(sizeof(kLevelNames) / sizeof(kLevelNames[0]));
+  return index >= 1 && index <= n ? kLevelNames[index - 1][1] : "";
+}
+
+const char kBase64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+std::string base64_encode(const std::uint8_t* in, std::size_t size) {
+  std::string out;
+  out.reserve((size + 2) / 3 * 4);
+  for (std::size_t i = 0; i < size; i += 3) {
+    const std::uint32_t n = (in[i] << 16) | (i + 1 < size ? in[i + 1] << 8 : 0) | (i + 2 < size ? in[i + 2] : 0);
+    out.push_back(kBase64[(n >> 18) & 63]);
+    out.push_back(kBase64[(n >> 12) & 63]);
+    out.push_back(i + 1 < size ? kBase64[(n >> 6) & 63] : '=');
+    out.push_back(i + 2 < size ? kBase64[n & 63] : '=');
+  }
+  return out;
+}
+
+void base64_append(const std::string& in, std::vector<std::uint8_t>& out) {
+  std::uint32_t n = 0;
+  int bits = 0;
+  for (const char c : in) {
+    const char* at = c ? std::strchr(kBase64, c) : nullptr;
+    if (!at) {
+      continue;
+    }
+    n = (n << 6) | static_cast<std::uint32_t>(at - kBase64);
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out.push_back(static_cast<std::uint8_t>((n >> bits) & 0xff));
+    }
+  }
+}
+
+// party.txt, beside vr-options.txt (the launcher writes it): "name <player name>", "server <address[:port]>",
+// "build <release>".
+struct Config {
+  std::string name = "Player";
+  std::string server;  // empty: the local network only
+  int server_port = kPort;
+  std::string build;
+};
+
+Config read_config() {
+  Config c;
+  const auto path = file_util::get_user_settings_dir(GameVersion::Jak1) / "party.txt";
+  std::ifstream in(path.string());
+  std::string line;
+  while (std::getline(in, line)) {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) {
+      line.pop_back();
+    }
+    const auto space = line.find(' ');
+    if (line.empty() || line[0] == '#' || space == std::string::npos) {
+      continue;
+    }
+    const std::string key = line.substr(0, space);
+    std::string value = line.substr(line.find_first_not_of(' ', space));
+    if (key == "name" && !value.empty()) {
+      c.name = clean(value);
+    } else if (key == "server") {
+      const auto colon = value.rfind(':');
+      if (colon != std::string::npos && value.find(':') == colon) {  // "address:port" (one colon: not IPv6)
+        try {
+          c.server_port = std::stoi(value.substr(colon + 1));
+        } catch (...) {
+          c.server_port = kPort;
+        }
+        value = value.substr(0, colon);
+      }
+      c.server = value;
+    } else if (key == "build") {
+      c.build = clean(value, 32);
+    }
+  }
+  return c;
+}
+
+enum class Mode { kNone, kStartingHost, kJoining, kHostLan, kHostServer, kMemberLan, kMemberServer };
+
+bool partying(Mode m) {
+  return m == Mode::kHostLan || m == Mode::kHostServer || m == Mode::kMemberLan || m == Mode::kMemberServer;
+}
+
+struct Event {
+  // kFrom: one player's message to this one alone (a save asked for or sent), in data
+  enum class Kind { kJoined, kState, kLeft, kClosed, kFrom } kind;
+  int index = 0;
+  std::string name;
+  json data;
+};
+
+// One TCP link of newline-delimited JSON: to a party server or a LAN host, or (hosting) from a member.
+class Conn : public std::enable_shared_from_this<Conn> {
+ public:
+  using OnLine = std::function<void(const std::shared_ptr<Conn>&, const json&)>;
+  using OnDown = std::function<void(const std::shared_ptr<Conn>&)>;
+
+  explicit Conn(tcp::socket socket) : socket_(std::move(socket)) {}
+
+  void start(OnLine on_line, OnDown on_down) {
+    on_line_ = std::move(on_line);
+    on_down_ = std::move(on_down);
+    asio::error_code ec;
+    socket_.set_option(tcp::no_delay(true), ec);
+    read();
+  }
+  void send(const json& j) {
+    if (closed_) {
+      return;
+    }
+    if (out_.size() >= kMaxQueued) {
+      close();
+      return;
+    }
+    out_.push_back(j.dump() + "\n");
+    if (out_.size() == 1) {
+      write();
+    }
+  }
+  // Closes once what is queued has gone.
+  void finish() {
+    finishing_ = true;
+    if (out_.empty()) {
+      close();
+    }
+  }
+  void close() {
+    if (closed_) {
+      return;
+    }
+    closed_ = true;
+    asio::error_code ec;
+    socket_.shutdown(tcp::socket::shutdown_both, ec);
+    socket_.close(ec);
+    if (on_down_) {
+      auto down = std::move(on_down_);
+      on_down_ = nullptr;
+      on_line_ = nullptr;
+      down(shared_from_this());
+    }
+  }
+  bool closed() const { return closed_; }
+
+  Clock::time_point heard = Clock::now();
+  // a host's bookkeeping of its members
+  std::string name = "Player", game, build;
+  int index = -1;
+
+ private:
+  void read() {
+    auto self = shared_from_this();
+    asio::async_read_until(socket_, buf_, '\n', [this, self](const asio::error_code& ec, std::size_t n) {
+      if (ec) {
+        close();
+        return;
+      }
+      const auto data = buf_.data();
+      std::string line(asio::buffers_begin(data), asio::buffers_begin(data) + static_cast<std::ptrdiff_t>(n));
+      buf_.consume(n);
+      heard = Clock::now();
+      json j = json::parse(line, nullptr, false);
+      if (j.is_object() && on_line_) {
+        try {
+          on_line_(self, j);
+        } catch (const std::exception& e) {
+          lg::warn("party: a bad message: {}", e.what());
+        }
+      }
+      if (!closed_) {
+        read();
+      }
+    });
+  }
+  void write() {
+    auto self = shared_from_this();
+    asio::async_write(socket_, asio::buffer(out_.front()), [this, self](const asio::error_code& ec, std::size_t) {
+      if (ec) {
+        close();
+        return;
+      }
+      out_.pop_front();
+      if (closed_) {
+        return;
+      }
+      if (!out_.empty()) {
+        write();
+      } else if (finishing_) {
+        close();
+      }
+    });
+  }
+
+  tcp::socket socket_;
+  asio::streambuf buf_{kMaxLine};
+  std::deque<std::string> out_;
+  OnLine on_line_;
+  OnDown on_down_;
+  bool closed_ = false, finishing_ = false;
+};
+
+class Session : public std::enable_shared_from_this<Session> {
+ public:
+  explicit Session(Config cfg)
+      : cfg_(std::move(cfg)), work_(asio::make_work_guard(io_)), timer_(io_), beacon_in_(io_), beacon_out_(io_) {
+    build_ = std::string("jakvr ") + (cfg_.build.empty() ? "dev" : cfg_.build) + " " + build_revision();
+    std::random_device rd;
+    id_ = rd() & 0x7fffffff;
+  }
+
+  void start() {
+    auto self = shared_from_this();
+    asio::post(io_, [self] { self->begin(); });
+    std::thread([self] {
+      try {
+        self->io_.run();
+      } catch (const std::exception& e) {
+        lg::error("party: its thread stopped: {}", e.what());
+      }
+    }).detach();
+  }
+  // Leaves the party (a moment for the goodbyes to go out), then the thread ends.
+  void stop() {
+    auto self = shared_from_this();
+    asio::post(io_, [self] {
+      self->leave_now();
+      self->stopping_ = true;
+      auto wait = std::make_shared<asio::steady_timer>(self->io_, std::chrono::milliseconds(300));
+      wait->async_wait([self, wait](const asio::error_code&) {
+        // every wait ends (cancelled) and none starts again, so the thread's run() returns and the Session goes
+        self->close_all();
+        self->work_.reset();
+      });
+    });
+  }
+  void host() {
+    auto self = shared_from_this();
+    asio::post(io_, [self] { self->host_now(); });
+  }
+  void join(const Game& g) {
+    auto self = shared_from_this();
+    asio::post(io_, [self, g] { self->join_now(g); });
+  }
+  void leave() {
+    auto self = shared_from_this();
+    asio::post(io_, [self] { self->leave_now(); });
+  }
+  void send(const json& data) {
+    auto self = shared_from_this();
+    asio::post(io_, [self, data] { self->send_now(data); });
+  }
+  // The menu's list shown: from now on hear the local network's games and ask the party server.
+  void browse() {
+    if (browse_asked_.exchange(true)) {
+      return;  // asked every frame the menu's list is shown: once is enough
+    }
+    auto self = shared_from_this();
+    asio::post(io_, [self] { self->open_listening(); });
+  }
+  // To one player of the party alone (0 the host): {"op": "from", "from": this player, "data": data} reaches it.
+  void send_to(int index, const json& data) {
+    auto self = shared_from_this();
+    asio::post(io_, [self, index, data] { self->send_to_now(index, data); });
+  }
+  void remove(int index) {
+    auto self = shared_from_this();
+    asio::post(io_, [self, index] { self->remove_now(index); });
+  }
+  const Config& config() const { return cfg_; }
+
+  // Between the threads, under mu.
+  std::mutex mu;
+  Mode mode = Mode::kNone;
+  std::string note;  // what last went wrong, for the menu
+  std::deque<Event> inbox;
+  std::map<std::string, std::pair<Game, Clock::time_point>> lan_games;
+  std::vector<Game> server_games;
+  json pending;  // the latest position-only update not sent yet
+  std::map<int, std::string> names;  // the others in the party, by index
+  int my_index = -1;                 // this player's in the party
+  std::string where;                 // this game's level and power cells, for its listing when it hosts
+  int cells = -1;
+
+ private:
+  // ---- the network's thread from here ----
+  void set_mode(Mode m, const std::string& why = "") {
+    std::lock_guard<std::mutex> lock(mu);
+    mode = m;
+    if (!why.empty() || m != Mode::kNone) {
+      note = why;
+    }
+  }
+  Mode get_mode() {
+    std::lock_guard<std::mutex> lock(mu);
+    return mode;
+  }
+  void push(Event e) {
+    std::lock_guard<std::mutex> lock(mu);
+    if (e.kind == Event::Kind::kState && !e.name.empty()) {
+      names[e.index] = e.name;
+    } else if (e.kind == Event::Kind::kLeft) {
+      names.erase(e.index);
+    } else if (e.kind == Event::Kind::kClosed) {
+      names.clear();
+      my_index = -1;
+    } else if (e.kind == Event::Kind::kJoined) {
+      names.clear();
+      my_index = e.index;
+    }
+    inbox.push_back(std::move(e));
+  }
+  json where_now() {
+    std::lock_guard<std::mutex> lock(mu);
+    return {{"where", where}, {"cells", cells}};
+  }
+  json hello() const {
+    return {{"op", "hello"}, {"proto", kProto}, {"name", cfg_.name}, {"game", kGameName}, {"build", build_}};
+  }
+  std::string title() const { return cfg_.name + "'s game"; }
+
+  // Multiplayer on opens nothing (on to start, it must not ask the firewall about gk at every start): the network is
+  // opened when the player first browses, hosts or joins (open_listening).
+  void begin() {
+    tick();
+    lg::info("party: on as {} ({}){}", cfg_.name, build_,
+             cfg_.server.empty() ? "" : ", party server " + cfg_.server + ":" + std::to_string(cfg_.server_port));
+  }
+
+  void open_listening() {
+    if (listening_ || stopping_) {
+      return;
+    }
+    listening_ = true;
+    asio::error_code ec;
+    beacon_in_.open(udp::v4(), ec);
+    if (!ec) {
+      beacon_in_.set_option(asio::socket_base::reuse_address(true), ec);
+    }
+    if (!ec) {
+      beacon_in_.bind(udp::endpoint(udp::v4(), static_cast<unsigned short>(kBeaconPort)), ec);
+    }
+    if (ec) {
+      lg::warn("party: games on the local network cannot be heard (UDP {}): {}", kBeaconPort, ec.message());
+    } else {
+      hear_beacons();
+    }
+    if (!cfg_.server.empty()) {
+      connect_server();
+    }
+    lg::info("party: looking for games");
+  }
+
+  // ---- games on the local network ----
+  void hear_beacons() {
+    auto self = shared_from_this();
+    beacon_in_.async_receive_from(asio::buffer(beacon_buf_), beacon_from_, [this, self](const asio::error_code& ec,
+                                                                                         std::size_t n) {
+      if (ec) {
+        if (ec != asio::error::operation_aborted && !stopping_) {
+          hear_beacons();
+        }
+        return;
+      }
+      try {
+        json b = json::parse(beacon_buf_.data(), beacon_buf_.data() + n, nullptr, false);
+        if (b.is_object() && b.value("jakvr", 0) == 1 && b.value("game", "") == kGameName &&
+            b.value("id", 0u) != id_) {
+          Game g;
+          g.lan = true;
+          g.address = beacon_from_.address().to_string();
+          g.party = b.value("party", 1);
+          g.players = b.value("players", 1);
+          g.host = clean(b.value("host", "Player"));
+          g.same_build = b.value("build", "") == build_;
+          g.where = clean(b.value("where", ""), 32);
+          g.cells = b.value("cells", -1);
+          g.label = label(g, false);
+          std::lock_guard<std::mutex> lock(mu);
+          lan_games[std::to_string(b.value("id", 0u)) + "#" + std::to_string(g.party)] = {g, Clock::now()};
+        }
+      } catch (...) {
+      }
+      hear_beacons();
+    });
+  }
+  // A game as the menu lists it: "Ann's game: Sentinel Beach, 23 cells, 2 players".
+  static std::string label(const Game& g, bool online) {
+    if (!g.same_build) {
+      return g.host + "'s game (other version)";
+    }
+    std::string s = g.host + "'s game";
+    if (!g.where.empty()) {
+      s += ": " + g.where;
+      if (g.cells >= 0) {
+        s += ", " + std::to_string(g.cells) + (g.cells == 1 ? " cell" : " cells");
+      }
+    }
+    s += ", " + std::to_string(g.players) + (g.players == 1 ? " player" : " players");
+    return online ? s + " (online)" : s;
+  }
+
+  void beacon() {
+    const json w = where_now();
+    json b = {{"jakvr", 1},       {"id", id_},          {"game", kGameName},
+              {"build", build_},  {"title", title()},   {"host", cfg_.name},
+              {"party", 1},       {"players", static_cast<int>(members_.size()) + 1},
+              {"where", w["where"]}, {"cells", w["cells"]}};
+    const std::string text = b.dump();
+    asio::error_code ec;
+    beacon_out_.send_to(asio::buffer(text), udp::endpoint(asio::ip::address_v4::broadcast(),
+                                                          static_cast<unsigned short>(kBeaconPort)), 0, ec);
+    // and to this machine, which a broadcast may not reach (two games on one PC)
+    beacon_out_.send_to(asio::buffer(text), udp::endpoint(asio::ip::address_v4::loopback(),
+                                                          static_cast<unsigned short>(kBeaconPort)), 0, ec);
+  }
+
+  // ---- links out: the party server, a LAN host ----
+  void connect_server() {
+    server_connecting_ = true;
+    last_server_try_ = Clock::now();
+    auto self = shared_from_this();
+    auto resolver = std::make_shared<tcp::resolver>(io_);
+    resolver->async_resolve(cfg_.server, std::to_string(cfg_.server_port), [this, self, resolver](
+                                                                                const asio::error_code& ec,
+                                                                                tcp::resolver::results_type found) {
+      if (ec || stopping_) {
+        server_connecting_ = false;
+        return;
+      }
+      auto socket = std::make_shared<tcp::socket>(io_);
+      asio::async_connect(*socket, found, [this, self, socket](const asio::error_code& ec2, const tcp::endpoint&) {
+        server_connecting_ = false;
+        if (ec2 || stopping_) {
+          return;
+        }
+        server_ = std::make_shared<Conn>(std::move(*socket));
+        server_hello_ = false;
+        server_->start([this, self](const std::shared_ptr<Conn>& c, const json& j) { on_link(c, j, false); },
+                       [this, self](const std::shared_ptr<Conn>& c) { on_link_down(c, false); });
+        server_->send(hello());
+        lg::info("party: connected to the party server {}", cfg_.server);
+      });
+    });
+  }
+
+  void connect_lan(const Game& g) {
+    auto self = shared_from_this();
+    asio::error_code ec;
+    const auto address = asio::ip::make_address(g.address, ec);
+    if (ec) {
+      set_mode(Mode::kNone, "Cannot reach " + g.host + "'s game");
+      return;
+    }
+    auto socket = std::make_shared<tcp::socket>(io_);
+    const std::string host = g.host;
+    socket->async_connect(tcp::endpoint(address, static_cast<unsigned short>(kPort)),
+                          [this, self, socket, host](const asio::error_code& ec2) {
+                            if (stopping_ || get_mode() != Mode::kJoining || !joining_lan_) {
+                              return;
+                            }
+                            if (ec2) {
+                              set_mode(Mode::kNone, "Cannot reach " + host + "'s game");
+                              return;
+                            }
+                            lan_link_ = std::make_shared<Conn>(std::move(*socket));
+                            lan_link_->start(
+                                [this, self](const std::shared_ptr<Conn>& c, const json& j) { on_link(c, j, true); },
+                                [this, self](const std::shared_ptr<Conn>& c) { on_link_down(c, true); });
+                            lan_link_->send(hello());
+                          });
+  }
+
+  void on_link(const std::shared_ptr<Conn>& c, const json& j, bool lan) {
+    const std::string op = j.value("op", "");
+    if (op == "hello") {
+      if (lan) {
+        c->send({{"op", "join"}, {"party", join_party_}});
+      } else {
+        server_hello_ = true;
+        c->send({{"op", "list"}});
+        try_host();
+      }
+    } else if (op == "from") {
+      const int from = j.value("from", -1);
+      if (partying(get_mode()) && from >= 0 && from < kMaxPlayers && j.contains("data") && j["data"].is_object()) {
+        push({Event::Kind::kFrom, from, "", j["data"]});
+      }
+    } else if (op == "removed") {
+      if (partying(get_mode())) {
+        set_mode(Mode::kNone, "The host took you out of the game.");
+        push({Event::Kind::kClosed, 0, "", {}});
+        lg::info("party: the host took this game out of the party");
+      }
+      if (lan) {
+        drop_lan_link();
+      }
+    } else if (op == "games") {
+      if (lan || !j.contains("games") || !j["games"].is_array()) {
+        return;
+      }
+      std::vector<Game> list;
+      for (const auto& s : j["games"]) {
+        if (!s.is_object()) {
+          continue;
+        }
+        Game g;
+        g.party = s.value("id", 0);
+        g.host = clean(s.value("host", "Player"));
+        g.players = s.value("players", 0);
+        g.same_build = s.value("build", "") == build_;
+        g.where = s.contains("where") && s["where"].is_string() ? clean(s["where"].get<std::string>(), 32) : "";
+        g.cells = s.contains("cells") && s["cells"].is_number_integer() ? s["cells"].get<int>() : -1;
+        g.label = label(g, true);
+        list.push_back(g);
+      }
+      std::lock_guard<std::mutex> lock(mu);
+      server_games = std::move(list);
+    } else if (op == "joined") {
+      const int index = j.value("index", -1);
+      const Mode was = get_mode();
+      if (index < 0 || index >= kMaxPlayers || (was != Mode::kJoining && was != Mode::kStartingHost)) {
+        return;
+      }
+      set_mode(index == 0 ? Mode::kHostServer : (lan ? Mode::kMemberLan : Mode::kMemberServer));
+      push({Event::Kind::kJoined, index, cfg_.name, {}});
+      lg::info("party: in a game as player {}", index);
+    } else if (op == "error") {
+      const std::string why = clean(j.value("why", "The game said no."), 80);
+      const Mode was = get_mode();
+      if (was == Mode::kJoining || was == Mode::kStartingHost) {
+        set_mode(Mode::kNone, why);
+      } else {
+        std::lock_guard<std::mutex> lock(mu);
+        note = why;
+      }
+      lg::warn("party: {}", why);
+      if (lan) {
+        drop_lan_link();
+      }
+    } else if (op == "state") {
+      if (!partying(get_mode())) {
+        return;
+      }
+      const int from = j.value("from", -1);
+      if (from < 0 || from >= kMaxPlayers || !j.contains("data") || !j["data"].is_object()) {
+        return;
+      }
+      push({Event::Kind::kState, from, clean(j.value("name", "Player")), j["data"]});
+    } else if (op == "left") {
+      const int from = j.value("from", -1);
+      if (from >= 0 && from < kMaxPlayers) {
+        push({Event::Kind::kLeft, from, "", {}});
+      }
+    } else if (op == "closed") {
+      if (partying(get_mode())) {
+        set_mode(Mode::kNone, "The host left, so the game ended.");
+        push({Event::Kind::kClosed, 0, "", {}});
+      }
+      if (lan) {
+        drop_lan_link();
+      }
+    }
+  }
+
+  void on_link_down(const std::shared_ptr<Conn>& c, bool lan) {
+    const Mode m = get_mode();
+    if (lan) {
+      if (c != lan_link_) {
+        return;
+      }
+      lan_link_.reset();
+      if (m == Mode::kMemberLan || (m == Mode::kJoining && joining_lan_)) {
+        set_mode(Mode::kNone, "Lost the game.");
+        if (m == Mode::kMemberLan) {
+          push({Event::Kind::kClosed, 0, "", {}});
+        }
+      }
+    } else {
+      if (c != server_) {
+        return;
+      }
+      server_.reset();
+      server_hello_ = false;
+      {
+        std::lock_guard<std::mutex> lock(mu);
+        server_games.clear();
+      }
+      if (m == Mode::kHostServer || m == Mode::kMemberServer ||
+          ((m == Mode::kJoining || m == Mode::kStartingHost) && !joining_lan_ && !host_pending_)) {
+        set_mode(Mode::kNone, "Lost the party server.");
+        if (partying(m)) {
+          push({Event::Kind::kClosed, 0, "", {}});
+        }
+      }
+      lg::warn("party: lost the party server");
+    }
+  }
+
+  void drop_lan_link() {
+    if (lan_link_) {
+      auto link = lan_link_;
+      lan_link_.reset();
+      link->finish();
+    }
+  }
+
+  // ---- hosting: on the party server if one is named and answers within a few seconds, else on this network ----
+  void host_now() {
+    if (get_mode() != Mode::kNone) {
+      return;
+    }
+    open_listening();
+    joining_lan_ = false;
+    host_pending_ = true;
+    host_deadline_ = Clock::now() + (cfg_.server.empty() ? std::chrono::seconds(0) : std::chrono::seconds(4));
+    set_mode(Mode::kStartingHost);
+    try_host();
+  }
+
+  void try_host() {
+    if (!host_pending_ || get_mode() != Mode::kStartingHost) {
+      return;
+    }
+    if (server_ && server_hello_) {
+      host_pending_ = false;
+      server_->send({{"op", "host"}, {"title", title()}});
+      return;
+    }
+    if (Clock::now() >= host_deadline_) {
+      host_pending_ = false;
+      host_lan();
+    }
+  }
+
+  // this game is the relay
+  void host_lan() {
+    asio::error_code ec;
+    acceptor_ = std::make_unique<tcp::acceptor>(io_);
+    acceptor_->open(tcp::v4(), ec);
+#if !defined(_WIN32)
+    if (!ec) {
+      acceptor_->set_option(tcp::acceptor::reuse_address(true), ec);  // hosting again at once (Windows's would share it)
+    }
+#endif
+    if (!ec) {
+      acceptor_->bind(tcp::endpoint(tcp::v4(), static_cast<unsigned short>(kPort)), ec);
+    }
+    if (!ec) {
+      acceptor_->listen(asio::socket_base::max_listen_connections, ec);
+    }
+    if (ec) {
+      lg::warn("party: cannot host on TCP {}: {}", kPort, ec.message());
+      acceptor_.reset();
+      set_mode(Mode::kNone, "Cannot host: another game on this machine is hosting.");
+      return;
+    }
+    beacon_out_.open(udp::v4(), ec);
+    if (!ec) {
+      beacon_out_.set_option(asio::socket_base::broadcast(true), ec);
+    }
+    if (ec) {
+      lg::warn("party: cannot announce the game: {}", ec.message());
+    }
+    accept();
+    set_mode(Mode::kHostLan);
+    push({Event::Kind::kJoined, 0, cfg_.name, {}});
+    lg::info("party: hosting on the local network (TCP {})", kPort);
+  }
+
+  void accept() {
+    auto self = shared_from_this();
+    acceptor_->async_accept([this, self](const asio::error_code& ec, tcp::socket socket) {
+      if (ec) {
+        if (acceptor_ && acceptor_->is_open() && ec != asio::error::operation_aborted) {
+          accept();
+        }
+        return;
+      }
+      auto guest = std::make_shared<Conn>(std::move(socket));
+      guests_.insert(guest);
+      guest->start([this, self](const std::shared_ptr<Conn>& c, const json& j) { on_guest(c, j); },
+                   [this, self](const std::shared_ptr<Conn>& c) { drop(c); });
+      if (acceptor_ && acceptor_->is_open()) {
+        accept();
+      }
+    });
+  }
+
+  json summary() {
+    const json w = where_now();
+    return {{"id", 1},           {"title", title()},  {"host", cfg_.name},
+            {"game", kGameName}, {"build", build_},   {"players", static_cast<int>(members_.size()) + 1},
+            {"where", w["where"]}, {"cells", w["cells"]}};
+  }
+
+  void on_guest(const std::shared_ptr<Conn>& c, const json& j) {
+    const std::string op = j.value("op", "");
+    if (op == "hello") {
+      if (j.value("proto", 0) != kProto) {
+        c->send({{"op", "error"}, {"why", "That game is on a different version: everyone needs the same release."}});
+        return;
+      }
+      c->name = clean(j.value("name", "Player"));
+      c->game = j.value("game", "");
+      c->build = j.value("build", "");
+      c->send({{"op", "hello"}, {"proto", kProto}});
+    } else if (op == "list") {
+      c->send({{"op", "games"}, {"games", json::array({summary()})}});
+    } else if (op == "join") {
+      if (c->index >= 0) {
+        return;
+      }
+      if (c->game != kGameName || c->build != build_) {
+        c->send({{"op", "error"}, {"why", "That game is on a different version: everyone needs the same release."}});
+        return;
+      }
+      int index = -1;
+      for (int i = 1; i < kMaxPlayers; ++i) {
+        if (!members_.count(i)) {
+          index = i;
+          break;
+        }
+      }
+      if (index < 0) {
+        c->send({{"op", "error"}, {"why", "That game is full."}});
+        return;
+      }
+      c->index = index;
+      members_[index] = c;
+      guests_.erase(c);
+      {
+        std::lock_guard<std::mutex> lock(mu);
+        names[index] = c->name;
+      }
+      c->send({{"op", "joined"}, {"party", 1}, {"index", index}});
+      lg::info("party: {} joined as player {}", c->name, index);
+    } else if (op == "to") {
+      // one member to another, or to this game (the host, 0)
+      const int to = j.value("index", -1);
+      if (c->index < 0 || !j.contains("data") || !j["data"].is_object()) {
+        return;
+      }
+      if (to == 0) {
+        push({Event::Kind::kFrom, c->index, c->name, j["data"]});
+      } else if (members_.count(to)) {
+        members_[to]->send({{"op", "from"}, {"from", c->index}, {"data", j["data"]}});
+      }
+    } else if (op == "host") {
+      c->send({{"op", "error"}, {"why", "That address is a player's game, not a party server."}});
+    } else if (op == "state") {
+      if (c->index < 0 || !j.contains("data") || !j["data"].is_object()) {
+        return;
+      }
+      const json out = {{"op", "state"}, {"from", c->index}, {"name", c->name}, {"data", j["data"]}};
+      for (auto& [i, m] : members_) {
+        if (i != c->index) {
+          m->send(out);
+        }
+      }
+      push({Event::Kind::kState, c->index, c->name, j["data"]});
+    } else if (op == "leave") {
+      drop(c);
+    }
+  }
+
+  void drop(const std::shared_ptr<Conn>& c) {
+    guests_.erase(c);
+    if (c->index >= 0) {
+      const int index = c->index;
+      c->index = -1;
+      members_.erase(index);
+      const json out = {{"op", "left"}, {"from", index}};
+      for (auto& [i, m] : members_) {
+        m->send(out);
+      }
+      push({Event::Kind::kLeft, index, "", {}});
+      lg::info("party: player {} left", index);
+    }
+    c->close();
+  }
+
+  // ---- joining, leaving, sending ----
+  void join_now(const Game& g) {
+    if (get_mode() != Mode::kNone) {
+      return;
+    }
+    open_listening();
+    if (!g.same_build) {
+      set_mode(Mode::kNone, "That game is on another release: everyone needs the same one.");
+      return;
+    }
+    if (!g.lan) {
+      if (!server_ || !server_hello_) {
+        set_mode(Mode::kNone, "Not connected to the party server.");
+        return;
+      }
+      joining_lan_ = false;
+      set_mode(Mode::kJoining);
+      server_->send({{"op", "join"}, {"party", g.party}});
+      return;
+    }
+    joining_lan_ = true;
+    join_party_ = g.party;
+    set_mode(Mode::kJoining);
+    connect_lan(g);
+  }
+
+  void leave_now() {
+    const Mode m = get_mode();
+    set_mode(Mode::kNone, "");
+    switch (m) {
+      case Mode::kHostLan: {
+        const json closed = {{"op", "closed"}};
+        auto members = members_;
+        auto guests = guests_;
+        members_.clear();
+        guests_.clear();
+        for (auto& [i, c] : members) {
+          c->index = -1;
+          c->send(closed);
+          c->finish();
+        }
+        for (auto& c : guests) {
+          c->close();
+        }
+        asio::error_code ec;
+        if (acceptor_) {
+          acceptor_->close(ec);
+          acceptor_.reset();
+        }
+        beacon_out_.close(ec);
+        break;
+      }
+      case Mode::kHostServer:
+      case Mode::kMemberServer:
+      case Mode::kStartingHost:
+        if (server_) {
+          server_->send({{"op", "leave"}});
+        }
+        break;
+      case Mode::kJoining:
+        if (joining_lan_) {
+          drop_lan_link();
+        } else if (server_) {
+          server_->send({{"op", "leave"}});
+        }
+        break;
+      case Mode::kMemberLan:
+        if (lan_link_) {
+          lan_link_->send({{"op", "leave"}});
+        }
+        drop_lan_link();
+        break;
+      default:
+        break;
+    }
+    last_position_ = nullptr;
+    if (partying(m)) {
+      push({Event::Kind::kClosed, 0, "", {}});
+      lg::info("party: left the game");
+    }
+  }
+
+  void send_now(const json& data) {
+    const Mode m = get_mode();
+    if (!partying(m)) {
+      return;
+    }
+    last_sent_ = Clock::now();
+    if (data.contains("vr") && data["vr"].is_string()) {
+      last_vr_ = data["vr"].get<std::string>();
+    }
+    if (data.contains("position") && data["position"].is_object()) {
+      json p = data["position"];
+      for (const char* k : kInterKeys) {
+        p.erase(k);
+      }
+      last_position_ = json{{"position", p}};
+    }
+    if (m == Mode::kHostLan) {
+      const json out = {{"op", "state"}, {"from", 0}, {"name", cfg_.name}, {"data", data}};
+      for (auto& [i, c] : members_) {
+        c->send(out);
+      }
+    } else if ((m == Mode::kHostServer || m == Mode::kMemberServer) && server_) {
+      server_->send({{"op", "state"}, {"data", data}});
+    } else if (m == Mode::kMemberLan && lan_link_) {
+      lan_link_->send({{"op", "state"}, {"data", data}});
+    }
+  }
+
+  void send_to_now(int index, const json& data) {
+    const Mode m = get_mode();
+    if (!partying(m) || index < 0 || index >= kMaxPlayers) {
+      return;
+    }
+    if (m == Mode::kHostLan) {
+      if (members_.count(index)) {
+        members_[index]->send({{"op", "from"}, {"from", 0}, {"data", data}});
+      }
+    } else if ((m == Mode::kHostServer || m == Mode::kMemberServer) && server_) {
+      server_->send({{"op", "to"}, {"index", index}, {"data", data}});
+    } else if (m == Mode::kMemberLan && lan_link_) {
+      lan_link_->send({{"op", "to"}, {"index", index}, {"data", data}});
+    }
+  }
+
+  // The host takes a player out of its game.
+  void remove_now(int index) {
+    const Mode m = get_mode();
+    if (index <= 0 || index >= kMaxPlayers) {
+      return;
+    }
+    if (m == Mode::kHostLan && members_.count(index)) {
+      auto c = members_[index];
+      c->send({{"op", "removed"}});
+      lg::info("party: took player {} out of the game", index);
+      drop(c);
+    } else if (m == Mode::kHostServer && server_) {
+      server_->send({{"op", "remove"}, {"index", index}});
+      lg::info("party: took player {} out of the game", index);
+    }
+  }
+
+  // ---- every 33 ms ----
+  void tick() {
+    if (stopping_) {
+      return;
+    }
+    auto self = shared_from_this();
+    timer_.expires_after(kTick);
+    timer_.async_wait([this, self](const asio::error_code& ec) {
+      if (ec || stopping_) {
+        return;
+      }
+      on_tick();
+      tick();
+    });
+  }
+
+  void on_tick() {
+    const auto now = Clock::now();
+    json waiting;
+    Mode m;
+    {
+      std::lock_guard<std::mutex> lock(mu);
+      waiting = std::move(pending);
+      pending = nullptr;
+      m = mode;
+      for (auto it = lan_games.begin(); it != lan_games.end();) {
+        it = now - it->second.second > kBeaconLasts ? lan_games.erase(it) : std::next(it);
+      }
+    }
+    if (partying(m)) {
+      if (!waiting.is_null()) {
+        send_now(waiting);
+      } else if (!last_position_.is_null()) {
+        // The game sends an update only when he moves (mod-custom-code.gc), but a VR player standing still still moves
+        // his head and hands: his VR body (jak_vr.h pose_word) goes out with his place each tick it changed.
+        std::string vr = jakvr::pose_word();
+        if (vr != last_vr_ || now - last_sent_ > kHeartbeat) {
+          json beat = last_position_;
+          beat["vr"] = std::move(vr);
+          send_now(beat);
+        }
+      }
+    }
+    if (now - last_list_ > kListEvery) {
+      last_list_ = now;
+      if (server_ && server_hello_) {
+        server_->send({{"op", "list"}});
+        if (m == Mode::kHostServer) {
+          // this game's level and power cells, for its line in the server's list (as the beacon says them here)
+          const json w = where_now();
+          server_->send({{"op", "where"}, {"where", w["where"]}, {"cells", w["cells"]}});
+        }
+      }
+      if (lan_link_) {
+        lan_link_->send({{"op", "list"}});  // the host hears from us
+      }
+    }
+    if (acceptor_ && now - last_beacon_ > kBeaconEvery) {
+      last_beacon_ = now;
+      beacon();
+    }
+    std::vector<std::shared_ptr<Conn>> idle;
+    for (auto& [i, c] : members_) {
+      if (now - c->heard > kIdle) {
+        idle.push_back(c);
+      }
+    }
+    for (auto& c : guests_) {
+      if (now - c->heard > kIdle) {
+        idle.push_back(c);
+      }
+    }
+    for (auto& c : idle) {
+      drop(c);
+    }
+    try_host();
+    if (listening_ && !cfg_.server.empty() && !server_ && !server_connecting_ && now - last_server_try_ > kRetryServer) {
+      connect_server();
+    }
+  }
+
+  void close_all() {
+    stopping_ = true;
+    asio::error_code ec;
+    timer_.cancel();
+    beacon_in_.close(ec);
+    beacon_out_.close(ec);
+    if (acceptor_) {
+      acceptor_->close(ec);
+      acceptor_.reset();
+    }
+    auto members = members_;
+    auto guests = guests_;
+    members_.clear();
+    guests_.clear();
+    for (auto& [i, c] : members) {
+      c->index = -1;
+      c->close();
+    }
+    for (auto& c : guests) {
+      c->close();
+    }
+    if (auto link = server_) {
+      server_.reset();
+      link->close();
+    }
+    if (auto link = lan_link_) {
+      lan_link_.reset();
+      link->close();
+    }
+  }
+
+  Config cfg_;
+  std::string build_;
+  unsigned id_ = 0;
+  asio::io_context io_;
+  asio::executor_work_guard<asio::io_context::executor_type> work_;
+  asio::steady_timer timer_;
+  bool stopping_ = false;
+  bool listening_ = false;  // the network opened (open_listening)
+  std::atomic<bool> browse_asked_{false};
+  bool host_pending_ = false;  // hosting asked for: on the party server once it answers, or here at host_deadline_
+  Clock::time_point host_deadline_{};
+  // games on the local network
+  udp::socket beacon_in_, beacon_out_;
+  udp::endpoint beacon_from_;
+  std::array<char, 2048> beacon_buf_{};
+  // the party server
+  std::shared_ptr<Conn> server_;
+  bool server_hello_ = false, server_connecting_ = false;
+  // a LAN host joined
+  std::shared_ptr<Conn> lan_link_;
+  bool joining_lan_ = false;
+  int join_party_ = 1;
+  // hosting on the local network
+  std::unique_ptr<tcp::acceptor> acceptor_;
+  std::map<int, std::shared_ptr<Conn>> members_;
+  std::set<std::shared_ptr<Conn>> guests_;  // connected, not joined (listing)
+  // sending
+  json last_position_;
+  std::string last_vr_;  // the VR body last sent ("vr")
+  Clock::time_point last_sent_{}, last_list_{}, last_beacon_{}, last_server_try_{};
+};
+
+// ---- the game's thread ----
+std::recursive_mutex g_api;
+std::shared_ptr<Session> g_session;
+Clock::time_point g_off_until{};
+bool g_in_game = false;
+std::set<int> g_remote;  // the others with a Jak in this game, by party index
+std::atomic<int> g_players{0};
+struct Taken {
+  int index;
+  json interaction;
+  std::string level;
+};
+std::deque<Taken> g_history;  // what the others took, to take again here when this game loads its level
+std::deque<Taken> g_replay;
+std::vector<std::pair<std::string, Clock::time_point>> g_replay_at;
+std::map<std::string, bool> g_level_shown;
+
+// Saves (party.h): what pc-vr.gc is asked to do next (kind | slot << 4), the members waiting for this game's progress
+// (the host), and the host's progress coming in (a member).
+int g_save_ask = 0;
+std::set<int> g_copy_for;
+bool g_copy_asked = false;  // a member: asked the host, waiting
+std::vector<std::uint8_t> g_copy;  // the host's progress as it comes in
+int g_copy_parts = 0, g_copy_of = 0;
+std::string g_save_note;
+
+// A message from one player to this one alone (Session::send_to): the host's progress asked for, or a piece of it.
+void take_from(int from, const json& data) {
+  const std::string save = data.value("save", "");
+  if (save == "ask") {
+    // a member wants this game's progress (this game hosts; pc-vr.gc makes it, save_made sends it)
+    g_copy_for.insert(from);
+    if (g_save_ask == 0) {
+      g_save_ask = kSaveMakeCopy;
+    }
+    lg::info("party: player {} asked for this game's progress", from);
+  } else if (save == "part" && g_copy_asked && from == 0) {
+    const int n = data.value("n", -1), of = data.value("of", 0);
+    if (n != g_copy_parts || of <= 0 || of > static_cast<int>(kSaveMost / kSaveChunk) + 1 || !data.contains("data") ||
+        !data["data"].is_string()) {
+      g_copy_asked = false;
+      g_copy.clear();
+      g_save_note = "The host's progress did not come through.";
+      return;
+    }
+    base64_append(data["data"].get<std::string>(), g_copy);
+    g_copy_of = of;
+    if (++g_copy_parts == of) {
+      g_copy_asked = false;
+      g_save_ask = kSaveLoadCopy;
+      g_save_note = "Loading the host's progress...";
+      lg::info("party: the host's progress came ({} bytes)", g_copy.size());
+    } else {
+      g_save_note = "Receiving the host's progress (" + std::to_string(100 * g_copy_parts / of) + "%)...";
+    }
+  } else if (save == "none" && g_copy_asked && from == 0) {
+    g_copy_asked = false;
+    g_save_note = "The host's game could not make a save just now: try again.";
+  }
+}
+
+void end_game_side() {
+  if (game_ready()) {
+    for (int r : g_remote) {
+      game_player_left(r);
+    }
+    if (g_in_game) {
+      game_left();
+    }
+  }
+  g_in_game = false;
+  g_remote.clear();
+  g_history.clear();
+  g_replay.clear();
+  g_replay_at.clear();
+  g_players = 0;
+}
+
+void remember(int index, const json& data) {
+  const auto pos = data.find("position");
+  if (pos == data.end() || !pos->is_object()) {
+    return;
+  }
+  const int type = pos->value("interType", 0);
+  if (!replayed(type) || (type == 5 && pos->value("interParent", "") == "client")) {
+    return;
+  }
+  const std::string level = pos->value("interLevel", "");
+  if (level.empty() || level == "none") {
+    return;
+  }
+  json inter = json::object();
+  for (const char* k : kInterKeys) {
+    if (pos->contains(k)) {
+      inter[k] = (*pos)[k];
+    }
+  }
+  g_history.push_back({index, inter, level});
+  if (g_history.size() > kMaxHistory) {
+    g_history.pop_front();
+  }
+}
+
+void take(const Event& e) {
+  switch (e.kind) {
+    case Event::Kind::kJoined:
+      end_game_side();
+      g_in_game = true;
+      g_players = 1;
+      game_joined(e.index, e.name);
+      break;
+    case Event::Kind::kState:
+      if (!g_in_game) {
+        break;
+      }
+      g_remote.insert(e.index);
+      g_players = 1 + static_cast<int>(g_remote.size());
+      remember(e.index, e.data);
+      game_player(e.index, e.name, e.data, false);
+      break;
+    case Event::Kind::kLeft:
+      if (g_remote.erase(e.index)) {
+        game_player_left(e.index);
+      }
+      g_players = g_in_game ? 1 + static_cast<int>(g_remote.size()) : 0;
+      g_copy_for.erase(e.index);
+      break;
+    case Event::Kind::kClosed:
+      end_game_side();
+      g_off_until = Clock::now() + kLinger;  // Teamruns' side a moment more, to put the others away
+      g_copy_for.clear();
+      if (g_copy_asked) {
+        g_copy_asked = false;
+        g_save_note = "";
+      }
+      break;
+    case Event::Kind::kFrom:
+      take_from(e.index, e.data);
+      break;
+  }
+}
+
+// A level this game has just loaded: what the others took there is taken here too, once now-ish and once more
+// when its things have surely come in.
+void watch_levels(const json& update) {
+  const auto it = update.find("levels");
+  if (it == update.end() || !it->is_array()) {
+    return;
+  }
+  const auto now = Clock::now();
+  std::set<std::string> shown;
+  for (const auto& l : *it) {
+    if (!l.is_object()) {
+      continue;
+    }
+    const std::string name = l.value("name", ""), status = l.value("status", "");
+    if (name.empty() || status.empty() || status == "#f" || status == "none") {
+      continue;
+    }
+    shown.insert(name);
+    if (!g_level_shown[name]) {
+      g_replay_at.push_back({name, now + std::chrono::seconds(4)});
+      g_replay_at.push_back({name, now + std::chrono::seconds(12)});
+    }
+  }
+  for (auto& [name, was] : g_level_shown) {
+    was = shown.count(name) != 0;
+  }
+}
+
+void replay_step() {
+  if (!g_in_game) {
+    return;
+  }
+  const auto now = Clock::now();
+  for (auto it = g_replay_at.begin(); it != g_replay_at.end();) {
+    if (now < it->second) {
+      ++it;
+      continue;
+    }
+    for (const auto& t : g_history) {
+      if (t.level == it->first) {
+        g_replay.push_back(t);
+      }
+    }
+    it = g_replay_at.erase(it);
+  }
+  for (int sent = 0; sent < kMaxPlayers && !g_replay.empty(); ++sent) {
+    const Taken& t = g_replay.front();
+    int slot = -1;
+    if (g_remote.count(t.index) && game_slot_free(t.index)) {
+      slot = t.index;
+    } else {
+      for (int r : g_remote) {
+        if (game_slot_free(r)) {
+          slot = r;
+          break;
+        }
+      }
+    }
+    if (slot < 0) {
+      if (g_remote.empty()) {
+        g_replay.clear();
+      }
+      break;
+    }
+    game_player(slot, "", t.interaction, true);
+    g_replay.pop_front();
+  }
+}
+
+}  // namespace
+
+void update(bool multiplayer_on) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (multiplayer_on && !g_session) {
+    g_session = std::make_shared<Session>(read_config());
+    g_session->start();
+  } else if (!multiplayer_on && g_session) {
+    g_session->stop();
+    g_session.reset();
+    g_off_until = Clock::now() + kLinger;
+    end_game_side();
+    lg::info("party: Multiplayer off");
+  }
+  if (!g_session) {
+    return;
+  }
+  // Tests on one PC (tools/run_sim.sh): JAKVR_PARTY_TEST=host hosts as the game comes up, =join joins the first game
+  // of this build it finds; JAKVR_PARTY_TEST_SAVE=copy then plays the host's progress. Players use the VR menu.
+  // Hosting and joining are the network's: Teamruns' side of the game starts with them (game_on), then takes the rest.
+  static const char* const test = std::getenv("JAKVR_PARTY_TEST");
+  static const char* const test_save = std::getenv("JAKVR_PARTY_TEST_SAVE");
+  static bool tested = false, tested_save = false;
+  if (test && !tested) {
+    if (std::string(test) == "host") {
+      tested = true;
+      lg::info("party: JAKVR_PARTY_TEST hosts");
+      host();
+    } else if (std::string(test) == "join") {
+      browse();
+      for (const auto& g : games()) {
+        if (g.same_build) {
+          tested = true;
+          lg::info("party: JAKVR_PARTY_TEST joins {}", g.label);
+          join(g);
+          break;
+        }
+      }
+    }
+  }
+  if (!game_ready()) {
+    return;
+  }
+  std::deque<Event> events;
+  {
+    std::lock_guard<std::mutex> inner(g_session->mu);
+    events.swap(g_session->inbox);
+  }
+  for (const auto& e : events) {
+    try {
+      take(e);
+    } catch (const std::exception& ex) {
+      lg::warn("party: a bad update: {}", ex.what());
+    }
+  }
+  replay_step();
+
+  if (test && tested && test_save && !tested_save && std::string(test_save) == "copy" && in_party() &&
+      g_remote.count(0)) {
+    tested_save = true;  // once the host's Jak is in this game
+    lg::info("party: JAKVR_PARTY_TEST_SAVE plays the host's progress");
+    play_host_copy();
+  }
+}
+
+bool on() {
