+      non_const_lvalue<WriteHandler> handler2(handler);
+      async_write(next_layer_, buffer(storage->data(), storage->size()),
+          buffered_flush_handler<typename decay<WriteHandler>::type>(
+            *storage, handler2.value));
+    }
