+// Ratchet's neck_of: the neck below and behind the eyes, so looking down is no crouch.
+constexpr float kNeckBack = 0.10f, kNeckDown = 0.15f;
+constexpr float kCrouchRise = 0.07f;   // metres back up from the drop before he stands
+constexpr float kStandSettle = 0.01f;  // metres a second
+
+// The eyes' even field: tan of half the field across and up, the larger side of either eye, a little more for the
+// eyes' distance apart (the game culls from between them).
+void even_field(const FrameInfo& f, float& tx, float& ty) {
+  tx = 0;
+  ty = 0;
+  for (int e = 0; e < 2; ++e) {
+    tx = std::max({tx, std::abs(std::tan(f.fov[e][0])), std::abs(std::tan(f.fov[e][1]))});
+    ty = std::max({ty, std::abs(std::tan(f.fov[e][2])), std::abs(std::tan(f.fov[e][3]))});
+  }
+  if (tx <= 0.1f || ty <= 0.1f) {
+    tx = 1.0f;
+    ty = 1.0f;
+  }
+  tx *= 1.03f;
+  ty *= 1.03f;
+}
+
+// A cutscene's eyes go in Jak's head only while that Jak is drawn, and (the playable Jak, not a scene's own) near the
+// scene's camera: Jak 3's opening plays without him (his root fell through the void, his neck still at the world's
+// origin, the camera 3 km off), and a Jak II scene played 100 m from where the playable Jak stood hidden. A scene's own
+// Jak is in it however far a wide shot's camera stands. Otherwise the scene is seen as third person sees it.
+constexpr float kSceneJakMost = 120.0f * 4096.0f;
+bool jak_in_scene(const VrCameraInfo& info) {
+  if (!(info.flags & kFlagDrawn)) {
+    return false;
+  }
+  if (info.head[0] == 0 && info.head[1] == 0 && info.head[2] == 0) {
+    return false;  // a bone not worked out
+  }
+  if (info.flags & kFlagSceneJak) {
+    return true;
+  }
+  const float dx = info.head[0] - info.camera_trans[0], dy = info.head[1] - info.camera_trans[1],
+              dz = info.head[2] - info.camera_trans[2];
+  return dx * dx + dy * dy + dz * dz < kSceneJakMost * kSceneJakMost;
+}
+
+// Adaptive cutscenes (the owner, 0.1.1: "auto switch to 3rd person in cutscenes where jak/daxter aren't really in the
+// scene properly, and then switch back when they are. Like for the intro cutscenes of jak 1"; on to start). A scene
+// set to be seen through Jak's eyes is seen around you, from the game's camera, while he is not properly in it:
+// - not drawn, or far off (jak_in_scene);
+// - the playable Jak far from his own place: Jak 1's opening credits leave his skeleton 100 m from his root, inside a
+//   Precursor silo, while the game's camera flies through the titles (sim b18 scene_face);
+// - the game's camera far from his head: the scene is showing somewhere else;
+// - carried along faster than a run for a while (a ride, a fall, a flight: the scene moves the view, not the player).
+// Leaving his eyes is at once; coming back waits until he has been properly in the scene for a second, and a scene
+// that has left his eyes three times stays around you to its end, so the view never fights the scene's cuts (Vixel on
+// Jak 3's opening: "view fight between 1st person view and where camera should be ... alot of flickering").
+constexpr float kSceneBodyMost = 12.0f * 4096.0f;
+constexpr float kSceneCameraMost = 40.0f * 4096.0f;
+constexpr float kSceneCarriedMost = 8.0f * 4096.0f;  // a second (Jak's run is 10 m a second; scenes walk him)
+// a step this long in one frame (30 m a second) is a cut, not speed: the scene put him somewhere else for its next
+// shot. 3 m let a cut of 2 to 3 m through as 150 m a second, and Jak 1's opening left his eyes twice for a second
+// each at the dark eco silo (sim b20 adaptive1: "Jak is carried along").
+constexpr float kSceneCutLeast = 0.5f * 4096.0f;
+constexpr double kSceneBackSeconds = 1.0;
+constexpr int kSceneDropsMost = 3;
+struct SceneFit {
+  bool in_scene = false;     // a scene is on (kModeMovie, a blackout in it counted)
+  double began = 0;
+  double fits_since = -1;    // he has been properly in it since (-1: he is not)
+  bool eyes = false;         // the verdict: through his eyes
+  int drops = 0;             // times this scene left his eyes
+  bool head_valid = false;
+  Vec3 head_was;
+  float speed = 0;           // his head's, eased, units a second
+  const char* why = "";
+};
+SceneFit s_scene_fit;
+
+// Why Jak is not properly in the scene now, or nullptr when he is.
+const char* scene_misfit(const VrCameraInfo& info) {
+  auto& s = s_scene_fit;
+  if (!jak_in_scene(info)) {
+    return (info.flags & kFlagDrawn) ? "Jak is far from the scene" : "Jak is not drawn";
+  }
+  const Vec3 head{info.head[0], info.head[1], info.head[2]};
+  if (!(info.flags & kFlagSceneJak)) {
+    const Vec3 root{info.target_trans[0], info.target_trans[1], info.target_trans[2]};
+    if (quest::length(head - root) > kSceneBodyMost) {
+      return "Jak's body is not at his own place";
+    }
+  }
+  const Vec3 cam{info.camera_trans[0], info.camera_trans[1], info.camera_trans[2]};
+  if (quest::length(head - cam) > kSceneCameraMost) {
+    return "the scene's camera is somewhere else";
+  }
+  if (s.speed > kSceneCarriedMost) {
+    return "Jak is carried along";
+  }
+  return nullptr;
+}
+
+// Once a game frame, before the view is chosen.
+void update_scene_fit(const VrCameraInfo& info) {
+  auto& s = s_scene_fit;
+  const double now = now_seconds();
+  if (info.mode != kModeMovie) {
+    if (info.mode != kModeLoading && info.mode != kModeMenu) {
+      s = SceneFit{};  // play or the title: the scene is over
+    }
+    s.head_valid = false;
+    return;
+  }
+  if (!s.in_scene) {
+    s = SceneFit{};
+    s.in_scene = true;
+    s.began = now;
+  }
+  const Vec3 head{info.head[0], info.head[1], info.head[2]};
+  if (s.head_valid) {
+    const float step = quest::length(head - s.head_was);
+    if (step > kSceneCutLeast * 60.0f * kGameFrameSeconds) {
+      s.speed = 0;  // a cut
+    } else {
+      s.speed += (step / kGameFrameSeconds - s.speed) * (1.0f - std::exp(-kGameFrameSeconds / 0.5f));
+    }
+  }
+  s.head_was = head;
+  s.head_valid = (info.flags & kFlagTarget) != 0;
+  const char* why = scene_misfit(info);
+  const bool was = s.eyes;
+  if (why) {
+    s.fits_since = -1;
+    s.eyes = false;
+    if (was) {
+      ++s.drops;
+    }
+  } else {
+    if (s.fits_since < 0) {
+      s.fits_since = now;
+    }
+    // at a scene's start at once; later after a steady second; never again once it has left his eyes too often
+    const bool start = now - s.began < 0.25 && s.drops == 0;
+    s.eyes = s.eyes || start || (s.drops < kSceneDropsMost && now - s.fits_since >= kSceneBackSeconds);
+  }
+  const bool first_word = !s.eyes && why && s.why[0] == 0;  // a scene that starts around you says why once
+  if (s.eyes != was || first_word) {
+    const Options& o = options();
+    if (o.adaptive_cutscenes && o.cutscene_view == CutsceneView::kFirstPerson && s_pad.scene_view < 0) {
+      if (s.eyes) {
+        lg::info("[vr-cam] adaptive cutscenes: through his eyes{}", s.drops ? " again" : "");
+      } else {
+        lg::info("[vr-cam] adaptive cutscenes: around you ({}){}", why ? why : "he was not in the scene",
+                 s.drops >= kSceneDropsMost ? ", to the scene's end" : "");
+      }
+    }
+  }
+  s.why = why ? why : "";
+}
+
+bool first_person_now(const VrCameraInfo& info) {
+  const Options& o = options();
+  switch (info.mode) {
+    case kModePlay:
+      return s_pad.view_first_person && (info.flags & kFlagTarget) &&
+             ((info.flags & kFlagFirstPersonOk) || (o.first_person_vehicles && (info.flags & kFlagVehicle))) &&
+             !((info.flags & kFlagGrabbed) && !o.first_person_in_talks);
+    case kModeMovie:
+      // the menu button's own choice in a scene (scene_view) is the player's: only that Jak is there counts then
+      if (s_pad.scene_view >= 0) {
+        return s_pad.scene_view == 1 && (info.flags & kFlagTarget) && jak_in_scene(info);
+      }
+      return o.cutscene_view == CutsceneView::kFirstPerson && (info.flags & kFlagTarget) &&
+             (o.adaptive_cutscenes ? s_scene_fit.eyes : jak_in_scene(info));
+    case kModeMenu:
+      // paused: the view stays as it was in play, the menu on the HUD in front
+      return s_rig.play_first_person && (info.flags & kFlagTarget);
+    default:
+      return false;
+  }
+}
+
+// Every scene the game draws is seen in the headset in 3D (owner, 2026-11-12: "all scenes/cutscenes that are rendered
+// in game should be shown in vr"): play, cutscenes (unless Cutscene view is On a screen), the title and its menus (in
+// VR around you, from the game's own camera), and a pause menu over play (the world kept in 3D, the menu on the HUD).
+// Only a load or a blackout, where nothing is drawn, is on the flat screen.
+bool stereo_now(const VrCameraInfo& info) {
+  switch (info.mode) {
+    case kModePlay:
+    case kModeTitle:
+    case kModeMenu:
+      return true;
+    case kModeMovie:
+      return s_pad.scene_view >= 0 || options().cutscene_view != CutsceneView::kScreen;
+    default:
+      return false;
+  }
+}
+
+// ---- The display thread ----
+
+const char* const kCopyVertex =
+#if defined(__ANDROID__)
+    "#version 320 es\nprecision highp float;\n"
+#else
+    "#version 410 core\n"
+#endif
+    "out vec2 uv;\n"
+    "uniform vec4 rect;\n"  // x0, y0, x1, y1 in NDC
+    "void main() {\n"
+    "  vec2 c = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));\n"
+    "  uv = c;\n"
+    "  gl_Position = vec4(mix(rect.xy, rect.zw, c), 0.0, 1.0);\n"
+    "}\n";
+
+const char* const kCopyFragment =
+#if defined(__ANDROID__)
+    "#version 320 es\nprecision highp float;\nprecision highp sampler2D;\n"
+#else
+    "#version 410 core\n"
+#endif
+    "in vec2 uv;\n"
+    "out vec4 color;\n"
+    "uniform sampler2D tex;\n"
+    "uniform float opaque;\n"
+    "void main() {\n"
+    "  vec4 c = texture(tex, uv);\n"
+    "  color = opaque > 0.5 ? vec4(c.rgb, 1.0) : c;\n"
+    "}\n";
+
+struct Picture {
+  GLuint tex = 0, fbo = 0;
+  int width = 0, height = 0;
+};
+
+struct Display {
+  std::unique_ptr<Headset> headset;
+  bool tried = false;
+  bool frame_open = false;
+  FrameInfo frame;
+  Pass pass;
+  double owed = 0;  // display time since the game was last let go
+  std::int64_t last_display = 0;  // the last frame's display time (0: the headset tells none)
+  double step = 1.0 / 72.0;       // display time from the last frame to this one, seconds
+  // Our pictures (each eye's and the panel's): drawn when the game sends a frame, given to the headset each frame.
+  Picture picture[3];
+  bool have_eyes = false;
+  bool have_panel = false;
+  bool panel_is_hud = false;
+  FrameTag shown;  // what the pictures show
+  const FrameTag* drawing = nullptr;  // the frame being drawn, during its passes (merc_hidden)
+  GLuint program = 0, vao = 0;
+  GLint loc_rect = -1, loc_tex = -1, loc_opaque = -1;
+  std::map<unsigned, GLuint> target_fbos;  // the headset's images' framebuffers
+  Pose flat_pose;
+  bool flat_placed = false;
+  // The HUD where it stays put (the VR menu's "HUD follows your head" off): in the room, upright, ahead of the head.
+  Pose hud_pose;
+  bool hud_placed = false;
+  long frames = 0;
+  // The HUD's own models (hud_models_drawn): the bucket being drawn, the buckets seen holding them (the HUD pass draws
+  // those for them alone) and the ones this frame's HUD pass drew them from.
+  int bucket = -1;
+  static constexpr int kHudBucketsMost = 1024;
+  std::vector<bool> hud_model_buckets = std::vector<bool>(kHudBucketsMost, false);
+  std::vector<bool> hud_models_drawn = std::vector<bool>(kHudBucketsMost, false);
+  // A blackout kept in the eyes, black (draw_passes): when it began (-1: none) and its frames so far.
+  double blackout_since = -1;
+  int blackout_frames = 0;
+};
+Display s_display;
+// A blackout (the game's mode 4: a cut between a scene's shots, a warp, a load) begun while the eyes saw play or a
+// scene keeps the eyes, black, for up to this long (seconds); a longer one (a load) goes to the flat panel as before.
+// 0.1.0 put each on the flat panel at once: in Jak 3's opening, a scene's cuts showed the game's own camera on the
+// panel for a few frames each, then Jak's eyes again (Vixel: "view fight between 1st person view and where camera
+// should be ... alot of flickering").
+constexpr double kBlackoutEyesMost = 1.5;
+Pass s_window_pass;
+
+GLuint compile(GLenum kind, const char* source) {
+  const GLuint s = glCreateShader(kind);
+  glShaderSource(s, 1, &source, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    char text[1024] = {};
+    glGetShaderInfoLog(s, sizeof text, nullptr, text);
+    lg::error("[vr] the copy shader: {}", text);
+  }
+  return s;
+}
+
+void make_copy_program() {
+  auto& d = s_display;
+  const GLuint vs = compile(GL_VERTEX_SHADER, kCopyVertex);
+  const GLuint fs = compile(GL_FRAGMENT_SHADER, kCopyFragment);
+  d.program = glCreateProgram();
+  glAttachShader(d.program, vs);
+  glAttachShader(d.program, fs);
+  glLinkProgram(d.program);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  d.loc_rect = glGetUniformLocation(d.program, "rect");
+  d.loc_tex = glGetUniformLocation(d.program, "tex");
+  d.loc_opaque = glGetUniformLocation(d.program, "opaque");
+  glGenVertexArrays(1, &d.vao);
+}
+
+// Draws texture `tex` into framebuffer `fbo` (width x height), over the rectangle `rect` (NDC).
+void copy(GLuint tex, GLuint fbo, int width, int height, const float rect[4], bool opaque) {
+  auto& d = s_display;
+  glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+#if !defined(__ANDROID__)
+  glDisable(GL_FRAMEBUFFER_SRGB);  // the game's picture is gamma-encoded already
+#endif
+  glViewport(0, 0, width, height);
+  glDisable(GL_DEPTH_TEST);
+  glDisable(GL_BLEND);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_STENCIL_TEST);
+  glDisable(GL_CULL_FACE);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glUseProgram(d.program);
+  glUniform4f(d.loc_rect, rect[0], rect[1], rect[2], rect[3]);
+  glUniform1i(d.loc_tex, 0);
+  glUniform1f(d.loc_opaque, opaque ? 1.0f : 0.0f);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glBindVertexArray(d.vao);
+  glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+  glBindVertexArray(0);
+  glUseProgram(0);
+}
+
+void make_picture(Picture& p, int width, int height) {
+  if (p.tex != 0 && p.width == width && p.height == height) {
+    return;
+  }
+  if (p.tex == 0) {
+    glGenTextures(1, &p.tex);
+    glGenFramebuffers(1, &p.fbo);
+  }
+  p.width = width;
+  p.height = height;
+  glBindTexture(GL_TEXTURE_2D, p.tex);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glBindFramebuffer(GL_FRAMEBUFFER, p.fbo);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, p.tex, 0);
+  glClearColor(0, 0, 0, 0);
+  glClear(GL_COLOR_BUFFER_BIT);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glBindTexture(GL_TEXTURE_2D, 0);
+}
+
+GLuint target_fbo(unsigned image) {
+  auto& d = s_display;
+  auto it = d.target_fbos.find(image);
+  if (it != d.target_fbos.end()) {
+    return it->second;
+  }
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image, 0);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  d.target_fbos[image] = fbo;
+  return fbo;
+}
+
+// Our picture into the headset's image of `target`.
+bool give(quest::Target target, const Picture& p, bool opaque) {
+  auto& d = s_display;
+  const unsigned image = d.headset->acquire(target);
+  if (image == 0) {
+    return false;
+  }
+  int w = 0, h = 0;
+  d.headset->target_size(target, w, h);
+  static const float kWhole[4] = {-1, -1, 1, 1};
+  copy(p.tex, target_fbo(image), w, h, kWhole, opaque);
+  return true;
+}
+
+// ---- Smoother frames (AppSW): the eyes' motion ----
+// Meta's XR_FB_space_warp takes, beside each eye's picture, how far each pixel moved since the last frame (NDC, this
+// frame's place less the last's) and its depth, at the size the runtime asks; the headset makes the frames between.
+// As Ratchet's camera pass: the eye's depth taken back to a place by this frame's background camera (note_eye_camera,
+// from the renderers' own matrix), then through the last frame's; the sky (nothing drawn, depth 0) by its direction.
+// Things moving on their own (Jak, enemies, platforms) move with the camera only here.
+
+const char* const kMotionVertex =
+#if defined(__ANDROID__)
+    "#version 320 es\nprecision highp float;\n"
+#else
+    "#version 410 core\n"
+#endif
+    "void main() {\n"
+    "  vec2 at = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+    "  gl_Position = vec4(at * 2.0 - 1.0, 0.0, 1.0);\n"
+    "}\n";
+
+const char* const kMotionFragment =
+#if defined(__ANDROID__)
+    "#version 320 es\nprecision highp float;\nprecision highp sampler2D;\n"
+#else
+    "#version 410 core\n"
+#endif
+    "uniform sampler2D eye_depth;\n"  // the eye's depth, at the eye's size
+    "uniform mat4 inverse_now;\n"     // clip to the eye's space (world units from the eye), this frame
+    "uniform mat4 then;\n"            // the eye's space now to the last frame's clip
+    "uniform vec2 size;\n"            // the motion image's size
+    "uniform vec2 scale;\n"           // the eye's size over it
+    "uniform float own_body;\n"       // nearer than this (world units) is Jak's own body, hands and gun: no motion
+    "layout(location = 0) out vec4 motion;\n"
+    "void main() {\n"
+    "  float depth = texelFetch(eye_depth, ivec2(gl_FragCoord.xy * scale), 0).r;\n"
+    "  gl_FragDepth = depth;\n"
+    "  bool sky = depth <= 0.0;\n"
+    "  vec3 now = vec3(gl_FragCoord.xy / size * 2.0 - 1.0, depth * 2.0 - 1.0);\n"
+    "  vec4 place = inverse_now * vec4(now.xy, sky ? 0.0 : now.z, 1.0);\n"
+    "  place = vec4(place.xyz / place.w, sky ? 0.0 : 1.0);\n"
+    "  if (!sky && length(place.xyz) < own_body) {\n"
+    "    motion = vec4(0.0);\n"
+    "    return;\n"
+    "  }\n"
+    "  vec4 old = then * place;\n"
+    "  if (old.w <= 0.0) {\n"
+    "    motion = vec4(0.0);\n"
+    "    return;\n"
+    "  }\n"
+    "  vec3 before = old.xyz / old.w;\n"
+    "  motion = vec4(now.xy - before.xy, sky ? 0.0 : now.z - before.z, 0.0);\n"
+    "}\n";
+
+// Movement between two frames past which the view cut (a new place or a turned camera): no motion for that frame.
+constexpr double kMotionJump = 4.0 * kUnitsPerMetre;
+constexpr double kMotionTurn = 0.9;  // the cosine of the most the view may turn (about 25 degrees)
+constexpr float kMotionOwnBody = 1.0f;  // metres from the eyes: Jak's own arms and hands in first person
+
+struct EyeMotion {
+  bool noted = false;     // this pass's camera came
+  double now[16]{};       // the eye's space (world units from the eye) to clip, column-major
+  double trans[3]{};      // the eye's place in the world
+  bool have_then = false;
+  long then_frame = -1;   // the display frame `then` is of
+  double then[16]{};
+  double then_trans[3]{};
+};
+
+struct Motion {
+  EyeMotion eye[2];
+  bool drawn[2]{};        // this display frame's motion
+  float depth_zero = 0;   // metres at depth 0 (far) and 1 (near), for the layer
+  float depth_one = 0;
+  long frame = 0;         // display frames (draw_passes)
+  GLuint program = 0, vao = 0;
+  GLint loc_depth = -1, loc_inverse = -1, loc_then = -1, loc_size = -1, loc_scale = -1, loc_own = -1;
+  bool failed = false;
+  GLuint depth_tex = 0, depth_fbo = 0;  // the eye's depth, copied out of the render buffer
+  int depth_w = 0, depth_h = 0;
+  std::map<std::pair<unsigned, unsigned>, GLuint> fbos;  // the headset's motion and depth images, together
+  long given = 0;
+  bool told = false;
+  // 0.1.1
+  bool cut[2]{};        // this frame's motion says nothing (a cut, a run's first frame): drawn as none, to be skipped
+  bool passes = false;  // the eyes were drawn anew this display frame
+  int steady = 0;       // drawn frames in a row with both eyes' motion
+  bool on = false;      // the motion is being given: the headset at its half rate
+};
+Motion s_motion;
+// Drawn frames in a row with their motion before it is given to the headset (a third of a second): a few frames of a
+// scene do not throw the headset into its half rate and out again.
+constexpr int kMotionSteady = 20;
+
+// Dynamic resolution (0.1.1, the VR menu's; off to start): the eyes drawn smaller while the headset is not keeping
+// up, and back up when it is. The headset tells no load, only that a frame was shown late; so a second with more than
+// a fifth of its frames late takes the eyes down a step (to kScaleLeast at the lowest), kScaleCalm seconds with none
+// late tries a step up, and a step up that brings late frames back at once is undone and the next try waits twice as
+// long (a minute at the most). The smaller picture is scaled up to the headset's own size as it is given.
+constexpr float kScaleStep = 0.1f, kScaleLeast = 0.6f;
+constexpr double kScaleCalm = 5.0, kScaleCalmMost = 60.0;
+struct Scale {
+  float now = 1.0f;
+  int frames = 0, late = 0;    // this second's
+  double window_at = 0;
+  double calm_since = 0;       // no late frame since
+  double calm_wait = kScaleCalm;
+  double stepped_up_at = -1;   // the last step up, while it is on trial
+};
+Scale s_scale;
+
+void mat_mul(const double a[16], const double b[16], double out[16]) {
+  for (int c = 0; c < 4; ++c) {
+    for (int r = 0; r < 4; ++r) {
+      double s = 0;
+      for (int k = 0; k < 4; ++k) {
+        s += a[k * 4 + r] * b[c * 4 + k];
+      }
+      out[c * 4 + r] = s;
+    }
+  }
+}
+
+bool mat_invert(const double m[16], double out[16]) {
+  double inv[16];
+  inv[0] = m[5] * m[10] * m[15] - m[5] * m[11] * m[14] - m[9] * m[6] * m[15] + m[9] * m[7] * m[14] +
+           m[13] * m[6] * m[11] - m[13] * m[7] * m[10];
+  inv[4] = -m[4] * m[10] * m[15] + m[4] * m[11] * m[14] + m[8] * m[6] * m[15] - m[8] * m[7] * m[14] -
+           m[12] * m[6] * m[11] + m[12] * m[7] * m[10];
+  inv[8] = m[4] * m[9] * m[15] - m[4] * m[11] * m[13] - m[8] * m[5] * m[15] + m[8] * m[7] * m[13] +
+           m[12] * m[5] * m[11] - m[12] * m[7] * m[9];
+  inv[12] = -m[4] * m[9] * m[14] + m[4] * m[10] * m[13] + m[8] * m[5] * m[14] - m[8] * m[6] * m[13] -
+            m[12] * m[5] * m[10] + m[12] * m[6] * m[9];
+  inv[1] = -m[1] * m[10] * m[15] + m[1] * m[11] * m[14] + m[9] * m[2] * m[15] - m[9] * m[3] * m[14] -
+           m[13] * m[2] * m[11] + m[13] * m[3] * m[10];
+  inv[5] = m[0] * m[10] * m[15] - m[0] * m[11] * m[14] - m[8] * m[2] * m[15] + m[8] * m[3] * m[14] +
+           m[12] * m[2] * m[11] - m[12] * m[3] * m[10];
+  inv[9] = -m[0] * m[9] * m[15] + m[0] * m[11] * m[13] + m[8] * m[1] * m[15] - m[8] * m[3] * m[13] -
+           m[12] * m[1] * m[11] + m[12] * m[3] * m[9];
+  inv[13] = m[0] * m[9] * m[14] - m[0] * m[10] * m[13] - m[8] * m[1] * m[14] + m[8] * m[2] * m[13] +
+            m[12] * m[1] * m[10] - m[12] * m[2] * m[9];
+  inv[2] = m[1] * m[6] * m[15] - m[1] * m[7] * m[14] - m[5] * m[2] * m[15] + m[5] * m[3] * m[14] +
+           m[13] * m[2] * m[7] - m[13] * m[3] * m[6];
+  inv[6] = -m[0] * m[6] * m[15] + m[0] * m[7] * m[14] + m[4] * m[2] * m[15] - m[4] * m[3] * m[14] -
+           m[12] * m[2] * m[7] + m[12] * m[3] * m[6];
+  inv[10] = m[0] * m[5] * m[15] - m[0] * m[7] * m[13] - m[4] * m[1] * m[15] + m[4] * m[3] * m[13] +
+            m[12] * m[1] * m[7] - m[12] * m[3] * m[5];
+  inv[14] = -m[0] * m[5] * m[14] + m[0] * m[6] * m[13] + m[4] * m[1] * m[14] - m[4] * m[2] * m[13] -
+            m[12] * m[1] * m[6] + m[12] * m[2] * m[5];
+  inv[3] = -m[1] * m[6] * m[11] + m[1] * m[7] * m[10] + m[5] * m[2] * m[11] - m[5] * m[3] * m[10] -
+           m[9] * m[2] * m[7] + m[9] * m[3] * m[6];
+  inv[7] = m[0] * m[6] * m[11] - m[0] * m[7] * m[10] - m[4] * m[2] * m[11] + m[4] * m[3] * m[10] +
+           m[8] * m[2] * m[7] - m[8] * m[3] * m[6];
+  inv[11] = -m[0] * m[5] * m[11] + m[0] * m[7] * m[9] + m[4] * m[1] * m[11] - m[4] * m[3] * m[9] -
+            m[8] * m[1] * m[7] + m[8] * m[3] * m[5];
+  inv[15] = m[0] * m[5] * m[10] - m[0] * m[6] * m[9] - m[4] * m[1] * m[10] + m[4] * m[2] * m[9] +
+            m[8] * m[1] * m[6] - m[8] * m[2] * m[5];
+  const double det = m[0] * inv[0] + m[1] * inv[4] + m[2] * inv[8] + m[3] * inv[12];
+  if (!std::isfinite(det) || std::fabs(det) < 1e-30) {
+    return false;
+  }
+  for (int i = 0; i < 16; ++i) {
+    out[i] = inv[i] / det;
+  }
+  return true;
+}
+
+// How far from the eye (metres) clip depth `z` (-1 far, 1 near) is straight ahead.
+float motion_distance(const double inverse[16], double z, float units) {
+  const double p[4] = {inverse[8] * z + inverse[12], inverse[9] * z + inverse[13], inverse[10] * z + inverse[14],
+                       inverse[11] * z + inverse[15]};
+  if (std::fabs(p[3]) < 1e-12) {
+    return 100000.0f;
+  }
+  const double d = std::sqrt(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]) / std::fabs(p[3]);
+  return static_cast<float>(d / units);
+}
+
+bool motion_program() {
+  auto& m = s_motion;
+  if (m.program != 0 || m.failed) {
+    return m.program != 0;
+  }
+  const GLuint vs = compile(GL_VERTEX_SHADER, kMotionVertex);
+  const GLuint fs = compile(GL_FRAGMENT_SHADER, kMotionFragment);
+  const GLuint program = glCreateProgram();
+  glAttachShader(program, vs);
+  glAttachShader(program, fs);
+  glLinkProgram(program);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint ok = 0;
+  glGetProgramiv(program, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    char text[1024] = {};
+    glGetProgramInfoLog(program, sizeof text, nullptr, text);
+    lg::error("[vr] smoother frames: the motion shader: {}", text);
+    glDeleteProgram(program);
+    m.failed = true;
+    return false;
+  }
+  m.program = program;
+  m.loc_depth = glGetUniformLocation(program, "eye_depth");
+  m.loc_inverse = glGetUniformLocation(program, "inverse_now");
+  m.loc_then = glGetUniformLocation(program, "then");
+  m.loc_size = glGetUniformLocation(program, "size");
+  m.loc_scale = glGetUniformLocation(program, "scale");
+  m.loc_own = glGetUniformLocation(program, "own_body");
+  glGenVertexArrays(1, &m.vao);
+  return true;
+}
+
+// A copy of the eye's depth (the render buffer's may be multisampled, and is not a texture).
+bool motion_depth_copy(GLuint render_fbo, int w, int h) {
+  auto& m = s_motion;
+  if (m.depth_tex == 0 || m.depth_w != w || m.depth_h != h) {
+    if (m.depth_tex == 0) {
+      glGenTextures(1, &m.depth_tex);
+      glGenFramebuffers(1, &m.depth_fbo);
+    }
+    m.depth_w = w;
+    m.depth_h = h;
+    glBindTexture(GL_TEXTURE_2D, m.depth_tex);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, w, h, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+    // a depth texture read texel by texel; anything else leaves it incomplete in GL ES
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, m.depth_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, m.depth_tex, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+      lg::warn("[vr] smoother frames: the eye's depth copy cannot be made");
+      glBindFramebuffer(GL_FRAMEBUFFER, 0);
+      m.failed = true;
+      return false;
+    }
+  }
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, render_fbo);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m.depth_fbo);
+  glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  return true;
+}
+
+GLuint motion_fbo(const quest::MotionTarget& t) {
+  auto& m = s_motion;
+  const auto key = std::make_pair(t.motion, t.depth);
+  auto it = m.fbos.find(key);
+  if (it != m.fbos.end()) {
+    return it->second;
+  }
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t.motion, 0);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, t.depth, 0);
+  if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+    lg::warn("[vr] smoother frames: the motion images {} and {} cannot be drawn into", t.motion, t.depth);
+    glDeleteFramebuffers(1, &fbo);
+    fbo = 0;
+  }
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  m.fbos[key] = fbo;
+  return fbo;
+}
+
+// The eye's camera now becomes the one the next frame's motion is measured from.
+void keep_motion(EyeMotion& e) {
+  std::memcpy(e.then, e.now, sizeof e.then);
+  std::memcpy(e.then_trans, e.trans, sizeof e.then_trans);
+  e.have_then = true;
+  e.then_frame = s_motion.frame;
+  e.noted = false;
+}
+
+// The headset for the game thread's one question of it (locate_grips), once started; it lives as long as the game.
+std::atomic<Headset*> s_game_headset{nullptr};
+
+void start_headset() {
+  auto& d = s_display;
+  d.tried = true;
+#if defined(_WIN32)
+  quest::sim_gl_proc = [](const char* name) -> void* {
+    return reinterpret_cast<void*>(SDL_GL_GetProcAddress(name));
+  };
+#endif
+  // 0.1.1: the options read before the headset starts. The game's own start reads them (set_game, on the kernel's
+  // thread), but seconds after the first frame gets here, so in 0.1.0 the headset started with every option at its
+  // default (Vixel's log: "the headset started" at 13:58, the options at 14:00): Eye resolution, Refresh rate, Smoother
+  // frames, Foveated rendering and CPU and GPU boost did nothing whatever the launcher or the VR menu said.
+  if (!options_loaded()) {
+    load_options(static_cast<int>(g_game_version));
+  }
+  const Options& o = options();
+  quest::XrSettings settings;
+  settings.refresh_hz = static_cast<float>(o.refresh_hz);
+  settings.resolution = static_cast<float>(o.resolution) / 100.0f;
+  settings.panel_width = 1024;
+  settings.panel_height = 768;
+  settings.space_warp = o.space_warp;
+  settings.cpu_gpu_boost = o.cpu_gpu_boost;
+  settings.foveation = o.foveation;
+  settings.sharpen = o.sharpen;
+  d.headset.reset(quest::make_headset(log_line));
+  std::string why;
+  if (!d.headset || !d.headset->start(settings, why)) {
+    lg::warn("[vr] no headset: {}", why);
+    d.headset.reset();
+    return;
+  }
+  make_copy_program();
+  s_game_headset = d.headset.get();
+  lg::info("[vr] the headset started");
+}
+
+void place_flat_panel(const FrameInfo& f) {
+  auto& d = s_display;
+  const Vec3 ahead = rot(f.head.orientation, {0, 0, -1});
+  float x = ahead.x, z = ahead.z;
+  const float len = std::sqrt(x * x + z * z);
+  if (len < 0.1f) {
+    x = 0;
+    z = -1;
+  } else {
+    x /= len;
+    z /= len;
+  }
+  d.flat_pose.position = {f.head.position.x + x * kFlatDistance, f.head.position.y,
+                          f.head.position.z + z * kFlatDistance};
+  d.flat_pose.orientation = quest::yaw_quat(std::atan2(-x, -z));
+  d.flat_placed = true;
+}
+
+// The HUD that stays put ("HUD follows your head" off): ahead of the head, upright, at the menu's distance and height.
+// It moves only once the head looks more than 60 degrees from it (so it is never left behind you), after a recentre, or
+// coming back from the flat screen.
+void place_hud(const FrameInfo& f) {
+  auto& d = s_display;
+  const Options& o = options();
+  if (o.hud_follows) {
+    d.hud_placed = false;
+    return;
+  }
+  const Vec3 ahead = rot(f.head.orientation, {0, 0, -1});
+  float x = ahead.x, z = ahead.z;
+  const float len = std::sqrt(x * x + z * z);
+  if (len < 0.1f) {
+    return;  // looking straight up or down: where it is
+  }
+  x /= len;
+  z /= len;
+  if (d.hud_placed && !f.recentred) {
+    const Vec3 to = rot(d.hud_pose.orientation, {0, 0, -1});
+    constexpr float kHudStayCos = 0.5f;  // 60 degrees
+    if (to.x * x + to.z * z >= kHudStayCos) {
+      return;
+    }
+  }
+  const float distance = static_cast<float>(o.hud_distance) / 100.0f;
+  d.hud_pose.position = {f.head.position.x + x * distance, f.head.position.y + static_cast<float>(o.hud_height) / 100.0f,
+                         f.head.position.z + z * distance};
+  d.hud_pose.orientation = quest::yaw_quat(std::atan2(-x, -z));
+  d.hud_placed = true;
+  lg::info("[vr-view] the HUD stays put, placed ahead at {:.0f} degrees", std::atan2(-x, -z) * 180.0f / quest::kPi);
+}
+
+void run_pass(PassKind kind, int eye, bool first, const FrameTag& tag, void (*draw)(void*), void* user) {
+  auto& d = s_display;
+  Pass p;
+  p.kind = kind;
+  p.eye = eye;
+  p.first_of_frame = first;
+  p.render_width = d.picture[0].width;
+  p.render_height = d.picture[0].height;
+  const int index = kind == PassKind::kEye ? eye : 2;
+  p.target_fbo = d.picture[index].fbo;
+  p.width = d.picture[index].width;
+  p.height = d.picture[index].height;
+  if (kind == PassKind::kEye) {
+    const Vec3 dt = tag.eye[eye].position - tag.head.position;
+    const Vec3 dh = rot(quest::conjugate(tag.head.orientation), dt);
+    // in the camera's axes: its first row is the head's left (camera_update), its third ahead
+    const float c[3] = {-dh.x * tag.units, dh.y * tag.units, -dh.z * tag.units};
+    for (int i = 0; i < 3; ++i) {
+      p.shift_cam[i] = c[i];
+      p.shift_world[i] = c[0] * tag.rows[0][i] + c[1] * tag.rows[1][i] + c[2] * tag.rows[2][i];
+    }
+    // Foveated rendering (Ratchet 0.1.19, the launcher's option): the eye's picture drawn at a lower resolution
+    // towards its edges, on the Quest's graphics chip; nothing on the PC.
+    d.headset->foveate(eye, d.picture[index].tex);
+    s_motion.eye[eye].noted = false;  // its camera comes with the pass's first background draw
+  }
+  if (kind == PassKind::kHud) {
+    std::fill(d.hud_models_drawn.begin(), d.hud_models_drawn.end(), false);  // this frame's, from its HUD pass on
+  }
+  d.bucket = -1;
+  d.pass = p;
+  d.drawing = &tag;
+  draw(user);
+  d.drawing = nullptr;
+  d.pass = s_window_pass;
+}
+
+// Whether frame `tag` is a blackout kept in the eyes, black (kBlackoutEyesMost): the game's mode 4, begun while the
+// eyes saw play or a scene, for its first kBlackoutEyesMost seconds.
+bool blackout_in_eyes(const FrameTag& tag) {
+  auto& d = s_display;
+  if (!tag.valid || tag.mode != kModeLoading) {
+    return false;
+  }
+  const double now = now_seconds();
+  if (d.blackout_since < 0) {
+    const bool from_eyes =
+        d.have_eyes && d.shown.valid && d.shown.stereo && (d.shown.mode == kModePlay || d.shown.mode == kModeMovie);
+    if (!from_eyes) {
+      return false;
+    }
+    d.blackout_since = now;
+    d.blackout_frames = 0;
+  }
+  if (now - d.blackout_since > kBlackoutEyesMost) {
+    if (d.blackout_frames > 0) {
+      lg::info("[vr-view] a blackout past {:.1f} s (a load): the flat panel after {} black frames in the eyes",
+               kBlackoutEyesMost, d.blackout_frames);
+      d.blackout_frames = -1;  // told; the flat panel until it ends
+    }
+    return false;
+  }
+  if (d.blackout_frames < 0) {
+    return false;
+  }
+  ++d.blackout_frames;
+  return true;
+}
+
+// Any frame not a blackout kept in the eyes ends one (told in the log for the tests).
+void end_blackout() {
+  auto& d = s_display;
+  if (d.blackout_since >= 0 && d.blackout_frames > 0) {
+    lg::info("[vr-view] a blackout kept in the eyes, black: {} frames", d.blackout_frames);
+  }
+  d.blackout_since = -1;
+  d.blackout_frames = 0;
+}
