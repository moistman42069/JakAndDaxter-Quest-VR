+int hand_probes(void* info_ptr) {
+  if (!info_ptr) {
+    return 0;
+  }
+  auto* info = static_cast<VrBodyInfo*>(info_ptr);
+  info->probe_count = 0;
+  for (auto& ask : s_probe_ask) {
+    ask.valid = false;
+  }
+  const Options& o = options();
+  if (!s_vr_on.load() || !o.body || !o.hands_on_world || !s_rig.map_valid || !s_rig.map_first_person) {
+    return 0;
+  }
+  const float metre = 4096.0f;  // his sizes are the game's metres
+  const Vec3 eyes = s_rig.map_head_world;
+  const Vec3 neck = eyes + scaled(to_world_dir(rot(s_rig.map_head.orientation, {0.0f, -kBodyNeckDown, kBodyNeckBack}),
+                                               s_rig.map_yaw),
+                                  metre);
+  Vec3 right = to_world_dir(rot(s_rig.map_head.orientation, {1, 0, 0}), s_rig.map_yaw);
+  right.y = 0;
+  right = unit(right, {1, 0, 0});
+  const auto put = [&](int i, Vec3 from, Vec3 to, float radius) {
+    info->probe_from[i][0] = from.x, info->probe_from[i][1] = from.y, info->probe_from[i][2] = from.z;
+    info->probe_from[i][3] = 1.0f;
+    info->probe_to[i][0] = to.x, info->probe_to[i][1] = to.y, info->probe_to[i][2] = to.z;
+    info->probe_to[i][3] = radius;
+    info->probe_hit[i][3] = -1.0f;
+    s_probe_ask[i].valid = radius > 0.0f;
+  };
+  for (int side = 0; side < 2; ++side) {
+    if (!s_rig.map_grip_valid[side]) {
+      put(kProbePalmLeft + side, neck, neck, 0.0f);
+      put(kProbeFingersLeft + side, neck, neck, 0.0f);
+      put(kProbeUnderLeft + side, neck, neck, 0.0f);
+      put(kProbeStrapLeft + side, neck, neck, 0.0f);
+      continue;
+    }
+    const GripWorld g = grip_world(side, s_rig.map_grip[side]);
+    const Vec3 shoulder = neck + scaled(right, (side == quest::kLeft ? -kShoulderAside : kShoulderAside) * metre) -
+                          Vec3{0, kShoulderDown * metre, 0};
+    put(kProbePalmLeft + side, shoulder, g.palm_middle, kPalmRadius * metre);
+    put(kProbeFingersLeft + side, g.palm_middle, g.palm_middle + scaled(g.along, kFingerReach * metre),
+        kFingerRadius * metre);
+    // under the palm: what the hand hovers over or lies on, for its fingers to rest on
+    const Vec3 under_from = g.palm_middle + scaled(g.along, kUnderAhead * metre);
+    put(kProbeUnderLeft + side, under_from, under_from + scaled(g.palm, kUnderReach * metre), kUnderRadius * metre);
+    // Jak 1's wrist straps: along where they hung a frame ago
+    if (s_body.strap_probe[side]) {
+      put(kProbeStrapLeft + side, s_body.strap_from[side], s_body.strap_to[side], kStrapRadius * metre);
+    } else {
+      put(kProbeStrapLeft + side, neck, neck, 0.0f);
+    }
+  }
+  info->probe_count = kBodyProbes;
+  return kBodyProbes;
+}
+
+int body(const void* info_ptr, std::uint8_t* memory) {
+  if (!s_vr_on.load() || !info_ptr || !memory) {
+    return 0;
+  }
+  VrBodyInfo& info = s_body_work.info;  // not on the stack (BodyWork)
+  std::memcpy(&info, info_ptr, sizeof info);
+  info.count = std::clamp(info.count, 0, kBodyNodesMost);
+  if (info.count == 0) {
+    return 0;
+  }
+  if (info.key != s_shape.key || info.count != s_shape.count) {
+    learn_shape(info, memory);
+  }
+  const auto& s = s_shape;
+  const int neck = info.named[kJointNeck] >= 0 && info.named[kJointNeck] < s.count ? info.named[kJointNeck] : -1;
+
+  // What the eyes leave out of this frame.
+  {
+    std::lock_guard<std::mutex> lock(s_tag_mutex);
+    const auto set_name = [](FrameTag::Hidden& h, const char* name) {
+      std::size_t n = 0;
+      while (n + 1 < sizeof h.name && name[n] != 0) {
+        ++n;
+      }
+      std::memcpy(h.name, name, n);
+      h.name[n] = 0;
+      if (char* lod = std::strstr(h.name, "-lod")) {
+        *lod = 0;
+      }
+    };
+    auto& head = s_game_tag.hidden[0];
+    head = FrameTag::Hidden{};
+    if ((info.flags & kBodyHideHead) && neck >= 0 && s.has_made[neck] && info.jak_name[0] != 0) {
+      set_name(head, info.jak_name);
+      // The neck goes with the head (neckA, the joint the head's neckB hangs from, when it is a neck of its own with no
+      // arm under it): its skin then shrinks down to the neck's base, closing the collar. Hidden from neckB alone, the
+      // neck's skin shrank up to the head's pivot behind the eyes, a funnel seen from above as an open neck hole when
+      // looking down (sim j1_down7 and 8).
+      int top = neck;
+      {
+        const int base = s.parent[neck];
+        const int chest_node = info.named[kJointChest], main_node = info.named[kJointMain];
+        bool arm_under = false;
+        if (base >= 0) {
+          for (int i : under(base)) {
+            for (int side = 0; side < 2; ++side) {
+              arm_under = arm_under || i == info.named[kJointSide + 16 * side];
+            }
+          }
+        }
+        if (base >= 0 && base != chest_node && base != main_node && s.has_made[base] && !arm_under) {
+          top = base;
+        }
+      }
+      for (int i : under(top)) {
+        head.slots[i >> 3] |= static_cast<std::uint8_t>(1u << (i & 7));
+      }
+      // Parts standing by his face that are not under his neck (pc-vr.gc *vr-body-names* from kJointHideFirst: Jak 1's
+      // collar flaps, Dark Jak's horns), each shrunk to its own joint: the eyes' near plane is 5 cm (each game's
+      // update-math-camera), so they show beside the view. Shrunk to the head's point they stretched across it (sim
+      // j1_down11). PC test aid: JAKVR_HIDE_JOINTS=<node>,<node>... leaves those nodes out the same way.
+      const auto add_group = [&](int n) {
+        if (n < 0 || n >= s.count || !s.has_made[n] || head.groups >= kMercHideGroups ||
+            ((head.slots[n >> 3] >> (n & 7)) & 1)) {
+          return;
+        }
+        auto& g = head.group[head.groups++];
+        g.root = n;
+        const Vec3 place = mat_place(s.made[n]);
+        g.at[0] = place.x;
+        g.at[1] = place.y;
+        g.at[2] = place.z;
+        for (int i : under(n)) {
+          g.slots[i >> 3] |= static_cast<std::uint8_t>(1u << (i & 7));
+        }
+      };
+      for (int k = kJointHideFirst; k < kBodyNamed; ++k) {
+        add_group(info.named[k]);
+      }
+#if !defined(__ANDROID__)
+      if (const char* list = std::getenv("JAKVR_HIDE_JOINTS")) {
+        for (const char* p = list; *p;) {
+          char* end = nullptr;
+          const long n = std::strtol(p, &end, 10);
+          if (end == p) {
+            break;
+          }
+          add_group(static_cast<int>(n));
+          p = *end == ',' ? end + 1 : end;
+        }
+      }
+#endif
+      head.root = top;
+      // The chest's matrix carries the neck's place as well while posed (the neck is straightened on it, step 3), and
+      // every model of him sends it: a model whose neck joint has no vertex sends no matrix for it (sim j1_body6: the
+      // head's blend then went to whatever that slot held, a funnel up to the eyes seen looking down).
+      const int chest_at = info.named[kJointChest];
+      head.root_alt = chest_at >= 0 && chest_at < s.count && s.has_made[chest_at] ? chest_at : -1;
+      const Vec3 at = mat_place(s.made[top]);
+      head.at[0] = at.x;
+      head.at[1] = at.y;
+      head.at[2] = at.z;
+
+      // Body shown (VR menu, owner 2026-11-14): the parts of him not shown are cut out of the eyes (merc_hidden's
+      // `cut`: the merc shaders drop the skin those joints carry most of), left where they are, so nothing stretches
+      // and what stays ends at the joint. His hands always stay. An arm is its collar (Lshould, with the body: cut
+      // with it), then the upper arm and forearm (cut as the arm), then the hand and fingers; a leg all from the thigh;
+      // the body every other node but the head's.
+      const BodyShown shown = options().body_shown;
+      const bool cut_body = shown == BodyShown::kArmsLegs || shown == BodyShown::kArms || shown == BodyShown::kLegs ||
+                            shown == BodyShown::kHands;
+      const bool cut_legs = shown == BodyShown::kBodyArms || shown == BodyShown::kArms || shown == BodyShown::kHands;
+      const bool cut_arms = shown == BodyShown::kBodyLegs || shown == BodyShown::kLegs || shown == BodyShown::kHands;
+      if (cut_body || cut_legs || cut_arms) {
+        const auto mark = [](std::uint8_t* bits, int i) {
+          if (i >= 0 && i < 128) {
+            bits[i >> 3] |= static_cast<std::uint8_t>(1u << (i & 7));
+          }
+        };
+        const auto marked = [](const std::uint8_t* bits, int i) {
+          return i >= 0 && i < 128 && ((bits[i >> 3] >> (i & 7)) & 1) != 0;
+        };
+        const auto node_at = [&](int k) {
+          const int n = info.named[k];
+          return n >= 0 && n < s.count ? n : -1;
+        };
+        std::uint8_t limbs[16] = {};  // every node of an arm (from the collar) or a leg
+        for (int side = 0; side < 2; ++side) {
+          const int base = kJointSide + 16 * side;
+          const int collar = node_at(base + kSideShoulder), arm = node_at(base + kSideArm);
+          const int hand = node_at(base + kSideHand), thigh = node_at(base + kSideThigh);
+          const int arm_top = collar >= 0 ? collar : arm;
+          if (hand >= 0 && arm_top >= 0) {
+            std::uint8_t hand_bits[16] = {}, arm_bits[16] = {};
+            for (int i : under(hand)) {
+              mark(hand_bits, i);
+            }
+            if (arm >= 0) {
+              for (int i : under(arm)) {
+                mark(arm_bits, i);
+              }
+            }
+            for (int i : under(arm_top)) {
+              mark(limbs, i);
+              if (marked(hand_bits, i)) {
+                continue;
+              }
