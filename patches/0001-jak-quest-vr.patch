+
+// ---- saves ----
+
+std::vector<Slot> slots() {
+  std::vector<Slot> out(4);
+  for (int slot = 0; slot < 4; ++slot) {
+    // each slot's two banks (kmemcard.cpp: bank 4 + 2 slot and the next), the one saved last; McHeader's preview is
+    // the game-save's info: level-index, power cells, orbs, scout flies, completion (game-save.gc)
+    std::uint32_t best_count = 0;
+    for (int bank = 0; bank < 2; ++bank) {
+      const auto path = file_util::get_user_memcard_dir(GameVersion::Jak1) /
+                        mc_get_filename_no_dir(GameVersion::Jak1, 4 + slot * 2 + bank);
+      std::ifstream in(path.string(), std::ios::binary);
+      std::uint8_t head[12 + 64] = {};
+      if (!in.read(reinterpret_cast<char*>(head), sizeof head)) {
+        continue;
+      }
+      std::uint32_t count, magic;
+      std::memcpy(&count, head, 4);
+      std::memcpy(&magic, head + 8, 4);
+      if (magic != 0x12345678 || (out[slot].present && count <= best_count)) {
+        continue;
+      }
+      std::int32_t level;
+      float cells, orbs, flies, percent;
+      std::memcpy(&level, head + 12, 4);
+      std::memcpy(&cells, head + 16, 4);
+      std::memcpy(&orbs, head + 20, 4);
+      std::memcpy(&flies, head + 24, 4);
+      std::memcpy(&percent, head + 28, 4);
+      out[slot].present = true;
+      best_count = count;
+      out[slot].where = level_name(level);
+      out[slot].cells = static_cast<int>(cells);
+      out[slot].orbs = static_cast<int>(orbs);
+      out[slot].flies = static_cast<int>(flies);
+      out[slot].percent = static_cast<int>(percent);
+    }
+  }
+  return out;
+}
+
+void play_slot(int slot) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (slot >= 0 && slot < 4) {
+    g_save_ask = kSaveLoadSlot | (slot << 4);
+    g_copy_asked = false;
+    g_save_note = "Loading save " + std::to_string(slot + 1) + "...";
+  }
+}
