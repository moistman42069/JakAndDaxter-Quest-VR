+bool merc_hidden(const char* name, std::uint8_t hidden[16], int& root, int& root_alt, float at[3],
+                 MercHideGroup groups[kMercHideGroups], int& group_count, std::uint8_t cut[16],
+                 std::uint8_t fade[128]) {
+  group_count = 0;
+  root_alt = -1;
+  std::memset(cut, 0, 16);
+  std::memset(fade, 0, 128);
+  const auto& d = s_display;
+  if (d.pass.kind != PassKind::kEye || !d.drawing || !name) {
+    return false;
+  }
+#if !defined(__ANDROID__)
+  // PC test aids: JAKVR_BODY_TRACE=1 names each merc model the eyes draw, once; JAKVR_HIDE_TEST=<name> leaves out of
+  // the eyes all of each model whose name starts so (which model is it that the eyes see?).
+  {
+    static const bool trace = std::getenv("JAKVR_BODY_TRACE") != nullptr;
+    static const char* hide_test = std::getenv("JAKVR_HIDE_TEST");
+    static std::vector<std::string> seen;
+    if (trace && std::find(seen.begin(), seen.end(), name) == seen.end()) {
+      seen.emplace_back(name);
+      log_line(0, fmt::format("[vr-body] the eyes draw merc model {}", name).c_str());
+    }
+    if (hide_test && hide_test[0] != 0 && std::strncmp(name, hide_test, std::strlen(hide_test)) == 0) {
+      std::memset(hidden, 0xff, 16);
+      root = -1;
+      return true;
+    }
+  }
+#endif
+  for (const auto& h : d.drawing->hidden) {
+    if (h.name[0] == 0) {
+      continue;
+    }
+    const std::size_t n = std::strlen(h.name);
+    if (std::strncmp(name, h.name, n) != 0 || (name[n] != 0 && name[n] != '-')) {
+      continue;
+    }
+    // told once for each of the two (Jak's and Daxter's models alternate within a frame)
+    static std::string told[2];
+    std::string& last = told[&h == &d.drawing->hidden[0] ? 0 : 1];
+    if (last != name) {
+      last = name;
+      log_line(0, fmt::format("[vr-body] the eyes leave out merc model {}", name).c_str());
+    }
+    std::memcpy(hidden, h.slots, 16);
+    group_count = std::clamp(h.groups, 0, kMercHideGroups);
+    for (int g = 0; g < group_count; ++g) {
+      groups[g] = h.group[g];
+    }
+    std::memcpy(cut, h.cut, 16);
+    std::memcpy(fade, h.fade, 128);
+    root = h.root;
+    root_alt = h.root_alt;
+    at[0] = h.at[0];
+    at[1] = h.at[1];
+    at[2] = h.at[2];
+    return true;
+  }
+  return false;
+}
