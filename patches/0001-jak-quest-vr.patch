+  operator()(S&& s, F&& f, N&& n) const
+    ASIO_NOEXCEPT_IF((
+      call_traits<S, void(F, N)>::is_noexcept))
+  {
+    return bulk_execute(ASIO_MOVE_CAST(S)(s),
+        ASIO_MOVE_CAST(F)(f), ASIO_MOVE_CAST(N)(n));
+  }
+
+  template <typename S, typename F, typename N>
