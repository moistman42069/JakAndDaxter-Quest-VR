+int pose_other(int player, const void* info_ptr, const float* trans, const float* quat, std::uint8_t* memory) {
+  const int r = pose_other_apply(player, info_ptr, trans, quat, memory);
+  // the log says when each player's VR body starts and stops being put on his Jak (called each frame)
+  static std::map<int, int> s_was;
+  int& was = s_was[player];
+  if (was != r) {
