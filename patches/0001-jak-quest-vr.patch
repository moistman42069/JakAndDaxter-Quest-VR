+ *   if (cs.cancelled() != asio::cancellation_type::none)
+ *     // ...
+ * } @endcode
+ */
+#if defined(ASIO_HAS_CONSTEXPR) || defined(GENERATING_DOCUMENTATION)
+constexpr cancellation_state_t cancellation_state;
