+Rig s_rig;
+
+// Jak's eyes above his root standing: first person sits here, not on his animated neck, which bobs with every step
+// and turn (Ratchet's anchor_now: the hero's root plus his eye height, for the same reason). His neck stands about
+// 2.2 game metres over his root in Jak 1 (sim, 2026-11-12), so the old fixed 1.5 put the eyes in his chest, with
+// Daxter on the shoulder in front of them. The height starts at a per-game guess and follows his standing eyes slowly
+// (`head` is his eyes: the game puts them a little up and ahead of his neck along his head's axes, vr-eyes<-neck!).
+constexpr float kJakEyeLearnSeconds = 2.0f;
+constexpr float kAnchorEaseSeconds = 0.12f;   // the offset falls to a third in this
+// Riding, his eyes' place from his root is followed in this (seconds: most of the way), so the view sits in his head
+// on what he rides without each bob of it (first_person_anchor).
+constexpr float kRideHeadSeconds = 0.15f;
+constexpr float kAnchorJumpLeast = 0.25f * 4096.0f;  // a frame's move past this (and past his motion) is a jump to ease
+constexpr float kAnchorJumpMotions = 3.0f;           // a jump: past this many of his recent steps besides
+constexpr float kAnchorJumpAlong = 0.6f * 4096.0f;   // along the ground, a jump from this (up and down, the least)
+constexpr float kAnchorJumpMost = 4.0f * 4096.0f;    // past this a cut (a warp, a respawn), taken at once
+inline float game_frame_seconds() {
+  return 1.0f / static_cast<float>(s_game_fps.load());
+}
+#define kGameFrameSeconds game_frame_seconds()
+// Crouched by the button (not by the player's head), the view goes down to his crouched eyes, as Ratchet's
+// update_eye_height. Crouched by the head, the head already took it there. A share of his standing eye height.
+constexpr float kJakDuckDropShare = 0.37f;
+
+// Jak's standing eye height this frame, world units: the game's guess at first, then his standing neck followed.
+float jak_eye_height(const VrCameraInfo& info) {
+  if (s_rig.eye_height <= 0) {
+    s_rig.eye_height = (s_game == (int)GameVersion::Jak1 ? 2.3f : 2.4f) * 4096.0f;
+  }
+  // Learned only standing in play: on the ground, not crouched, not held by a scene.
+  const int want = kFlagTarget | kFlagOnGround;
+  if (info.mode == kModePlay && (info.flags & want) == want &&
+      !(info.flags & (kFlagDucking | kFlagRolling | kFlagGrabbed))) {
+    const float sample = info.head[1] - info.target_trans[1];
+    if (sample > 1.2f * 4096.0f && sample < 3.5f * 4096.0f) {
+      s_rig.eye_height += (sample - s_rig.eye_height) * (1.0f - std::exp(-kGameFrameSeconds / kJakEyeLearnSeconds));
+    }
+  }
+  return s_rig.eye_height;
+}
+
+// Running, Jak leans his neck about 0.45 m ahead of his root (sim, 2026-11-12), so eyes over the root saw his collar
+// and shoulders fill the bottom of the view. The eyes go ahead with the lean: only along his facing (a step's side
+// sway left out), eased, held in the air (a running jump keeps it); `head` is already his eyes, ahead of his neck.
+constexpr float kJakLeanSeconds = 0.2f;
+constexpr float kJakLeanLeast = -0.2f * 4096.0f;
+constexpr float kJakLeanMost = 0.8f * 4096.0f;
+float jak_lean(const VrCameraInfo& info, float fx, float fz) {
+  if (info.flags & kFlagOnGround) {
+    const float ahead =
+        (info.head[0] - info.target_trans[0]) * fx + (info.head[2] - info.target_trans[2]) * fz;
+    // a head not worked out (no number, or metres off his root) leaves the lean as it was: read as it came, it put the
+    // view at the 0.8 m most ahead of him (sim b26 buttons1, Jak 1's look-around)
+    if (std::isfinite(ahead) && std::fabs(ahead) < 3.0f * 4096.0f) {
+      const float want = std::min(kJakLeanMost, std::max(kJakLeanLeast, ahead));
+      s_rig.lean += (want - s_rig.lean) * (1.0f - std::exp(-kGameFrameSeconds / kJakLeanSeconds));
+    }
+  }
+  return s_rig.lean;
+}
+
+// The first-person anchor for this game frame: Jak's root plus his eye height and lean, a jump eased. In a cutscene,
+// his animated head (the scene moves his body away from his root), as Ratchet's scene eyes.
+Vec3 first_person_anchor(const VrCameraInfo& info) {
+  const float eye = jak_eye_height(info);
+  Vec3 now{info.target_trans[0], info.target_trans[1] + eye, info.target_trans[2]};
+  const Vec3 head_from_root{info.head[0] - info.target_trans[0], info.head[1] - info.target_trans[1],
+                            info.head[2] - info.target_trans[2]};
+  const bool head_near = std::isfinite(head_from_root.x) && std::isfinite(head_from_root.y) &&
+                         std::isfinite(head_from_root.z) && quest::length(head_from_root) < 4.0f * 4096.0f;
+  if (info.mode == kModeMovie) {
+    // his eyes, as the game worked them out from his neck
+    now = {info.head[0], info.head[1], info.head[2]};
+    s_rig.ride_head_valid = false;
+  } else if ((info.flags & (kFlagBoard | kFlagVehicle)) && head_near) {
+    // Riding (0.1.1, First person in vehicles): his eyes where they are on what he rides, followed over
+    // kRideHeadSeconds. His standing eye height over his root left the view a metre under his neck on the JET-Board
+    // (its root is not under his feet), and the body, held to the view, folded his legs flat against the board, the
+    // knees 23 to 110 cm from one frame to the next (sims b37 and b38 board); in a car it put the eyes above his head.
+    if (!s_rig.ride_head_valid) {
+      s_rig.ride_head = head_from_root;
+      s_rig.ride_head_valid = true;
+    } else {
+      const float k = 1.0f - std::exp(-kGameFrameSeconds / kRideHeadSeconds);
+      s_rig.ride_head = s_rig.ride_head + (head_from_root - s_rig.ride_head) * k;
+    }
+    now = {info.target_trans[0] + s_rig.ride_head.x, info.target_trans[1] + s_rig.ride_head.y,
+           info.target_trans[2] + s_rig.ride_head.z};
+  } else {
+    s_rig.ride_head_valid = false;
+    // his facing: target_yaw is atan2(ahead.x, ahead.z)
+    const float fx = std::sin(info.target_yaw), fz = std::cos(info.target_yaw);
+    const float lean = jak_lean(info, fx, fz);
+    now.x += fx * lean;
+    now.z += fz * lean;
+    // (0.1.1: his roll too. The view stayed at standing height through it, his body 1.5 m and more under it, so his
+    // arms let go of the player's hands until he stood again: sim b22 roll)
+    if ((info.flags & (kFlagDucking | kFlagRolling)) && !s_rig.crouch_physical) {
+      now.y -= eye * kJakDuckDropShare;
+    }
+  }
+  if (s_rig.anchor_valid) {
+    const Vec3 step = now - s_rig.anchor_was;
+    const float d = std::sqrt(step.x * step.x + step.y * step.y + step.z * step.z);
+    // A jump is a step well past how he is moving (kAnchorJumpMotions of his recent steps, plus the least): running is
+    // 0.16 m a frame, and a frame late (a hitch) brings 0.44 m at once (sim j1_run3). Those were eased as jumps, each
+    // putting the view a little further behind him, until it stood 0.8 m back and his body filled the view (sim j1_run1:
+    // his back and pack in front of the eyes). A stop (a wall) is never one. Up and down (a ledge's snap, a stair) from
+    // 0.25 m; along the ground from 0.6 m, past a run's start with a hitch in it (0.40 m at once, sim j1_wall3).
+    const float usual = quest::length(s_rig.anchor_motion);
+    const Vec3 past = step - s_rig.anchor_motion;
+    const float flat = std::sqrt(step.x * step.x + step.z * step.z);
+    const float flat_usual = std::sqrt(s_rig.anchor_motion.x * s_rig.anchor_motion.x +
+                                       s_rig.anchor_motion.z * s_rig.anchor_motion.z);
+    const bool jump_up = std::fabs(step.y) > kAnchorJumpLeast + kAnchorJumpMotions * std::fabs(s_rig.anchor_motion.y);
+    const bool jump_along = flat > kAnchorJumpAlong + kAnchorJumpMotions * flat_usual;
+    if (d > kAnchorJumpMost) {
+      s_rig.anchor_offset = {};
+      s_rig.anchor_motion = {};
+    } else if (jump_up || jump_along) {
+      // the part past his usual motion eased; his motion kept as it was
+      const Vec3 jump = past;
+      s_rig.anchor_offset = s_rig.anchor_offset - jump;
+      static int told = 0;
+      if (told < 20) {
+        ++told;
+        lg::info("[vr-cam] a jump of {:.2f} m eased (up {:.2f}, moving {:.2f} m a frame)", quest::length(jump) / 4096.0f,
+                 jump.y / 4096.0f, usual / 4096.0f);
+      }
+    } else {
+      s_rig.anchor_motion = scaled(s_rig.anchor_motion + step, 0.5f);
+    }
+  } else {
+    s_rig.anchor_motion = {};
+  }
+  s_rig.anchor_was = now;
+  s_rig.anchor_valid = true;
+  const float keep = std::pow(1.0f / 3.0f, kGameFrameSeconds / kAnchorEaseSeconds);
+  s_rig.anchor_offset = scaled(s_rig.anchor_offset, keep);
+  return now + s_rig.anchor_offset;
+}
