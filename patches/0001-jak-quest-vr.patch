+/* Jak and Daxter Quest VR: not on Android, whose stdio.h always declares fileno (included in a namespace by kmachine.cpp, a second declaration made it ambiguous with NDK 27.2) */
+#if !defined(_MSC_VER) && !((defined(_POSIX_C_SOURCE) && _POSIX_C_SOURCE >= 1) || defined(_XOPEN_SOURCE) || defined(_POSIX_SOURCE)) && !defined(MA_BSD) && !defined(__ANDROID__)
