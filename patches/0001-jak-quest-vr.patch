+void clear_mp_command() {
+  for (int i = 0; i < MAX_COMMAND_COUNT; i++) {
+    if (commandBuffer[i] == gMultiplayerInfo->teamrun_command) {
+      commandBuffer[i] = 0;
+      break;
+    }
+  }
+  gMultiplayerInfo->teamrun_command = 0;
+}
