+    (dispatch)(executor_,
+        spawned_thread_resumer(
+          default_spawned_thread_type::spawn(
+            spawn_entry_point<Executor, function_type, handler_type>(
+              executor_, ASIO_MOVE_CAST(F)(f),
+              ASIO_MOVE_CAST(Handler)(handler)),
+            proxy_slot, cancel_state)));
