+  template <typename Ex, class Prop>
+  static void query_fn_non_void(void*, const void*, const void*,
+      typename enable_if<
+        !asio::can_query<const Ex&, const Prop&>::value
+          && is_same<typename Prop::polymorphic_query_result_type, void>::value
+      >::type*)
+  {
+  }
