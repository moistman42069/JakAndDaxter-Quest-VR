+  lg::info("Multiplayer ready");
+  isConnectedToGame = true;
+
+  if (isConnectedOverSocket) {
+    gMultiplayerInfo->teamrun_command = 1;
+    sendConnectionAcknowledgement = true;
+    send_position_update();
+  }
+}
