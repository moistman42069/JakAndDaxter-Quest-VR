   (set! (-> this connection-list prev1) #f)
-  (set! (-> this main-thread) (new 'process 'cpu-thread this 'code 256 stack-pointer))
+  ;; Jak and Daxter Quest VR: 512 bytes of backup stack for a process with a big heap (an entity's, before it shrinks),
