+          ASIO_MOVE_CAST(T)(t),
+          ASIO_MOVE_CAST(P0)(p0)),
+        ASIO_MOVE_CAST(P1)(p1),
+        ASIO_MOVE_CAST(PN)(pn) ASIO_ELLIPSIS);
+  }
+};
