+(defmethod read-from-file teamruns-pc-settings ((obj teamruns-pc-settings) (filename string))
+  "read settings from a file"
+
+  (if (not filename)
+    (return #f))
+
+  (let ((file (new 'stack 'file-stream filename 'read)))
+    (when (not (file-stream-valid? file))
+      (return #f))
+
+    ;;Check version
+    (let ((version TEAMRUNS_SETTINGS_VERSION))
+      (with-settings-scope (file)
+        (case-str (file-stream-read-word file)
+          (("settings")
+            (set! version (file-stream-read-int file))
+            (cond
+              ((= (logand version #xffffffff00000000) (logand TEAMRUNS_SETTINGS_VERSION #xffffffff00000000))
+                ;; minor difference
+                )
+              (else
+                ;; major difference
+                (format 0 "Randomizer settings version mismatch! Got ~D.~D vs ~D.~D~%" TEAMRUNS_SETTINGS_VERSION_MAJOR TEAMRUNS_SETTINGS_VERSION_MINOR (bit-field int version 32 16) (bit-field int version 48 16))
+                (file-stream-close file)
+                (return #f)
+                )
+              )
+            ;;read through the file and set fields
+            (dosettings (file)
+              (case-str *pc-temp-string*
+                (("ui-teams") (set! (-> obj ui-teams) (file-stream-read-int file)))
+                (("ui-timer") (set! (-> obj ui-timer) (file-stream-read-int file)))
+                (("ui-splits") (set! (-> obj ui-splits) (file-stream-read-int file)))
+                (("ui-names") (set! (-> obj ui-names) (file-stream-read-int file)))
+                )
+              )
+            )
+          )
+        )
+
+      )
+      (inspect file)
+    (file-stream-close file)
+    )
+
+  (format 0 "pc settings file read: ~A~%" filename)
+
+  #t
+  )
+
+(defmethod load-settings teamruns-pc-settings ((obj teamruns-pc-settings))
+  "load"
+
+  (format (clear *pc-temp-string-1*) "~S/Mods/teamruns-pc-settings.gc" *pc-settings-folder*)
+  (if (pc-filepath-exists? *pc-temp-string-1*)
+    (begin
+      (format 0 "Teamruns settings found at '~S'...loading!~%" *pc-temp-string-1*)
+      (unless (read-from-file obj *pc-temp-string-1*)
+        (format 0 "Teamruns settings found at '~S' but could not be loaded, using defaults!~%" *pc-temp-string-1*)
+        (reset obj)))
+    (format 0 "Teamruns settings not found at '~S'...initializing with defaults!~%" *pc-temp-string-1*))
+  0
+  )
+  
+(defmethod new teamruns-pc-settings ((allocation symbol) (type-to-make type))
+  "make a new teamruns-pc-settings"
+  (let ((obj (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
+    (reset obj)
+    ;; auto load settings if available
+    ;; if saved settings are corrupted or not found, use defaults
+    (load-settings obj)
+    obj)
+  )
