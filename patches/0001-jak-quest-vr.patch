+bool party::game_ready() {
+  return isConnectedToGame && gMultiplayerInfo && gMultiplayerInfo->player_num >= 0;
+}
+
+// Another player's slot in Teamruns' table: index + 1 (0 is this game's own).
+bool party::game_slot_free(int index) {
+  const int slot = index + 1;
+  if (!game_ready() || index < 0 || slot >= MAX_MULTIPLAYER_COUNT || hasInteractionsBuffered)
+    return false;
+  const RemotePlayerInfo& p = gMultiplayerInfo->players[slot];
+  return p.mp_state != 0 && p.inter_type == 0;
+}
