+  constexpr Executor ex1 = {};
+  constexpr exec::blocking_t result1 = asio::query(ex1, Param());
+  ASIO_CHECK(result1 == ExpectedResult());
+#endif // defined(ASIO_HAS_CONSTEXPR)
+}
