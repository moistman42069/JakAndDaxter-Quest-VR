+(defun dm-orb-placer-select-func ((idx int) (msg debug-menu-msg))
+  (when (= msg (debug-menu-msg press))
+    (cond
+      ((= *orb-placer-selected-idx* idx)
+       ;; deselect
+       (set! *orb-placer-selected-idx* -1)
+       (set! *orb-placer-enabled?* #f))
+      (else
