+
+void publish(const nlohmann::json& update) {
+  std::lock_guard<std::recursive_mutex> lock(g_api);
+  if (!g_session) {
+    return;
+  }
+  watch_levels(update);
+  {
+    std::lock_guard<std::mutex> inner(g_session->mu);
+    // this game's level and power cells, for its line in the others' list of games
+    const auto at = update.find("position");
+    if (at != update.end() && at->is_object() && at->contains("currentLevel") && (*at)["currentLevel"].is_string()) {
+      const std::string where = level_name((*at)["currentLevel"].get<std::string>());
+      if (!where.empty()) {
+        g_session->where = where;
+      }
+    }
+    const auto state = update.find("state");
+    if (state != update.end() && state->is_object() && state->contains("cellCount") &&
+        (*state)["cellCount"].is_number()) {
+      g_session->cells = (*state)["cellCount"].get<int>();
+    }
+    if (!partying(g_session->mode)) {
+      return;
+    }
+    const auto pos = update.find("position");
+    const bool urgent = update.contains("state") || update.contains("levels") ||
+                        (pos != update.end() && pos->is_object() && pos->contains("interType"));
+    if (!urgent) {
+      g_session->pending = update;  // the next tick sends the latest
+      return;
+    }
+    g_session->pending = nullptr;
+  }
+  g_session->send(update);
+}
+
+}  // namespace party
diff --git a/game/party.h b/game/party.h
new file mode 100644
index 000000000..bdc14e962
--- /dev/null
+++ b/game/party.h
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+//
+// Parties for Teamruns' multiplayer (Jak 1), without Teamruns' app: one player's game hosts, the others' join it.
+//
+// Teamruns (github.com/JoKronk/teamruns-jak-project, ISC) puts the other players into the game: their Jaks, and the
+// cells, orbs, flies, crates and tasks they take, shared by a team. Its game listens on a websocket for its app
+// (game/multiplayer.cpp), which finds the other players through its author's own lobby service and passes each one's
+// "position" to the others as a "players" table. A party here does that part itself:
+//   - on the local network, the hosting game is the relay: it listens on TCP kPort and says so on UDP kBeaconPort, so
+//     the others' games list it;
+//   - over the internet, every game connects out to a party server (tools/party_server.py, the same protocol), named
+//     in party.txt by the launcher; there the server is the relay and keeps the list of games.
+// The protocol is newline-delimited JSON, one object a line; tools/party_server.py describes it. Everyone in a party
+// is one team: what one takes, everyone has.
+//
+// Multiplayer is a mod in the launcher's Mods (vr-options.txt "multiplayer"), on to start (owner, 2026-11-14): it
+// changes the game only in a party (game_on), so with nobody hosted or joined Jak 1 plays as it always has.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "third-party/json.hpp"
+
+namespace party {
+
+constexpr int kPort = 8120;        // TCP: a host's relay on the local network, and the party server
+constexpr int kBeaconPort = 8121;  // UDP: hosts on the local network say so here
+constexpr int kMaxPlayers = 8;     // in one party, its host too
+
+// A game the menu can join.
+struct Game {
+  std::string label;    // as the menu shows it
+  std::string host;     // the hosting player's name
+  std::string address;  // on the local network: the host's address; through the server: empty
+  std::string where;    // the host's level as the game names it ("Sentinel Beach"), or empty
+  int cells = -1;       // the host's power cells, or -1
+  int party = 0;        // the party's number at its relay
+  int players = 0;
+  bool lan = false;
+  bool same_build = true;  // a game on another release cannot be joined
+};
+
+// A player in this party, this game's own player too.
+struct Player {
+  int index = 0;  // 0 the host
+  std::string name;
+  bool me = false;
+};
+
+// A save slot of this game (Jak 1's four), from its memory card files.
+struct Slot {
+  bool present = false;
+  std::string where;  // the level it continues in
+  int cells = 0, orbs = 0, flies = 0, percent = 0;
+};
+
+// The game's side (its thread; the menu's calls may come from another).
+void update(bool multiplayer_on);  // every frame (pc-multiplayer-on?): starts and stops the party's thread
+// Multiplayer is on (the mod: the menu can host, browse and join). On to start; it changes nothing in the game until a
+// party starts, and opens no port until the player browses, hosts or joins.
+bool on();
+// Teamruns' side of the game runs: hosting, joining or in a party, or just left one (the others' Jaks put away).
+// Only then are the in-game scenes skipped and the taunts on the d-pad (pc-multiplayer-on?).
+bool game_on();
+bool in_party();
+bool hosting();
+void host();
+void join(const Game& game);
+void leave();
+void browse();              // the menu's games are shown: hear the local network's and ask the party server, from now on
+std::vector<Game> games();  // found on the local network and on the party server
+std::vector<Player> players();  // in this party
+void remove(int index);         // the host: that player out of the game
+std::string status();       // a line for the menu's help: "Hosting on this network: 2 players", "That game is full.", ...
+std::string short_status();  // a few words for the menu's value column: "None", "Hosting (2)", "Joined (3)", ...
+std::string my_name();
+void publish(const nlohmann::json& update);  // this player's Teamruns update ("position", "state", "levels")
+
+// Saves (Ratchet's Multiplayer asks the same: "Host which save?", "Play which save?").
+std::vector<Slot> slots();  // this game's four
+void play_slot(int slot);   // load that save (the game's own load)
+void play_new_game();       // a new game, saved nowhere until saved from the pause menu
+void play_host_copy();      // a member: the host's progress, sent by the host's game; this game's own saves untouched
+std::string save_status();  // what is happening with a save for the menu ("Receiving the host's progress...")
+// The game's side of it (kmachine.cpp, Jak 1's pc-vr.gc vr-party-saves), on the game's thread.
+int save_ask();                                   // 0, or what pc-vr.gc is to do: kind | slot << 4
+void save_made(const std::uint8_t* data, int length);  // the host: its progress as a save, for the members who asked
+int save_copy_into(std::uint8_t* to, int most);   // a member: the host's progress into the game's buffer; its length
+void save_done(int kind, bool ok);                // pc-vr.gc did it (or could not)
+constexpr int kSaveLoadSlot = 1, kSaveNewGame = 2, kSaveMakeCopy = 3, kSaveLoadCopy = 4;
+
+// Implemented by game/multiplayer.cpp, called on the game's thread (from update): the others into Teamruns' tables.
+bool game_ready();                // the game's Teamruns side is set up (pc-connect-mp-info)
+bool game_slot_free(int index);   // the other player index's Jak takes an interaction this frame
+void game_joined(int my_index, const std::string& my_name);
+void game_left();
+// One of the others' updates (as publish's), or with replay one interaction again ("interaction" object) to clean
+// up a level this game has just loaded: what the others took there while it was not loaded here.
+void game_player(int index, const std::string& name, const nlohmann::json& update, bool replay);
+void game_player_left(int index);
+
+}  // namespace party
