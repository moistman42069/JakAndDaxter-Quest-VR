+      }
+      else
+      {
+        const std::size_t bytes_copied = asio::buffer_copy(
+            buffers_, storage_.data(), storage_.size());
+        storage_.consume(bytes_copied);
+        ASIO_MOVE_OR_LVALUE(ReadHandler)(handler_)(ec, bytes_copied);
