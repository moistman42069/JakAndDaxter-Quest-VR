+
+  // Terminal cancellation works. Operation completes with failure.
+  signal.emit(asio::cancellation_type::terminal);
+
+  ioc.run();
+
+  ASIO_CHECK(ioc.stopped());
+  ASIO_CHECK(count == 1);
+  ASIO_CHECK(result == false);
+}
