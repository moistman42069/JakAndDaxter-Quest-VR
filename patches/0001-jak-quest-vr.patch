@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+//
+// Jak and Daxter Quest VR: the headset in OpenGOAL's runtime, for Jak 1, Jak II and Jak 3 alike.
+//
+// Three threads meet here:
+// - the display thread (GLDisplay::render): the headset's frames, the eyes and the panel drawn from the game's chain;
+// - the game thread (GOAL, the EE): the head in the game's camera (pc-vr-camera!), the body, the pad (scePadRead);
+// - neither keeps the other waiting longer than a mutex for a copy of a few hundred bytes.
+//
+// Units: the games' world is Y up, 4096 units a metre. OpenXR's tracking space is metres, Y up, -Z ahead.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace jakvr {
+
+// ---- Set-up ----
+
+// VR is wanted: always on the Quest; on a PC with JAKVR=1 (OpenXR, SteamVR or Link) or JAKVR_SIM_SCRIPT (the
+// simulated headset that tests drive).
+bool wanted();
+
+// The game being run (GameVersion as an int: 1 Jak 1, 2 Jak II, 3 Jak 3).
+void set_game(int game_version);
+
+// ---- Display thread ----
+
+// What a pass of the renderer over the frame's chain draws.
+enum class PassKind { kWindow, kEye, kHud, kFlat };
+
+struct Pass {
+  PassKind kind = PassKind::kWindow;
+  int eye = 0;               // kEye: 0 left, 1 right
+  unsigned target_fbo = 0;   // where the pass's picture goes (0: the window)
+  int width = 0, height = 0;  // its size
+  float shift_cam[3] = {0, 0, 0};    // the eye from the game's camera, in camera space (x left, y up, z ahead), units
+  float shift_world[3] = {0, 0, 0};  // and in the world
+  bool first_of_frame = true;      // the frame's first pass: once-a-frame work (texture animation, sky blend) runs
+  int render_width = 0, render_height = 0;  // the game's render buffer, the same for all of a frame's passes
+};
+
+// The pass being drawn now (kWindow outside VR).
+const Pass& pass();
+
+// Starts a display frame; true: this display frame is the headset's (the caller draws through draw_passes and
+// end_frame, and does not swap the window unless mirror() says so).
+bool begin_frame(int window_width, int window_height);
+
+// Draws the frame's passes with `draw`, which renders the game's chain once into pass(); `have_chain`: the game sent
+// a new frame (else the eyes keep their last pictures).
+void draw_passes(bool have_chain, void (*draw)(void* user), void* user);
+
+// Ends the display frame begun; `window_width/height`: the window, for the PC's mirror of the left eye.
+void end_frame(int window_width, int window_height);
+
+// The PC's window shows the left eye (swapped as before); the Quest's is not swapped.
+bool mirror_window();
+
+// VR is drawing (the headset's session runs).
+bool on();
+// The headset's session ended (the app closed on the Quest, a test's "quit"): the game should end.
+bool exit_wanted();
+
+// Whether the game thread is let go for its next frame now (the games run 60 frames a second whatever the
+// headset's rate).
+bool release_game();
+
+// The game sent its chain for a frame (game thread, from __send-gfx-dma-chain): what the frame was made with goes
+// with it to the display thread.
+void chain_sent();
+
+// Whether a bucket of the game's chain is drawn in this pass (the HUD's in the panel, the world's in the eyes).
+bool bucket_drawn(int bucket_id);
+
+// The HUD's own models: what Generic2 draws by the game's HUD matrix (Jak 1's power cells, orbs and flies by their
+// counts, Jak II and 3's icons beside their numbers, the pause menu's), in the world's buckets, at a place on the
+// game's screen. Drawn in the eyes, they stood at that place of each eye's whole view, off to the side of the HUD
+// panel's numbers (Vixel, 0.1.1: "jak 2 hud collectable colors off to the side of their values"); they go on the HUD
+// panel with the rest of it. `bucket_has`: the bucket being drawn holds some this frame. Returns whether this pass
+// draws them: the HUD pass (which draws such a bucket for them alone, hud_models_only()), an eye pass only when this
+// frame's HUD pass did not (the first frame they show), and every other pass as before.
+bool hud_models_drawn(bool bucket_has);
+// The HUD pass: Generic2 draws only the HUD's models of the buckets it is given (the rest is the eyes').
+bool hud_models_only();
+
+// The eye shift, for the renderers. A matrix of 4 rows (x, y, z, translation), points as rows times it, its input in
+// camera space (`camera_space`) or the world: changed to the matrix as seen from the pass's eye. Nothing outside an
+// eye pass.
+void shift_matrix(float* rows16, bool camera_space);
+// The same for a camera position (world units): moved to where the pass's eye is.
+void shift_position(float* trans3);
+// The shift in camera space (0 outside an eye pass), for shaders that take it as a uniform.
+void shift_camera_space(float out[3]);
+
+// Smoother frames (AppSW): the eye pass's world camera as the background's shaders take it (background_common's
+// pc_camera: 4 columns, the vertex less the camera's place in, the clip position negated out), the eye's place (the
+// shifted camera's, world units) and the shaders' y scale (SCISSOR_ADJUST times HEIGHT_SCALE). Nothing outside an eye
+// pass; the pass's first is kept (all its background draws share it).
+void note_eye_camera(const float* pc_camera16, const float* eye_trans3, float y_scale);
+// An eye pass is drawn: `render_fbo` (width x height) holds its depth, made into the eye's motion and depth images.
+void eye_drawn(unsigned render_fbo, int width, int height);
+// An eye pass: the matrix that takes a draw the game made on the screen already (the ocean, Jak 1's shadows: points
+// projected from between the eyes, by the CPU or an emulated VU program) to this eye's view, applied to its
+// gl_Position (the shaders' vr_reproject, set by Shader::activate). Anything else: the identity.
+void reproject_matrix(float out16[16]);
+
+// ---- Game thread ----
+
+// The head in the game's camera: `inv_rot` (4 rows of 4 floats, camera to world: right, up, ahead) and `trans`
+// (4 floats) of the math camera, changed in place; `info` the game's facts (VrCameraInfo, GOAL's vr-camera-info).
+// Bits: 1 first person (the game hides Jak's head), 2 the eyes see the game in stereo (the letterbox left out).
+int camera(void* inv_rot, void* trans, const void* info);
+// The frustum the eyes need, for update-math-camera: tan of half the field across and up, or false to keep the
+// game's own (not in VR, or a flat view).
+bool frustum(float& x_ratio, float& y_ratio);
+// The mode the game last told (VrMode), -1 before.
+int game_mode();
+// A shot from the hand ("Aim with your hand" on): Jak 1's yellow eco from the hand that last punched (else the right);
+// Jak II and 3's gun where the player aims it, in first person only (the right hand's aim, or from the right hand to
+// the left with both on it: Two-hand grip). `pos` (4 floats, units) gets the hand's place in first person; `dir`
+// (4 floats) where it points. 0: keep the game's shot; 1: `dir` only (third person, the shot leaves Jak's own hand);
+// 2: `pos` and `dir`.
+int hand_shot(float* pos, float* dir);
+// Jak's body in first person, once a game frame after the joint math and the camera (pc-vr-body!): `info` a
+// VrBodyInfo, `memory` the start of the game's memory (its addresses are offsets from it). Poses his skeleton's bones
+// in place (arms to the controllers, fingers to the player's, the head as the player's, seen in the shadow) and says
+// what the eyes leave out of the frame being made (his head, Daxter at the eyes). 1 when the body was posed.
+int body(const void* info, std::uint8_t* memory);
+// Multiplayer (Jak 1's parties, game/party.h): each VR player's posed body on his Jak in the others' games, as
+// Ratchet's parties show heads, hands and fingers. All on the game thread. `trans` his root's place (units) and `quat`
+// its turn (x y z w), as Teamruns sends them with his position, so the pose rides on his Jak wherever the others see it.
+// pose_publish: after body() posed him (`posed` 1; 0 when it did not, and the others then show the game's own Jak), his
+// named joints from the same `info` become this player's word, which pose_word gives (base64, "" for none) for the
+// party's update. pose_heard: the word another player (party index) sent. pose_other: another player's Jak, `info`
+// filled from his skeleton as body()'s is, posed by his player's word when it is under a second old; 1 when posed.
+void pose_publish(const void* info, const float* trans, const float* quat, int posed, std::uint8_t* memory);
+std::string pose_word();
+void pose_heard(int player, const std::string& word);
+int pose_other(int player, const void* info, const float* trans, const float* quat, std::uint8_t* memory);
+// Before body() each frame (pc-vr-hand-probes!): the lines to probe the world along for the hands, into `info`'s
+// probe_from and probe_to (a VrBodyInfo in the game's memory). Gives how many (0: none this frame).
+int hand_probes(void* info);
+// More joints an eye pass leaves out of a model, each group shrunk to its own joint's place (the slot `root`'s matrix
+// applied to `at`) rather than to the head's point: a part by his face that is not under his neck, which stretched
+// across the view when it went to the neck's point (sim j1_down11).
+struct MercHideGroup {
+  int root = -1;
+  float at[3] = {0, 0, 0};
+  std::uint8_t slots[16] = {};
+};
+constexpr int kMercHideGroups = 4;
+// Merc's model `name` in the pass being drawn (display thread): false, all of it drawn; true, `hidden` (16 bytes, a
+// bit a joint slot) its slots left out, which the caller collapses to one point: the slot `root`'s matrix applied to
+// `at` (the model's own place of that joint), or `root_alt`'s when the model sent no matrix for `root` (no vertex on
+// that joint), or with neither (-1) any hidden slot's own place; and `group_count` of `groups`, each to its own point.
+// `cut` (16 bytes, a bit a slot): the parts the VR menu's Body shown leaves out (arms, legs, his body), not moved but
+// cut away where their joints carry more than half of a point's skin (the merc shaders' vr_cut), so what stays ends
+// cleanly with nothing stretched; all zero for none. `fade` (128 bytes, one a slot, 0 to 255): how far that joint's
+// part of him is faded out of the eyes just now (0.1.1: a leg swung up before the eyes, his body and legs in a roll or
+// a flip), eased over a few frames by body() so it goes and comes back smoothly; the merc shaders dither by it
+// (vr_fade), and a slot at 255 is as good as cut.
+bool merc_hidden(const char* name, std::uint8_t hidden[16], int& root, int& root_alt, float at[3],
+                 MercHideGroup groups[kMercHideGroups], int& group_count, std::uint8_t cut[16],
+                 std::uint8_t fade[128]);
+// PC test aid (JAKVR_BODY_TRACE=2): the point the hidden head shrinks to as merc draws it in the left eye's pass, in
+// that eye's camera space, logged with the drawn frame's number (body()'s lines have the same numbers). Else nothing.
+void merc_trace_point(const char* name, const float point[4]);
+// PC test aid (JAKVR_BODY_TRACE=2), from Jak 1's bones.gc as each model's skinning matrices are made (`matrices`,
+// `bones`, `count` and `camera` EE addresses and the bone count): for Jak's, the head point as skinned in the camera,
+// and how far the camera and his neck base's bone then are from where camera() placed and body() posed them. Else
+// nothing.
+void skin_trace(std::uint8_t* memory, std::uint32_t matrices, std::uint32_t bones, int count, std::uint32_t camera);
+// A glow sprite's share of its light in this pass (Jak II and 3's Sprite3_Glow): 1, but in an eye pass in first
+// person it fades to nothing as the point its flare is drawn at (`z_offset` nearer the eye than the light, `depth`
+// ahead of it, both in game units) comes within 2 m to half a metre of the eye: there the flare, a picture of the light
+// facing the camera, grew to fill the eye's whole view (Jak 3's Spargus light beam whited out the view for a moment as
+// Jak walked through it, sim 2026-11-14). `flare` and `flare_max` (its size on screen, and the game's most) are only
+// logged. PC test aid: JAKVR_GLOW_TRACE=1 logs, in the left eye, each glow faded or drawn within 4 m of it.
+float glow_near_fade(float depth, float z_offset, float flare, float flare_max);
+// Jak's own merc models near the eyes in first person (0.1.1, the owner: "certain actions seem to clip in the eyes"):
+// his body (this frame's hidden[0] model, its parts too) and the gun in his hand ("gun-...") fade out, dithered, as
+// they come into the eyes, so nothing of him is cut open by the eyes' near plane (5 cm). Returns whether `name` fades
+// in this pass, with `gone` (nearer is not drawn) and `full` (all of it drawn from here) in camera units from the eye.
+// Never another player's Jak (the caller leaves those out), the panel, the HUD or a third-person view.
+bool merc_near_fade(const char* name, float& gone, float& full);
+// Whose model a merc draw is, as Jak 1 tags it (bones.gc pc-merc-draw-request: the name's 128 bytes end with this
+// magic, then the tag). Another player's Jak (Teamruns' multiplayer, the same model as the player's own) is
+// never left out by name: shown whole, or all of it left out of the eyes while it stands in the player's own body.
+// Untagged (Jak II and 3) or 0: by name, as merc_hidden says.
+constexpr std::uint32_t kMercWhoMagic = 0x52564a4bu;
+constexpr std::uint32_t kMercWhoOther = 2;
+constexpr std::uint32_t kMercWhoOtherInside = 3;
+// The controllers as pad `port`'s report (CPadInfo, filled by scePadRead before).
+void fill_pad(int port, std::uint8_t* cpad);
+// The game's rumble on pad `port`.
+void rumble(int port, int small_motor, int big_motor);
+// The menu pointer on the games' 512 by 416 screen, for their own menus (pc-vr-pointer, each game's pc-vr.gc): 0 when
+// it is on no menu; else bit 1, bit 2 when it moved since the last ask (the menu chooses the row under it), bit 4 when
+// a click waits for that row.
+int menu_pointer_at(float& x, float& y);
+// The game's menu chose the row under the pointer (pc-vr-pointer-hit!): a click there is Cross.
+void menu_pointer_hit();
+// A game menu's two-way choice (On / Off, Yes / No) with the pointer on one side of it (pc-vr-pointer-side!): d-pad
+// left (dir < 0) or right once, as the menu takes the d-pad.
+void menu_pointer_side(int dir);
+// Jak II and 3: a round of the gun fired (pc-vr-gun-fired!, from target-gun-fire), `ammo` its ammo (0 yellow, 1 red,
+// 2 blue, 3 dark): a kick in the gun's hand by gun.
+void gun_fired(int ammo);
+// Jak II and 3: the game's chosen gun changed (pc-vr-gun-switched!, gun-util.gc vr-gun-switch-check!), `gun` its gun
+// type now: a quick buzz in the gun's hand, with the VR menu's "Buzz on gun switch".
+void gun_switched(int gun);
+// Jak II and 3, the holsters (pc-vr-holster, gun-util.gc vr-holster!): what the grips did at the hip or over the
+// shoulder since the last ask, as bits, then forgotten. The game draws the gun (without the shot R1 would fire with it)
+// or puts it away, by whether it is drawn.
+constexpr int kHolsterGripped = 1;         // a grip squeezed at a holster: the gun drawn, if it is away
+constexpr int kHolsterBroughtBack = 2;     // a grip squeezed elsewhere let go at a holster: the gun put away
+constexpr int kHolsterLetGoThere = 4;      // a grip squeezed and let go at a holster: away, unless that squeeze drew it
+int holster();
+// The VR options the game's own graphics settings follow while VR draws (pc-vr-graphics, each game's pc-vr.gc
+// vr-graphics!): kGraphicsMaxDistance, every actor at any distance and each model at its highest detail. 0 with VR off.
+constexpr int kGraphicsMaxDistance = 1;
+// 0.1.1: kGraphicsPs2Detail, the distances, effects and shadows the PlayStation 2 drew (the VR menu's PS2 detail, over
+// Max draw distance); and from bit 8, the game's frames a second (the VR menu's Game frame rate).
+constexpr int kGraphicsPs2Detail = 2;
+int graphics();
+// The texture filter a texture is made with (each place the renderer sets GL_TEXTURE_MAX_ANISOTROPY): `most`, the
+// graphics chip's highest, or less as the launcher's Anisotropic filtering says while VR is wanted.
+float anisotropy(float most);
+// The anti-aliasing the eyes draw with: the launcher's (VR) or the game's own `game_samples`.
+int msaa_samples(int game_samples);
+#if defined(_WIN32)
+// PC test aid (crash_dump_win.cpp): with JAKVR_CRASH_DUMP=<folder>, the first access violation's registers, stack and
+// the game's memory written there. Called once at start.
+void install_crash_dump();
+#endif
+
+// What GOAL's vr-camera-info holds (pc/vr.gc in each game).
+struct VrCameraInfo {
+  std::int32_t mode;      // VrMode
+  std::int32_t flags;     // VrFlag bits
+  float target_yaw;       // Jak's facing (radians about Y, the world's +Z at 0, +X at pi/2)
+  float pad0;
+  float head[4];          // Jak's head (between the eyes) in the world, units
+  float target_trans[4];  // Jak's root
+  float camera_trans[4];  // the game's camera as it stands (before the head)
+};
+
+enum VrMode : std::int32_t {
+  kModePlay = 0,      // on foot or riding, the game playing
+  kModeMovie = 1,     // a cutscene
+  kModeMenu = 2,      // paused, the progress menu, a menu over play
+  kModeTitle = 3,     // the title and its menus
+  kModeLoading = 4,   // a blackout or a load
+};
+
+enum VrFlag : std::int32_t {
+  kFlagTarget = 1,           // Jak is there (head and target_trans hold)
+  kFlagFirstPersonOk = 2,    // first person suits what he is doing (on foot, not riding or in a minigame)
+  kFlagLookAround = 4,       // the game's own first-person look (Triangle)
+  kFlagGrabbed = 8,          // the game holds him (a scene in play, a talk)
+  kFlagOnGround = 16,        // standing on something (in the air, the crouch button is the dive)
+  kFlagDucking = 32,         // in the game's crouch (duck stance or duck walk)
+  kFlagDrawn = 64,           // the Jak whose head is in `head` is drawn (in Jak II and 3's scenes, the scene's own Jak)
+  kFlagSceneJak = 128,       // `head` is a Jak II or 3 scene's own high-res Jak (surely in the scene)
+  kFlagVehicle = 256,        // riding something whose seat the view can sit in (vr-vehicle-first-person-ok?, 0.1.1)
+  kFlagGun = 512,            // Jak II and 3: he has a gun and may draw it here, so the holsters count (0.1.1)
+  kFlagRolling = 1024,       // in his roll (Jak 1's target-wheel, Jak II and 3's target-roll): the view low, as crouched (0.1.1)
+  kFlagBoard = 2048,         // Jak II and 3: on the JET-Board (the right stick's click is its R2 there, as on foot; 0.1.1)
+};
+
+// What GOAL's vr-body-info holds (pc/pc-vr.gc in each game): the skeleton of the Jak the eyes are in, this frame.
+constexpr int kBodyNodesMost = 128;
+constexpr int kBodyNamed = 48;
+constexpr int kBodyProbes = 8;  // 0.1.1: 4 more (under each palm, each wrist's straps)
+constexpr int kGunBonesMost = 64;  // 0.1.1: Jak 3's gun has its magazines on joints 36 to 39 (item 10)
+constexpr int kDaxBonesMost = 64;
+struct VrBodyInfo {
+  std::int32_t count;        // nodes (cspaces) in his node list
+  std::int32_t flags;        // VrBodyFlag bits
+  std::uint32_t key;         // the node list's address: a new one is a new skeleton
+  std::int32_t pad;
+  std::int16_t named[kBodyNamed];  // BodyJoint: the node of each named joint, -1 where the skeleton has none
+  char jak_name[64];         // his merc model's name ("eichar-lod0", "jakb-lod0", a scene's "jak-highres-lod0")
+  char dax_name[64];         // Daxter's, when he is hidden from the eyes
+  std::int8_t parent[kBodyNodesMost];   // each node's parent node, -1 for none
+  std::uint32_t bone[kBodyNodesMost];   // each node's bone (its world matrix, 4 rows of 4), a game address; 0 none
+  std::uint32_t bind[kBodyNodesMost];   // its joint's bind pose (the inverse of its frame as made), 0 none
+  // The hands against the world (list item 25): lines the runtime asks about (hand_probes), each a sphere moved from
+  // `from` to `to` (w: its radius), which the game probes against its level and solid objects; `hit` xyz the normal of
+  // what it met, w how far along the line (0 to 1), negative for nothing. Read by body() the same frame.
+  std::int32_t probe_count;
+  std::int32_t probe_pad[3];
+  float probe_from[kBodyProbes][4];
+  float probe_to[kBodyProbes][4];
+  float probe_hit[kBodyProbes][4];
+  // Jak II and 3's gun (list items 27 and 28): its process's bones, made this frame from his gun joint as that was when
+  // the gun's process ran (body()'s pose of the frame before). body() carries them on to where it poses the gun joint
+  // now, so the gun stays in his hand, and turns the hand so the barrel points where the player aims.
+  std::int32_t gun_count;    // its bones (0: no gun, as in Jak 1)
+  std::int32_t gun_flags;    // VrGunFlag bits
+  std::int32_t gun_barrel;   // its bone whose z row is where it shoots
+  std::int32_t gun_pad;      // the gun's own node count (the body trace's; gun_count is at most kGunBonesMost)
+  std::uint32_t gun_bone[kGunBonesMost];
+  float gun_root[4][4];      // the gun's root as its process placed it this frame (rows: its axes, then its place)
+  // Daxter on his shoulder in play (pc-vr.gc vr-dax-fill!): his bones, posed by his animation on Jak's animated body,
+  // which body() carries with Jak's chest as it poses him, so Daxter and his shadow stay on the posed shoulder.
+  std::int32_t dax_count;
+  std::int32_t dax_pad[3];
+  std::uint32_t dax_bone[kDaxBonesMost];
+};
+static_assert(sizeof(VrBodyInfo) == 2400, "VrBodyInfo must match vr-body-info in each game's pc-vr.gc");
+
+enum VrGunFlag : std::int32_t {
+  kGunInHand = 1,  // drawn, in his right hand (the game's using-gun?)
+};
+
+// The probes, in order: each hand's palm (from the shoulder), then each hand's fingers (from the palm).
+// 0.1.1: then what lies under each palm (the way the palm faces, for the fingers to rest on), and Jak 1's wrist straps
+// (from each wrist along where its straps hang).
+enum BodyProbe : int {
+  kProbePalmLeft = 0,
+  kProbePalmRight = 1,
+  kProbeFingersLeft = 2,
+  kProbeFingersRight = 3,
+  kProbeUnderLeft = 4,
+  kProbeUnderRight = 5,
+  kProbeStrapLeft = 6,
+  kProbeStrapRight = 7,
+};
+
+enum VrBodyFlag : std::int32_t {
+  kBodyPose = 1,        // posed: Jak himself in play, the view in his eyes
+  kBodyHideHead = 2,    // his head left out of the eyes (still in the shadow)
+  kBodyHideDaxter = 4,  // Daxter left out of the eyes
+};
+
+// The named joints (the same names in all three games).
+enum BodyJoint : int {
+  kJointNeck = 0,   // neckB (else head): the head and all on it hang from it
+  kJointMain = 1,
+  kJointChest = 2,
+  kJointGun = 3,    // Jak II and 3
+  kJointSide = 4,   // + 16 a side (0 left, 1 right), then:
+  kSideShoulder = 0, kSideArm = 1, kSideForearm = 2, kSideHand = 3,
+  kSideThumbA = 4, kSideThumbB = 5, kSideIndexA = 6, kSideIndexB = 7, kSideMiddleA = 8, kSideMiddleB = 9,
+  kSideRingA = 10, kSideRingB = 11, kSidePinkyA = 12, kSidePinkyB = 13,
+  kSideThigh = 14, kSideKnee = 15,
+  kJointAnkle = 36,  // + side
+  kJointHips = 38,   // the legs and the spine hang from it
+  kJointUpper = 39,  // upper_body: the spine's first, under the chest
+  kJointHideFirst = 40,  // to kBodyNamed: more joints left out of the eyes with his head (collar flaps, horns)
+};
+
+}  // namespace jakvr
diff --git a/game/vr/notice.h b/game/vr/notice.h
new file mode 100644
index 000000000..1c1a14f88
--- /dev/null
+++ b/game/vr/notice.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// A line of words the headset can show with nothing of the game's: the port's own notices are drawn
+// on its window, which a headset does not see. Capitals and spaces in a 5 by 7 font, on an RGBA8
+// picture whose first row is the bottom, as a GL texture's. Plain data (tests/rig_pad_test.cpp).
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace quest {
+
+inline constexpr int kNoticeWidth = 1120;
+inline constexpr int kNoticeHeight = 72;
+
+// Each letter's five columns, the low bit at the top.
+inline constexpr std::uint8_t kNoticeFont[26][5] = {
+    {0x7C, 0x12, 0x11, 0x12, 0x7C}, {0x7F, 0x49, 0x49, 0x49, 0x36}, {0x3E, 0x41, 0x41, 0x41, 0x22},
+    {0x7F, 0x41, 0x41, 0x41, 0x3E}, {0x7F, 0x49, 0x49, 0x49, 0x41}, {0x7F, 0x09, 0x09, 0x09, 0x01},
+    {0x3E, 0x41, 0x41, 0x51, 0x73}, {0x7F, 0x08, 0x08, 0x08, 0x7F}, {0x00, 0x41, 0x7F, 0x41, 0x00},
+    {0x20, 0x40, 0x41, 0x3F, 0x01}, {0x7F, 0x08, 0x14, 0x22, 0x41}, {0x7F, 0x40, 0x40, 0x40, 0x40},
+    {0x7F, 0x02, 0x1C, 0x02, 0x7F}, {0x7F, 0x04, 0x08, 0x10, 0x7F}, {0x3E, 0x41, 0x41, 0x41, 0x3E},
+    {0x7F, 0x09, 0x09, 0x09, 0x06}, {0x3E, 0x41, 0x51, 0x21, 0x5E}, {0x7F, 0x09, 0x19, 0x29, 0x46},
+    {0x26, 0x49, 0x49, 0x49, 0x32}, {0x03, 0x01, 0x7F, 0x01, 0x03}, {0x3F, 0x40, 0x40, 0x40, 0x3F},
+    {0x1F, 0x20, 0x40, 0x20, 0x1F}, {0x3F, 0x40, 0x38, 0x40, 0x3F}, {0x63, 0x14, 0x08, 0x14, 0x63},
+    {0x03, 0x04, 0x78, 0x04, 0x03}, {0x61, 0x59, 0x49, 0x4D, 0x43},
+};
+
+// `text` in white on a dark bar, centred; what the font lacks is a space.
+inline std::vector<std::uint8_t> render_notice(const char* text) {
+    constexpr int kScale = 4;
+    constexpr int kAdvance = 6 * kScale;
+    std::vector<std::uint8_t> rgba(static_cast<std::size_t>(kNoticeWidth) * kNoticeHeight * 4);
+    for (std::size_t i = 0; i < rgba.size(); i += 4) {
+        rgba[i] = 0x70;
+        rgba[i + 1] = 0x10;
+        rgba[i + 2] = 0x10;
+        rgba[i + 3] = 0xE0;
+    }
+    int count = 0;
+    while (text[count] != 0) {
+        ++count;
+    }
+    int x = (kNoticeWidth - count * kAdvance) / 2;
+    const int top = (kNoticeHeight - 7 * kScale) / 2;
+    for (int i = 0; i < count; ++i, x += kAdvance) {
+        const char c = text[i];
+        const int letter = c >= 'A' && c <= 'Z' ? c - 'A' : c >= 'a' && c <= 'z' ? c - 'a' : -1;
+        if (letter < 0) {
+            continue;
+        }
+        for (int column = 0; column < 5; ++column) {
+            for (int row = 0; row < 7; ++row) {
+                if ((kNoticeFont[letter][column] >> row & 1) == 0) {
+                    continue;
+                }
+                for (int py = 0; py < kScale; ++py) {
+                    for (int px = 0; px < kScale; ++px) {
+                        const int at_x = x + column * kScale + px;
+                        const int at_y = kNoticeHeight - 1 - (top + row * kScale + py);
+                        if (at_x < 0 || at_x >= kNoticeWidth || at_y < 0 || at_y >= kNoticeHeight) {
+                            continue;
+                        }
+                        std::uint8_t* pixel = &rgba[(static_cast<std::size_t>(at_y) * kNoticeWidth
+                                                     + static_cast<std::size_t>(at_x)) * 4];
+                        pixel[0] = pixel[1] = pixel[2] = pixel[3] = 0xFF;
+                    }
+                }
+            }
+        }
+    }
+    return rgba;
+}
+
+}  // namespace quest
diff --git a/game/vr/pad.h b/game/vr/pad.h
new file mode 100644
index 000000000..9c148660a
--- /dev/null
+++ b/game/vr/pad.h
@@ -0,0 +1,710 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// Touch controllers as the game's pad: what each control means in each phase of play, and the pad
+// report it makes. Plain data, apart from OpenXR and the game (tests/rig_pad_test.cpp).
+//
+// The table is Rerac-vr's (npiriou, ISC; vr/game_input.rs), so a player of the PC VR mod finds the
+// same buttons. In play:
+//
+//   left stick   walk                      right stick  turn; click: talk, quick select (Triangle)
+//   A            jump (Cross)              B            hover, strafe, Hydro-Pack boost (R2)
+//   X            map (Select); in a scene, its view (the mod's)   Y   pause, skip a scene (Start)
+//   right trigger  fire (Circle)           right grip   the wrench, swung for real (Square)
+//   left grip, left trigger  crouch, the packs (R1); with Physical crouch in first person, the trigger alone
+//
+// Mounted (a turret, a flown ship) X and B keep Circle and Square; on a turret the left stick steers
+// it, the trigger fires it and the right stick's click leaves it. In a menu, where Rerac-vr has a
+// pointer this port has not yet, A or the trigger confirm: Cross, and Circle as well, as the game's
+// memory card questions ask for Yes with Circle. B goes back (Triangle), either stick moves, the left
+// grip and trigger are the page shoulders L1 and R1.
+//
+// On the big screen (the launcher's 2D mode) the controllers are simply a pad, an Xbox controller's
+// layout: A Cross, B Circle, X Square, Y Triangle, the grips L1 and R1, the triggers L2 and R2 (to
+// 0.1.18 the other way round), the menu button Start, the left stick's click Select, the right's R3,
+// and the sticks are its sticks. So are they in third person with the launcher's Third person controls
+// on Gamepad (0.1.19, the owner's ask; its default), in the menus too, where A and the trigger still
+// answer as in VR (the pointer). The pad's D-pad (the launcher's "D-pad"): a stick is it while its
+// controller is held up by the side of the head, or the right stick while the left thumb rests on its
+// thumb rest; that stick is then nothing else, and its click is L3 or R3. First person keeps the table
+// above.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "rig.h"
+
+namespace quest {
+
+// The pad's buttons, set while held (openrac_mod.h's OPENRAC_PAD_*).
+enum PadBit : std::uint16_t {
+    kPadSelect = 0x0001,
+    kPadL3 = 0x0002,
+    kPadR3 = 0x0004,
+    kPadStart = 0x0008,
+    kPadUp = 0x0010,
+    kPadRight = 0x0020,
+    kPadDown = 0x0040,
+    kPadLeft = 0x0080,
+    kPadL2 = 0x0100,
+    kPadR2 = 0x0200,
+    kPadL1 = 0x0400,
+    kPadR1 = 0x0800,
+    kPadTriangle = 0x1000,
+    kPadCircle = 0x2000,
+    kPadCross = 0x4000,
+    kPadSquare = 0x8000,
+};
+
+// The controllers this tick.
+struct Controls {
+    float left_x = 0, left_y = 0;    // sticks, -1..1, up positive
+    float right_x = 0, right_y = 0;
+    float left_trigger = 0, right_trigger = 0;
+    float left_grip = 0, right_grip = 0;
+    bool a = false, b = false, x = false, y = false;
+    bool menu = false;           // the left controller's menu button
+    bool left_click = false, right_click = false;
+    // The controllers' touch sensors: a first finger on the trigger, a thumb on a button, the stick or the thumb rest.
+    bool left_first_touch = false, right_first_touch = false;
+    bool left_thumb_touch = false, right_thumb_touch = false;
+    bool left_rest_touch = false;  // the left thumb on its thumb rest, that sensor alone (the D-pad's "Left thumb rest")
+    // Whether the left controller has that thumb rest sensor: a Quest's Touch does; on PC VR an Index, Vive wand or
+    // Windows Mixed Reality controller does not, and the d-pad is then the left hand at the head.
+    bool left_rest_sensed = true;
+    // Whether the left menu button reaches the game: SteamVR keeps a Touch controller's for its dashboard (Vixel, 0.1.0),
+    // and the left stick's click is then the menu button (jak_vr.cpp fill_pad).
+    bool menu_sensed = true;
+};
+
+// What the mod knows of the moment.
+struct PadContext {
+    bool in_menu = false;       // a menu or the title: buttons as a menu wants them, sticks the d-pad
+    bool screen = false;        // the big screen: the controllers are a plain pad
+    bool first_person = false;  // the head steers: the left stick is turned by head and camera
+    float head_yaw = 0;         // world yaw of where forward on the stick goes
+    float camera_yaw = 0;       // the game's camera yaw (stick angle plus this is the move yaw)
+    bool quick_select = false;  // the ring is open: the right hand picks, the trigger turns its page
+    bool mounted = false;       // a turret or a flown ship
+    bool flying = false;        // a flown ship: its lasers are Square
+    bool swing = false;         // first person: the right hand is swinging the wrench
+    bool button_moves = false;  // first person, Arm moves on Buttons: the right grip is the game's swing, as in third person
+    bool trigger_held_back = false;  // the trigger is taking the gun out, not firing it
+    bool throw_by_hand = false;      // the trigger holds a glove's bomb for the hand to throw
+    bool punch = false;              // a punch of the hand: the Walloper's lunge, as its fire
+    bool left_support = false;       // the left grip holds the weapon's foregrip, not R1
+    bool crouch = false;             // Physical crouch: the player's own head is down, R1 as the left grip's crouch is
+    // The left grip is R1 (crouch, the packs), Rerac-vr's; not with Physical crouch on foot in first person, where the
+    // head crouches and the hand is left free for its fingers (the owner's ask). The left trigger is R1 still.
+    bool grip_crouch = true;
+    // Hanging by the hands: the grips hold on, so R1 and the stick are the mod's, and A climbs only
+    // with both hands on and settled.
+    bool ledge = false;
+    bool ledge_climb = false;        // A may climb
+    bool ledge_press = false;        // the shove: Cross
+    bool ledge_drop = false;         // both hands let go: R1, the game's drop
+    bool ledge_stick = false;        // the hands pull along it: the stick toward head_yaw
+    bool dive = false;               // the hands pushed the water up, or stroked looking down: Square, the game's dive
+    bool surface = false;            // at the water's surface, either view: the left trigger dives (0.1.17)
+    bool raw_stick = false;          // the stick steers a Visibomb missile: not turned by the head
+    bool board = false;              // on the hoverboard: boost, tricks, and the stick steers it
+    bool board_steers = false;       // on it and not spinning in a trick: the stick's x turns it about its own heading
+    // RAC-Board's board (vr/src/board.h; `board` above is the game's own hoverboard). Riding it, the hands are its
+    // buttons and nothing of the game's play: A its jump (Cross), the right trigger its spins and flips, the right grip
+    // its grind, the left trigger or grip its grab, each on the button its settings chose; Y the pause, X the map. In
+    // first person the stick is about the board's heading (RAC-Board's own frame), which the view follows: forward keeps on its way.
+    bool jet_board = false;
+    // Its "Weapons on the board" (0.1.19, the owner: "make the board compatible with weapons/gadgets as well, so weapons
+    // can be used/equipped while riding. including wrench"): the hands keep their weapons as on foot (the right trigger
+    // fires, the right grip is the wrench, the sticks' clicks the wheels), and the board takes what play on foot leaves
+    // free: B its spins and flips, and with A by a rail its grind (both R1 or R2 in its defaults), the left grip its grab,
+    // and the left trigger too unless the left hand holds a gun.
+    bool jet_weapons = false;
+    std::uint16_t jet_trick = 0, jet_grind = 0, jet_grab = 0;
+    std::uint16_t jet_toggle = 0;    // its "Board on and off", pressed now (a hand reached behind the back, its stick clicked)
+    float jet_yaw = 0;               // the board's heading (his, as RAC-Board turns him)
+    bool third_person_walk = false;  // third person on foot: forward on the stick is where the head looks (rerac-vr-3p)
+    float head_turn = 0;             // how far the head has turned from the game's camera's heading
+    float board_yaw = 0;             // its heading
+    // In the Hologuise disguise (Rerac-vr's): B, or A, takes it off (Square, A's Cross held too, so he
+    // does not jump on coming back); the trigger and the raised open hand salute (Circle).
+    bool disguised = false;
+    bool salute = false;
+    bool puzzle = false;             // at the Trespasser's rings: the sticks turn them
+    bool left_weapon = false;        // Akimbo: the left trigger fires what the left hand holds, not R1
+    bool left_ring = false;          // Akimbo: the left stick's click holds the ring open
+    bool lead = false;               // Akimbo: the left hand's Walloper or Swingshot is the hand's item: the
+                                     // left trigger is the game's fire, the right trigger nothing
+    bool shopping = false;           // at the vendor on foot: the trigger and the right stick's click are the shop's
+    bool menu_aimed = false;         // the trigger answers only what the pointer is on (the vendor)
+    std::uint16_t menu_pulse = 0;    // a key the mod presses itself this tick (the vendor's strip, a step)
+    std::uint16_t menu_key = 0;      // in a menu, the pointer on a line a key answers (the quit box's): the
+                                     // trigger presses that key alone, not Cross
+    bool menu_pointing = false;      // in a menu with things to point at, the right hand tracked: pointing is the
+                                     // selection, A answers as the trigger does and the sticks leave the cursor alone
+    bool menu_map = false;           // the pause menu's map: A is Cross alone (its missions), the trigger Circle alone
+                                     // (the planet's infobot), as their icons there say
+    bool skip_held = false;          // Y skipped a scene and is still down: it does nothing else until let go
+    bool view_held = false;          // X switched a scene's view and is still down: no map (Select) until let go
+    // Third person with Third person controls on Gamepad: the controllers are a plain pad, as on the big screen (0.1.19,
+    // the owner: "map the quest controllers to gamepad inputs"; RAC-Board's board as well); in the menus B, X, Y, the
+    // menu button, the grips and the left trigger are the pad's, A and the right trigger answer as in VR.
+    bool gamepad = false;
+    // Where the controllers are a plain pad (the big screen, `gamepad`), out of the menus: the stick that is the D-pad now
+    // (the launcher's "D-pad": its controller up by the side of the head; or the right one, the left thumb on its rest).
+    bool left_dpad = false, right_dpad = false;
+};
+
+// The pad as it comes out.
+struct VirtualPad {
+    std::uint16_t held = 0;
+    bool withdraw = false;         // a fresh press at the Trespasser's rings: take the tool out
+    float left_x = 0, left_y = 0;  // up positive
+    float right_x = 0, right_y = 0;
+};
+
+inline constexpr float kTriggerOn = 0.55f;
+inline constexpr float kTriggerOff = 0.35f;
+inline constexpr float kStickDead = 0.15f;
+
+// A stick past its dead zone, with the rest of its travel stretched back to 0..1, round.
+inline void shape_stick(float& x, float& y) {
+    const float length = std::sqrt(x * x + y * y);
+    if (length <= kStickDead) {
+        x = y = 0;
+        return;
+    }
+    const float strength = std::min(1.0f, (length - kStickDead) / (1.0f - kStickDead));
+    x = x / length * strength;
+    y = y / length * strength;
+}
+
+// Forward on the stick is `head_yaw` in the world; a stick up in the game is the camera's yaw, and
+// the game adds the two. So the stick is turned by the angle from the camera to the head.
+inline void turn_stick(float& x, float& y, float head_yaw, float camera_yaw) {
+    const float angle = head_yaw - camera_yaw;
+    const float c = std::cos(angle);
+    const float s = std::sin(angle);
+    const float turned_x = x * c - y * s;
+    const float turned_y = x * s + y * c;
+    x = turned_x;
+    y = turned_y;
+}
+
+// Riding RAC-Board in first person: how far the stick is turned, from the board's heading to the head's, at most
+// kBoardSteerMost either way (0.1.19, racboardhead.sim: with the gaze 130 degrees off the heading, forward turned that far
+// was a stick pulled back, and the board went round the long way, past behind him, until the game's own turn about took
+// it). Past that the board carves at the most the short way round to the gaze, and within it the stick is as before.
+inline constexpr float kBoardSteerMost = 1.4f;  // radians: 80 degrees
+inline float board_stick_turn(float head_yaw, float board_yaw) {
+    return std::clamp(wrap_angle(head_yaw - board_yaw), -kBoardSteerMost, kBoardSteerMost);
+}
+
+// One side of an analog control read as a button, with a gap so that it does not chatter.
+struct Latch {
+    bool on = false;
+    bool update(float value) {
+        on = on ? value > kTriggerOff : value > kTriggerOn;
+        return on;
+    }
+};
+
+// The right hand's salute in the Hologuise (Rerac-vr's Salute): the right hand raised open, at the
+// shoulders or above, within 0.75 m of the head and not across to the left (a salute at the brow, or
+// a wave), held 5 frames; it lets go with 0.1 of slack. `head` and `hand` in tracking space.
+struct Salute {
+    int frames = 0;
+    bool active = false;
+
+    bool update(const Pose& head, const Pose& hand, float grip) {
+        const Vec3 p = rotate(conjugate(head.orientation), hand.position - head.position);
+        const auto pose = [&](float m) {
+            return grip < 0.6f + m && p.y > -0.15f - m && p.x > -0.15f - m && length(p) < 0.75f + m;
+        };
+        if (active) {
+            active = pose(0.1f);
+        } else if (pose(0.0f)) {
+            frames = std::min(frames + 1, 100);
+            active = frames >= 5;
+        } else {
+            frames = 0;
+        }
+        return active;
+    }
+    void reset() { *this = Salute{}; }
+};
+
+// A controller held up by the side of the head, as a phone at the ear (the D-pad's "Controller by your head", 0.1.19):
+// in the head's own frame, out on its own side kBySideNear to kBySideFar from the eyes' middle, at most kBySideDown below
+// them or kBySideUp above, from kBySideFront ahead of them to kBySideBack behind (short of where a hand reaches behind
+// the back, board.h's kBackBehind, so the two never meet). Once in, the place is kBySideLeave larger every way, so a
+// hand at its edge does not come and go. `head` and `hand` in tracking space; `left` for the left hand.
+inline constexpr float kBySideNear = 0.06f, kBySideFar = 0.32f;
+inline constexpr float kBySideDown = 0.22f, kBySideUp = 0.20f;
+inline constexpr float kBySideFront = 0.12f, kBySideBack = 0.08f;
+inline constexpr float kBySideLeave = 0.03f;
+
+inline bool hand_by_head(const Pose& head, Vec3 hand, bool left, bool was_in) {
+    const Vec3 p = rotate(conjugate(head.orientation), hand - head.position);
+    const float grow = was_in ? kBySideLeave : 0.0f;
+    const float out = left ? -p.x : p.x;
+    return out > kBySideNear - grow && out < kBySideFar + grow && p.y > -(kBySideDown + grow) && p.y < kBySideUp + grow
+           && p.z > -(kBySideFront + grow) && p.z < kBySideBack + grow;
+}
+
+class PadMapper {
+public:
+    VirtualPad map(const Controls& given, const PadContext& context) {
+        VirtualPad out;
+        Controls c = given;
+        float left_x = c.left_x;
+        float left_y = c.left_y;
+        float right_x = c.right_x;
+        float right_y = c.right_y;
+        shape_stick(left_x, left_y);
+        shape_stick(right_x, right_y);
+
+        const bool right_fire = m_right_trigger.update(c.right_trigger);
+        const bool wrench = m_right_grip.update(c.right_grip);
+        const bool left_fire = m_left_trigger.update(c.left_trigger);
+        bool fire = context.lead ? left_fire : right_fire;
+        const bool left_squeeze = m_left_grip.update(c.left_grip);
+
+        if (context.screen) {
+            plain_pad(out, c, fire, left_fire, wrench, left_squeeze, context, left_x, left_y, right_x, right_y);
+            if (context.in_menu) {
+                directions(out, left_x, left_y, right_x, right_y);
+            }
+            return out;
+        }
+
+        if (context.in_menu) {
+            const bool keyed = context.menu_key != 0;
+            // A answers a pointed key label as the trigger does; at the vendor A stays Cross, which buys, as its screen says.
+            const bool a_keyed = keyed && !context.menu_aimed;
+            const bool confirm = (c.a && !a_keyed) || (fire && !keyed && !context.menu_aimed);
+            // Third person with Gamepad: B, X and Y are the plain pad's (Circle, Square, Triangle), as the hints' Xbox
+            // icons say, with the menu button Start, the grips L1 and R1, the left trigger L2, the right stick's click R3.
+            // A and the right trigger answer as in VR, the pointer's pull among them.
+            const bool pad = context.gamepad;
+            const bool circle = pad ? c.b : c.x;
+            if (context.menu_map) {
+                // The map takes Cross for its missions page and Circle for the planet's infobot, which closes the
+                // menu: both at once (A's confirm), the infobot won over the missions (a tester's, 0.1.12).
+                set(out, c.a && !a_keyed, kPadCross);
+                set(out, (fire && !keyed) || circle, kPadCircle);
+            } else {
+                set(out, confirm, kPadCross);
+                set(out, confirm || circle, kPadCircle);
+            }
+            if ((keyed && fire) || (a_keyed && c.a)) {
+                out.held = static_cast<std::uint16_t>(out.held | context.menu_key);
+            }
+            out.held = static_cast<std::uint16_t>(out.held | context.menu_pulse);
+            set(out, c.left_click, kPadSelect);
+            set(out, left_squeeze, kPadL1);
+            if (pad) {
+                set(out, c.y, kPadTriangle);
+                set(out, c.x, kPadSquare);
+                set(out, c.menu, kPadStart);
+                set(out, c.right_click, kPadR3);
+                set(out, wrench, kPadR1);
+                set(out, left_fire, kPadL2);
+            } else {
+                set(out, c.b || c.right_click, kPadTriangle);
+                set(out, c.y, kPadStart);
+                set(out, wrench, kPadSquare);
+                set(out, left_fire, kPadR1);
+            }
+            if (context.menu_pointing) {
+                m_menu_trigger = fire;
+                return out;  // the game's lists also move by the analog sticks
+            }
+            directions(out, left_x, left_y, right_x, right_y);
+            out.left_x = left_x;
+            out.left_y = left_y;
+            out.right_x = right_x;
+            out.right_y = right_y;
+            m_menu_trigger = fire;
+            return out;
+        }
+
+        // A pull that answered a menu fires nothing after it, until let go (Rerac-vr's menu_pointer.rs).
+        m_menu_trigger = fire && m_menu_trigger;
+        fire = fire && !m_menu_trigger;
+        if (context.skip_held) {
+            c.y = false;
+        }
+        if (context.view_held) {
+            c.x = false;
+        }
+        if (context.jet_board && !context.jet_weapons) {
+            set(out, c.a, kPadCross);
+            if (right_fire) {
+                out.held = static_cast<std::uint16_t>(out.held | context.jet_trick);
+            }
+            if (wrench) {
+                out.held = static_cast<std::uint16_t>(out.held | context.jet_grind);
+            }
+            if (left_fire || left_squeeze) {
+                out.held = static_cast<std::uint16_t>(out.held | context.jet_grab);
+            }
+            set(out, c.y, kPadStart);
+            set(out, c.x, kPadSelect);
+            out.held = static_cast<std::uint16_t>(out.held | context.jet_toggle);
+            // Riding, RAC-Board takes the stick about the board's own heading (measured on PC: turned from the game's camera
+            // to the heading, forward turned the board round and round; as it is, forward keeps its way). In first person
+            // forward is where the player looks, as on foot (0.1.19, the owner: "make sure it follows head direction"; the
+            // stick about the board alone was hard to steer): turned from the board's heading to the head's, so forward
+            // brings the board round to the gaze and holds it there (BoardFollow no longer turns the view with a carve).
+            if (context.first_person) {
+                turn_stick(left_x, left_y, board_stick_turn(context.head_yaw, context.jet_yaw), 0.0f);
+            }
+            out.left_x = left_x;
+            out.left_y = left_y;
+            if (!context.first_person) {
+                out.right_x = right_x;
+                out.right_y = right_y;
+            }
+            return out;
+        }
+
+        // At the vendor on foot the trigger and the right stick's click are the shop's, which the mod sends to its
+        // update alone; a pull that was the shop's fires nothing after it, until let go (game_input.rs).
+        if (context.shopping) {
+            c.right_click = false;
+        }
+        m_shop_trigger = fire && (m_shop_trigger || context.shopping);
+        fire = fire && !m_shop_trigger;
+
+        // The Trespasser's rings (Rerac-vr's): the sticks turn them; Y, the click or a fresh pull of the
+        // trigger withdraw the tool (Triangle). What withdrew it does nothing else until let go.
+        const bool utility = c.y || c.right_click || fire;
+        const bool fresh = utility && !m_utility_down;
+        m_utility_down = utility;
+        if (context.puzzle) {
+            directions(out, left_x, left_y, right_x, right_y);
+            set(out, fresh, kPadTriangle);
+            out.withdraw = fresh;
+            m_utility_spent = m_utility_spent || fresh;
+            return out;
+        }
+        m_utility_spent = m_utility_spent && utility;
+        if (m_utility_spent) {
+            c.y = c.right_click = fire = false;
+        }
+
+        // Third person with Gamepad: the plain pad, as on the big screen; RAC-Board's board takes it as its settings say,
+        // as from an Xbox controller on PC (its defaults: a spin or flip on R1, the right grip; the grind on R2, the right
+        // trigger; the grab on L1, the left grip; the board on and off on D-pad Up, besides the reach behind the back).
+        // The left stick walks where the head looks still (third_person_walk).
+        if (context.gamepad) {
+            if (context.third_person_walk && !context.left_dpad) {
+                turn_stick(left_x, left_y, context.head_turn, 0.0f);
+            }
+            plain_pad(out, c, fire, left_fire, wrench, left_squeeze, context, left_x, left_y, right_x, right_y);
+            out.held = static_cast<std::uint16_t>(out.held | context.jet_toggle);
+            return out;
+        }
+
+        if (context.ledge) {
+            set(out, (c.a && context.ledge_climb) || context.ledge_press, kPadCross);
+            set(out, context.ledge_drop, kPadR1);
+            left_x = 0;
+            left_y = context.ledge_stick ? 1.0f : 0.0f;
+        } else {
+            set(out, c.a, kPadCross);
+            if (context.board) {
+                // The left trigger boosts, the left grip is L1, the right stick holds a trick's shoulder.
+                set(out, left_fire, kPadSquare);
+                set(out, left_squeeze, kPadL1);
+                if (std::sqrt(right_x * right_x + right_y * right_y) >= 0.6f) {
+                    if (std::abs(right_y) >= std::abs(right_x)) {
+                        set(out, right_y > 0, kPadL1);
+                        set(out, right_y <= 0, kPadL2);
+                    } else {
+                        set(out, right_x > 0, kPadR1);
+                        set(out, right_x <= 0, kPadR2);
+                    }
+                }
+            } else {
+                // At the water's surface the left trigger, the crouch, dives: Square, the game's dive (a tester asked how
+                // to dive in first person, where Square is only a swing; 0.1.17), and in third person as well, where the
+                // right grip is Square too. The crouch does nothing there.
+                const bool dives = left_fire && !context.left_weapon && context.surface;
+                set(out, (left_squeeze && !context.left_support && context.grip_crouch) || (left_fire && !context.left_weapon && !dives) || context.crouch,
+                    kPadR1);
+                set(out, dives, kPadSquare);
+            }
+        }
+        // RAC-Board with its weapons (jet_weapons): the left grip is its grab, and the left trigger unless it fires a gun;
+        // B its spins and flips, and its grind with A. The game sees none of them while he rides (RAC-Board's own pad).
+        const bool jet = context.jet_board && context.jet_weapons;
+        if (jet) {
+            out.held = static_cast<std::uint16_t>(out.held & ~kPadR1);
+            if (left_squeeze || (left_fire && !context.left_weapon)) {
+                out.held = static_cast<std::uint16_t>(out.held | context.jet_grab);
+            }
+            if (c.b) {
+                out.held = static_cast<std::uint16_t>(out.held | context.jet_trick | context.jet_grind);
+            }
+        }
+        set(out, c.y, kPadStart);
+        set(out, c.b && !jet, context.mounted || context.disguised ? kPadSquare : kPadR2);
+        set(out, context.disguised && c.a, kPadSquare);
+        set(out, c.x, context.mounted ? kPadCircle : kPadSelect);
+        // The ring's page takes the trigger: it fires nothing there, nor after until let go. One already held as the ring
+        // opens is not the page's (the mod's s_page_trigger), and stays the game's fire until let go: hanging from the
+        // Swingshot, opening the wheel let go of it (0.1.18, a tester's ask).
+        const bool ring_opened = context.quick_select && !m_ring_was;
+        m_ring_was = context.quick_select;
+        m_ring_kept = fire && (m_ring_kept || (ring_opened && !m_ring_trigger));
+        m_ring_trigger = fire && !m_ring_kept && (m_ring_trigger || context.quick_select);
+        // Hanging, the trigger is the free hand's gun's, which the mod runs: the game's fire would let go.
+        if ((fire && !m_ring_trigger && !context.trigger_held_back && !context.throw_by_hand && !context.ledge) || context.punch) {
+            out.held = static_cast<std::uint16_t>(out.held | (context.flying ? kPadSquare : kPadCircle));
+        }
+        set(out, context.salute, kPadCircle);
+        set(out, c.right_click, kPadTriangle);
+
+        // In first person the wrench swings when the hand does; else the grip is the button (and in first
+        // person too with Arm moves on Buttons). A turret has no wrench to swing, and a hand on a ledge is
+        // climbing: a shove with the right grip closed is not a swing, which would knock him off.
+        const bool turret = context.mounted && !context.flying;
+        // Riding RAC-Board in first person the hand's own swing is the hit (the mod's): Square would add the board's.
+        const bool swung = context.first_person ? (context.swing && !jet) || (context.button_moves && wrench) : wrench;
+        set(out, !turret && !context.ledge && swung, kPadSquare);
+        set(out, context.dive, kPadSquare);
+        set(out, context.left_ring, kPadTriangle);
+
+        if (context.first_person && !context.raw_stick && !context.board) {
+            // Riding RAC-Board, about the board's heading, which it takes the stick by (as in the branch above).
+            if (jet) {
+                turn_stick(left_x, left_y, board_stick_turn(context.head_yaw, context.jet_yaw), 0.0f);
+            } else {
+                turn_stick(left_x, left_y, context.head_yaw, context.camera_yaw);
+            }
+        }
+        if (context.third_person_walk && !jet) {
+            turn_stick(left_x, left_y, context.head_turn, 0.0f);
+        }
+        // Rerac-vr's board steering: the stick's x turns the board about its own heading, a quarter turn off it at
+        // full, at the game's rate times its amount. The game takes a direction about its camera: it is given that.
+        if (context.first_person && context.board_steers) {
+            const float amount = std::clamp(left_x, -1.0f, 1.0f);
+            const float away = context.board_yaw - context.camera_yaw - amount * 1.5707964f;
+            left_x = -std::sin(away) * std::fabs(amount);
+            left_y = std::cos(away) * std::fabs(amount);
+        }
+        out.left_x = left_x;
+        out.left_y = left_y;
+
+        // In first person the right stick turns the player and the game's camera stays out of it; on
+        // a turret it is nothing, the view being fixed while the turret turns beneath it.
+        if (!context.first_person && !turret) {
+            out.right_x = right_x;
+            out.right_y = right_y;
+        }
+        out.held = static_cast<std::uint16_t>(out.held | context.jet_toggle);
+
+        return out;
+    }
+
+private:
+    static void set(VirtualPad& pad, bool on, PadBit bit) {
+        if (on) {
+            pad.held = static_cast<std::uint16_t>(pad.held | bit);
+        }
+    }
+
+    // Rerac-vr's menu_directions: the stick pushed further, along its longer axis, past 0.55.
+    // Real d-pad buttons, as lists such as the ship's take no stick.
+    static void directions(VirtualPad& pad, float left_x, float left_y, float right_x, float right_y) {
+        const bool left = left_x * left_x + left_y * left_y >= right_x * right_x + right_y * right_y;
+        const float x = left ? left_x : right_x;
+        const float y = left ? left_y : right_y;
+        if (std::max(std::abs(x), std::abs(y)) < 0.55f) {
+            return;
+        }
+        if (std::abs(x) > std::abs(y)) {
+            set(pad, x > 0, kPadRight);
+            set(pad, x < 0, kPadLeft);
+        } else {
+            set(pad, y > 0, kPadUp);
+            set(pad, y < 0, kPadDown);
+        }
+    }
+
+    // The controllers as a plain pad (the big screen; third person with Gamepad), laid out as an Xbox controller is on a
+    // PlayStation pad (OpenRAC's own pad defaults, docs/port/CONTROLS.md; the Xbox button icons the hints show): A Cross,
+    // B Circle, X Square, Y Triangle, the grips (its bumpers) L1 and R1, the triggers L2 and R2, the menu button Start,
+    // the left stick's click Select, the right's R3, the sticks the pad's. To 0.1.18 the big screen had the triggers on
+    // L1 and R1, the grips on L2 and R2. A stick that is the D-pad now (context.left_dpad, right_dpad) gives the D-pad
+    // and none of its own, and its click is L3 (the left) or R3.
+    void plain_pad(VirtualPad& out, const Controls& c, bool fire, bool left_fire, bool wrench, bool left_squeeze,
+                   const PadContext& context, float left_x, float left_y, float right_x, float right_y) {
+        set(out, c.a, kPadCross);
+        set(out, c.b, kPadCircle);
+        set(out, c.x, kPadSquare);
+        set(out, c.y, kPadTriangle);
+        set(out, wrench, kPadR1);
+        set(out, left_squeeze, kPadL1);
+        set(out, fire, kPadR2);
+        set(out, left_fire, kPadL2);
+        set(out, c.menu, kPadStart);
+        set(out, c.left_click && !context.left_dpad, kPadSelect);
+        set(out, c.left_click && context.left_dpad, kPadL3);
+        set(out, c.right_click, kPadR3);
+        dpad_stick(out, m_dpad_on[0], context.left_dpad, left_x, left_y);
+        dpad_stick(out, m_dpad_on[1], context.right_dpad, right_x, right_y);
+        out.left_x = left_x;
+        out.left_y = left_y;
+        out.right_x = right_x;
+        out.right_y = right_y;
+    }
+
+    // A stick as the D-pad: pushed past kDpadOn (until back under kDpadOff), in eight ways, a diagonal two buttons, each
+    // way's share of the circle the same. Its own push is then nothing.
+    static constexpr float kDpadOn = 0.55f, kDpadOff = 0.4f;
+    static void dpad_stick(VirtualPad& out, bool& on, bool dpad, float& x, float& y) {
+        if (!dpad) {
+            on = false;
+            return;
+        }
+        const float length = std::sqrt(x * x + y * y);
+        on = on ? length > kDpadOff : length > kDpadOn;
+        if (on && length > 0.0f) {
+            constexpr float kEighth = 0.38268343f;  // sin 22.5 degrees: the edge between a way and a diagonal
+            set(out, x / length > kEighth, kPadRight);
+            set(out, x / length < -kEighth, kPadLeft);
+            set(out, y / length > kEighth, kPadUp);
+            set(out, y / length < -kEighth, kPadDown);
+        }
+        x = y = 0.0f;
+    }
+
+    bool m_dpad_on[2] = {};
+    Latch m_right_trigger, m_left_trigger, m_right_grip, m_left_grip;
+    bool m_ring_trigger = false;
+    bool m_ring_was = false;   // the ring open the last time
+    bool m_ring_kept = false;  // the trigger held as the ring opened: the game's still
+    bool m_shop_trigger = false;
+    bool m_menu_trigger = false;
+    bool m_utility_down = false, m_utility_spent = false;
+};
+
+// A real swing of the wrench, from the hand's speed. Weak taps do not count (Rerac-vr's "put some
+// energy into it"): the grip held and the hand past kSwingSpeed presses the game's swing for a
+// moment, and the hand must slow down before the next.
+inline constexpr float kSwingSpeed = 2.2f;   // metres a second
+inline constexpr float kSwingRearm = 1.0f;
+inline constexpr float kSwingSeconds = 0.12f;
+
+class SwingDetector {
+public:
+    bool update(float speed, bool held, float seconds) {
+        m_left = std::max(0.0f, m_left - seconds);
+        if (speed < kSwingRearm) {
+            m_armed = true;
+        }
+        if (held && m_armed && speed > kSwingSpeed) {
+            m_armed = false;
+            m_left = kSwingSeconds;
+        }
+        return m_left > 0.0f;
+    }
+
+private:
+    bool m_armed = true;
+    float m_left = 0;
+};
+
+// The game's stick reading: an axis byte counts from 0x7F, nothing within 0x30 of it, then
+// (|b - 0x7F| - 0x30) / 0x4C up to 1 (keyboard-mouse's kbm.hpp, seen in game code). `v` (-1..1) as
+// the byte the game reads back as about v, so a slow walk is a slow walk.
+inline std::uint8_t stick_byte(float v) {
+    if (v == 0.0f) {
+        return 0x80;
+    }
+    const float distance = 0x30 + 1 + std::min(std::fabs(v), 1.0f) * (0x4C - 1);
+    const float byte = 0x7F + (v > 0.0f ? distance : -distance);
+    return static_cast<std::uint8_t>(std::clamp(std::round(byte), 0.0f, 255.0f));
+}
+
+// The button of each pressure byte, bytes 6..17: right, left, up, down, triangle, circle, cross,
+// square, L1, R1, L2, R2 (kbm.hpp).
+inline constexpr std::array<std::uint16_t, 12> kPressureBits = {
+    kPadRight, kPadLeft, kPadUp, kPadDown, kPadTriangle, kPadCircle, kPadCross, kPadSquare,
+    kPadL1, kPadR1, kPadL2, kPadR2,
+};
+
+// Into the game's report (18 bytes: buttons active low, right stick, left stick, twelve
+// pressures): the controllers' buttons held as well as a real pad's; an axis of ours off centre
+// takes that axis's place. Stick bytes run down and right: up on a stick is a low byte.
+inline void merge_report(const VirtualPad& pad, std::uint8_t* report, int size) {
+    if (size < 6) {
+        return;
+    }
+    const std::uint16_t was = static_cast<std::uint16_t>(~(report[0] | (report[1] << 8)));
+    const std::uint16_t held = static_cast<std::uint16_t>(was | pad.held);
+    report[0] = static_cast<std::uint8_t>(~held & 0xFF);
+    report[1] = static_cast<std::uint8_t>(~held >> 8);
+    const auto axis = [&](int at, float value) {
+        if (value != 0.0f) {
+            report[at] = stick_byte(value);
+        }
+    };
+    axis(2, pad.right_x);
+    axis(3, -pad.right_y);
+    axis(4, pad.left_x);
+    axis(5, -pad.left_y);
+    for (int i = 0; i < static_cast<int>(kPressureBits.size()) && 6 + i < size; ++i) {
+        if ((pad.held & kPressureBits[i]) != 0) {
+            report[6 + i] = 0xFF;
+        }
+    }
+}
+
+// How a turn control acts. One of these each tick gives the turn to make this tick, radians left.
+struct TurnSettings {
+    bool smooth = false;
+    float snap_angle = 0.7853982f;   // 45 degrees
+    float smooth_rate = 2.4f;        // radians a second at full stick
+};
+
+class TurnControl {
+public:
+    // `held_off`: the stick is another's now (a ring's hand, the shop, the Trespasser's rings, a menu). Pushed as that
+    // ends it turns nothing until it has come back (Rerac-vr's).
+    float update(float stick_x, float seconds, const TurnSettings& settings, bool held_off = false) {
+        const bool centred = std::abs(stick_x) < 0.3f;
+        m_waiting = !centred && (m_waiting || held_off);
+        if (held_off || m_waiting) {
+            m_armed = m_armed || centred;
+            return 0.0f;
+        }
+        const float push = std::abs(stick_x) > 0.25f ? stick_x : 0.0f;
+        if (settings.smooth) {
+            return -push * settings.smooth_rate * seconds;
+        }
+        // A snap needs the stick back near the centre before the next one.
+        if (m_armed && std::abs(stick_x) > 0.7f) {
+            m_armed = false;
+            return stick_x > 0 ? -settings.snap_angle : settings.snap_angle;
+        }
+        if (std::abs(stick_x) < 0.3f) {
+            m_armed = true;
+        }
+        return 0.0f;
+    }
+
+private:
+    bool m_armed = true;
+    bool m_waiting = false;
+};
+
+}  // namespace quest
