+struct ProbeAsk {
+  bool valid = false;
+};
+ProbeAsk s_probe_ask[kBodyProbes];
+
+// A probe's answer as a plane; false when it met nothing (or was not asked).
+bool probe_plane(const VrBodyInfo& info, int probe, HandPlane& out) {
+  if (probe < 0 || probe >= kBodyProbes || probe >= info.probe_count || !s_probe_ask[probe].valid) {
+    return false;
+  }
+  const float u = info.probe_hit[probe][3];
+  if (!(u >= 0.0f && u <= 1.0f)) {
+    return false;
+  }
+  const Vec3 from{info.probe_from[probe][0], info.probe_from[probe][1], info.probe_from[probe][2]};
+  const Vec3 to{info.probe_to[probe][0], info.probe_to[probe][1], info.probe_to[probe][2]};
+  Vec3 n = unit(Vec3{info.probe_hit[probe][0], info.probe_hit[probe][1], info.probe_hit[probe][2]}, {0, 1, 0});
+  const Vec3 centre = from + scaled(to - from, u);
+  if (dot3(n, from - centre) < 0.0f) {
+    n = scaled(n, -1.0f);  // toward where the probe came from
+  }
+  out.n = n;
+  out.at = centre - scaled(n, info.probe_to[probe][3]);
+  return true;
+}
