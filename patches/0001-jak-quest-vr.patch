+(define *vr-state-was* (the-as symbol #f))
+
+(defun vr-state-trace ()
+  "PC test aid (JAKVR_STATE_TRACE=1, pc-vr-test-flags bit 2): Jak's state in the log as it changes."
+  (when (and *target* (logtest? (pc-vr-test-flags) 2))
+    (let ((name (-> *target* next-state name)))
+      (when (!= name *vr-state-was*)
+        (set! *vr-state-was* name)
+        (format 0 "[vr] state ~A~%" name))))
+  ;; PC test aid (JAKVR_TEST_HUD=1, pc-vr-test-flags bit 32): the HUD kept on screen in play, for the HUD tests
+  (when (and *target* (logtest? (pc-vr-test-flags) 32))
+    (show-hud))
+  0)
+
+(defun vr-camera-update ()
+  (when (not (pc-vr-on?))
+    (set! *vr-head-hidden* #f)
+    (set! *vr-stereo* #f)
+    (set! *vr-posed* #f))
+  (when (pc-vr-on?)
+    (let ((info *vr-camera-info*))
+      (set! (-> info mode)
+            (cond
+              ((or (= *master-mode* 'pause) (= *master-mode* 'progress)) 2)
+              ;; a blackout (a load, a scene starting): the game's own camera, so what waits on it starts
+              ((< (current-time) (-> *game-info* blackout-time)) 4)
+              ((movie?) 1)
+              (else 0)))
+      (set! (-> info flags) 0)
+      (when *target*
+        (logior! (-> info flags) 1)
+        (if (not (logtest? (-> *target* draw status) (draw-status hidden)))
+            (logior! (-> info flags) 64))
+        (when (vr-title?)
+          (set! (-> info mode) 3))
+        (if (vr-first-person-ok?)
+            (logior! (-> info flags) 2))
+        (if (vr-vehicle-first-person-ok?)
+            (logior! (-> info flags) 256))
+        (if (= (-> *target* next-state name) 'target-grab)
+            (logior! (-> info flags) 8))
+        (if (logtest? (-> *target* control status) (cshape-moving-flags onsurf))
+            (logior! (-> info flags) 16))
+        (if (case (-> *target* next-state name) (('target-duck-stance 'target-duck-walk) #t) (else #f))
+            (logior! (-> info flags) 32))
+        ;; 0.1.1: in his roll (kFlagRolling): the view goes down with him as in a crouch, so his arms still reach the
+        ;; player's hands (jak_vr.cpp first_person_anchor; Vixel: "rolling feels off")
+        (if (= (-> *target* next-state name) 'target-wheel)
+            (logior! (-> info flags) 1024))
+        (set! (-> info target-trans quad) (-> *target* control trans quad))
+        (if (and (nonzero? (-> *target* neck)) (-> *target* neck joint))
+            (vr-eyes<-neck! (-> info head) (-> *target* neck joint)
+                            (vr-jak-ahead! (new-stack-vector0) (= (-> info mode) 1)))
+            (begin
+              (set! (-> info head quad) (-> *target* control trans quad))
+              (+! (-> info head y) (meters 1.5))))
+        (let ((fwd (vr-jak-ahead! (new-stack-vector0) (= (-> info mode) 1))))
+          ;; atan gives GOAL rotation units (65536 per turn); the runtime wants radians
+          (set! (-> info target-yaw) (* 0.00009587380 (atan (-> fwd x) (-> fwd z))))))
+      (set! (-> info camera-trans quad) (-> *math-camera* trans quad))
+      ;; back: 1 when the view is in Jak's head this frame, 2 when the eyes see the game in stereo
+      (let ((r (pc-vr-camera! (-> *math-camera* inv-camera-rot) (-> *math-camera* trans) info)))
+        (set! *vr-head-hidden* (logtest? r 1))
+        (set! *vr-stereo* (logtest? r 2)))
+      (vr-graphics!)
+      (vr-body-update! (-> info mode))
+      (vr-menu-draw)))
+  ;; the others' VR bodies, in VR or not
+  (vr-others-pose!)
+  (vr-test-continue!)
+  (vr-test-warp!)
+  (vr-state-trace)
+  0)
+
+;; ---- Shots from the hand (Jak 1's yellow eco, "Aim with your hand" in the VR menu) ----
+;; Each asks the runtime for the hand that last punched: where it points, and in first person where it is. Used in
+;; target-yellow-blast and target-yellow-jump-blast (engine/target/target2.gc) in place of Jak's facing and hand.
+
+(define *vr-shot-pos* (new 'static 'vector))
+(define *vr-shot-dir* (new 'static 'vector))
+
+(defun vr-shot-dir! ((dir vector) (speed float))
+  "The shot's velocity: where the hand points, at speed; dir as it was without VR. Changes dir in place."
+  ;; only for the player's own Jak: a party's other players (Teamruns' remote targets) shoot as they face
+  (when (and (with-pp (= pp *target*)) (> (pc-vr-hand-shot! *vr-shot-pos* *vr-shot-dir*) 0))
+    (vector-normalize-copy! dir *vr-shot-dir* speed))
+  dir)
+
+(defun vr-shot-origin ((pos vector))
+  "The shot's start: the hand in first person, else pos (not changed)."
+  (if (and (with-pp (= pp *target*)) (= (pc-vr-hand-shot! *vr-shot-pos* *vr-shot-dir*) 2))
+      *vr-shot-pos*
+      pos))
+
+;; ---- the party's saves (game/party.h; Ratchet's "Host which save?" and "Play which save?") ----
+;; The VR menu's Multiplayer asks game/party.cpp; vr-party-saves, every frame (runs-every-frame), starts it here with
+;; the game's own saves: a save slot loaded as the pause menu loads one, a new game as the pause menu starts one, and
+;; the host's progress made as a save for the members who asked (sent by party.cpp), or a member's game loaded from it.
+;; The host's progress goes into the game, never onto a save slot: the member's own saves stay as they were, and its
+;; auto-save is off until it saves from the pause menu.
+
+(define *vr-party-save-job* (the-as handle #f))  ;; the process doing one
+(define *vr-party-save-next* 0)                  ;; asked, to start when the last one is done: kind | slot << 4
+
+(defbehavior vr-party-reserve process ()
+  "The art control's spare buffer, as the auto-save gets it (game-save.gc get-heap): waits for it, 10 seconds at most."
+  (let ((from (-> *display* real-frame-counter))
+        (buffer (reserve-alloc *art-control*)))
+    (while (and (not buffer) (< (- (-> *display* real-frame-counter) from) (seconds 10)))
+      (suspend)
+      (set! buffer (reserve-alloc *art-control*)))
+    (the-as kheap buffer)))
+
+(defbehavior vr-party-save-job process ((kind int) (slot int))
+  ;; an auto-save running finishes first: initialize! would end it, and a second one cannot start
+  (while (handle->process (-> *game-info* auto-save-proc))
+    (suspend))
+  (case kind
+    ((1)
+     ;; a save slot, as the pause menu's load (progress.gc memcard-loading): done sets auto-save on again, an error
+     ;; leaves it off
+     (sound-volume-off)
+     (auto-save-command 'restore 0 slot self)
+     (while (handle->process (-> *game-info* auto-save-proc))
+       (suspend))
+     (pc-party-save-done kind (-> *setting-control* default auto-save)))
+    ((2)
+     ;; a new game, as the pause menu's (progress.gc save-game-title), saved nowhere until saved from the pause menu
+     (sound-volume-off)
+     (set! (-> *setting-control* default auto-save) #f)
+     (set! (-> *game-info* mode) 'play)
+     (initialize! *game-info* 'game (the-as game-save #f) "intro-start")
+     (set-master-mode 'game)
+     (dotimes (i 15)
+       (suspend))
+     (pc-party-save-done kind #t))
+    ((3)
+     ;; the host: its progress made as the save state makes one (game-save.gc save), sent to the members who asked
+     (let ((buffer (vr-party-reserve)))
+       (cond
+         (buffer
+          (set! (-> buffer current) (-> buffer base))
+          (let ((old loading-level))
+            (set! loading-level buffer)
+            (let ((save (new 'loading-level 'game-save (- SPOOL_HEAP_SIZE (psize-of game-save)))))
+              (save-game! *game-info* save "save")
+              (set! loading-level old)
+              ;; the type word, the header and the tags: what a memory card bank holds of it
+              (pc-party-save-made (&-> save type) (+ (the int (-> game-save size)) (-> save length)))))
+          (reserve-free *art-control* buffer)
+          (pc-party-save-done kind #t))
+         (else (pc-party-save-done kind #f)))))
+    ((4)
+     ;; a member: the game from the host's progress, as the restore state loads a save slot's (game-save.gc restore)
+     (let ((buffer (vr-party-reserve))
+           (bytes 0))
+       (if buffer
+           (set! bytes (pc-party-save-copy-into (-> buffer base) (the int (&- (-> buffer top) (-> buffer base))))))
+       (let ((save (the-as game-save (if buffer (&+ (-> buffer base) 4) #f))))
+         (cond
+           ((or (not buffer) (< bytes 84))
+            (if buffer (reserve-free *art-control* buffer))
+            (pc-party-save-done kind #f))
+           (else
+            (set! (-> save type) game-save)
+            (cond
+              ((!= (-> save version) 1)
+               (reserve-free *art-control* buffer)
+               (pc-party-save-done kind #f))
+              (else
+               (set-setting! 'music-volume 'abs 0.0 0)
+               (set-setting! 'sfx-volume 'abs 0.0 0)
+               (set! (-> *setting-control* default auto-save) #f)
+               (set! (-> *game-info* mode) 'play)
+               (initialize! *game-info* 'game save (the-as string #f))
+               (set-master-mode 'game)
+               (add-setting! 'process-mask 'set 0.0 (process-mask progress))
+               (apply-settings *setting-control*)
+               (dotimes (i 15)
+                 (suspend))
+               (if (-> *art-control* reserve-buffer) (reserve-free *art-control* buffer))
+               (pc-party-save-done kind #t)))))))))
+  (none))
+
+(defun vr-party-saves ()
+  "Every frame (runs-every-frame): starts what the VR menu's Multiplayer asked of the saves (pc-party-save-ask), one
+   at a time."
+  (let ((ask (pc-party-save-ask)))
+    (when (nonzero? ask)
+      ;; a newer ask replaces one not started; the host's progress still not made is told so (the member hears "none")
+      (if (nonzero? *vr-party-save-next*) (pc-party-save-done (logand *vr-party-save-next* 15) #f))
+      (set! *vr-party-save-next* ask)))
+  (when (and (nonzero? *vr-party-save-next*) (not (handle->process *vr-party-save-job*)))
+    (let* ((ask *vr-party-save-next*)
+           (job (process-spawn-function process vr-party-save-job (logand ask 15) (shr ask 4)
+                                        :to *default-pool* :stack *kernel-dram-stack*)))
+      (set! *vr-party-save-next* 0)
+      (cond
+        (job
+         ;; runs in the pause menu and the VR menu too, as the auto-save does
+         (logclear! (-> job 0 mask) (process-mask pause menu progress))
+         (set! *vr-party-save-job* (ppointer->handle job)))
+        (else (pc-party-save-done (logand ask 15) #f)))))
+  (none))
