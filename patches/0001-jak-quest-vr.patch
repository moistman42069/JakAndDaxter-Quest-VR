+void pose_heard(int player, const std::string& word) {
+  std::lock_guard<std::mutex> lock(s_pose_mutex);
+  if (word.empty()) {
+    s_pose_heard.erase(player);
+    return;
+  }
+  s_pose_heard[player] = PoseHeard{base64_decode(word), std::chrono::steady_clock::now()};
+}
