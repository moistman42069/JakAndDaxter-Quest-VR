+    // without scale: the gun's is uniform and the same in both).
+    const auto unscaled = [](Mat a) {
+      for (int r = 0; r < 3; ++r) {
+        const Vec3 row = unit(Vec3{a.m[r][0], a.m[r][1], a.m[r][2]}, Vec3{r == 0 ? 1.0f : 0.0f, r == 1 ? 1.0f : 0.0f, r == 2 ? 1.0f : 0.0f});
+        a.m[r][0] = row.x, a.m[r][1] = row.y, a.m[r][2] = row.z, a.m[r][3] = 0.0f;
+      }
+      a.m[3][3] = 1.0f;
+      return a;
+    };
+    Mat used;
+    std::memcpy(&used, info.gun_root, sizeof used);
+    used = unscaled(used);
+    {
+      const Mat back = mat_inverse(used);
+      const int barrel_bone = info.gun_barrel;
+      const int right_hand = named(kJointSide + 16 * quest::kRight + kSideHand);
+      if (s_gun_in_hand && o.hand_aim && right_hand >= 0 && s_rig.map_grip_valid[quest::kRight] && barrel_bone >= 0 &&
+          barrel_bone < gun_count && bone_ok(info.gun_bone[barrel_bone])) {
+        const Mat bb = read_bone(s_bone_keep.gun[barrel_bone], memory, info.gun_bone[barrel_bone]);
+        const Vec3 barrel = unit(mat_dir({bb.m[2][0], bb.m[2][1], bb.m[2][2]}, mat_mul(back, unscaled(w[gun]))), {0, 0, 1});
+        const Vec3 aim = unit(to_world_dir(gun_aim_tracking(), s_rig.map_yaw), barrel);
+        const Mat turn = turn_between(barrel, aim);
+        const Vec3 pivot = mat_place(w[right_hand]);
+        turn_under(w, right_hand, turn, pivot);
+        if (!hangs_under(gun, right_hand)) {
+          turn_under(w, gun, turn, pivot);
+        }
+      }
+      const Mat carry = mat_mul(back, unscaled(w[gun]));
+#if !defined(__ANDROID__)
+      // PC test aid (JAKVR_BODY_TRACE=1): once a second while it is in his hand, how near the eyes the gun's joints
+      // are, and where his right hand is from them (the player's metres: right, up, ahead of the head)
+      static int near_count = 0;
+      const bool near_trace = std::getenv("JAKVR_BODY_TRACE") && s_gun_in_hand && ++near_count % 60 == 0;
+      float nearest = 1e9f;
+      Vec3 nearest_at{0, 0, 0};
+      // the head's own flat frame, as the arm trace's (right, up, ahead), the player's metres
+      const Vec3 near_ahead = flat_dir(head_heading), near_right{-near_ahead.z, 0.0f, near_ahead.x};
+      const auto from_head = [&](const Vec3& p) {
+        const Vec3 d = scaled(p - s_rig.map_head_world, 1.0f / s_rig.map_units);
+        return fmt::format("{:.2f} {:.2f} {:.2f}", dot3(d, near_right), d.y, dot3(d, near_ahead));
+      };
+      std::string bones_at;  // each of the gun's joints, the same way
+#endif
+      for (int i = 0; i < gun_count; ++i) {
+        if (!bone_ok(info.gun_bone[i])) {
+          continue;
+        }
+        Mat b = read_bone(s_bone_keep.gun[i], memory, info.gun_bone[i]);
+        make_affine(b);  // as Jak's own (mat_corner_off)
+        b = mat_mul(b, carry);
+        make_affine(b);
+        write_bone(s_bone_keep.gun[i], memory, info.gun_bone[i], b);
+#if !defined(__ANDROID__)
+        if (near_trace) {
+          const float d = quest::length(mat_place(b) - s_rig.map_head_world) / s_rig.map_units;
+          if (d < nearest) {
+            nearest = d;
+            nearest_at = mat_place(b);
+          }
+          if (i < 16) {
+            bones_at += fmt::format("{}{}: {}", bones_at.empty() ? "" : ", ", i, from_head(mat_place(b)));
+          }
+        }
+#endif
+      }
+#if !defined(__ANDROID__)
+      if (near_trace && right_hand >= 0) {
+        log_line(0, fmt::format("[vr-body] the gun's nearest joint {:.2f} m from the eyes (at {}), his right hand at {}, "
+                                "the controller's palm at {}, his gun joint at {}",
+                                nearest, from_head(nearest_at), from_head(mat_place(w[right_hand])),
+                                s_rig.map_grip_valid[quest::kRight]
+                                    ? from_head(grip_world(quest::kRight, s_rig.map_grip[quest::kRight]).palm_middle)
+                                    : std::string("-"),
+                                from_head(mat_place(w[gun])))
+                        .c_str());
+        log_line(0, fmt::format("[vr-body] the gun's joints from the eyes (right, up, ahead; barrel {}): {}",
+                                info.gun_barrel, bones_at)
+                        .c_str());
+      }
+#endif
+    }
+  }
+  // 8. Jak 1's wrist straps: set as made on the joint that carries them (the game's own flapping left out), then swung.
+  // Each strap's middle and tip keep their motion, fall, and are drawn a little back to how the strap was made (leather,
+  // not thread); held to its lengths from its root on the wrist, out of what the hand is at and what the strap's own
+  // probe met, and off the wrist itself. Its root joint is turned to the middle, the middle to the tip.
+  s_body.strap_probe[0] = s_body.strap_probe[1] = false;
+  if (s.strap_count > 0 && o.hands_on_world) {
+    const float dt = std::clamp(seconds, 1.0f / 240.0f, 1.0f / 30.0f);
+    const float metre = s_rig.map_units;
+    Vec3 tip_sum[2] = {};
+    int tips[2] = {0, 0};
+    HandPlane strap_plane[2];
+    bool strap_plane_ok[2];
+    for (int side = 0; side < 2; ++side) {
+      strap_plane_ok[side] = probe_plane(info, kProbeStrapLeft + side, strap_plane[side]);
+    }
+    for (int k = 0; k < s.strap_count; ++k) {
+      const Strap& st = s.straps[k];
+      auto& now = s_body.strap[k];
+      if (!bone_ok(info.bone[st.root]) || !bone_ok(info.bone[st.mid]) || !bone_ok(info.bone[st.parent]) ||
+          !s_rig.map_grip_valid[st.side]) {
+        now.valid = false;
+        continue;
+      }
+      w[st.root] = mat_mul(mat_mul(s.made[st.root], mat_inverse(s.made[st.parent])), w[st.parent]);
+      w[st.mid] = mat_mul(mat_mul(s.made[st.mid], mat_inverse(s.made[st.root])), w[st.root]);
+      const Vec3 a = mat_place(w[st.root]);
+      const Vec3 rest_mid = mat_place(w[st.mid]);
+      const float l1 = quest::length(rest_mid - a);
+      if (l1 < 1.0f) {
+        now.valid = false;
+        continue;
+      }
+      const Vec3 d0 = scaled(rest_mid - a, 1.0f / l1);
+      const float l2 = l1;
+      const Vec3 rest_tip = rest_mid + scaled(d0, l2);
+      if (!now.valid || quest::length(a - now.anchor) > 0.5f * metre) {
+        now.p1 = now.was1 = rest_mid;
+        now.p2 = now.was2 = rest_tip;
+        now.valid = true;
+      }
+      now.anchor = a;
+      const float keep = std::exp(-kStrapDamp * dt);
+      const float back = std::min(kStrapStiff * dt * dt, 0.5f);  // a spring: the same at every frame rate
+      const Vec3 fall{0.0f, -kStrapGravity * metre * dt * dt, 0.0f};
+      Vec3* at[2] = {&now.p1, &now.p2};
+      Vec3* was[2] = {&now.was1, &now.was2};
+      const Vec3 rest[2] = {rest_mid, rest_tip};
+      for (int i = 0; i < 2; ++i) {
+        const Vec3 moved = scaled(*at[i] - *was[i], keep);
+        *was[i] = *at[i];
+        *at[i] = *at[i] + moved + fall + scaled(rest[i] - *at[i], back);
+      }
+      const Vec3 wrist = mat_place(w[st.parent]);
+      const float wrist_r = 0.9f * quest::length(a - wrist);  // the strap's root sits on the wrist's skin
+      const Vec3 out = unit(a - wrist, d0);                   // off the wrist, at the strap's root
+      const float thick = kStrapThick * 4096.0f;
+      // The strap leaves the wrist outwards or along its skin, never through the arm: hanging from the wrist's top it
+      // lies over the wrist's side and falls from there.
+      const auto off_the_arm = [&] {
+        const Vec3 d = unit(now.p1 - a, d0);
+        const float into = dot3(d, out);
+        if (into < 0.0f) {
+          const Vec3 along = d - scaled(out, into);
+          now.p1 = a + scaled(quest::length(along) > 1e-3f ? unit(along, d0) : d0, l1);
+        }
+      };
+      for (int pass = 0; pass < 4; ++pass) {
+        now.p1 = a + scaled(unit(now.p1 - a, d0), l1);
+        off_the_arm();
+        now.p2 = now.p1 + scaled(unit(now.p2 - now.p1, d0), l2);
+        for (int i = 0; i < 2; ++i) {
+          const auto keep_off = [&](const HandPlane& pl) {
+            const float d = dot3(pl.n, *at[i] - pl.at) - thick;
+            if (d < 0.0f && dot3(pl.n, a - pl.at) > 0.0f) {
+              *at[i] = *at[i] - scaled(pl.n, d);
+              *was[i] = *was[i] + scaled(*at[i] - *was[i], kStrapRub);  // it drags on what it lies on
+            }
+          };
+          for (int q = 0; q < s_body.plane_count[st.side]; ++q) {
+            keep_off(s_body.planes[st.side][q]);
+          }
+          if (strap_plane_ok[st.side]) {
+            keep_off(strap_plane[st.side]);
+          }
+          const Vec3 from_wrist = *at[i] - wrist;
+          const float from_wrist_m = quest::length(from_wrist);
+          if (wrist_r > 1.0f && from_wrist_m < wrist_r) {
+            *at[i] = wrist + scaled(unit(from_wrist, unit(a - wrist, d0)), wrist_r);
+          }
+        }
+      }
+      now.p1 = a + scaled(unit(now.p1 - a, d0), l1);
+      off_the_arm();
+      now.p2 = now.p1 + scaled(unit(now.p2 - now.p1, d0), l2);
+      const Vec3 d1 = unit(now.p1 - a, d0);
+      turn_under(w, st.root, turn_between(d0, d1), a);
+      const Vec3 d2 = unit(now.p2 - now.p1, d1);
+      turn_under(w, st.mid, turn_between(d1, d2), mat_place(w[st.mid]));
+      tip_sum[st.side] = tip_sum[st.side] + now.p2;
+      ++tips[st.side];
+#if !defined(__ANDROID__)
+      {
+        // PC test aid (JAKVR_BODY_TRACE=1): each strap's middle and tip from its root, twice a second (world, metres)
+        static const bool strap_trace = std::getenv("JAKVR_BODY_TRACE") != nullptr;
+        static int strap_trace_count = 0;
+        if (strap_trace && (k != 0 || ++strap_trace_count % 30 == 0) && strap_trace_count % 30 == 0) {
+          const Vec3 m1 = scaled(now.p1 - a, 1.0f / 4096.0f), m2 = scaled(now.p2 - a, 1.0f / 4096.0f);
+          const Vec3 r = scaled(rest_tip - a, 1.0f / 4096.0f);
+          log_line(0, fmt::format("[vr-body] strap {} ({} wrist): middle {:.3f} {:.3f} {:.3f}, tip {:.3f} {:.3f} {:.3f} "
+                                  "from its root (world m); as made the tip {:.3f} {:.3f} {:.3f}; on {} surfaces",
+                                  k, st.side == quest::kLeft ? "left" : "right", m1.x, m1.y, m1.z, m2.x, m2.y, m2.z,
+                                  r.x, r.y, r.z, s_body.plane_count[st.side] + (strap_plane_ok[st.side] ? 1 : 0))
+                          .c_str());
+        }
+      }
+#endif
+    }
+    // next frame's probe: from the wrist along where its straps hang, a little past their tips
+    for (int side = 0; side < 2; ++side) {
+      const int hand = named(kJointSide + 16 * side + kSideHand);
+      if (tips[side] > 0 && hand >= 0) {
+        const Vec3 from = mat_place(w[hand]);
+        const Vec3 tip = scaled(tip_sum[side], 1.0f / static_cast<float>(tips[side]));
+        const float len = quest::length(tip - from);
+        if (len > 1.0f) {
+          s_body.strap_from[side] = from;
+          s_body.strap_to[side] = tip + scaled(tip - from, 0.03f * 4096.0f / len);
+          s_body.strap_probe[side] = true;
+        }
+      }
+    }
+  } else {
+    for (auto& st : s_body.strap) {
+      st.valid = false;
+    }
+  }
+  // 9. Parts of him fading out of the eyes (0.1.1's refinement pass; the owner: "certain actions seem to clip in the
+  // eyes ... refine ik and body representation", then "body part fading (so it doesnt obscure view ... as smooth as
+  // possible though and not too jarring)"; "Fade body near your eyes", on to start: the owner). What goes, from the
+  // body as posed, in the world, against the eyes:
+  //  - a leg, with any of it from the hip to the toes within kLegClear of the eyes, or its knee, ankle or toes up by
+  //    the face (kLegUnder: a high kick, a flip's legs; with his body upright under the head, a foot that high is
+  //    before the face or about to be);
+  //  - his body and both legs, in a roll, while the game holds him turned over (a dive, a flip, a swim, a pole's
+  //    swing: his legs then reach from the hips under the head to feet beside or over it), or with his chest at the
+  //    eyes (the body held back from the head by its reach of the game's place);
+  //  - an arm, its elbow or mid-forearm within kArmClear (eased only with "Hide arms near your eyes").
+  // Each lets go a little further out than it asks, so none flickers at the edge. His hands never go.
+  {
+    const Vec3 eyes = s_rig.map_head_world;
+    const float m = 4096.0f;
+    const auto nearest_on = [&](Vec3 a, Vec3 b) {  // the eyes from the line a to b
+      const Vec3 ab = b - a;
+      const float l2 = dot3(ab, ab);
+      const float u = l2 > 1.0f ? std::clamp(dot3(eyes - a, ab) / l2, 0.0f, 1.0f) : 0.0f;
+      return quest::length(a + scaled(ab, u) - eyes);
+    };
+    const bool fade_on = o.fade_near_eyes;
+    for (int side = 0; side < 2; ++side) {
+      const int base = kJointSide + 16 * side;
+      const char* which = side == quest::kLeft ? "left" : "right";
+      const int thigh = named(base + kSideThigh), knee = named(base + kSideKnee), ankle = named(kJointAnkle + side);
+      bool leg = false;
+      float leg_near = 0.0f, leg_lift = -1.0f;
+      if (fade_on && thigh >= 0 && knee >= 0 && ankle >= 0) {
+        const Vec3 T = mat_place(w[thigh]), K = mat_place(w[knee]), A = mat_place(w[ankle]);
+        Vec3 toe = A;  // his toes: the joint under the ankle furthest from it
+        float reach = 0.0f;
+        for (int i : under(ankle)) {
+          const float d = quest::length(mat_place(w[i]) - A);
+          if (d > reach && d < 1.0f * m) {
+            reach = d;
+            toe = mat_place(w[i]);
+          }
+        }
+        leg_near = std::min({nearest_on(T, K), nearest_on(K, A), nearest_on(A, toe)});
+        leg_lift = (std::max({K.y, A.y, toe.y}) - eyes.y) / m;  // its highest against the eyes' height (under: below 0)
+        const bool was = s_body.leg_near[side];
+        leg = leg_near < (was ? kLegClearLeave : kLegClear) * m ||
+              (leg_near < (was ? kLegUpNearLeave : kLegUpNear) * m && leg_lift > -(was ? kLegUnderLeave : kLegUnder));
+      }
+      if (leg != s_body.leg_near[side]) {
+        s_body.leg_near[side] = leg;
+        lg::info("[vr-body] the {} leg {} the eyes ({:.2f} m from them, its highest {:+.2f} m against their height)", which,
+                 leg ? "fades out of" : "comes back to", leg_near / m, leg_lift);
+      }
+      const int fore = named(base + kSideForearm), hand = named(base + kSideHand);
+      bool arm = false;
+      float arm_near = 0.0f;
+      if (fore >= 0 && hand >= 0) {
+        const Vec3 E = mat_place(w[fore]), H = mat_place(w[hand]);
+        arm_near = std::min(quest::length(E - eyes), quest::length(scaled(E + H, 0.5f) - eyes));
+        arm = arm_near < (s_body.arm_near[side] ? kArmClearLeave : kArmClear) * s_rig.map_units;
+      }
+      if (arm != s_body.arm_near[side]) {
+        s_body.arm_near[side] = arm;
+        if (o.hide_arms_near_eyes) {
+          lg::info("[vr-body] the {} arm {} the eyes ({:.2f} m from them)", which, arm ? "fades out of" : "comes back to",
+                   arm_near / s_rig.map_units);
+        }
+      }
+    }
+    bool trunk = false;
+    const char* why = "";
+    float chest_near = 0.0f;
+    if (fade_on) {
+      const int chest = named(kJointChest);
+      chest_near = chest >= 0 ? quest::length(mat_place(w[chest]) - eyes) : 100.0f * m;
+      const bool was = s_body.trunk_near;
+      if (s_rig.last_flags & kFlagRolling) {
+        trunk = true;
+        why = "his roll";
+      } else if (s_body.tilt_cos < (was ? kTiltLeave : kTiltAsk)) {
+        trunk = true;
+        why = "the game holds him turned over";
+      } else if (chest_near < (was ? kTrunkClearLeave : kTrunkClear) * m) {
+        trunk = true;
+        why = "his chest at the eyes";
+      }
+    }
+    if (trunk != s_body.trunk_near) {
+      s_body.trunk_near = trunk;
+      lg::info("[vr-body] his body and legs {} the eyes{}{} (his chest {:.2f} m from them, held {:.0f} degrees from upright)",
+               trunk ? "fade out of" : "come back to", trunk ? ": " : "", why, chest_near / m,
+               std::acos(std::clamp(s_body.tilt_cos, -1.0f, 1.0f)) * 57.29578f);
+    }
+    // Eased, and given to the eyes with this very frame (its tag goes to them when the frame's drawing is sent, after
+    // this): out over kFadeOut, held kFadeHold after the ask ends, back over kFadeIn, so a part goes and comes
+    // smoothly (the merc shaders dither by it, vr_fade) where 0.1.0's cuts went at once. His hands never go, nor his
+    // arms unless that option is on; the shadow keeps all of him.
+    std::lock_guard<std::mutex> lock(s_tag_mutex);
+    auto& head = s_game_tag.hidden[0];
+    const double now = now_seconds();
+    const float dt = s_body.fade_at < 0.0 ? 0.0f : std::clamp(static_cast<float>(now - s_body.fade_at), 0.0f, 0.1f);
+    s_body.fade_at = now;
+    const auto ease_fade = [&](float& fade, bool ask, double& asked) {
+      if (ask) {
+        asked = now;
+      }
+      const bool out = ask || (asked >= 0.0 && now - asked < kFadeHold);
+      fade = std::clamp(fade + (out ? dt / kFadeOut : -dt / kFadeIn), 0.0f, 1.0f);
+    };
+    ease_fade(s_body.trunk_fade, s_body.trunk_near, s_body.trunk_asked);
+    for (int side = 0; side < 2; ++side) {
+      ease_fade(s_body.arm_fade[side], s_body.arm_near[side] && options().hide_arms_near_eyes, s_body.arm_asked[side]);
+      ease_fade(s_body.leg_fade[side], s_body.leg_near[side], s_body.leg_asked[side]);
+    }
+    const auto node_ok = [&](int k) {
+      const int n = info.named[k];
+      return n >= 0 && n < s.count && n < 128 && s.has_made[n] ? n : -1;
+    };
+    // eased once more along the way (a smooth step), then a byte for the shaders
+    const auto amount = [](float f) {
+      const float t = std::clamp(f, 0.0f, 1.0f);
+      return static_cast<std::uint8_t>(std::lround(t * t * (3.0f - 2.0f * t) * 255.0f));
+    };
+    const auto put = [&](int i, std::uint8_t a) {
+      if (i >= 0 && i < 128 && a > head.fade[i]) {
+        head.fade[i] = a;
+      }
+    };
+    const auto mark = [](std::uint8_t* bits, int i) {
+      if (i >= 0 && i < 128) {
+        bits[i >> 3] |= static_cast<std::uint8_t>(1u << (i & 7));
+      }
+    };
+    const auto marked = [](const std::uint8_t* bits, int i) {
+      return i >= 0 && i < 128 && ((bits[i >> 3] >> (i & 7)) & 1) != 0;
+    };
+    std::uint8_t limb[16] = {};  // his arms (from the collar, the hands with them) and his legs
+    const std::uint8_t trunk_a = amount(s_body.trunk_fade);
+    for (int side = 0; side < 2; ++side) {
+      const int base = kJointSide + 16 * side;
+      const int collar = node_ok(base + kSideShoulder), arm = node_ok(base + kSideArm);
+      const int hand = node_ok(base + kSideHand), thigh = node_ok(base + kSideThigh);
+      const int arm_top = collar >= 0 ? collar : arm;
+      if (arm_top >= 0) {
+        for (int i : under(arm_top)) {
+          mark(limb, i);
+        }
+      }
+      const std::uint8_t arm_a = amount(s_body.arm_fade[side]);
+      if (arm_a != 0 && arm >= 0 && hand >= 0) {
+        std::uint8_t hand_bits[16] = {};
+        for (int i : under(hand)) {
+          mark(hand_bits, i);
+        }
+        for (int i : under(arm)) {
+          if (!marked(hand_bits, i)) {
+            put(i, arm_a);
+          }
+        }
+      }
+      if (thigh >= 0) {
+        const std::uint8_t leg_a = std::max(amount(s_body.leg_fade[side]), trunk_a);
+        for (int i : under(thigh)) {
+          mark(limb, i);
+          put(i, leg_a);
+        }
+      }
+    }
+    if (trunk_a != 0) {
+      for (int i = 0; i < s.count && i < 128; ++i) {
+        if (!marked(limb, i) && !marked(head.slots, i)) {
+          put(i, trunk_a);
+        }
+      }
+    }
+  }
+#if !defined(__ANDROID__)
+  // PC test aid (JAKVR_BODY_TRACE=1), as Ratchet's QUEST_BODY_TRACE: how the body sits, twice a second.
+  static const bool trace = std::getenv("JAKVR_BODY_TRACE") != nullptr;
+  static int trace_count = 0;
+  // JAKVR_BODY_TRACE=2: each frame too, by the game frame's number (its tag's, as merc_trace_point's lines): the eyes,
+  // his root, the anchor's ease and lean, and his neck and neck base from the eyes, posed and as the game had them.
+  static const bool trace_each = trace && std::getenv("JAKVR_BODY_TRACE")[0] == '2';
+  if (trace_each) {
+    const float m = 1.0f / 4096.0f;
+    const Vec3 eyes = s_rig.map_head_world;
+    const auto from_eyes = [&](Vec3 p) { return fmt::format("({:.2f} {:.2f} {:.2f})", (p.x - eyes.x) * m,
+                                                            (p.y - eyes.y) * m, (p.z - eyes.z) * m); };
+    const int base = neck >= 0 ? s.parent[neck] : -1;
+    log_line(0, fmt::format("[vr-body] frame {}: eyes ({:.2f} {:.2f} {:.2f}) root {} ease ({:.2f} {:.2f} {:.2f}) lean "
+                            "{:.2f}; neck {} base {} game's neck {} base {}; hidden {}",
+                            s_game_tag.number, eyes.x * m, eyes.y * m, eyes.z * m, from_eyes(s_rig.map_root),
+                            s_rig.anchor_offset.x * m, s_rig.anchor_offset.y * m, s_rig.anchor_offset.z * m,
+                            s_rig.lean * m, neck >= 0 ? from_eyes(mat_place(w[neck])) : "-",
+                            base >= 0 ? from_eyes(mat_place(w[base])) : "-", from_eyes(s_body.neck_was),
+                            base >= 0 ? from_eyes(mat_place(feet[base])) : "-",
+                            s_game_tag.hidden[0].name[0] ? s_game_tag.hidden[0].name : "nothing")
+                    .c_str());
+    if (base >= 0 && bone_ok(info.bone[base])) {
+      s_trace_bone = memory + info.bone[base];
+      std::memcpy(s_trace_bone_was, &w[base], sizeof s_trace_bone_was);
+    }
+    // the body's big parts in the head's flat frame (right, up, ahead; the player's metres) and what each fades, so a
+    // part seen in a picture is found by its frame
+    {
+      const Vec3 ahead = flat_dir(head_heading), right{-ahead.z, 0.0f, ahead.x};
+      const auto at = [&](int n) {
+        if (n < 0) {
+          return std::string("-");
+        }
+        const Vec3 d = scaled(mat_place(w[n]) - eyes, 1.0f / s_rig.map_units);
+        return fmt::format("({:.2f} {:.2f} {:.2f})", dot3(d, right), d.y, dot3(d, ahead));
+      };
+      // (the ankles as posed, and "feet": where the game has each ankle, the legs' aim)
+      const auto foot_at = [&](int n) {
+        if (n < 0) {
+          return std::string("-");
+        }
+        const Vec3 d = scaled(mat_place(feet[n]) - eyes, 1.0f / s_rig.map_units);
+        return fmt::format("({:.2f} {:.2f} {:.2f})", dot3(d, right), d.y, dot3(d, ahead));
+      };
+      log_line(0, fmt::format("[vr-body] frame {} parts: main {} chest {} collars {} {} thighs {} {} knees {} {} hands "
+                              "{} {} ankles {} {} feet {} {}; hips {:.2f} head {:.2f} game {:.2f}; fades trunk {:.2f} "
+                              "legs {:.2f} {:.2f} arms {:.2f} {:.2f}; bones as posed last frame {} (nodes {} {}); "
+                              "feet carried {:.2f} in the air {:.2f}; hips face {:.2f}{}; the game tips him {:.0f} "
+                              "degrees, turns him {:.0f} (followed {:.0f}), his feet turned {:.0f}, his trunk leans {:.0f}",
+                              s_game_tag.number, at(main), at(named(kJointChest)),
+                              at(named(kJointSide + kSideShoulder)), at(named(kJointSide + 16 + kSideShoulder)),
+                              at(named(kJointSide + kSideThigh)), at(named(kJointSide + 16 + kSideThigh)),
+                              at(named(kJointSide + kSideKnee)), at(named(kJointSide + 16 + kSideKnee)),
+                              at(named(kJointSide + kSideHand)), at(named(kJointSide + 16 + kSideHand)),
+                              at(named(kJointAnkle)), at(named(kJointAnkle + 1)), foot_at(named(kJointAnkle)),
+                              foot_at(named(kJointAnkle + 1)), hips, head_heading, heading, s_body.trunk_fade,
+                              s_body.leg_fade[0], s_body.leg_fade[1], s_body.arm_fade[0], s_body.arm_fade[1],
+                              s_bone_keep.stale, s_bone_keep.stale_node[0], s_bone_keep.stale_node[1],
+                              s_body.feet_carry_shown, s_body.feet_air, hips_face, riding ? " riding" : "",
+                              std::acos(std::clamp(s_body.tilt_cos, -1.0f, 1.0f)) * 57.29578f,
+                              s_body.feet_d_was * 57.29578f, s_body.feet_turn * 57.29578f,
+                              s_body.feet_turned * 57.29578f, s_body.crouch_lean * 57.29578f)
+                      .c_str());
+      log_line(0, fmt::format("[vr-body] frame {} on feet {}; spine as the game sent it (node:rows@from its parent, "
+                              "m):{}",
+                              s_game_tag.number, on_feet ? 1 : 0, spine_raw)
+                      .c_str());
+    }
+  }
+  // Each hand's fingers as drawn (the thumb first; 0 straight, 1 closed, below 0 bent back), how far the world
+  // moved each from what the controller asks, and how many surfaces the hand is at. JAKVR_BODY_TRACE=3: each frame
+  // too (do they hold still against the world?).
+  static const bool trace_fingers = trace && std::getenv("JAKVR_BODY_TRACE")[0] == '3';
+  const auto finger_lines = [&]() {
+    for (int side = 0; side < 2; ++side) {
+      if (s_rig.map_grip_valid[side]) {
+        const float* c = s_body.finger_curl[side];
+        const float* f = s_body.finger_off[side];
+        log_line(0, fmt::format("[vr-body] the {} fingers {:.2f} {:.2f} {:.2f} {:.2f} {:.2f}, by the world {:+.2f} "
+                                "{:+.2f} {:+.2f} {:+.2f} {:+.2f}, at {} surfaces{}",
+                                side == quest::kLeft ? "left" : "right", c[0], c[1], c[2], c[3], c[4], f[0], f[1],
+                                f[2], f[3], f[4], s_body.plane_count[side],
+                                s_body.palm_faces[side] ? " (the palm faces one)" : "")
+                        .c_str());
+      }
+    }
+  };
+  if (trace_fingers && (trace_count + 1) % 30 != 0) {
+    finger_lines();
+  }
+  // Steadiness (0.1.1, the owner: "refine ik and body representation, to be sure its all as smooth as possible"): each
+  // of these joints from the eyes every frame, and the most it jumped in a frame against the frames either side (its
+  // move less the mean of its moves before and after: a steady swing is 0, a pop is its size), told with the lines
+  // below, in cm: the elbows, the hands, the knees, his chest and hips.
+  static constexpr int kSteadyJoints = 8;
+  static Vec3 steady_was[kSteadyJoints][2];
+  static int steady_have = 0;
+  static float steady_most[kSteadyJoints] = {};
+  if (trace) {
+    const int joints[kSteadyJoints] = {named(kJointSide + kSideForearm), named(kJointSide + 16 + kSideForearm),
+                                       named(kJointSide + kSideHand),    named(kJointSide + 16 + kSideHand),
+                                       named(kJointSide + kSideKnee),    named(kJointSide + 16 + kSideKnee),
+                                       named(kJointChest),               named(kJointHips)};
+    for (int k = 0; k < kSteadyJoints; ++k) {
+      const Vec3 now = joints[k] >= 0 ? scaled(mat_place(w[joints[k]]) - s_rig.map_head_world, 1.0f / s_rig.map_units)
+                                      : Vec3{0, 0, 0};
+      if (steady_have >= 2) {
+        const Vec3 jerk = (now - steady_was[k][0]) - (steady_was[k][0] - steady_was[k][1]);
+        // (past 3 m it is no joint's jump: the body was not posed for a while, a scene or a warp between the samples)
+        if (quest::length(jerk) < 3.0f) {
+          steady_most[k] = std::max(steady_most[k], quest::length(jerk) * 100.0f);
+        }
+      }
+      steady_was[k][1] = steady_was[k][0];
+      steady_was[k][0] = now;
+    }
+    steady_have = std::min(steady_have + 1, 2);
+  } else {
+    steady_have = 0;
+  }
+  if (trace && (trace_count + 1) % 30 == 0) {
+    const float* s = steady_most;
+    log_line(0, fmt::format("[vr-body] steadiness, the most a joint jumped in a frame (cm): elbows {:.1f} {:.1f}, hands "
+                            "{:.1f} {:.1f}, knees {:.1f} {:.1f}, chest {:.1f}, hips {:.1f}",
+                            s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7])
+                    .c_str());
+    std::fill(std::begin(steady_most), std::end(steady_most), 0.0f);
+  }
+  // What of him comes nearest before the eyes (0.1.1, the owner: "certain actions seem to clip in the eyes"): of the
+  // joints the eyes still draw (not his head's, none cut), the nearest not behind the eyes, named by what it is or
+  // hangs from, told as it comes within 30 cm (the player's metres) and every 10 frames while it stays there.
+  if (trace) {
+    const auto& hid = s_game_tag.hidden[0];
+    const auto bit = [](const std::uint8_t* bits, int i) { return i < 128 && ((bits[i >> 3] >> (i & 7)) & 1) != 0; };
+    const Vec3 near_ahead = flat_dir(head_heading), near_right{-near_ahead.z, 0.0f, near_ahead.x};
+    int best = -1;
+    float best_d = 0.30f;
+    Vec3 best_at{0, 0, 0};
+    for (int i = 0; i < info.count && i < 128; ++i) {
+      if (!bone_ok(info.bone[i]) || bit(hid.slots, i) || bit(hid.cut, i)) {
+        continue;
+      }
+      const Vec3 d = scaled(mat_place(w[i]) - s_rig.map_head_world, 1.0f / s_rig.map_units);
+      const Vec3 r{dot3(d, near_right), d.y, dot3(d, near_ahead)};
+      const float len = quest::length(d);
+      if (r.z > -0.02f && len < best_d) {
+        best_d = len;
+        best = i;
+        best_at = r;
+      }
+    }
+    static int near_was = -1, near_frames = 0;
+    if (best >= 0 && (best != near_was || ++near_frames % 10 == 0)) {
+      static const char* kSideName[16] = {"collar", "upper arm", "forearm", "hand", "thumb", "thumb", "index finger",
+                                          "index finger", "middle finger", "middle finger", "ring finger", "ring finger",
+                                          "little finger", "little finger", "thigh", "knee"};
+      const auto label_of = [&](int n) -> std::string {
+        for (int k = 0; k < kJointHideFirst; ++k) {
+          if (info.named[k] != n) {
+            continue;
+          }
+          if (k >= kJointSide && k < kJointAnkle) {
+            return fmt::format("{} {}", (k - kJointSide) / 16 == 0 ? "left" : "right", kSideName[(k - kJointSide) % 16]);
+          }
+          switch (k) {
+            case kJointNeck: return "neck";
+            case kJointMain: return "main";
+            case kJointChest: return "chest";
+            case kJointGun: return "gun joint";
+            case kJointAnkle: return "left ankle";
+            case kJointAnkle + 1: return "right ankle";
+            case kJointHips: return "hips";
+            case kJointUpper: return "upper body";
+            default: break;
+          }
+        }
+        return "";
+      };
+      std::string what = label_of(best);
+      for (int p = s.parent[best]; what.empty() && p >= 0; p = s.parent[p]) {
+        const std::string above = label_of(p);
+        if (!above.empty()) {
+          what = "on the " + above;
+        }
+      }
+      log_line(0, fmt::format("[vr-body] nearest before the eyes: joint {} ({}) {:.2f} m (right {:.2f}, up {:.2f}, "
+                              "ahead {:.2f}), frame {}",
+                              best, what.empty() ? "?" : what, best_d, best_at.x, best_at.y, best_at.z,
+                              s_game_tag.number)
+                      .c_str());
+    }
+    if (best != near_was) {
+      near_frames = 0;
+    }
+    near_was = best;
+  }
+  if (trace && ++trace_count % 30 == 0) {
+    const float m = 1.0f / 4096.0f;
+    const Vec3 eyes = s_rig.map_head_world;
+    const Vec3 nk = neck >= 0 ? mat_place(w[neck]) : Vec3{0, 0, 0};
+    log_line(0, fmt::format("[vr-body] main {} neck {} hips node {}: on feet {}, moving {}, heading {:.2f}, hips {:.2f}, "
+                            "head {:.2f}, twist {:.2f}; neck from the eyes ({:.2f} {:.2f} {:.2f}) m, game's neck was "
+                            "({:.2f} {:.2f} {:.2f}) from them; hands {} {}",
+                            main, neck, named(kJointHips), on_feet ? 1 : 0, moving ? 1 : 0, heading, hips, head_heading,
+                            twist, (nk.x - eyes.x) * m, (nk.y - eyes.y) * m, (nk.z - eyes.z) * m,
+                            (s_body.neck_was.x - eyes.x) * m, (s_body.neck_was.y - eyes.y) * m,
+                            (s_body.neck_was.z - eyes.z) * m, s_rig.map_grip_valid[0] ? 1 : 0,
+                            s_rig.map_grip_valid[1] ? 1 : 0)
+                    .c_str());
+    finger_lines();
+    // His main joint's z row as the game posed it (Jak 1's scenes take their facing from it, pc-vr.gc vr-jak-ahead!):
+    // in play it should be his facing.
+    if (main >= 0) {
+      const Vec3 z{feet[main].m[2][0], feet[main].m[2][1], feet[main].m[2][2]};
+      log_line(0, fmt::format("[vr-body] the game's main joint faces {:.2f} (z row {:.2f} {:.2f} {:.2f}); his facing {:.2f}",
+                              std::atan2(z.x, z.z), z.x, z.y, z.z, heading)
+                      .c_str());
+    }
+    // The collar's joints from the eyes in the head's own flat frame (right, up, ahead), and the gun's state.
+    const Vec3 ahead_flat = flat_dir(head_heading), right_flat{-ahead_flat.z, 0.0f, ahead_flat.x};
+    const auto rel = [&](int n) {
+      if (n < 0) {
+        return Vec3{0, 0, 0};
+      }
+      const Vec3 d = mat_place(w[n]) - eyes;
+      return Vec3{dot3(d, right_flat) * m, d.y * m, dot3(d, ahead_flat) * m};
+    };
+    const auto rel_point = [&](Vec3 at) {
+      const Vec3 d = at - eyes;
+      return Vec3{dot3(d, right_flat) * m, d.y * m, dot3(d, ahead_flat) * m};
+    };
+    const Vec3 nb = rel(neck >= 0 ? s.parent[neck] : -1), ch = rel(named(kJointChest)), nr = rel(neck);
+    log_line(0, fmt::format("[vr-body] from the eyes (right, up, ahead) m: neck {:.2f} {:.2f} {:.2f}, neck base {:.2f} "
+                            "{:.2f} {:.2f}, chest {:.2f} {:.2f} {:.2f}; gun bones {} (of its {}) in hand {} held by "
+                            "both {}",
+                            nr.x, nr.y, nr.z, nb.x, nb.y, nb.z, ch.x, ch.y, ch.z, info.gun_count, info.gun_pad,
+                            s_gun_in_hand ? 1 : 0,
+                            s_support.held ? 1 : 0)
+                    .c_str());
+    // Each arm's collar, shoulder, elbow and wrist from the eyes (the IK's work: is the arm in the eyes' way?).
+    for (int side = 0; side < 2; ++side) {
+      const int b = kJointSide + 16 * side;
+      const Vec3 c = rel(named(b + kSideShoulder)), sh = rel(named(b + kSideArm)), el = rel(named(b + kSideForearm)),
+                 wr = rel(named(b + kSideHand));
+      log_line(0, fmt::format("[vr-body] {} arm from the eyes (right, up, ahead) m: collar {:.2f} {:.2f} {:.2f}, "
+                              "shoulder {:.2f} {:.2f} {:.2f}, elbow {:.2f} {:.2f} {:.2f}, wrist {:.2f} {:.2f} {:.2f}",
+                              side == quest::kLeft ? "left" : "right", c.x, c.y, c.z, sh.x, sh.y, sh.z, el.x, el.y,
+                              el.z, wr.x, wr.y, wr.z)
+                      .c_str());
+    }
+    // JAKVR_TRACE_JOINTS=14,64,...: those nodes from the eyes too (what is that in the eyes' way?).
+    static const char* more = std::getenv("JAKVR_TRACE_JOINTS");
+    if (more) {
+      std::string line = "[vr-body] nodes from the eyes (right, up, ahead) m:";
+      for (const char* p = more; *p;) {
+        char* end = nullptr;
+        const long n = std::strtol(p, &end, 10);
+        if (end == p) {
+          ++p;
+          continue;
+        }
+        p = end;
+        if (n >= 0 && n < info.count) {
+          const Vec3 r = rel(static_cast<int>(n));
+          line += fmt::format(" {}<{}=({:.2f} {:.2f} {:.2f})", n, s.parent[n], r.x, r.y, r.z);
+        }
+      }
+      log_line(0, line.c_str());
+    }
+    // The gun: where the game's own pose (before the body was fitted) has its anchor from the right hand, and where the
+    // drawn one is from the eyes; the barrel bone and the gun's first bone from the eyes.
+    const int rh = named(kJointSide + 16 * quest::kRight + kSideHand);
+    if (gun >= 0 && rh >= 0) {
+      const Vec3 hold = mat_place(mat_mul(feet[gun], mat_inverse(feet[rh])));
+      if (s.has_made[gun] && s.has_made[rh]) {
+        const Vec3 made_hold = mat_place(mat_mul(s.made[gun], mat_inverse(s.made[rh])));
+        const Vec3 mg = mat_place(s.made[gun]), mh = mat_place(s.made[rh]);
+        log_line(0, fmt::format("[vr-body] gun as made: from the right hand ({:.2f} {:.2f} {:.2f}) in its axes; gun at "
+                                "{:.2f} {:.2f} {:.2f}, hand at {:.2f} {:.2f} {:.2f} (model m)",
+                                made_hold.x * m, made_hold.y * m, made_hold.z * m, mg.x * m, mg.y * m, mg.z * m, mh.x * m,
+                                mh.y * m, mh.z * m)
+                        .c_str());
+      }
+      const Vec3 anim_hand = mat_place(feet[rh]) - eyes, anim_gun = mat_place(feet[gun]) - eyes;
+      Vec3 bar{0, 0, 0}, root{0, 0, 0};
+      if (gun_count > 13 && bone_ok(info.gun_bone[13]) && bone_ok(info.gun_bone[0])) {
+        Mat b;
+        std::memcpy(&b, memory + info.gun_bone[13], sizeof b);
+        bar = rel_point(mat_place(b));
+        std::memcpy(&b, memory + info.gun_bone[0], sizeof b);
+        root = rel_point(mat_place(b));
+      }
+      log_line(0, fmt::format("[vr-body] gun: the game's hold from the right hand ({:.2f} {:.2f} {:.2f}) m in its axes, "
+                              "{:.2f} m; the game's hand {:.2f} {:.2f} {:.2f} and gun {:.2f} {:.2f} {:.2f} from the eyes "
+                              "(world); drawn gun bone 0 at {:.2f} {:.2f} {:.2f}, barrel 13 at {:.2f} {:.2f} {:.2f} "
+                              "(right, up, ahead)",
+                              hold.x * m, hold.y * m, hold.z * m, quest::length(hold) * m, anim_hand.x * m,
+                              anim_hand.y * m, anim_hand.z * m, anim_gun.x * m, anim_gun.y * m, anim_gun.z * m, root.x,
+                              root.y, root.z, bar.x, bar.y, bar.z)
+                  .c_str());
+    }
+  }
+#endif
+  int posed_corner_node = -1;
+  float posed_corner_off = 0.0f;
+  for (int i = 0; i < info.count; ++i) {
+    if (bone_ok(info.bone[i])) {
+      const float off = mat_corner_off(w[i]);
+      if (off > posed_corner_off) {
+        posed_corner_off = off;
+        posed_corner_node = i;
+      }
+      make_affine(w[i]);
+      write_bone(s_bone_keep.jak[i], memory, info.bone[i], w[i]);
+    }
+  }
+#if !defined(__ANDROID__)
+  // PC test aid (JAKVR_BODY_TRACE=1): a bone not affine as the game gave it or as posed (mat_corner_off), each frame
+  // one is.
+  if (trace && (corner_off > 1e-4f || posed_corner_off > 1e-4f)) {
+    log_line(0, fmt::format("[vr-body] frame {}: the game's bones' last column most {:.5f} off 0 0 0 1 (node {}), as "
+                            "posed {:.5f} (node {}); made affine",
+                            s_game_tag.number, corner_off, corner_node, posed_corner_off, posed_corner_node)
+                    .c_str());
+  }
+#else
+  (void)corner_node;
+  (void)posed_corner_node;
+#endif
+  // Daxter carried with the chest from where the game had it to where it is posed: his animation puts him on the
+  // animated shoulder, which the body pose moves under the head (he is out of the eyes, but his shadow and the
+  // shoulder he sits on are not).
+  if (dax_chest >= 0 && info.dax_count > 0) {
+    const Mat carry = mat_mul(mat_inverse(chest_as_game), w[dax_chest]);
+    const int n = std::min<int>(info.dax_count, kDaxBonesMost);
+    for (int i = 0; i < n; ++i) {
+      if (!bone_ok(info.dax_bone[i])) {
+        continue;
+      }
+      Mat b = read_bone(s_bone_keep.dax[i], memory, info.dax_bone[i]);
+      make_affine(b);
+      b = mat_mul(b, carry);
+      make_affine(b);
+      write_bone(s_bone_keep.dax[i], memory, info.dax_bone[i], b);
+    }
+  }
+  // Told once each way for the tests (JAKVR_BODY_TRACE or not: a state that freezes his joints is worth a line).
+  if ((s_bone_keep.stale > 0) != s_bone_keep.stale_was) {
+    s_bone_keep.stale_was = s_bone_keep.stale > 0;
+    lg::info("[vr-body] {}", s_bone_keep.stale_was
+                                 ? fmt::format("the game left {} bones as posed last frame: posed again from its own "
+                                               "before them",
+                                               s_bone_keep.stale)
+                                 : std::string("the game makes his bones again"));
+  }
+  return 1;
+}
+
+// ==== Multiplayer: each VR player's posed body on his Jak in the others' games (Jak 1's parties) ====
+// The word: 'J' 'V' kPoseVersion n, then n joints, each its BodyJoint (u8), its turn in his root's frame as a quaternion
+// (4 x i16, 1/32767) and its place there (3 x i16, in 2 game units: 16 m each way), so about 600 bytes, base64 in the
+// party's update ("vr"; party.cpp also sends it on its own, with his place, each tick it changed while he stands
+// still). A game that does not know "vr" drops it. The receiving game puts each joint there on his Jak (its own
+// scale kept) and carries every joint under it along, so his skin, his shadow and his head follow the player's.
+
+namespace {
+
+constexpr std::uint8_t kPoseVersion = 1;
+constexpr int kPoseEntry = 15;  // bytes a joint
+constexpr auto kPoseFresh = std::chrono::seconds(1);
+
+struct PoseHeard {
+  std::vector<std::uint8_t> word;
+  std::chrono::steady_clock::time_point when;
+};
+
+std::mutex s_pose_mutex;
+std::string s_pose_word;                // this player's word, base64 ("" none)
+std::map<int, PoseHeard> s_pose_heard;  // the others' last words, by party index
+VrBodyInfo s_pose_info;                 // not on the stack (as body()'s)
+Mat s_pose_old[kBodyNodesMost], s_pose_new[kBodyNodesMost];
+
+// A root as the games' matrices are (rows: its axes, then its place) from its place and quaternion (x y z w).
+Mat pose_root(const float* trans, const float* quat) {
+  const float x = quat[0], y = quat[1], z = quat[2], w = quat[3];
+  Mat r = mat_identity();
+  r.m[0][0] = 1 - 2 * (y * y + z * z);
+  r.m[0][1] = 2 * (x * y + w * z);
+  r.m[0][2] = 2 * (x * z - w * y);
+  r.m[1][0] = 2 * (x * y - w * z);
+  r.m[1][1] = 1 - 2 * (x * x + z * z);
+  r.m[1][2] = 2 * (y * z + w * x);
+  r.m[2][0] = 2 * (x * z + w * y);
+  r.m[2][1] = 2 * (y * z - w * x);
+  r.m[2][2] = 1 - 2 * (x * x + y * y);
+  r.m[3][0] = trans[0];
+  r.m[3][1] = trans[1];
+  r.m[3][2] = trans[2];
+  return r;
+}
+
+// pose_root's turn back to its quaternion (a turn with no scale).
+void pose_quat(const Mat& a, float q[4]) {
+  const auto& m = a.m;
+  const float trace = m[0][0] + m[1][1] + m[2][2];
+  if (trace > 0.0f) {
+    const float s = std::sqrt(trace + 1.0f) * 2.0f;
+    q[3] = 0.25f * s;
+    q[0] = (m[1][2] - m[2][1]) / s;
+    q[1] = (m[2][0] - m[0][2]) / s;
+    q[2] = (m[0][1] - m[1][0]) / s;
+  } else if (m[0][0] > m[1][1] && m[0][0] > m[2][2]) {
+    const float s = std::sqrt(std::max(1e-12f, 1.0f + m[0][0] - m[1][1] - m[2][2])) * 2.0f;
+    q[3] = (m[1][2] - m[2][1]) / s;
+    q[0] = 0.25f * s;
+    q[1] = (m[0][1] + m[1][0]) / s;
+    q[2] = (m[2][0] + m[0][2]) / s;
+  } else if (m[1][1] > m[2][2]) {
+    const float s = std::sqrt(std::max(1e-12f, 1.0f + m[1][1] - m[0][0] - m[2][2])) * 2.0f;
+    q[3] = (m[2][0] - m[0][2]) / s;
+    q[0] = (m[0][1] + m[1][0]) / s;
+    q[1] = 0.25f * s;
+    q[2] = (m[1][2] + m[2][1]) / s;
+  } else {
+    const float s = std::sqrt(std::max(1e-12f, 1.0f + m[2][2] - m[0][0] - m[1][1])) * 2.0f;
+    q[3] = (m[0][1] - m[1][0]) / s;
+    q[0] = (m[2][0] + m[0][2]) / s;
+    q[1] = (m[1][2] + m[2][1]) / s;
+    q[2] = 0.25f * s;
+  }
+}
+
+void put_i16(std::vector<std::uint8_t>& out, float v) {
+  const int i = std::clamp(static_cast<int>(std::lround(v)), -32767, 32767);
+  out.push_back(static_cast<std::uint8_t>(i & 0xff));
+  out.push_back(static_cast<std::uint8_t>((i >> 8) & 0xff));
+}
+
+float get_i16(const std::uint8_t* p) {
+  return static_cast<float>(static_cast<std::int16_t>(static_cast<std::uint16_t>(p[0] | (p[1] << 8))));
+}
+
+const char kBase64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+std::string base64_encode(const std::vector<std::uint8_t>& in) {
+  std::string out;
+  out.reserve((in.size() + 2) / 3 * 4);
+  for (std::size_t i = 0; i < in.size(); i += 3) {
+    const std::uint32_t n = (in[i] << 16) | (i + 1 < in.size() ? in[i + 1] << 8 : 0) |
+                            (i + 2 < in.size() ? in[i + 2] : 0);
+    out.push_back(kBase64[(n >> 18) & 63]);
+    out.push_back(kBase64[(n >> 12) & 63]);
+    out.push_back(i + 1 < in.size() ? kBase64[(n >> 6) & 63] : '=');
+    out.push_back(i + 2 < in.size() ? kBase64[n & 63] : '=');
+  }
+  return out;
+}
+
+std::vector<std::uint8_t> base64_decode(const std::string& in) {
+  std::vector<std::uint8_t> out;
+  std::uint32_t n = 0;
+  int bits = 0;
+  for (const char c : in) {
+    const char* at = std::strchr(kBase64, c);
+    if (c == '=' || c == 0 || !at) {
+      continue;
+    }
+    n = (n << 6) | static_cast<std::uint32_t>(at - kBase64);
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out.push_back(static_cast<std::uint8_t>((n >> bits) & 0xff));
+    }
+  }
+  return out;
+}
