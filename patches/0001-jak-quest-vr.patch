+;; (vr-ptr-note-row!; the chosen row's bar is from 6 above it, 35 high): moving onto a row chooses it, and a click on
+;; the chosen row is Cross on it.
+(defun vr-ptr-progress-rows ((obj progress) (count int))
+  (when (and (= (-> obj menu-transition) 0.0)
+             (zero? (-> obj want-option-index)))
+    (dotimes (index (min count 60))
+      (when (logtest? *vr-ptr-rows* (ash 1 index))
+        (let ((y (-> *vr-ptr-row-y* index)))
+          (when (vr-ptr-over? 40.0 472.0 (+ y -6.0) (+ y -6.0 (-> *vr-ptr-row-h* index)))
+            (cond
+              ((-> obj selected-option)
+               (if (and (logtest? *vr-ptr-flags* 4) (= index (-> obj option-index)))
+                   (pc-vr-pointer-hit!)))
+              (else
+                (when (and (logtest? *vr-ptr-flags* 6) (!= index (-> obj option-index)))
+                  (set! (-> obj option-index) index)
