+;; ---- the VR menu ----
+;; Opened from the options menu's "VR Options" (pc/progress/progress-static-pc.gc) or the left menu button held a
+;; second in a menu. The runtime lays it out in the 512 by 416 screen and takes the controllers while it is up; this
+;; draws its boxes (the menu, the chosen row) and then its words, in the HUD bucket the menus use, over the game's own
+;; menu.
+
+(define *vr-menu-string* (new 'global 'string 256 (the-as string #f)))
+
+(defun vr-menu-draw ()
+  (when (pc-vr-menu-shown?)
+    (let ((at (new 'stack-no-clear 'vector)))
+      (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
+                                   (bucket-id hud-draw-hud-alpha))
+        ;; the boxes blend over what is under them, whatever the bucket's last drawing left set, and keep no depth
+        (dma-buffer-add-gs-set buf
+                               (zbuf-1 (new 'static 'gs-zbuf :zbp #x130 :psm (gs-psm ct24) :zmsk #x1))
+                               (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
+                               (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
+        (dotimes (i 4)
+          (let ((kind (pc-vr-menu-box i at)))
+            (when (nonzero? kind)
+              (draw-sprite2d-xy buf (the int (-> at x)) (the int (-> at y)) (the int (-> at z)) (the int (-> at w))
+                                (if (= kind 2)
+                                    (new 'static 'rgba :r #x40 :g #x48 :b #x70 :a #x60)
+                                    (new 'static 'rgba :r #x06 :g #x08 :b #x10 :a #x80))
+                                #x3fffff)))))
+      (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
+        (dotimes (i 40)
+          (let ((r (pc-vr-menu-text i *vr-menu-string* at)))
+            (when (nonzero? r)
+              (let ((align (logand (ash r -8) 255))
+                    (width (-> at w)))
+                (set-width! font (the int width))
+                (set-height! font 24)
+                (set-scale! font (-> at z))
+                (set-color! font (the-as font-color (logand r 255)))
+                (case align
+                  ((1)
+                   (set-flags! font (font-flags shadow kerning middle large))
+                   (set-origin! font (the int (- (-> at x) (* 0.5 width))) (the int (-> at y))))
+                  ((2)
+                   (set-flags! font (font-flags shadow kerning right large))
+                   (set-origin! font (the int (-> at x)) (the int (-> at y))))
+                  (else
+                   (set-flags! font (font-flags shadow kerning large))
+                   (set-origin! font (the int (-> at x)) (the int (-> at y)))))
+                (print-game-text *vr-menu-string* font #f 44 (bucket-id hud-draw-hud-alpha)))))))))
+  0)
+
+;; ---- the menu pointer on the game's own menus ----
+;; The runtime's pointer (jak_vr.cpp menu_pointer_at) on the 512 by 416 screen, read once a frame by the menus
+;; (progress-post): flags 1 on the screen, 2 moved since last read, 4 a click waits for the row under it. A menu's row
+;; under it is chosen, and a click on it calls pc-vr-pointer-hit!, which the runtime makes Cross on that row. Jak 3's
+;; rows place themselves (adjust-font-origin-y), so each row's place is noted as it is drawn (vr-ptr-note-row!).
+
+(define *vr-ptr* (new 'global 'vector))
+(define *vr-ptr-flags* 0)
+(define *vr-ptr-click* #f) ;; a click this frame that was not waiting last frame
+(define *vr-ptr-noting* #f) ;; progress-post is drawing its rows
+(define *vr-ptr-rows* 0) ;; a bit for each row noted this frame
+(define *vr-ptr-row-y* (the-as (pointer float) (malloc 'global 256)))
+
+(defun vr-ptr-read! ()
+  (let ((was (logtest? *vr-ptr-flags* 4)))
+    (set! *vr-ptr-flags* (pc-vr-pointer *vr-ptr*))
+    (set! *vr-ptr-click* (and (logtest? *vr-ptr-flags* 4) (not was))))
+  (set! *vr-ptr-rows* 0)
+  0)
+
+(define *vr-ptr-row-h* (the-as (pointer float) (malloc 'global 256))) ;; each noted row's height (35, a bar)
+
+(defun vr-ptr-note-row! ((index int) (y float))
+  "Where row index is drawn this frame (its first placing; what it draws after, such as a header, is not it)."
+  (when (and *vr-ptr-noting* (>= index 0) (< index 60) (not (logtest? *vr-ptr-rows* (ash 1 index))))
+    (logior! *vr-ptr-rows* (ash 1 index))
+    (set! (-> *vr-ptr-row-y* index) y)
+    (set! (-> *vr-ptr-row-h* index) 35.0))
+  0)
+
+(defun vr-ptr-note-box! ((index int) (top float) (height float))
+  "A row drawn as a box of its own, from top and height high (0.1.1: the save slots, which place themselves without
+   adjust-font-origin-y, so the pointer missed them)."
+  (when (and *vr-ptr-noting* (>= index 0) (< index 60))
+    (logior! *vr-ptr-rows* (ash 1 index))
+    (set! (-> *vr-ptr-row-y* index) (+ top 6.0))
+    (set! (-> *vr-ptr-row-h* index) height))
+  0)
+
+(defun vr-ptr-over? ((x0 float) (x1 float) (y0 float) (y1 float))
+  (and (logtest? *vr-ptr-flags* 1)
+       (>= (-> *vr-ptr* x) x0)
+       (< (-> *vr-ptr* x) x1)
+       (>= (-> *vr-ptr* y) y0)
+       (< (-> *vr-ptr* y) y1)))
+
+;; PC test aid (kmachine.cpp pc-vr-test-continue!): with JAKVR_TEST_CONTINUE=<continue point> set, once Jak has been in
+;; play on foot for 2 seconds (no scene, not the title: a boot has a frame or two of him before the title) the game
+;; starts again at that continue point, so a sim reaches any level.
+(define *vr-test-continue* (new 'global 'string 64 (the-as string #f)))
+(define *vr-test-continue-asked* #f)
+(define *vr-test-continue-frames* 0)
+
+(defun vr-test-continue! ()
+  (cond
+    ((or *vr-test-continue-asked* (not *target*) (movie?) (vr-title?) (not (vr-first-person-ok?)))
+     (set! *vr-test-continue-frames* 0))
+    ((< *vr-test-continue-frames* 120)
+     (+! *vr-test-continue-frames* 1))
+    (else
+     (set! *vr-test-continue-asked* #t)
+     (when (= (pc-vr-test-continue! *vr-test-continue*) 1)
+       (let ((cont (get-continue-by-name *game-info* *vr-test-continue*)))
+         (format 0 "[vr] test: continue ~A ~A~%" *vr-test-continue* (if cont "found, starting there" "not found"))
+         (if cont
+             (start 'play cont))))))
+  0)
+
+(define *vr-state-was* (the-as symbol #f))
