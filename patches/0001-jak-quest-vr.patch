+             (zero? (-> obj want-option-index))
+             (not (-> obj selected-option))
+             (logtest? *vr-ptr-flags* 1))
+    (let* ((top (if (= (get-aspect-ratio) 'aspect4x3) 180.0 175.0))
+           (bottom (+ top 80.0)))
+      (cond
+        ((< (-> *vr-ptr* y) top)
+         (when *vr-ptr-click*
+           (set! (-> obj want-option-index) -1)
+           (sound-play "ring-select")))
+        ((>= (-> *vr-ptr* y) bottom)
+         (when *vr-ptr-click*
+           (set! (-> obj want-option-index) 1)
+           (sound-play "ring-select")))
+        (else
+          (if (logtest? *vr-ptr-flags* 4)
+              (pc-vr-pointer-hit!))))))
+  0)
