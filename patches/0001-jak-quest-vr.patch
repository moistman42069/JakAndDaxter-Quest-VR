+constexpr float kFingerBackMost = -0.30f, kFingerFine = 0.02f, kFingerWrapMost = 0.70f;
+constexpr float kFingerThick = 0.012f;  // game metres: half a finger, kept off the surface
+// Under the palm: a small sphere from the palm's middle the way the palm faces, for what the hand hovers over.
+constexpr float kUnderAhead = 0.05f, kUnderReach = 0.11f, kUnderRadius = 0.015f;  // game metres
+// The wrist straps: their fall (m/s2), how fast their swing dies (a second), the spring that draws them back to how
