+;;-*-Lisp-*-
+(in-package goal)
+(bundles "ENGINE.CGO" "GAME.CGO")
+
+;; Jak Quest VR: hands the game's camera to the VR runtime once per frame.
+;; Called from update-camera just before camera-rot is built from inv-camera-rot,
+;; so the runtime can replace the camera with the player's head (first person) or
+;; turn it with the head (third person). Does nothing when no headset is running.
+
+(define-extern movie? (function symbol))
+(define-extern vector<-cspace! (function vector cspace vector))
+(define-extern show-hud (function none)) ;; engine/ui/hud-classes.gc
+
+;; must match VrCameraInfo in game/vr/jak_vr.h (64 bytes)
+(deftype vr-camera-info (structure)
+  ((mode         int32)
+   (flags        int32)
+   (target-yaw   float)   ;; radians
+   (pad0         float)
+   (head         vector :inline)
+   (target-trans vector :inline)
+   (camera-trans vector :inline))
+  )
+
+(define *vr-camera-info* (new 'static 'vr-camera-info))
+
+(defun vr-first-person-ok? ()
+  "Can the camera sit in Jak's head right now? No for vehicles, minigames and scripted states."
+  ;; state names compared as symbols: no game has a runtime string-prefix test
+  (not (case (-> *target* next-state name) (('target-racing 'target-racing-bounce 'target-racing-clone-anim 'target-racing-death 'target-racing-falling 'target-racing-get-off 'target-racing-get-off-hit-ground 'target-racing-get-off-jump 'target-racing-get-on 'target-racing-grab 'target-racing-hit 'target-racing-jump 'target-racing-smack 'target-racing-start 'target-flut-air-attack 'target-flut-air-attack-hit-ground 'target-flut-clone-anim 'target-flut-death 'target-flut-double-jump 'target-flut-falling 'target-flut-get-off 'target-flut-get-off-hit-ground 'target-flut-get-off-jump 'target-flut-get-on 'target-flut-grab 'target-flut-hit 'target-flut-hit-ground 'target-flut-jump 'target-flut-running-attack 'target-flut-stance 'target-flut-start 'target-flut-walk 'target-tube 'target-tube-death 'target-tube-hit 'target-tube-jump 'target-tube-start 'target-snowball 'target-snowball-start 'target-pole-cycle 'target-pole-flip-forward 'target-pole-flip-forward-jump 'target-pole-flip-up 'target-pole-flip-up-jump 'target-title 'target-title-play 'target-title-wait 'target-warp-in 'target-warp-out 'target-fishing 'target-periscope 'target-billy-game 'target-death 'target-clone-anim 'target-launch 'target-demo 'target-final-door 'target-play-anim) #t) (else #f))))
+
+(defun vr-vehicle-first-person-ok? ()
+  "Jak and Daxter Quest VR 0.1.1, the VR menu's First person in vehicles (off to start): riding the Zoomer or the flut
+   flut, or down a slide (the tubes), where the view can sit in his head and turn with it (the owner: 'vehicles/
+   everything'). Not getting on or off, a death or a scripted move; not round a pole or in a minigame."
+  (case (-> *target* next-state name)
+    (('target-racing 'target-racing-bounce 'target-racing-falling 'target-racing-hit 'target-racing-jump
+      'target-racing-smack 'target-racing-start 'target-flut-air-attack 'target-flut-air-attack-hit-ground
+      'target-flut-double-jump 'target-flut-falling 'target-flut-hit 'target-flut-hit-ground 'target-flut-jump
+      'target-flut-running-attack 'target-flut-stance 'target-flut-start 'target-flut-walk
+      'target-tube 'target-tube-jump 'target-tube-hit)
+     #t)
+    (else #f)))
+
+(defun vr-title? ()
+  (case (-> *target* next-state name) (('target-title 'target-title-play 'target-title-wait) #t) (else #f)))
+
+;; ---- Jak's head, and Daxter on his shoulder, kept out of the first-person view ----
+;; The view sits in Jak's head, so his head (neckB and the hair, ears, eyes and mouth on it) is left out of the eyes,
+;; and Daxter likewise in play (on the shoulder, at the eyes) and in a scene while he is within a metre of them. Left
+;; out in the renderer only (jak_vr.cpp body and merc_hidden), not in his bones: his shadow keeps all of him, head and
+;; all (the owner's ask, 2026-11-12, as Ratchet's).
+
+(define *vr-head-hidden* #f)    ;; first person this frame
+(define *vr-stereo* #f)         ;; the eyes see the game in stereo this frame: no letterbox (main.gc)
+(defun vr-daxter ()
+  "Daxter: Jak's sidekick process (no game sets *sidekick*), #f without one."
+  (let ((p (if (and *target* (-> *target* sidekick)) (ppointer->process (-> *target* sidekick)) #f)))
+    ;; a sidekick still: the link can outlive him, its process slot dead or another's (sim j2_glow1, a new game)
+    (if (and p (type-type? (-> p type) sidekick)) (the-as sidekick p) (the-as sidekick #f))))
+
+(defun vr-eyes<-neck! ((out vector) (csp cspace) (fwd vector))
+  "The eyes' place from Jak's neck joint: a little above it and ahead along his facing fwd (any length, flattened), so a
+   cutscene's eyes look out of his face, not from inside his neck. The world's up and his body's facing, not the neck's
+   own axes: a scene's high-res Jak turns his neck bone every way (sim, 2026-11-12)."
+  (vector<-cspace! out csp)
+  (when (!= (-> out w) 0.0)
+    (+! (-> out y) (meters 0.1))
+    (let ((len (sqrtf (+ (* (-> fwd x) (-> fwd x)) (* (-> fwd z) (-> fwd z))))))
+      (when (< 0.0 len)
+        (+! (-> out x) (* (-> fwd x) (/ (meters 0.08) len)))
+        (+! (-> out z) (* (-> fwd z) (/ (meters 0.08) len))))))
+  out)
+
+(defun vr-near-eyes? ((pd process-drawable))
+  "pd (where it is drawn: Daxter's root stays put, his joints hang off Jak's shoulder) within a metre of the view."
+  (if (and pd (nonzero? (-> pd draw))
+           (< (vector-vector-distance (-> pd draw origin) (-> *math-camera* trans)) (meters 1.0)))
+      #t
+      #f))
+
+(defun vr-before-joints ()
+  "Called just before the frame's joint math (main.gc). Nothing now: the body is posed after it (vr-body-update!)."
+  (none))
+
+(defun vr-joint-named ((pd process-drawable) (name string))
+  "The index of pd's joint called name, -1 without one."
+  (let ((nl (-> pd node-list)))
+    (when (nonzero? nl)
+      (dotimes (i (-> nl length))
+        (let ((j (-> nl data i joint)))
+          (if (and j (string= (the-as string (-> j name)) name)) (return i))))))
+  -1)
+
+(define *vr-main-joint* -2) ;; Jak's "main" joint (-2: not looked up yet, -1: none)
+
+(defun vr-jak-ahead! ((out vector) (movie? symbol))
+  "Jak's ahead (any length, flat or not): his control's facing in play; in a scene his main joint's z row (its y row is
+   up), as Jak II and 3's scene Jak (LIST-0.1.1 item 8, Vixel: 'your mostly looking away from what is happening in the
+   story'): Jak 1's scenes turn his whole body by its joints and leave his control's facing as it was in play."
+  (vector-z-quaternion! out (-> *target* control quat))
+  (when (and movie? (nonzero? (-> *target* node-list)))
+    (if (= *vr-main-joint* -2) (set! *vr-main-joint* (vr-joint-named *target* "main")))
+    (when (and (>= *vr-main-joint* 0) (< *vr-main-joint* (-> *target* node-list length)))
+      (let ((z (-> *target* node-list data *vr-main-joint* bone transform vector 2)))
+        (when (or (!= (-> z x) 0.0) (!= (-> z z) 0.0))
+          (set! (-> out x) (-> z x))
+          (set! (-> out y) 0.0)
+          (set! (-> out z) (-> z z))))))
+  out)
+
+;; ---- Jak's body in first person (all three games alike) ----
+;; The runtime poses his bones once a frame after the joint math and the camera (pc-vr-body!, jak_vr.cpp body): his
+;; arms to the controllers, his fingers to the player's, the body under the head, his head turned as the player's (seen
+;; in the shadow). It also leaves his head, and Daxter at the eyes, out of the eyes. Here: what it needs to know of his
+;; skeleton, each frame.
+
+;; must match VrBodyInfo in game/vr/jak_vr.h
+(deftype vr-body-info (structure)
+  ((count    int32)
+   (flags    int32)       ;; 1 pose him, 2 his head out of the eyes, 4 Daxter out of the eyes
+   (key      uint32)      ;; the node list the named joints were found in
+   (pad      int32)
+   (named    int16 48)    ;; jak_vr.h BodyJoint: the named joints' nodes, -1 for none
+   (jak-name uint8 64)    ;; his merc model's name
+   (dax-name uint8 64)    ;; Daxter's
+   (parent   int8 128)    ;; each node's parent node
+   (bone     uint32 128)  ;; each node's bone
+   (bind     uint32 128)  ;; its joint's bind pose
+   ;; the hands against the world: lines the runtime asks about (pc-vr-hand-probes!), each a sphere moved from `from`
+   ;; to `to` (w its radius); `hit` xyz the normal of what it met, w how far along (0 to 1), -1 for nothing
+   (probe-count int32)
+   (probe-pad   int32 3)
+   (probe-from  vector 8 :inline)  ;; 8 (0.1.1): the palms, the fingers ahead, under the palms, the wrist straps
+   (probe-to    vector 8 :inline)
+   (probe-hit   vector 8 :inline)
+   ;; Jak II and 3's gun: its bones, carried with his hand (gun-util.gc vr-gun-fill!); flags 1 drawn, in hand
+   (gun-count   int32)
+   (gun-flags   int32)
+   (gun-barrel  int32)
+   (gun-pad     int32)     ;; the gun's own node count (the trace's, JAKVR_BODY_TRACE)
+   (gun-bone    uint32 64)  ;; 64: Jak 3's magazines are its joints 36 to 39 (0.1.1 item 10)
+   ;; the gun's root as its process placed it (its quat and trans), which the runtime carries the gun from
+   (gun-root    matrix :inline)
+   ;; Daxter on his shoulder in play: his bones, carried with Jak's posed chest (vr-dax-fill!)
+   (dax-count   int32)
+   (dax-pad     int32 3)
+   (dax-bone    uint32 64))
+  )
+
+(define *vr-body-info* (new 'static 'vr-body-info))
+
+;; the named joints in BodyJoint's order: neck, main, chest, gun (none in Jak 1), then a side each (16 apiece, the left
+;; first: shoulder to fingers, thigh and knee), the ankles, hips, upper_body
+(define *vr-body-names*
+  (new 'static 'boxed-array :type string
+       "neckB" "main" "chest" "gun"
+       "Lshould" "Larm" "Lforarm" "sk_lhand" "lthumA" "lthumB" "lindA" "lindB" "lmidA" "lmidB" "lringA" "lringB" "lpinkA" "lpinkB" "Lthigh" "Lknee"
+       "Rshould" "Rarm" "Rforarm" "sk_rhand" "rthumA" "rthumB" "rindA" "rindB" "rmidA" "rmidB" "rringA" "rringB" "rpinkA" "rpinkB" "Rthigh" "Rknee"
+       "Lankle" "Rankle" "hips" "upper_body"
+       ;; left out of the eyes, each on its own: the collar flaps by his jaw (Jak 1), Dark Jak's horns (Jak II and 3)
+       "collarL" "collarR" "horns" "" "" "" "" ""))
+
+(defun vr-body-fill! ((info vr-body-info) (pd process-drawable) (flags int))
+  "info from pd's skeleton: each node's bone, its joint's bind pose and parent; its named joints when it is new."
+  (let* ((nl (-> pd node-list))
+         (n (min 128 (-> nl length))))
+    (set! (-> info flags) flags)
+    (when (or (!= (-> info key) (the-as uint nl)) (!= (-> info count) n))
+      (set! (-> info key) (the-as uint nl))
+      (dotimes (k 48)
+        (set! (-> info named k) -1)
+        (when (< k (-> *vr-body-names* length))
+          (let ((name (-> *vr-body-names* k)))
+            (if (nonzero? (length name))
+                (set! (-> info named k) (vr-joint-named pd name))))))
+      (if (< (-> info named 0) 0)
+          (set! (-> info named 0) (vr-joint-named pd "head"))))
+    (set! (-> info count) n)
+    (dotimes (i n)
+      (let* ((csp (-> nl data i))
+             (j (-> csp joint)))
+        (set! (-> info bone i) (the-as uint (-> csp bone)))
+        (cond
+          (j
+           (set! (-> info bind i) (the-as uint (-> j bind-pose)))
+           (set! (-> info parent i) (if (-> j parent) (+ (-> j parent number) 1) -1)))
+          (else
+           (set! (-> info bind i) (the-as uint 0))
+           (set! (-> info parent i) -1))))))
+  (charp<-string (-> info jak-name) (-> pd draw mgeo name))
+  info)
+
+(defun vr-hand-probes! ((info vr-body-info))
+  "The lines the runtime asks about for the hands (pc-vr-hand-probes!), each probed as a sphere moved along it against
+   the level and solid objects: how far along it met something (0 to 1) and that thing's normal, -1 for nothing."
+  (let ((n (pc-vr-hand-probes! info))
+        (move (new 'stack-no-clear 'vector))
+        (tri (new 'stack-no-clear 'collide-tri-result)))
+    (dotimes (i n)
+      (let ((from (-> info probe-from i))
+            (hit (-> info probe-hit i))
+            (radius (-> info probe-to i w)))
+        (set! (-> hit w) -1.0)
+        (when (< 0.0 radius)
+          (vector-! move (-> info probe-to i) from)
+          (set! (-> move w) 1.0)
+          (let ((u (fill-and-probe-using-line-sphere *collide-cache* from move radius
+                                                     (collide-kind background wall-object ground-object)
+                                                     (the-as process #f) tri
+                                                     (new 'static 'pat-surface :noentity #x1))))
+            (when (>= u 0.0)
+              (set! (-> hit quad) (-> tri normal quad))
+              (set! (-> hit w) u)))))))
+  0)
+
+(defun vr-dax-fill! ((info vr-body-info))
+  "Daxter's bones on Jak's shoulder in play, which the runtime carries with Jak's posed chest (jak_vr.cpp body): his
+   animation sits him on the animated shoulder, which the pose moves under the head."
+  (let ((dax (the-as process-drawable (vr-daxter))))
+    (when (and dax (nonzero? (-> dax node-list)) (nonzero? (-> dax draw)))
+      (let ((n (min 64 (-> dax node-list length))))
+        (dotimes (i n)
+          (set! (-> info dax-bone i) (the-as uint (-> dax node-list data i bone))))
+        (set! (-> info dax-count) n))))
+  0)
+
+;; ---- The other players (Teamruns' multiplayer, engine/mods) ----
+;; Their Jaks are Jaks as the player's is (the same model): the eyes, which leave out the player's own head by its
+;; model, show theirs whole (bones.gc *vr-merc-who*). Teamruns gives them no Daxter (init-target: only the player's own
+;; Jak spawns him). A Jak standing in the player's own body in first person (two players at one spot, as each game
+;; starts) is left out of the eyes whole: his model was all about the eyes (sim mp, 2026-11-13).
+
+(defun vr-merc-others-begin! ()
+  "Before Teamruns' render-targets names this frame's other players (vr-merc-other!)."
+  (set! (-> *vr-merc-who* count) 0)
+  0)
+
+(defun vr-merc-other! ((jak process-drawable))
+  "Another player's Jak for this frame's merc tags. Only his own process is read: a pointer he carries (his sidekick)
+   may hold another use's leftovers, and in GOAL anything but #f counts as set."
+  (let* ((tags *vr-merc-who*)
+         (mine *target*)
+         (who (if (and *vr-head-hidden* mine
+                       (< (vector-vector-xz-distance (-> jak root trans) (-> mine control trans)) (meters 0.7))
+                       (< (fabs (- (-> jak root trans y) (-> mine control trans y))) (meters 1.5)))
+                  3
+                  2)))
+    (when (< (-> tags count) 40)
+      (set! (-> tags proc (-> tags count)) (process->handle jak))
+      (set! (-> tags who (-> tags count)) who)
+      (+! (-> tags count) 1)))
+  0)
+
+;; Each VR player's posed body (his head, arms and hands where his headset and controllers are) on his Jak in the
+;; others' games, VR or flat, in our parties (game/party.cpp; jak_vr.h pose_publish and pose_other): the runtime sends
+;; this player's with each update and puts each other player's on his Jak before it is drawn.
+(deftype vr-other-bodies (structure)
+  ((info vr-body-info 8 :inline)) ;; by party slot - 1 (party.cpp kMaxPlayers)
+  )
+
+(define *vr-other-bodies* (new 'static 'vr-other-bodies))
+(define *vr-posed* #f) ;; pc-vr-body! posed this player's Jak this frame
+(define-extern *mp-party?* symbol) ;; engine/mods/mod-game-handler.gc
+
+(defun vr-others-pose! ()
+  "In a party: this player's posed body to the runtime for the others, and theirs on their Jaks here."
+  (when *mp-party?*
+    (if *target*
+        (pc-vr-pose-publish! *vr-body-info* (-> *target* root trans) (-> *target* root quat) (if *vr-posed* 1 0))
+        (pc-vr-pose-publish! *vr-body-info* *zero-vector* *unity-quaternion* 0))
+    (let ((tags *vr-merc-who*))
+      (dotimes (i (-> tags count))
+        (let ((jak (the-as target (handle->process (-> tags proc i)))))
+          (when (and jak (nonzero? (-> jak node-list)) (nonzero? (-> jak draw)))
+            (let ((slot (the int (-> jak saved-owner))))
+              (when (and (> slot 0) (<= slot 8))
+                (let ((info (-> *vr-other-bodies* info (+ slot -1))))
+                  (vr-body-fill! info jak 0)
+                  (pc-vr-pose-other! slot info (-> jak root trans) (-> jak root quat))))))))))
+  0)
+
+;; what vr-graphics! last set: 0 nothing, 1 Max draw distance, 2 PS2 detail
+(define *vr-graphics-set* 0)
+
+(defun vr-graphics! ()
+  "While VR draws, the game's own graphics settings follow the VR menu's Max draw distance (on to start; the owner,
+   2026-11-13: no pop-in in any of the games, as Ratchet's): every actor born and drawn however far (the PC port's
+   actor culling off; Jak II and 3 also past each actor's own vis-dist, entity.gc), each model, the level and the sea at
+   their highest detail with no distance cut, every effect launched in full however far (as at the camera), shadows
+   and reflections at any distance. Off, the game's own settings as the player set them."
+  (let* ((g (pc-vr-graphics))
+         (fps (logand (ash g -8) 255))
+         (s *pc-settings*))
+    ;; 0.1.1: the game's frames a second follow the VR menu's Game frame rate (jak_vr.cpp s_game_fps: 60, the headset's
+    ;; rate or half of it; half with Smoother frames). The runtime lets the game go that often and the clocks step by
+    ;; it; the player's own choice is kept for the settings file (pckernel-common.gc *vr-user-fps*).
+    (when (and (> fps 0) (!= fps (-> s target-fps)))
+      (if (< *vr-user-fps* 0) (set! *vr-user-fps* (the-as int (-> s target-fps))))
+      (set-frame-rate! s fps #f))
+    (cond
+      ((logtest? g 2)
+       ;; PS2 detail (0.1.1, off to start; over Max draw distance): far things, effects and shadows as the PS2 drew them
+       (set! (-> s ps2-actor-vis?) #t)
+   (set! (-> s use-vis?) #f) ;; Jak 1: no vis trees (the PS2's visibility cells popped things in and out)
+       (set! (-> s ps2-lod-dist?) #t)
+       (set! (-> s ps2-parts?) #t)
+       (set! (-> s ps2-shadow?) #t)
+       (set! (-> s force-envmap?) #f)
+       (set! *vr-graphics-set* 2))
+      ((logtest? g 1)
+       (set! (-> s ps2-actor-vis?) #f)
+   (set! (-> s use-vis?) #f) ;; Jak 1: no vis trees (the PS2's visibility cells popped things in and out)
+       (set! (-> s ps2-lod-dist?) #f)
+       (set! (-> s ps2-parts?) #f)
+       (set! (-> s ps2-shadow?) #f)
+       (set! (-> s force-envmap?) #t)
+       (set! (-> s lod-force-tfrag) 0)
+       (set! (-> s lod-force-tie) 0)
+       (set! (-> s lod-force-ocean) 0)
+       (set! (-> s lod-force-actor) 0)
+       (set! *vr-graphics-set* 1))
+      ((and (nonzero? g) (nonzero? *vr-graphics-set*))
+       ;; both off again after one was on: the PC port's own settings back, as they start
+       (set! (-> s ps2-actor-vis?) #t)
+       (set! (-> s ps2-lod-dist?) #f)
+       (set! (-> s ps2-parts?) #f)
+       (set! (-> s ps2-shadow?) #f)
+       (set! (-> s force-envmap?) #t)
+       (set! *vr-graphics-set* 0))))
+  0)
+
+(defun vr-body-update! ((mode int))
+  "Jak's body to the runtime each frame: posed in play in first person; his head and Daxter at the eyes left out of the
+   eyes."
+  (let ((info *vr-body-info*)
+        (jak (the-as process-drawable #f))
+        (flags 0))
+    (set! (-> info dax-name 0) 0)
+    (set! (-> info probe-count) 0)
+    (set! (-> info gun-count) 0)
+    (set! (-> info dax-count) 0)
+    (when (and *vr-head-hidden* *target*)
+      (set! jak *target*)
+      (set! flags (if (zero? mode) 3 2))
+      (let ((dax (the-as process-drawable (vr-daxter))))
+        (when (and dax (nonzero? (-> dax draw)) (or (zero? mode) (vr-near-eyes? dax)))
+          (logior! flags 4)
+          (charp<-string (-> info dax-name) (-> dax draw mgeo name)))))
+    (cond
+      ((and jak (nonzero? (-> jak node-list)) (nonzero? (-> jak draw)))
+       (vr-body-fill! info jak flags)
+       (when (logtest? flags 1)
+         (vr-hand-probes! info)
+         (vr-dax-fill! info)))
+      (else
+       (set! (-> info flags) flags)
+       (set! (-> info jak-name 0) 0)))
+    (set! *vr-posed* (= (pc-vr-body! info) 1)))
+  0)
+
+;; ---- The VR menu (game/vr/vr_menu.h): the runtime's rows, drawn with the game's font on the HUD ----
+;; Opened from the options menu's "VR OPTIONS" (pc/progress-pc.gc) or the left menu button held a second in a menu. The
+;; runtime lays it out in Jak 1's 512 by 224 screen and takes the controllers while it is up; this draws its boxes (the
+;; menu, the chosen row) and then its words, in the debug bucket the HUD shows, over the game's own menu.
+
+(define *vr-menu-string* (new 'global 'string 256 (the-as string #f)))
+
+(defun vr-menu-draw ()
+  (when (pc-vr-menu-shown?)
+    (let ((at (new 'stack-no-clear 'vector)))
+      (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
+        ;; the boxes blend over what is under them, whatever the bucket's last drawing left set, and keep no depth
+        (dma-buffer-add-gs-set buf
+                               (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
+                               (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
+                               (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
+        (dotimes (i 4)
+          (let ((kind (pc-vr-menu-box i at)))
+            (when (nonzero? kind)
+              (draw-sprite2d-xy buf (the int (-> at x)) (the int (-> at y)) (the int (-> at z)) (the int (-> at w))
+                                (if (= kind 2)
+                                    (new 'static 'rgba :r #x40 :g #x48 :b #x70 :a #x60)
+                                    (new 'static 'rgba :r #x06 :g #x08 :b #x10 :a #x80)))))))
+      (let ((font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
+        (dotimes (i 40)
+          (let ((r (pc-vr-menu-text i *vr-menu-string* at)))
+            (when (nonzero? r)
+              (let ((align (logand (ash r -8) 255))
+                    (width (-> at w)))
+                (set-width! font (the int width))
+                (set-height! font 24)
+                (set-scale! font (-> at z))
+                (set-color! font (the-as font-color (logand r 255)))
+                (case align
+                  ((1)
+                   (set-flags! font (font-flags shadow kerning middle large))
+                   (set-origin! font (the int (- (-> at x) (* 0.5 width))) (the int (-> at y))))
+                  ((2)
+                   (set-flags! font (font-flags shadow kerning right large))
+                   (set-origin! font (the int (-> at x)) (the int (-> at y))))
+                  (else
+                   (set-flags! font (font-flags shadow kerning large))
+                   (set-origin! font (the int (-> at x)) (the int (-> at y)))))
+                (print-game-text *vr-menu-string* font #f 128 22))))))))
+  0)
+
+;; PC test aid (kmachine.cpp pc-vr-test-continue!): with JAKVR_TEST_CONTINUE=<continue point> set, once Jak has been in
+;; play on foot for 2 seconds (no scene, not the title: a boot has a frame or two of him before the title) the game
+;; starts again at that continue point, so a sim reaches any level.
+(define *vr-test-continue* (new 'global 'string 64 (the-as string #f)))
+(define *vr-test-continue-asked* #f)
+(define *vr-test-continue-frames* 0)
+(define-extern start (function symbol continue-point target)) ;; engine/target/logic-target.gc
+
+(defun vr-test-continue! ()
+  (cond
+    ((or *vr-test-continue-asked* (not *target*) (movie?) (vr-title?) (not (vr-first-person-ok?)))
+     (set! *vr-test-continue-frames* 0))
+    ((< *vr-test-continue-frames* 120)
+     (+! *vr-test-continue-frames* 1))
+    (else
+     (set! *vr-test-continue-asked* #t)
+     (when (= (pc-vr-test-continue! *vr-test-continue*) 1)
+       (let ((cont (get-continue-by-name *game-info* *vr-test-continue*)))
+         (format 0 "[vr] test: continue ~A ~A~%" *vr-test-continue* (if cont "found, starting there" "not found"))
+         (if cont
+             (start 'play cont))))))
+  0)
+
+
+;; PC test aid (kmachine.cpp pc-vr-test-warp!): with JAKVR_TEST_WARP=<actor> set (an actor's entity name, or its type's
+;; name for the first of that type), once Jak has been in play on foot for 3 seconds after any test continue he is put
+;; a metre over that actor, so a sim reaches a scene's trigger (LIST-0.1.1 item 43: the underwater city's scenes);
+;; JAKVR_TEST_WARP=list logs each actor of the levels loaded then (name, type, where in metres). JAKVR_TEST_WARP_OFFSET=
+;; dx,dy,dz puts him that far from the actor instead (metres), for things an actor spawns itself (the pipe game's buttons).
+;; With JAKVR_TEST_WARP_APPROACH=1 too, the offset is a first stop: once the levels there have loaded and he has stood 5
+;; seconds, he goes onto the actor (the elevator down to the underwater city asks to show the city as it starts down,
+;; which the game refuses while the city is not yet loaded; a player walking up to it has it loaded).
+(define *vr-test-warp* (new 'global 'string 64 (the-as string #f)))
+(define *vr-test-warp-state* 0) ;; 0 not read yet, 1 to do, 2 done or not set, 3 beside it (the approach)
+(define *vr-test-warp-frames* 0)
+
+(defun vr-test-warp-find ((name string))
+  "The actor named name, or else the first whose type is named so; with list? each one logged instead."
+  (let ((list? (string= name "list")))
+    (dotimes (i (-> *level* length))
+      (let ((lev (-> *level* level i)))
+        (when (and (= (-> lev status) 'active) (nonzero? (-> lev bsp actors)))
+          (let ((actors (-> lev bsp actors)))
+            (dotimes (j (-> actors length))
+              (let* ((e (-> actors data j actor))
+                     (ename (res-lump-struct e 'name basic))
+                     (etype (if (type-type? (-> e type) entity-actor) (-> e etype) #f)))
+                (cond
+                  (list?
+                   (format 0 "[vr-test] actor ~A ~A ~A at ~,,2M ~,,2M ~,,2M~%" (-> lev name) ename
+                           (if etype (-> (the-as type etype) symbol) '?)
+                           (-> e extra trans x) (-> e extra trans y) (-> e extra trans z)))
+                  ((name= ename name) (return e)))))))))
+    (when (not list?)
+      (dotimes (i (-> *level* length))
+        (let ((lev (-> *level* level i)))
+          (when (and (= (-> lev status) 'active) (nonzero? (-> lev bsp actors)))
+            (let ((actors (-> lev bsp actors)))
+              (dotimes (j (-> actors length))
+                (let ((e (-> actors data j actor)))
+                  (if (and (type-type? (-> e type) entity-actor) (-> e etype) (name= (-> (the-as type (-> e etype)) symbol) name))
+                      (return e))))))))))
+  (the-as entity-actor #f))
+
+(define *vr-test-warp-actor* (the-as entity-actor #f)) ;; the approach's actor (state 3)
+
+(defun vr-test-warp-to! ((e entity-actor) (offset? symbol))
+  "Jak put by the actor e: at JAKVR_TEST_WARP_OFFSET from it with offset?, else a metre over it; the camera with him."
+  (let ((pos (new-stack-vector0))
+        (off (new-stack-vector0)))
+    (set! (-> pos quad) (-> e extra trans quad))
+    (if (and offset? (= (pc-vr-test-warp-offset! off) 1))
+        (vector+! pos pos off)
+        (+! (-> pos y) (meters 1.0)))
+    (move-to-point! (-> *target* control) pos)
+    (vector-reset! (-> *target* control transv))
+    ;; the game's camera with him, its string started 6 m aside and 3 m over him (as pov-camera.gc restarts it):
+    ;; left behind, it stays where he was and follows him only slowly
+    (let ((cam-at (new-stack-vector0)))
+      (set! (-> cam-at quad) (-> pos quad))
+      (+! (-> cam-at x) (meters 6.0))
+      (+! (-> cam-at y) (meters 3.0))
+      (send-event *camera* 'teleport-to-vector-start-string cam-at))
+    (format 0 "[vr-test] warp to ~A (~A) at ~,,2M ~,,2M ~,,2M~%" *vr-test-warp* (res-lump-struct e 'name basic)
+            (-> pos x) (-> pos y) (-> pos z)))
+  0)
+
+(defun vr-test-warp! ()
+  (when (zero? *vr-test-warp-state*)
+    (set! *vr-test-warp-state* (if (= (pc-vr-test-warp! *vr-test-warp*) 1) 1 2)))
+  (when (or (= *vr-test-warp-state* 1) (= *vr-test-warp-state* 3))
+    (cond
+      ((or (not *vr-test-continue-asked*) (not *target*) (movie?) (vr-title?) (not (vr-first-person-ok?))
+           (< (current-time) (-> *game-info* blackout-time))
+           (not (logtest? (-> *target* control status) (cshape-moving-flags onsurf)))
+           ;; the approach waits for the levels there to load (a level loading)
+           (and (= *vr-test-warp-state* 3) (!= (-> *level* loading-level) (-> *level* level-default))))
+       (set! *vr-test-warp-frames* 0))
+      ((< *vr-test-warp-frames* (if (= *vr-test-warp-state* 3) 300 180))
+       (+! *vr-test-warp-frames* 1))
+      ((= *vr-test-warp-state* 3)
+       ;; JAKVR_TEST_WARP_APPROACH: beside it with the levels loaded, as a player walks up to it; now onto it
+       (set! *vr-test-warp-state* 2)
+       (vr-test-warp-to! *vr-test-warp-actor* #f)
+       (pc-vr-test-ready!))
+      (else
+       (set! *vr-test-warp-state* 2)
+       (let ((e (vr-test-warp-find *vr-test-warp*)))
+         (cond
+           ((string= *vr-test-warp* "list")
+            (format 0 "[vr-test] actors listed~%"))
+           ((not e)
+            (format 0 "[vr-test] warp: no actor ~A~%" *vr-test-warp*))
+           ((logtest? (pc-vr-test-flags) 512)
+            (set! *vr-test-warp-actor* e)
+            (set! *vr-test-warp-state* 3)
+            (set! *vr-test-warp-frames* 0)
+            (vr-test-warp-to! e #t))
+           (else
+            (vr-test-warp-to! e #t))))
+       ;; the sim's aligned frames start now, found or not (a script waiting on them would never end), or after the
+       ;; approach
+       (if (!= *vr-test-warp-state* 3) (pc-vr-test-ready!)))))
+  0)
