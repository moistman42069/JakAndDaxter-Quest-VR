+;; PC test aid (kmachine.cpp pc-vr-test-continue!): with JAKVR_TEST_CONTINUE=<continue point> set, once Jak has been in
+;; play on foot for 2 seconds (no scene, not the title: a boot has a frame or two of him before the title) the game
+;; starts again at that continue point, so a sim reaches any level.
+(define *vr-test-continue* (new 'global 'string 64 (the-as string #f)))
+(define *vr-test-continue-asked* #f)
+(define *vr-test-continue-frames* 0)
+
+(defun vr-test-continue! ()
+  (cond
+    ((or *vr-test-continue-asked* (not *target*) (movie?) (vr-title?) (not (vr-first-person-ok?)))
+     (set! *vr-test-continue-frames* 0))
+    ((< *vr-test-continue-frames* 120)
+     (+! *vr-test-continue-frames* 1))
+    (else
+     (set! *vr-test-continue-asked* #t)
+     (when (= (pc-vr-test-continue! *vr-test-continue*) 1)
+       (let ((cont (get-continue-by-name *game-info* *vr-test-continue*)))
+         (format 0 "[vr] test: continue ~A ~A~%" *vr-test-continue* (if cont "found, starting there" "not found"))
+         (if cont
+             (start 'play cont))))))
+  0)
+
+(define-extern vr-test-turret! (function int)) ;; below (item 22's test aid)
+
+(define *vr-state-was* (the-as symbol #f))
+
+(defun vr-state-trace ()
+  "PC test aid (JAKVR_STATE_TRACE=1, pc-vr-test-flags bit 2): Jak's state in the log as it changes."
+  (when (and *target* (logtest? (pc-vr-test-flags) 2))
+    (let ((name (-> *target* next-state name)))
+      (when (!= name *vr-state-was*)
+        (set! *vr-state-was* name)
+        (format 0 "[vr] state ~A~%" name))))
+  ;; PC test aid (JAKVR_TEST_HUD=1, pc-vr-test-flags bit 32): the HUD kept on screen in play, for the HUD tests
+  (when (and *target* (logtest? (pc-vr-test-flags) 32))
+    (show-hud #f))
+  (vr-test-turret!)
+  0)
+
+;; PC test aid (JAKVR_TEST_TURRETS=1, pc-vr-test-flags bit 256; LIST-0.1.1 item 22, Vixel's crash: "suspend called
+;; without enough stack in proc: #<sew-gunturret sew-gunturret-13 running :state die ... Stack: 288/256"): every 2
+;; seconds in play, the sewer's first gun turret (sew-gunturret-13, made with the light switch at the sewer's start)
+;; is looked for; once it is made it is destroyed through the game's own instant-death, so its die state runs, and
+;; the log follows it until it is gone. Not made after 6 seconds: Jak is put 12 m from it, on its level.
+(define *vr-test-turret-frames* 0)
+(define *vr-test-turret-step* 0) ;; 0 looking, 1 destroyed, 2 gone
+(define *vr-test-turret-waits* 0)
+
+(defun vr-test-turret! ()
+  (when (and *target* (logtest? (pc-vr-test-flags) 256) (< *vr-test-turret-step* 2))
+    (+! *vr-test-turret-frames* 1)
+    (when (>= *vr-test-turret-frames* 120)
+      (set! *vr-test-turret-frames* 0)
+      (let ((e (the-as entity-actor (entity-by-name "sew-gunturret-13"))))
+        (cond
+          ((not e)
+           (format 0 "[vr] test: turret: sew-gunturret-13 is in no level loaded~%"))
+          ((not (-> e extra process))
+           (cond
+             ((= *vr-test-turret-step* 1)
+              (set! *vr-test-turret-step* 2)
+              (format 0 "[vr] test: turret: gone, its death ran through~%"))
+             (else
+              (+! *vr-test-turret-waits* 1)
+              (format 0 "[vr] test: turret: not made yet, ~M from Jak~%"
+                      (vector-vector-distance (-> *target* control trans) (-> e trans)))
+              (when (>= *vr-test-turret-waits* 3)
+                (let ((at (new-stack-vector0)))
+                  (vector-! at (-> *target* control trans) (-> e trans))
+                  (set! (-> at y) 0.0)
+                  (vector-normalize! at (meters 12))
+                  (vector+! at at (-> e trans))
+                  (format 0 "[vr] test: turret: Jak put 12 m from it~%")
+                  (move-to-point! (-> *target* control) at))))))
+          (else
+           (let ((p (-> e extra process)))
+             (format 0 "[vr] test: turret: ~A in state ~A, stack ~D~%" (-> p name)
+                     (if (-> p state) (-> p state name) 'none) (-> p main-thread stack-size))
+             (when (zero? *vr-test-turret-step*)
+               (set! *vr-test-turret-step* 1)
+               (format 0 "[vr] test: turret: destroyed (instant-death)~%")
+               (send-event p 'instant-death))))))))
+  0)
