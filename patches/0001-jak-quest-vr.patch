+void party::game_player(int index, const std::string& name, const json& update, bool replay) {
+  const int slot = index + 1;
+  if (!game_ready() || index < 0 || index >= party::kMaxPlayers || slot >= MAX_MULTIPLAYER_COUNT)
+    return;
+  json p = json::object();
+  if (replay) {
+    json inter = update;
+    inter["interCleanup"] = 1;
+    p["interaction"] = inter;
+  } else {
+    p["username"] = name;
+    p["color"] = kPartyColor;
+    p["mpState"] = 2;  // mp-tgt-interactive
+    // His VR body (jak_vr.h pose_heard), "" when he is not posed; an update without it keeps the last
+    const auto vr = update.find("vr");
+    if (vr != update.end() && vr->is_string())
+      jakvr::pose_heard(index, vr->get<std::string>());
+    const auto pos = update.find("position");
+    if (pos != update.end() && pos->is_object()) {
+      for (const char* k : kPartyPositionKeys) {
+        if (pos->contains(k) && (*pos)[k].is_number())
+          p[k] = (*pos)[k];
+      }
+      if (pos->value("interType", 0) != 0) {
+        json inter = json::object();
+        for (const char* k : kPartyInterKeys) {
+          if (pos->contains(k))
+            inter[k] = (*pos)[k];
+        }
+        inter["interCleanup"] = 0;
+        p["interaction"] = inter;
+      }
+    }
+    json info = {{"teamId", 0}, {"playerIndex", index}};
+    const auto state = update.find("state");
+    if (state != update.end() && state->is_object() && state->contains("cellCount"))
+      info["cellsCollected"] = (*state)["cellCount"];
+    p["playerInfo"] = info;
+    // the table's keys come in order, "interaction" before "mpState": a newcomer is interactive before his first
+    if (gMultiplayerInfo->players[slot].mp_state == 0)
+      gMultiplayerInfo->players[slot].mp_state = 2;
+  }
+  handle_client_json({{"players", {{std::to_string(index), p}}}});
+}
+
+void party::game_player_left(int index) {
+  jakvr::pose_heard(index, "");
+  if (!game_ready() || index < 0 || index + 1 >= MAX_MULTIPLAYER_COUNT)
+    return;
+  handle_client_json({{"players", {{std::to_string(index), {{"mpState", 0}}}}}});
+}
