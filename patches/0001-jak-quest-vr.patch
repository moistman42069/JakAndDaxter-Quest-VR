+  ;; none (the start of play sets the game's features again after the first frame, sim j2_holster3)
+  (when (and *target* (not (logtest? (-> *game-info* features) (game-feature gun))) (logtest? (pc-vr-test-flags) 1))
+    (set! *vr-test-gun-given* #t)
