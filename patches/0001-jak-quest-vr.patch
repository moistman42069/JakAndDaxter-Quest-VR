+                  [](Options& o, int v) { o.anisotropy = kAnisotropy[std::clamp(v, 0, 4)]; }, 0, 4, 1, kAnisoNames};
+  aniso.next_start = true;
+  r.push_back(aniso);
+
+  // 0.1.1, the owner: "see whatever can be done to boost performance ... optional and off by default of course"
+  r.push_back({Kind::kHeader, "Performance", ""});
+  r.push_back(VR_CHOICE("Game frame rate", frame_rate, int, kFrameRate, "How often the game draws. The headset's: smoothest, most work. Half: least work, the headset fills in."));
+  r.push_back(VR_TOGGLE("Dynamic resolution", dynamic_resolution, "The eyes are drawn smaller while the headset is not keeping up, and back up when it is."));
+  r.push_back(VR_TOGGLE("PS2 detail", ps2_detail, "Far things, effects and shadows as the PlayStation 2 drew them: faster, with some pop-in. Over Max draw distance."));
+  Row sharp = VR_CHOICE("Sharpening", sharpen, int, kSharpen, "The headset sharpens the picture: a lower Eye resolution keeps its edges. On the Quest.");
+  sharp.next_start = true;
+  r.push_back(sharp);
+
+  r.push_back({Kind::kBack, "Back", "Back to the game's menu."});
+  return r;
+}
+
+#undef VR_TOGGLE
+#undef VR_NUMBER
+#undef VR_CHOICE
+
+// The layout, in the games' screen.
+constexpr float kBoxX = 32, kBoxY = 30, kBoxW = 448, kBoxH = 356;
+constexpr float kTitleY = 40;
+constexpr float kFirstRowY = 72;
+constexpr float kRowStep = 24;
+constexpr int kRowsShown = 10;
+constexpr float kLabelX = 48;
+constexpr float kValueLeft = 292, kValueRight = 466;
+constexpr float kHelpY = 328;  // two lines at most
+constexpr float kHintY = 366;
+
+struct State {
+  std::mutex mutex;
+  int game = 1;
+  bool shown = false;
+  std::vector<Row> main_rows;  // VR Options
+  std::vector<Row> page_rows;  // another page's, made again each frame (the games found, the players)
+  int page = kMain;
+  int want_page = -1;                    // ask_page's, for after this frame's input
+  int main_selected = 1, main_top = 0;   // where VR Options was left, to come back to
+  std::vector<party::Slot> slots;        // this game's saves, read as a save page opens
+  std::vector<int> visible;  // the rows of this game, in order
+  int selected = 1;          // into visible
+  int top = 0;               // the first of visible in the window
+  // the sticks' and buttons' last state, for presses and repeats
+  int stick_dir_y = 0, stick_dir_x = 0;
+  double stick_next = 0;
+  bool confirm_was = true, back_was = true, press_was = true;
+  int hover_was = -2;
+  double press_next = 0;
+} s;
+
+bool selectable(const Row& row) {
+  return row.kind != Kind::kHeader;
+}
+
+std::vector<Row>& rows() {
+  return s.page == kMain ? s.main_rows : s.page_rows;
+}
+
+void ask_page(int page) {
+  s.want_page = page;
+}
+
+// A save slot's row: "Save 2: Sentinel Beach", "23 cells".
+Row slot_row(int slot, const char* doing, std::function<void()> pick) {
+  const party::Slot& at = s.slots[slot];
+  Row row{Kind::kAction, "Save " + std::to_string(slot + 1) + (at.present && !at.where.empty() ? ": " + at.where : ""),
+          ""};
+  const std::string value = at.present ? std::to_string(at.cells) + " cells" : "Empty";
+  row.value = [value] { return value; };
+  const std::string help =
+      at.present ? std::string(doing) + std::to_string(at.cells) + " power cells, " + std::to_string(at.orbs) +
+                       " orbs, " + std::to_string(at.flies) + " scout flies, " + std::to_string(at.percent) + "%."
+                 : "Nothing is saved there.";
+  row.live_help = [help] { return save_help(help); };
+  if (at.present) {
+    row.act = [pick](int by) {
+      if (by == 0) {
+        pick();
+      }
+    };
+  }
+  return row;
+}
+
+std::vector<Row> make_page(int page) {
+  std::vector<Row> r;
+  const auto action = [&r](const std::string& label, const std::string& help, std::function<std::string()> value,
+                           std::function<void()> pick) {
+    Row row{Kind::kAction, label, ""};
+    row.value = value ? std::move(value) : std::function<std::string()>([] { return std::string(); });
+    row.live_help = [help] { return save_help(help); };
+    if (pick) {
+      row.act = [pick](int by) {
+        if (by == 0) {
+          pick();
+        }
+      };
+    }
+    r.push_back(row);
+  };
+  switch (page) {
+    case kHostSave:
+      action("This game as it is", "Host now, playing on from where you are.", nullptr, [] {
+        party::host();
+        ask_page(kMain);
+      });
+      for (int slot = 0; slot < static_cast<int>(s.slots.size()); ++slot) {
+        r.push_back(slot_row(slot, "Loads it, then hosts: ", [slot] {
+          party::play_slot(slot);
+          party::host();
+          ask_page(kMain);
+        }));
+      }
+      action("New game", "Hosts a new game, saved nowhere until you save it from the pause menu.", nullptr, [] {
+        party::play_new_game();
+        party::host();
+        ask_page(kMain);
+      });
+      break;
+    case kGames: {
+      const auto list = party::games();
+      if (list.empty()) {
+        action("Looking for games...", "Games on this network, and on the party server if the launcher names one. The list keeps itself up to date.",
+               nullptr, nullptr);
+      }
+      for (const auto& g : list) {
+        const std::string where =
+            !g.same_build ? "(other version)" : g.cells >= 0 ? std::to_string(g.cells) + " cells" : "";
+        const std::string help =
+            g.same_build ? g.label + ". A joins it."
+                         : g.label + ": another release of Jak and Daxter Quest VR. Both need the same one to play together.";
+        Row row{Kind::kAction, g.host + "'s game", ""};
+        row.value = [where] { return where; };
+        row.live_help = [help] { return party_help(help.c_str()); };
+        if (g.same_build) {
+          row.act = [g](int by) {
+            if (by == 0) {
+              party::join(g);
+              ask_page(kPlaySave);  // as Ratchet's: which save to play in it
+            }
+          };
+        }
+        r.push_back(row);
+      }
+      break;
+    }
+    case kPlaySave:
+      action("The host's progress", "The host's power cells, orbs and scout flies, as far as it has got. Your own saves stay as they are.",
+             [] { return std::string(party::in_party() && !party::hosting() ? "" : "Join first"); }, [] {
+               party::play_host_copy();
+             });
+      action("This game as it is", "Play on from where you are.", nullptr, [] { ask_page(kMain); });
+      for (int slot = 0; slot < static_cast<int>(s.slots.size()); ++slot) {
+        r.push_back(slot_row(slot, "Loads it: ", [slot] { party::play_slot(slot); }));
+      }
+      action("New game", "A new game, saved nowhere until you save it from the pause menu.", nullptr,
+             [] { party::play_new_game(); });
+      break;
+    case kPlayers: {
+      const auto list = party::players();
+      const bool host = party::hosting();
+      if (list.empty()) {
+        action("Not in a game", "Host or join one first.", nullptr, nullptr);
+      }
+      for (const auto& p : list) {
+        const std::string label = p.name + (p.index == 0 ? " (host)" : "") + (p.me ? " (you)" : "");
+        Row row{Kind::kAction, label, ""};
+        const bool can_remove = host && !p.me;
+        row.value = [can_remove] { return std::string(can_remove ? "Remove" : ""); };
+        const std::string help = can_remove ? "A takes " + p.name + " out of your game." : std::string("In this game.");
+        row.live_help = [help] { return help; };
+        if (can_remove) {
+          const int index = p.index;
+          row.act = [index](int by) {
+            if (by == 0) {
+              party::remove(index);
+            }
+          };
+        }
+        r.push_back(row);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  r.push_back({Kind::kBack, "Back", "Back to VR Options."});
+  return r;
+}
+
+void build_visible() {
+  if (s.main_rows.empty()) {
+    s.main_rows = make_rows();
+  }
+  if (s.page != kMain) {
+    s.page_rows = make_page(s.page);
+  }
+  s.visible.clear();
+  const bool guns = s.game != static_cast<int>(GameVersion::Jak1);
+  const auto& all = rows();
+  for (int i = 0; i < static_cast<int>(all.size()); ++i) {
+    if ((all[i].guns_only && !guns) || (all[i].jak1_only && guns)) {
+      continue;
+    }
+    s.visible.push_back(i);
+  }
+}
+
+void keep_in_window() {
+  const int count = static_cast<int>(s.visible.size());
+  s.selected = std::clamp(s.selected, 0, std::max(count - 1, 0));
+  if (s.selected < s.top + 1) {
+    s.top = s.selected - 1;  // the header above it in view too
+  }
+  if (s.selected >= s.top + kRowsShown) {
+    s.top = s.selected - kRowsShown + 1;
+  }
+  s.top = std::clamp(s.top, 0, std::max(count - kRowsShown, 0));
+}
+
+void move_selection(int by) {
+  const int count = static_cast<int>(s.visible.size());
+  int at = s.selected;
+  for (int tries = 0; tries < count; ++tries) {
+    at += by;
+    if (at < 0 || at >= count) {
+      return;  // no wrap: the list's ends stop it
+    }
+    if (selectable(rows()[s.visible[at]])) {
+      s.selected = at;
+      keep_in_window();
+      return;
+    }
+  }
+}
+
+std::string value_text(const Row& row, const Options& o) {
+  switch (row.kind) {
+    case Kind::kToggle:
+      return row.get(o) != 0 ? "On" : "Off";
+    case Kind::kChoice:
+      return row.names[std::clamp(row.get(o), row.low, row.high)];
+    case Kind::kNumber: {
+      const int v = row.get(o);
+      if (row.tenths) {
+        return std::to_string(v / 10) + "." + std::to_string(std::abs(v % 10)) + row.unit;
+      }
+      return std::to_string(v) + row.unit;
+    }
+    case Kind::kAction:
+      return row.value ? row.value() : "";
+    default:
+      return "";
+  }
+}
+
+// The page ask_page asked for, after the frame's input: its rows made, its first row chosen (VR Options: where it was).
+void go_to_asked_page() {
+  if (s.want_page < 0) {
+    return;
+  }
+  const int to = s.want_page;
+  s.want_page = -1;
+  if (s.page == kMain && to != kMain) {
+    s.main_selected = s.selected;
+    s.main_top = s.top;
+  }
+  if (to == kHostSave || to == kPlaySave) {
+    s.slots = party::slots();
+  }
+  s.page = to;
+  build_visible();
+  if (to == kMain) {
+    s.selected = s.main_selected;
+    s.top = s.main_top;
+    keep_in_window();
+  } else {
+    s.selected = 0;
+    s.top = 0;
+    if (!s.visible.empty() && !selectable(rows()[s.visible[0]])) {
+      move_selection(1);
+    }
+    s.top = 0;
+  }
+  s.hover_was = -2;
+  lg::info("[vr-menu] page: {}", kPageTitle[to]);
+}
+
+// One step of a row's value: by -1 or +1; 0 for a press (on/off flips, a choice goes round, a number steps up and
+// goes round from its top).
+void change(const Row& row, int by) {
+  if (row.kind == Kind::kBack) {
+    if (by == 0) {
+      if (s.page != kMain) {
+        ask_page(kMain);
+      } else {
+        close();
+      }
+    }
+    return;
+  }
+  if (row.kind == Kind::kAction) {
+    if (row.act) {
+      if (by == 0) {
+        lg::info("[vr-menu] {}", row.label);
+      }
+      row.act(by);
+    }
+    return;
+  }
+  if (!row.get || !row.set) {
+    return;
+  }
+  Options next = options();
+  const int was = row.get(next);
+  int v = was;
+  switch (row.kind) {
+    case Kind::kToggle:
+      v = was != 0 ? 0 : 1;
+      break;
+    case Kind::kChoice:
+      v = by == 0 ? (was >= row.high ? row.low : was + 1) : std::clamp(was + by, row.low, row.high);
+      break;
+    case Kind::kNumber:
+      v = by == 0 ? (was + row.step > row.high ? row.low : was + row.step)
+                  : std::clamp(was + by * row.step, row.low, row.high);
+      break;
+    default:
+      return;
+  }
+  if (v == was) {
+    return;
+  }
+  row.set(next, v);
+  set_options(next);
+  lg::info("[vr-menu] {}: {}", row.label, value_text(row, next));
+}
+
+}  // namespace
+
+void set_game(int game_version) {
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.game = game_version;
+  build_visible();
+}
+
+float game_screen_height() {
+  return s.game == static_cast<int>(GameVersion::Jak1) ? 224.0f : kScreenHeight;
+}
+
+bool shown() {
+  return s.shown;
+}
+
+void open(const char* why) {
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.shown) {
+    return;
+  }
+  s.page = kMain;
+  s.want_page = -1;
+  build_visible();
+  s.shown = true;
+  s.selected = 0;
+  s.top = 0;
+  move_selection(1);
+  s.top = 0;
+  // what is held as it opens (the A that picked "VR Options", the menu button) does nothing until let go
+  s.confirm_was = s.back_was = s.press_was = true;
+  s.stick_dir_x = s.stick_dir_y = 0;
+  s.hover_was = -2;
+  lg::info("[vr-menu] open ({})", why);
+}
+
+void close() {
+  if (s.shown) {
+    s.shown = false;
+    lg::info("[vr-menu] closed");
+  }
+}
+
+void update(const Input& in, double now) {
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!s.shown) {
+    return;
+  }
+  if (s.page != kMain) {
+    // a page of Multiplayer's: the games found, the players, made again; the games' list wanted while it is shown
+    if (s.page == kGames) {
+      party::browse();
+    }
+    build_visible();
+    keep_in_window();
+  }
+  if (s.visible.empty()) {
+    return;
+  }
+  // The sticks: up and down choose, left and right change; held, they repeat.
+  const int dir_y = in.stick_y > 0.6f ? -1 : in.stick_y < -0.6f ? 1 : 0;
+  const int dir_x = std::fabs(in.stick_x) > 0.6f && std::fabs(in.stick_x) > std::fabs(in.stick_y) ? (in.stick_x > 0 ? 1 : -1) : 0;
+  const bool moved = dir_y != s.stick_dir_y || (dir_y == 0 && dir_x != s.stick_dir_x);
+  if (moved) {
+    s.stick_next = now + 0.4;
+  }
+  if ((dir_y != 0 || dir_x != 0) && (moved || now >= s.stick_next)) {
+    if (!moved) {
+      s.stick_next = now + 0.1;
+    }
+    if (dir_y != 0) {
+      move_selection(dir_y);
+    } else {
+      const Row& row = rows()[s.visible[s.selected]];
+      if (row.kind != Kind::kToggle) {
+        change(row, dir_x);
+      } else if ((dir_x > 0) != (row.get(options()) != 0)) {
+        change(row, 0);  // right is on, left is off
+      }
+    }
+  }
+  s.stick_dir_y = dir_y;
+  s.stick_dir_x = dir_x;
+
+  if (in.confirm && !s.confirm_was) {
+    change(rows()[s.visible[s.selected]], 0);
+  }
+  s.confirm_was = in.confirm;
+  if (in.back && !s.back_was) {
+    if (s.page != kMain) {
+      ask_page(kMain);  // B on a page: back to VR Options
+    } else {
+      close();
+    }
+  }
+  s.back_was = in.back;
+  if (!s.shown) {
+    return;
+  }
+
+  // The pointer: a row under it is chosen as it comes onto it; the trigger changes it (on a number, its left half of
+  // the value steps down and the right half up) or, above or below the list, scrolls it.
+  if (in.point_valid) {
+    const float x = in.point_u * kScreenWidth, y = in.point_v * kScreenHeight;
+    int hover = -1;  // -1 none, -3 above the list, -4 below it
+    if (x >= kBoxX && x < kBoxX + kBoxW) {
+      if (y >= kFirstRowY - 2 && y < kFirstRowY - 2 + kRowStep * kRowsShown) {
+        const int slot = static_cast<int>((y - (kFirstRowY - 2)) / kRowStep);
+        const int at = s.top + slot;
+        if (at >= 0 && at < static_cast<int>(s.visible.size()) && selectable(rows()[s.visible[at]])) {
+          hover = at;
+        }
+      } else if (y >= kBoxY && y < kFirstRowY - 2) {
+        hover = -3;
+      } else if (y >= kFirstRowY - 2 + kRowStep * kRowsShown && y < kHelpY - 4) {
+        hover = -4;
+      }
+    }
+    if (hover >= 0 && hover != s.hover_was) {
+      s.selected = hover;
+    }
+    s.hover_was = hover;
+    const bool press = in.point_press && !s.press_was;
+    if (hover >= 0 && press) {
+      const Row& row = rows()[s.visible[hover]];
+      const float middle = (kValueLeft + kValueRight) / 2;
+      if ((row.kind == Kind::kNumber || row.kind == Kind::kChoice || (row.kind == Kind::kAction && row.cycles)) &&
+          x >= kValueLeft) {
+        change(row, x < middle ? -1 : 1);
+      } else {
+        change(row, 0);
+      }
+    }
+    if ((hover == -3 || hover == -4) && in.point_press && (press || now >= s.press_next)) {
+      s.press_next = now + (press ? 0.35 : 0.1);
+      s.top = std::clamp(s.top + (hover == -3 ? -1 : 1), 0, std::max(static_cast<int>(s.visible.size()) - kRowsShown, 0));
+      s.selected = std::clamp(s.selected, s.top, s.top + kRowsShown - 1);
+      if (!selectable(rows()[s.visible[s.selected]])) {
+        move_selection(hover == -3 ? -1 : 1);
+      }
+    }
+  } else {
+    s.hover_was = -2;
+  }
+  s.press_was = in.point_press;
+  go_to_asked_page();
+}
+
+namespace {
+bool box_laid_out(int index, int& kind, float out[4]);
+bool text_laid_out(int index, Text& out);
+}  // namespace
+
+// The layout is in the 512 by 416 screen; the game's own is Jak 1's shorter one (game_screen_height), and Jak 1's
+// font, all capitals, is wider for the same scale.
+bool box(int index, int& kind, float out[4]) {
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!box_laid_out(index, kind, out)) {
+    return false;
+  }
+  const float y_scale = game_screen_height() / kScreenHeight;
+  out[1] *= y_scale;
+  out[3] *= y_scale;
+  return true;
+}
+
+bool text(int index, Text& out) {
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!text_laid_out(index, out)) {
+    return false;
+  }
+  out.y *= game_screen_height() / kScreenHeight;
+  // each game's large font at the layout's scale: a row's label and value side by side in the box (sim j1_menu2,
+  // j2_menu2)
+  out.scale *= s.game == static_cast<int>(GameVersion::Jak1) ? 0.85f : 0.8f;
+  return true;
+}
+
+namespace {
+
+bool box_laid_out(int index, int& kind, float out[4]) {
+  if (!s.shown) {
+    return false;
+  }
+  if (index == 0) {
+    kind = 1;
+    out[0] = kBoxX;
+    out[1] = kBoxY;
+    out[2] = kBoxW;
+    out[3] = kBoxH;
+    return true;
+  }
+  if (index == 1) {
+    const int slot = s.selected - s.top;
+    if (slot < 0 || slot >= kRowsShown) {
+      return false;
+    }
+    kind = 2;
+    out[0] = kBoxX + 6;
+    out[1] = kFirstRowY - 2 + kRowStep * static_cast<float>(slot);
+    out[2] = kBoxW - 12;
+    out[3] = kRowStep;
+    return true;
+  }
+  return false;
+}
+
+bool text_laid_out(int index, Text& out) {
+  if (!s.shown || s.visible.empty()) {
+    return false;
+  }
+  const Options& o = options();
+  // 0 the title; then two a row shown (label, value); then the arrows; then the help and the hint
+  if (index == 0) {
+    out = {kPageTitle[s.page], kScreenWidth / 2, kTitleY - 8, 5, 1, 0.75f};
+    return true;
+  }
+  int i = index - 1;
+  const int shown_rows = std::min(kRowsShown, static_cast<int>(s.visible.size()) - s.top);
+  if (i < shown_rows * 2) {
+    const int at = s.top + i / 2;
+    const Row& row = rows()[s.visible[at]];
+    const float y = kFirstRowY + kRowStep * static_cast<float>(i / 2);
+    const bool chosen = at == s.selected;
+    if (i % 2 == 0) {
+      if (row.kind == Kind::kHeader) {
+        out = {row.label, kLabelX - 6, y, 5, 0, 0.6f};
+      } else {
+        out = {row.label, kLabelX, y, chosen ? 10 : 0, 0, 0.55f};
+      }
+    } else {
+      std::string v = value_text(row, o);
+      // (no "< v >" as Ratchet's: the games' fonts draw button pictures for < and >; the chosen row's colour and
+      // bar say it)
+      out = {v, kValueRight - 6, y, chosen ? 10 : 0, 2, 0.55f};
+    }
+    return true;
+  }
+  i -= shown_rows * 2;
+  if (i == 0) {
+    out = {s.top > 0 ? "more above" : "", kScreenWidth / 2, kFirstRowY - 14, 0, 1, 0.4f};
+    return true;
+  }
+  if (i == 1) {
+    const bool more = s.top + kRowsShown < static_cast<int>(s.visible.size());
+    out = {more ? "more below" : "", kScreenWidth / 2, kFirstRowY - 2 + kRowStep * kRowsShown, 0, 1, 0.4f};
+    return true;
+  }
+  if (i == 2) {
+    const Row& chosen = rows()[s.visible[s.selected]];
+    out = {chosen.live_help ? chosen.live_help() : chosen.help, kScreenWidth / 2, kHelpY, 0, 1, 0.42f,
+           kBoxW - 24};
+    return true;
+  }
+  if (i == 3) {
+    out = {"Stick or point: choose.  A or trigger: change.  B: back.", kScreenWidth / 2, kHintY, 5, 1, 0.42f,
+           kBoxW - 24};
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+}  // namespace jakvr::menu
diff --git a/game/vr/vr_menu.h b/game/vr/vr_menu.h
new file mode 100644
index 000000000..0ba276dda
--- /dev/null
+++ b/game/vr/vr_menu.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+//
+// The in-game VR menu (list item 29), the same in all three games: every VR option (vr_options.h) as a row, on or off
+// or a value to step, chosen with either stick or pointed at with a hand, as Ratchet's VR Options. Opened from each
+// game's own options menu ("VR Options", goal_src/jakN/pc/pc-vr.gc pc-vr-menu-open!) or by holding the left menu button
+// a second in a game menu. The runtime keeps the rows and the layout; each game draws what it is given with its own
+// font (vr-menu-draw in pc-vr.gc) on the HUD, in the games' 512 by 416 screen.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace jakvr::menu {
+
+// The controllers this tick, for the menu.
+struct Input {
+  float stick_x = 0, stick_y = 0;  // the further pushed of the two sticks (up positive)
+  bool confirm = false;            // A held
+  bool back = false;               // B or Y held
+  bool point_valid = false;        // the pointing hand's ray meets the panel
+  float point_u = 0, point_v = 0;  // there: 0..1 from the left, 0..1 from the top
+  bool point_press = false;        // the pointing hand's trigger held
+};
+
+// The games' screen, where the menu is laid out.
+inline constexpr float kScreenWidth = 512.0f;
+inline constexpr float kScreenHeight = 416.0f;
+// The game's own 2D screen's height: Jak II and 3's text and boxes are 512 by 416, Jak 1's 512 by 224 (box() and
+// text() give the game its own; the pointer on the games' menus is in it too).
+float game_screen_height();
+
+void set_game(int game_version);
+bool shown();
+void open(const char* why);
+void close();
+// One tick of the pad while shown (game thread). The game gets none of the controllers meanwhile.
+void update(const Input& in, double now);
+
+// What to draw, in the games' screen. Boxes: 1 the menu's background, 2 the chosen row.
+bool box(int index, int& kind, float out[4]);
+// Words: colour is the games' font-color (0 default, 5 yellow, 10 menu-selected); align 0 left, 1 centre, 2 right;
+// x is the left edge, the middle or the right edge; the game wraps them within width.
+struct Text {
+  std::string words;
+  float x = 0, y = 0;
+  int color = 0;
+  int align = 0;
+  float scale = 0.6f;
+  float width = 420.0f;
+};
+bool text(int index, Text& out);
+
+}  // namespace jakvr::menu
diff --git a/game/vr/vr_options.cpp b/game/vr/vr_options.cpp
new file mode 100644
index 000000000..ae2087eb3
--- /dev/null
+++ b/game/vr/vr_options.cpp
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+
+#include "vr_options.h"
+
+#include <algorithm>
+#include <atomic>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+namespace jakvr {
+
+namespace {
+
+std::mutex s_mutex;
+Options s_options;
+std::string s_path;
+std::atomic<bool> s_loaded{false};
+
+template <typename T>
+T clamp_enum(int v, T count) {
+  return static_cast<T>(std::clamp(v, 0, static_cast<int>(count) - 1));
+}
+
+// Each option's name in the file, and how it is read and written.
+struct Field {
+  const char* name;
+  bool* flag = nullptr;
+  int* number = nullptr;
+  float* real = nullptr;
+  int low = 0, high = 0;
+};
+
+std::vector<Field> fields(Options& o, int& cutscene, int& dpad, int& turn, int& menu_hand, int& move_by,
+                          int& body_shown) {
+  return {
+      {"first-person", &o.first_person},
+      {"cutscenes", nullptr, &cutscene, nullptr, 0, 2},
+      {"adaptive-cutscenes", &o.adaptive_cutscenes},
+      {"first-person-in-talks", &o.first_person_in_talks},
+      {"first-person-vehicles", &o.first_person_vehicles},
+      {"turn", nullptr, &turn, nullptr, 0, 1},
+      {"snap-degrees", nullptr, &o.snap_degrees, nullptr, 15, 90},
+      {"smooth-degrees", nullptr, &o.smooth_degrees, nullptr, 30, 360},
+      {"world-scale", nullptr, nullptr, &o.world_scale, 0, 0},
+      {"third-person-scale", nullptr, nullptr, &o.third_person_scale, 0, 0},
+      {"seated", &o.seated},
+      {"hud-size", nullptr, &o.hud_size, nullptr, 50, 150},
+      {"hud-distance", nullptr, &o.hud_distance, nullptr, 80, 300},
+      {"hud-height", nullptr, &o.hud_height, nullptr, -40, 40},
+      {"hud-follows-head", &o.hud_follows},
+      {"dpad", nullptr, &dpad, nullptr, 0, 1},
+      {"dpad-reach", nullptr, &o.dpad_reach, nullptr, 10, 40},
+      {"vibration", &o.vibration},
+      {"vibration-strength", nullptr, &o.vibration_strength, nullptr, 25, 200},
+      {"world-vibration", &o.world_vibration},
+      {"dpad-buzz", &o.dpad_buzz},
+      {"gun-switch-buzz", &o.gun_switch_buzz},
+      {"menu-hand", nullptr, &menu_hand, nullptr, 0, 2},
+      {"stick-click-menu", &o.stick_click_menu},
+      {"move-direction", nullptr, &move_by, nullptr, 0, 1},
+      {"body", &o.body},
+      {"body-shown", nullptr, &body_shown, nullptr, 0, 6},
+      {"hide-arms-near-eyes", &o.hide_arms_near_eyes},
+      {"fade-body-near-eyes", &o.fade_near_eyes},
+      {"keep-body-upright", &o.steady_body},
+      {"fingers", &o.fingers},
+      {"predict-hands", &o.predict_hands},
+      {"hands-on-world", &o.hands_on_world},
+      {"physical-crouch", &o.physical_crouch},
+      {"crouch-drop", nullptr, &o.crouch_drop, nullptr, 10, 60},
+      {"arm-length", nullptr, &o.arm_length, nullptr, 70, 150},
+      {"body-height", nullptr, &o.body_height, nullptr, -30, 30},
+      {"body-forward", nullptr, &o.body_forward, nullptr, -30, 30},
+      {"view-height", nullptr, &o.view_height, nullptr, -40, 40},
+      {"hand-melee", &o.hand_melee},
+      {"melee-speed", nullptr, &o.melee_speed, nullptr, 10, 50},
+      {"melee-grip", &o.melee_grip},
+      {"spread-spin-kick", &o.spread_spin_kick},
+      {"hand-aim", &o.hand_aim},
+      {"two-hand-grip", &o.two_hand_grip},
+      {"holster-draw", &o.holster_draw},
+      {"holster-size", nullptr, &o.holster_size, nullptr, 50, 200},
+      {"holster-on-foot", &o.holster_on_foot},
+      {"gun-angle", nullptr, &o.gun_angle, nullptr, -45, 45},
+      {"resolution", nullptr, &o.resolution, nullptr, 50, 150},
+      {"smoother-frames", &o.space_warp},  // 0.1.0 wrote "space-warp" (on to start then): read no more
+      {"cpu-gpu-boost", &o.cpu_gpu_boost},
+      {"foveation", nullptr, &o.foveation, nullptr, 0, 4},
+      {"refresh-hz", nullptr, &o.refresh_hz, nullptr, 0, 120},
+      {"max-draw-distance", &o.max_draw_distance},
+      {"msaa", nullptr, &o.msaa, nullptr, 1, 8},
+      {"anisotropy", nullptr, &o.anisotropy, nullptr, 1, 16},
+      {"frame-rate", nullptr, &o.frame_rate, nullptr, 0, 2},
+      {"dynamic-resolution", &o.dynamic_resolution},
+      {"sharpening", nullptr, &o.sharpen, nullptr, 0, 2},
+      {"ps2-detail", &o.ps2_detail},
+      {"multiplayer", &o.multiplayer},
+  };
+}
+
+}  // namespace
+
+const Options& options() {
+  // Read without the lock: a change replaces fields that are each a word; a reader seeing half a change sees two
+  // settings each valid. The menu changes one at a time.
+  return s_options;
+}
+
+void set_options(const Options& next) {
+  {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    s_options = next;
+  }
+  save_options();
+}
+
+std::string options_path() {
+  return s_path;
+}
+
+void load_options(int game_version) {
+  std::lock_guard<std::mutex> lock(s_mutex);
+  const auto dir = file_util::get_user_settings_dir(static_cast<GameVersion>(game_version));
+  s_path = (dir / "vr-options.txt").string();
+  Options o;
+  int cutscene = static_cast<int>(o.cutscene_view), dpad = static_cast<int>(o.dpad_place);
+  int turn = static_cast<int>(o.turn), menu_hand = static_cast<int>(o.menu_hand);
+  int move_by = static_cast<int>(o.move_by), body_shown = static_cast<int>(o.body_shown);
+  std::ifstream in(s_path);
+  if (in) {
+    auto list = fields(o, cutscene, dpad, turn, menu_hand, move_by, body_shown);
+    std::string line;
+    while (std::getline(in, line)) {
+      std::istringstream words(line);
+      std::string name, value;
+      if (!(words >> name >> value) || name.empty() || name[0] == '#') {
+        continue;
+      }
+      for (auto& f : list) {
+        if (name != f.name) {
+          continue;
+        }
+        try {
+          if (f.flag) {
+            *f.flag = value == "on" || value == "1" || value == "true";
+          } else if (f.number) {
+            *f.number = std::clamp(std::stoi(value), f.low, f.high);
+          } else if (f.real) {
+            *f.real = std::clamp(std::stof(value), 0.5f, 2.0f);
+          }
+        } catch (...) {
+        }
+      }
+    }
+    lg::info("[vr] options from {}", s_path);
+  } else {
+    lg::info("[vr] no {} yet: the defaults", s_path);
+  }
+  o.cutscene_view = clamp_enum(cutscene, CutsceneView::kCount);
+  o.dpad_place = clamp_enum(dpad, DpadPlace::kCount);
+  o.turn = clamp_enum(turn, TurnKind::kCount);
+  o.menu_hand = clamp_enum(menu_hand, MenuHand::kCount);
+  o.move_by = clamp_enum(move_by, MoveBy::kCount);
+  o.body_shown = clamp_enum(body_shown, BodyShown::kCount);
+  s_options = o;
+  s_loaded = true;
+}
+
+bool options_loaded() {
+  return s_loaded.load();
+}
+
+void save_options() {
+  std::lock_guard<std::mutex> lock(s_mutex);
+  if (s_path.empty()) {
+    return;
+  }
+  Options o = s_options;
+  int cutscene = static_cast<int>(o.cutscene_view), dpad = static_cast<int>(o.dpad_place);
+  int turn = static_cast<int>(o.turn), menu_hand = static_cast<int>(o.menu_hand);
+  int move_by = static_cast<int>(o.move_by), body_shown = static_cast<int>(o.body_shown);
+  std::ostringstream out;
+  out << "# Jak and Daxter Quest VR options: the launcher and the in-game VR menu write this.\n";
+  for (auto& f : fields(o, cutscene, dpad, turn, menu_hand, move_by, body_shown)) {
+    out << f.name << ' ';
+    if (f.flag) {
+      out << (*f.flag ? "on" : "off");
+    } else if (f.number) {
+      out << *f.number;
+    } else if (f.real) {
+      out << *f.real;
+    }
+    out << '\n';
+  }
+  try {
+    file_util::create_dir_if_needed_for_file(s_path);
+    file_util::write_text_file(s_path, out.str());
+  } catch (const std::exception& e) {
+    lg::warn("[vr] could not write {}: {}", s_path, e.what());
+  }
+}
+
+}  // namespace jakvr
diff --git a/game/vr/vr_options.h b/game/vr/vr_options.h
new file mode 100644
index 000000000..17d109e1c
--- /dev/null
+++ b/game/vr/vr_options.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Jak and Daxter Quest VR contributors
+//
+// The VR options: what the launcher sets before the game starts and the in-game VR menu changes while it runs. One
+// file for each game (vr-options.txt in its settings folder), lines of "name value". Everything the port adds is on to
+// start, each with its row to turn it off.
+
+#pragma once
+
+#include <string>
+
+namespace jakvr {
+
+enum class CutsceneView { kFirstPerson = 0, kThirdPerson = 1, kScreen = 2, kCount = 3 };
+enum class DpadPlace { kHead = 0, kThumbRest = 1, kCount = 2 };
+enum class TurnKind { kSnap = 0, kSmooth = 1, kCount = 2 };
+enum class MenuHand { kBoth = 0, kRight = 1, kLeft = 2, kCount = 3 };
+enum class MoveBy { kHead = 0, kLeftHand = 1, kCount = 2 };
+// What of Jak the eyes see in first person (owner, 2026-11-14: "hands only, hands and arms only, arms hands and legs
+// only, etc."); his hands always. The rest is still posed and casts his shadow (jak_vr.cpp body()).
+enum class BodyShown {
+  kWhole = 0,     // all of him but the head
+  kBodyArms = 1,  // no legs
+  kBodyLegs = 2,  // no arms: the hands by themselves
+  kArmsLegs = 3,  // no body
+  kArms = 4,
+  kLegs = 5,      // and the hands
+  kHands = 6,
+  kCount = 7
+};
+
+struct Options {
+  // ---- View ----
+  bool first_person = true;  // play starts seen from Jak's eyes (the left menu button held switches)
+  CutsceneView cutscene_view = CutsceneView::kFirstPerson;  // through his eyes where he is in the scene
+  // Adaptive cutscenes (the owner, 0.1.1): a scene set to be seen through his eyes goes around you by itself while Jak
+  // is not properly in it, and back when he is (jak_vr.cpp update_scene_fit)
+  bool adaptive_cutscenes = true;
+  // a talk in play from his eyes too (else the game's camera, around you); owner, 2026-11-13: on to start
+  bool first_person_in_talks = true;
+  // First person in vehicles (the owner, 0.1.1): on the Zoomer, the JET-Board, in cars, the Titan suit and on the flut
+  // the view sits in his head too, turning with what he rides (each game's vr-vehicle-first-person-ok?, kFlagVehicle)
+  bool first_person_vehicles = false;  // off to start: vehicles in third person, as the games put them (the owner)
+  TurnKind turn = TurnKind::kSmooth;  // owner, 2026-11-13: smooth turn to start (snap is the VR menu's other choice)
+  int snap_degrees = 45;
+  int smooth_degrees = 120;  // a second, the stick full over
+  // First person: 1 is life size, Jak as tall as a person (his eyes 1.6 m up: jak_vr.cpp kLifeSize); more: the world
+  // bigger. To 0.1.0, 1 was a game metre a real one, which made him 2.3 m to the eyes: 1.45 here is that look.
+  float world_scale = 1.0f;
+  float third_person_scale = 1.0f;  // third person: the world seen at this size around the game's camera
+  bool seated = false;       // a sitting player: the view at his eyes whatever the head's height
+  int hud_size = 100;        // percent
+  int hud_distance = 160;    // centimetres ahead
+  int hud_height = 0;        // centimetres up from the eyes' line (below 0: under it)
+  bool hud_follows = true;   // the HUD moves with the head; off, it stays put ahead of you until you look well away
+
+  // ---- Controls ----
+  DpadPlace dpad_place = DpadPlace::kThumbRest;  // owner 2026-11-11: left thumb on its rest makes the right stick the d-pad (kHead: left hand at the head, left stick)
+  int dpad_reach = 22;       // centimetres from the head the hand counts as there
+  bool vibration = true;
+  int vibration_strength = 100;  // percent of every buzz
+  bool world_vibration = true;   // a hand meeting a wall or the floor, harder the harder it presses (Ratchet's)
+  bool dpad_buzz = true;         // 0.1.1: a quick pulse in the stick's hand as a d-pad direction goes in
+  bool gun_switch_buzz = true;   // 0.1.1: Jak II and 3, a quick pulse in the gun's hand as the gun changes
+  MenuHand menu_hand = MenuHand::kBoth;
+  // Stick click as menu button (0.1.1): where the runtime binds no left menu button (SteamVR keeps Touch's for its
+  // dashboard), the left stick's lone click is the menu button (jak_vr.cpp fill_pad). Off: that click is L3 there too.
+  bool stick_click_menu = true;
+  // Owner 2026-11-12: the stick moves Jak where you look (the games turn it by the camera, which is the head); the
+  // other choice, where the left hand points.
+  MoveBy move_by = MoveBy::kHead;
+
+  // ---- Body ----
+  bool body = true;          // Jak's body seen from his eyes, its arms reaching the controllers (full-body IK)
+  BodyShown body_shown = BodyShown::kWhole;  // what of him the eyes see (first person); the hands always
+  bool hide_arms_near_eyes = false;  // 0.1.1: an arm's upper arm and forearm out of the eyes while near them (owner: off to start)
+  // 0.1.1's refinement pass (the owner: both on to start). Fade body near your eyes: a leg swung up by the face, his
+  // body and legs in a roll, a flip or a dive fade out of the eyes and back, eased (jak_vr.cpp body() step 9). Keep
+  // your body upright: his hips and chest stay upright under your head whatever his animation does (a spin kick, a
+  // punch's twist), his legs still reaching the game's feet (body() step 1b).
+  bool fade_near_eyes = true;
+  bool steady_body = true;
+  bool fingers = true;       // the fingers follow the controllers' sensors
+  bool predict_hands = true; // his hands drawn where the controllers will be when the frame is shown (no lag behind)
+  bool hands_on_world = true;  // hands and what they hold stop at walls and floors
+  bool physical_crouch = true;  // the head going down crouches him
+  int crouch_drop = 30;      // centimetres down from standing
+  int arm_length = 100;      // percent of his arm's own reach
+  int body_height = 0;       // centimetres
+  int body_forward = 0;      // centimetres his body sits ahead of the head (less: behind), as Ratchet's
+  int view_height = 0;       // centimetres
+
+  // ---- Combat ----
+  bool hand_melee = true;    // punch and swing with your arms: a punch is his punch, a sweep his spin kick
+  int melee_speed = 25;      // tenths of a metre a second the hand must move for a hit (2.5 m/s)
+  // Fists on the right grip (owner, 2026-11-13, as Ratchet's wrench): on foot, the right grip held makes fists and only
+  // fists hit; the grip's game button there (Jak II and 3's JET-Board) moves to the right stick's click
+  bool melee_grip = true;
+  // Spin kick by spreading your arms (Vixel's T-pose, 0.1.1): both arms out wide at the sides, held a moment, is one
+  // spin kick (jak_vr.cpp fill_pad); the arms come in before the next
+  bool spread_spin_kick = false;  // off to start (the owner, 0.1.1)
+  bool hand_aim = true;     // Jak II and 3's gun and Jak 1's yellow eco aim where the hand points
+  bool two_hand_grip = true; // the other hand on the gun steadies it (Jak II and 3)
+  bool holster_draw = true;  // a grip at the hip or over the shoulder draws the gun, let go there puts it away (Jak II and 3)
+  // Holster size: how far past 0.1.0's places a hand still counts as at the hip or the shoulder (jak_vr.cpp at_holster).
+  // A little bigger to start (Vixel, 0.1.0: easier to put the gun away); the owner wanted it in the VR menu.
+  int holster_size = 130;    // percent
+  // Holsters only on foot (0.1.1, Vixel's car height button): in a vehicle, on the board, a turret or a ride a grip at
+  // the hip or shoulder stays the game's grip button (the gun cannot come out there). Off, as 0.1.0.
+  bool holster_on_foot = true;
+  int gun_angle = 0;         // degrees up from where the controller points
+
+  // ---- Graphics (the launcher's; read by the runtime) ----
+  int resolution = 100;      // percent of the headset's recommended eye size
+  // Smoother frames (AppSW): off to start since 0.1.1 (owner, 2026-11-14: "it seems to cause visual issues for now. the
+  // title screen flickers with it on"); saved as "smoother-frames", so 0.1.0's "space-warp on" is left behind once.
+  bool space_warp = false;
+  bool cpu_gpu_boost = true; // CPU and GPU boost
+  int foveation = 2;         // Foveated rendering (Ratchet 0.1.19): 0 off, 1 low, 2 medium, 3 high, 4 highest (0.1.1)
+  int refresh_hz = 0;        // 0: the headset's own
+  bool max_draw_distance = true;  // no pop-in: every actor, effect and model drawn however far, at its highest detail (pc-vr.gc vr-graphics!)
+  int msaa = 2;              // Anti-aliasing, samples a pixel (1 off, 2, 4); Ratchet's 2x to start, proven on the Quest
+  int anisotropy = 16;       // Anisotropic filtering (1 off .. 16), at most the graphics chip's; 16 the games' own (the most)
+
+  // ---- Performance (0.1.1; the owner: "optional and off by default of course") ----
+  // Game frame rate: 0 sixty a second whatever the headset's rate (as 0.1.0), 1 the headset's own (each display a new
+  // game frame), 2 half the headset's (half the work; the headset turns each picture to the head between). Smoother
+  // frames makes it half by itself (jak_vr.cpp s_game_fps).
+  int frame_rate = 0;
+  bool dynamic_resolution = false;  // the eyes drawn smaller while the headset is not keeping up (jak_vr.cpp Scale)
+  int sharpen = 0;                  // the headset sharpens the eyes' picture: 0 off, 1 normal, 2 strong (the Quest's)
+  // PS2 detail: the distances, effects and shadows the PlayStation 2 drew (pc-vr.gc vr-graphics!); over Max draw
+  // distance while it is on
+  bool ps2_detail = false;
+
+  // ---- Multiplayer (Jak 1: Teamruns' game side and a party of our own, game/party.h) ----
+  // on to start (owner, 2026-11-14), the launcher's Mods turn it off: the VR menu hosts, browses and joins games; it
+  // changes nothing in the game until the player hosts or joins one (party::game_on), and opens no port until then
+  bool multiplayer = true;
+};
+
+// The options in force (game thread and display thread both read; a change is a whole copy).
+const Options& options();
+// Replaces them and saves them.
+void set_options(const Options& next);
+// Reads the game's file (defaults where it has nothing), at start.
+void load_options(int game_version);
+// Whether the file has been read yet (0.1.1: the headset reads it itself if it starts first).
+bool options_loaded();
+// Writes the game's file.
+void save_options();
+// The file's path, for the launcher and the logs.
+std::string options_path();
+
+}  // namespace jakvr
diff --git a/game/vr/xr.h b/game/vr/xr.h
new file mode 100644
index 000000000..b03335f33
--- /dev/null
+++ b/game/vr/xr.h
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 the Ratchet & Clank Quest VR and Jak and Daxter Quest VR contributors
+//
+// The headset, as the mod sees it. Two backends share this: xr_openxr.cpp (OpenXR on the Quest) and
+// xr_sim.cpp (scripted poses and PNGs on a desktop, for testing against the real game).
+// Everything here runs on the game's thread, with its GL context current.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+#include "pad.h"
+#include "rig.h"
+
+namespace quest {
+
+enum Hand { kLeft = 0, kRight = 1 };
+
+// The swapchains: one for each eye and the panel the 2D goes on.
+enum Target { kTargetLeftEye = 0, kTargetRightEye = 1, kTargetPanel = 2, kTargetCount = 3 };
+
+struct XrSettings {
+    float refresh_hz = 0;        // 0: the headset's own
+    bool keep_refresh = true;    // stay at it where it is not held; false: back to 72 Hz after two slow 10 s spells
+    float resolution = 1.0f;     // of the headset's recommended eye size
+    int panel_width = 1024;
+    int panel_height = 768;
+    // Smoother frames (Application SpaceWarp, XR_FB_space_warp, from 0.1.17): the game draws every other frame and the
+    // headset makes the ones between from the last and how its pixels moved. Where the runtime has it (the Quest's).
+    bool space_warp = false;  // off to start since 0.1.1 (vr_options.h)
+    // CPU and GPU boost (0.1.18, the owner's ask for Quest Games Optimizer's highest speeds): the processors at the
+    // highest level the runtime lets an app ask for (XR_EXT_performance_settings' boost) rather than sustained high. Tools
+    // such as Quest Games Optimizer go further through the developer shell, which no app can do itself.
+    bool cpu_gpu_boost = true;
+    // Foveated rendering (0.1.19, the owner's ask): each eye's picture drawn at a lower resolution towards its edges,
+    // where the lenses blur it anyway (GL_QCOM_texture_foveated, the Quest's graphics chip). 0 off, 1 low, 2 medium,
+    // 3 high.
+    int foveation = 2;  // 4 highest (0.1.1)
+    // Sharpening (0.1.1, off to start): the headset sharpens the eyes' picture as it shows it
+    // (XR_FB_composition_layer_settings, the Quest's). 0 off, 1 normal, 2 strong (its "quality" filter).
+    int sharpen = 0;
+};
+
+// Smoother frames: an eye's motion and depth images to draw this frame (GL textures of the game's context).
+struct MotionTarget {
+    unsigned motion = 0;  // GL_RGBA16F: each pixel's movement since the last frame, in NDC
+    unsigned depth = 0;   // GL_DEPTH24_STENCIL8: that pass's depth, 1 near and 0 far
+    int width = 0;
+    int height = 0;
+};
+
+// What the frame's motion pass drew, for the finish_frame after it.
+struct SpaceWarpFrame {
+    bool drawn[2]{};        // each eye's motion and depth were drawn this frame, from the frame before
+    float depth_zero = 0;   // the distance in metres that depth 0 stands for (the far plane)
+    float depth_one = 0;    // and depth 1 (the near plane)
+    // 0.1.1. `skip`: the motion says nothing (a cut, the first frame of a run): the headset makes no frame from this
+    // one but stays at its half rate (XR_COMPOSITION_LAYER_SPACE_WARP_INFO_FRAME_SKIP_BIT_FB). `kept`: nothing was
+    // drawn this frame (the game sent no picture): the last motion images again, skipped likewise. Dropping the motion
+    // for such a frame instead threw the headset out of its half rate and back in: a flicker.
+    bool skip = false;
+    bool kept = false;
+};
+
+struct FrameInfo {
+    bool should_render = false;  // the headset will show this frame
+    bool recentred = false;      // the runtime moved the room (the headset's own recentre, its button held)
+    bool focused = false;        // the app has input (the Quest's system menu takes it away)
+    bool views_valid = false;
+    std::int64_t display_time = 0;
+    double frame_seconds = 1.0 / 72.0;
+    Pose eye[2];
+    float fov[2][4]{};           // left, right, up, down, radians
+    Pose head;
+    float head_above_floor = -1.0f;  // over the floor the headset knows (Feet on the floor); below 0, it knows none
+    Pose hand_grip[2];
+    Pose hand_aim[2];
+    bool hand_valid[2]{};
+    bool hand_bound[2]{};        // a controller is bound to this hand, as OpenXR says
+    bool stick_active[2]{};      // its stick reports: the system has given it to the app
+    Controls controls;
+};
+
+// A flat picture in the world (tracking space) or following the head.
+struct PanelLayer {
+    bool visible = false;
+    bool follows_head = false;
+    Pose pose;                   // in tracking space, or the head's when follows_head
+    float width = 1, height = 1; // metres
+    bool blend = false;          // uses the picture's alpha
+};
+
+// The menu pointer's beam from the hand and the dot where it lands, in tracking space; a second pair for the other hand.
+struct PointerLayers {
+    bool beam = false;
+    Pose beam_pose;
+    float beam_length = 0;
+    bool dot = false;
+    Pose dot_pose;
+    // The other hand's (0.1.19): with Akimbo both weapon wheels can be up at once, each hand pointing at its own.
+    bool beam2 = false;
+    Pose beam2_pose;
+    float beam2_length = 0;
+    bool dot2 = false;
+    Pose dot2_pose;
+};
+
+class Headset {
+public:
+    virtual ~Headset() = default;
+
+    // Starts with the GL context current. False: `why` says what is missing.
+    virtual bool start(const XrSettings& settings, std::string& why) = 0;
+
+    // Waits for the headset's next frame. False: no frame this time (the session is not running):
+    // the caller draws nothing and calls neither finish_frame nor anything below.
+    virtual bool begin_frame(FrameInfo& out) = 0;
+
+    // The size of a target, and a GL texture for this frame's picture of it (0: none to draw to).
+    virtual void target_size(Target target, int& width, int& height) const = 0;
+    virtual unsigned acquire(Target target) = 0;
+
+    // Ends the frame begin_frame began. `eyes`: the eyes were drawn (with the FrameInfo's poses).
+    // `eyes_kept`: the eyes' pictures are the last drawn, not this frame's: shown from the poses they were drawn
+    // from, so that the compositor holds the world still under the head.
+    virtual void finish_frame(bool eyes, bool eyes_kept, const PanelLayer& panel) = 0;
+
+    // Smoother frames: eye `eye`'s motion images for this frame, taken with it; false for none (the headset makes no
+    // frames between, or it is off).
+    virtual bool motion_target(int eye, MotionTarget& out) {
+        (void)eye;
+        (void)out;
+        return false;
+    }
+
+    // What this frame's motion pass drew, told before its finish_frame; not told: nothing.
+    virtual void space_warp(const SpaceWarpFrame& warp) { (void)warp; }
+
+    // Smoother frames can be given here: the headset makes frames between from the motion (motion_target answers),
+    // pacing the game at half its rate while it does.
+    virtual bool makes_frames() const { return false; }
+
+    // In how many nanoseconds the next frame begin_frame begins is predicted to be shown; 0: it cannot say.
+    virtual std::int64_t next_display_in() { return 0; }
+
+    // The controllers' grips as the runtime predicts them for display time `at` (FrameInfo::display_time's clock), from
+    // any thread (Jak: the game thread poses the body for the display the frame it makes will be shown in). False where
+    // it cannot say: the frame's own grips stand.
+    virtual bool locate_grips(std::int64_t at, Pose grip[2], bool valid[2]) {
+        (void)at;
+        (void)grip;
+        (void)valid;
+        return false;
+    }
+
+    // The eyes' poses (tracking space) and fields of view (left, right, up, down, radians) the pictures of this frame
+    // were drawn with, when not the frame's own views (Jak: the head the game's camera was made from, a frame or two
+    // older, and a field even on both sides). Told before finish_frame; not told: the frame's own.
+    virtual void drawn_views(const Pose eye[2], const float fov[2][4]) {
+        (void)eye;
+        (void)fov;
+    }
+
+    // Foveated rendering: `texture` is the GL texture the port draws eye `eye`'s picture into, before it is copied to the
+    // eye's target; drawn foveated from the next frame, as XrSettings::foveation says. Called each frame the eye is drawn.
+    virtual void foveate(int eye, unsigned texture) {
+        (void)eye;
+        (void)texture;
+    }
+
+    virtual void haptic(Hand hand, float strength, float seconds, float hertz) = 0;
+
+    // A line of words ahead of the head until it is cleared with null or "" (notice.h).
+    virtual void show_notice(const char* text) = 0;
+
+    // Drawn over the panel in the next finish_frame.
+    virtual void show_pointer(const PointerLayers& pointer) = 0;
+
+    // The system ended the app's session for good: leave.
+    virtual bool wants_exit() const = 0;
+
+    virtual void stop() = 0;
+};
+
+// The backend this build has.
+Headset* make_headset(void (*log)(int level, const char* text));
+
+}  // namespace quest
