+  "Does str-a start with str-b?.
+   If either string is null, returns #f."
+  (let ((a-ptr (-> str-a data))
+        (b-ptr (-> str-b data))
+        )
+    (if (or (zero? str-a) (zero? str-b))
+        (return #f)
+        )
+    (while (and (nonzero? (-> a-ptr 0)) (nonzero? (-> b-ptr 0)))
+      (if (!= (-> a-ptr 0) (-> b-ptr 0))
