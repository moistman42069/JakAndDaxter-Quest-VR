+void Debugger::fire_stop_callback(xdbg::SignalInfo::Kind kind) {
+  std::function<void(xdbg::SignalInfo::Kind)> cb;
+  {
+    std::lock_guard<std::mutex> lock(m_stop_callback_mutex);
+    cb = m_stop_callback;
+  }
+  if (cb) {
+    cb(kind);
+  }
+}
